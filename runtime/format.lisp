(in-package :hol2cl.runtime)

;; Format's box API used by the actual HOL printer. This is a bounded
;; compatibility interface, not a replacement for every OCaml Format feature.
(defstruct format-text string width)
(defstruct format-break spaces offset)
(defstruct format-box (mode :hov) (indent 0) (children nil))
(defstruct formatter buffer stream (margin 78) (max-boxes 4611686018427387903) root stack (suppressed 0))
(defun buffer-create (size)
  (if (minusp size) (invalid-arg "Buffer.create")
      (make-array (max 1 size) :element-type 'character :fill-pointer 0 :adjustable t)))
(defun buffer-contents (buffer) (copy-seq buffer))
(defun buffer-reset (buffer) (setf (fill-pointer buffer) 0) unit)
(defun reset-formatter (fmt)
  (setf (formatter-root fmt) (make-format-box)
        (formatter-stack fmt) (list (formatter-root fmt))
        (formatter-suppressed fmt) 0) fmt)
(defun formatter-of-buffer (buffer) (reset-formatter (make-formatter :buffer buffer)))
(setf std-formatter (reset-formatter (make-formatter :stream *standard-output*)))
(defun add-format-node (fmt node)
  (when (zerop (formatter-suppressed fmt))
    (push node (format-box-children (first (formatter-stack fmt))))) unit)
(defun pp-print-string (fmt s)
  (add-format-node fmt (make-format-text :string s :width (length s))))
(defun pp-print-as (fmt width s)
  (add-format-node fmt (make-format-text :string s :width width)))
(defun open-format-box (fmt mode indent)
  (cond ((plusp (formatter-suppressed fmt)) (incf (formatter-suppressed fmt)))
        ((cl:>= (length (formatter-stack fmt)) (formatter-max-boxes fmt))
         (pp-print-string fmt "...") (setf (formatter-suppressed fmt) 1))
        (t (let ((box (make-format-box :mode mode :indent indent)))
             (add-format-node fmt box) (push box (formatter-stack fmt))))) unit)
(defun pp-open-box (fmt indent) (open-format-box fmt :hov indent))
(defun pp-open-hbox (fmt u) (declare (ignore u)) (open-format-box fmt :h 0))
(defun pp-open-hvbox (fmt indent) (open-format-box fmt :hv indent))
(defun pp-open-vbox (fmt indent) (open-format-box fmt :v indent))
(defun pp-close-box (fmt u)
  (declare (ignore u))
  (cond ((plusp (formatter-suppressed fmt)) (decf (formatter-suppressed fmt)))
        ((rest (formatter-stack fmt)) (pop (formatter-stack fmt)))) unit)
(defun pp-print-break (fmt spaces offset)
  (add-format-node fmt (make-format-break :spaces spaces :offset offset)))
(defun pp-print-space (fmt u) (declare (ignore u)) (pp-print-break fmt 1 0))
(defun pp-set-margin (fmt margin)
  (when (cl:> margin 1) (setf (formatter-margin fmt) margin)) unit)
(defun pp-set-max-boxes (fmt n)
  (when (cl:> n 1) (setf (formatter-max-boxes fmt) n)) unit)
(defun pp-get-max-boxes (fmt u) (declare (ignore u)) (formatter-max-boxes fmt))
(defun get-margin (u) (declare (ignore u)) (formatter-margin std-formatter))
(defun set-margin (margin) (pp-set-margin std-formatter margin))
(defun set-max-boxes (n) (pp-set-max-boxes std-formatter n))

(defun box-children (box) (reverse (format-box-children box)))
(defun flat-format-width (node)
  (typecase node
    (format-text (format-text-width node))
    (format-break (format-break-spaces node))
    (format-box (reduce #'+ (box-children node) :key #'flat-format-width :initial-value 0))))
(defun render-format (fmt)
  (let ((column 0) (width (formatter-margin fmt)))
    (with-output-to-string (out)
      (labels ((text (string length)
                 (write-string string out) (incf column length))
               (break-line (indent)
                 (terpri out) (setf column (max 0 indent))
                 (write-string (make-string column :initial-element #\Space) out))
               (next-width (nodes)
                 (loop for node in nodes until (format-break-p node)
                       sum (flat-format-width node)))
               (render (node mode indent)
                 (typecase node
                   (format-text (text (format-text-string node) (format-text-width node)))
                   (format-box
                    (let* ((base (cl:+ column (format-box-indent node)))
                           (box-mode (case (format-box-mode node)
                                       (:h :flat)
                                       (:v :vertical)
                                       (:hv (if (cl:<= (flat-format-width node) (cl:- width column)) :flat :vertical))
                                       (otherwise :hov))))
                      (walk-nodes (box-children node) box-mode base)))
                   (format-break
                    (if (eq mode :flat)
                        (text (make-string (format-break-spaces node) :initial-element #\Space)
                              (format-break-spaces node))
                        (break-line (cl:+ indent (format-break-offset node)))))))
               (walk-nodes (nodes mode indent)
                 (loop for rest on nodes for node = (car rest)
                   do (if (and (format-break-p node) (eq mode :hov))
                          (if (cl:<= (cl:+ column (format-break-spaces node) (next-width (cdr rest))) width)
                              (render node :flat indent) (render node :vertical indent))
                          (render node mode indent)))))
        (render (formatter-root fmt) :hov 0)))))
(defun pp-print-flush (fmt u)
  (declare (ignore u))
  (let ((string (render-format fmt)))
    (if (formatter-buffer fmt)
        (loop for c across string do (vector-push-extend c (formatter-buffer fmt)))
        (write-string string (formatter-stream fmt)))
    (when (formatter-stream fmt) (finish-output (formatter-stream fmt))))
  (reset-formatter fmt) unit)
(defun print-flush (u) (pp-print-flush std-formatter u))
(defun pp-print-char (fmt c) (pp-print-string fmt (string c)))
(defun pp-print-int (fmt n) (pp-print-string fmt (string-of-int n)))
(defun pp-print-cut (fmt u) (declare (ignore u)) (pp-print-break fmt 0 0))
(defun open-box (indent) (pp-open-box std-formatter indent))
(defun open-vbox (indent) (pp-open-vbox std-formatter indent))
(defun close-box (u) (pp-close-box std-formatter u))
(defun print-break (spaces offset) (pp-print-break std-formatter spaces offset))
(defun pp-print-newline (fmt u)
  (pp-print-flush fmt u)
  (pp-print-string fmt (string #\Newline))
  (pp-print-flush fmt unit))

;; The format string selects a registered curried continuation. Keep callbacks
;; on the same function-value boundary as every other translated function.
(defun parse-format-string (string &optional (origin "Format"))
  (let ((tokens nil) (arity 0) (start 0) (i 0))
    (labels ((literal (end)
               (when (cl:> end start) (push (subseq string start end) tokens))))
      (loop while (cl:< i (length string))
        do (if (char= (char string i) #\%)
               (progn
                 (literal i) (incf i)
                 (when (cl:= i (length string)) (invalid-arg (string-concat origin ": incomplete directive")))
                 (let ((directive (char string i)))
                   (case directive
                     (#\% (push "%" tokens))
                     (#\a (incf arity 2) (push directive tokens))
                     ((#\t #\s #\d #\b) (incf arity) (push directive tokens))
                     (#\! (push directive tokens))
                     (otherwise (invalid-arg (string-concat origin ": unsupported directive")))))
                 (incf i) (setf start i))
               (incf i)))
      (literal i))
    (values (nreverse tokens) arity)))
(defun format-continuation (fmt string finish)
  (multiple-value-bind (tokens arity) (parse-format-string string)
    (flet ((emit (&rest arguments)
             (dolist (token tokens)
               (if (stringp token) (pp-print-string fmt token)
                   (case token
                     (#\a (let ((printer (pop arguments)) (value (pop arguments)))
                             (funcall printer fmt value)))
                     (#\t (funcall (pop arguments) fmt))
                     (#\s (pp-print-string fmt (pop arguments)))
                     (#\d (pp-print-string fmt (string-of-int (pop arguments))))
                     (#\b (pp-print-string fmt (if (pop arguments) "true" "false")))
                     (#\! (pp-print-flush fmt unit)))))
             (cl:funcall finish)))
      (if (zerop arity) (emit) (function-value #'emit arity)))))
(defun format-fprintf (fmt string)
  (format-continuation fmt string (lambda () unit)))
(defun format-printf (string) (format-fprintf std-formatter string))
(defun format-asprintf (string)
  (let* ((buffer (buffer-create 16)) (fmt (formatter-of-buffer buffer)))
    (format-continuation fmt string
      (lambda () (pp-print-flush fmt unit) (buffer-contents buffer)))))

;; Printf's scalar profile writes to channels/strings, without Format boxes.
;; Its %a/%t callback conventions are outside this profile and are rejected.
(defun printf-continuation (string writer flush finish)
  (multiple-value-bind (tokens arity) (parse-format-string string "Printf")
    (when (or (member #\a tokens) (member #\t tokens))
      (invalid-arg "Printf: unsupported callback directive"))
    (flet ((emit (&rest arguments)
             (dolist (token tokens)
               (if (eql token #\!) (cl:funcall flush)
                   (cl:funcall writer
                     (if (stringp token) token
                         (case token
                           (#\s (pop arguments))
                           (#\d (string-of-int (pop arguments)))
                           (#\b (if (pop arguments) "true" "false")))))))
             (cl:funcall finish)))
      (if (zerop arity) (emit) (function-value #'emit arity)))))
(defun printf-printf (string)
  (let ((stream *standard-output*))
    (printf-continuation string (lambda (s) (write-string s stream))
      (lambda () (finish-output stream)) (lambda () unit))))
(defun printf-sprintf (string)
  (let ((buffer (buffer-create 16)))
    (printf-continuation string
      (lambda (s) (loop for c across s do (vector-push-extend c buffer)))
      (lambda () unit) (lambda () (buffer-contents buffer)))))
