(require :asdf)
(asdf:initialize-source-registry `(:source-registry (:directory ,(truename ".")) :inherit-configuration))
(setf asdf:*asdf-verbose* nil *compile-verbose* nil *load-verbose* nil)
(asdf:load-system "holai-runtime")
(defvar *tuple-list-checks* 0)
(defun check-tuple (value) (incf *tuple-list-checks*) (unless value (error "Tuple-list check ~d failed" *tuple-list-checks*)))
(let* ((inner (holai.runtime:tuple 3 4)) (pair (holai.runtime:tuple nil inner)))
  (check-tuple (equal (holai.runtime:tuple-items pair) (list nil inner)))
  (check-tuple (not (vectorp (holai.runtime:tuple-items pair))))
  (check-tuple (null (holai.runtime:fst pair)))
  (check-tuple (eq inner (holai.runtime:snd pair)))
  (check-tuple (holai.runtime:match pair ((holai.runtime:tuple nil (holai.runtime:tuple 3 4)) t) (_ nil)))
  (check-tuple (holai.runtime:match pair ((holai.runtime:tuple _) nil) (_ t)))
  (check-tuple (holai.runtime:match pair ((holai.runtime:tuple _ _ _) nil) (_ t)))
  (check-tuple (handler-case (progn (holai.runtime:= pair (list nil inner)) nil) (holai.runtime:invalid_argument () t))))
(check-tuple (holai.runtime:< (holai.runtime:tuple 99 99) (holai.runtime:tuple 0 0 0)))
(check-tuple (holai.runtime:< (holai.runtime:tuple 1 8) (holai.runtime:tuple 2 0)))
(let ((a (holai.runtime:tuple 1 (holai.runtime:tuple 2 3)))
      (b (holai.runtime:tuple 1 (holai.runtime:tuple 2 3))))
  (check-tuple (holai.runtime:= a b))
  (check-tuple (= (holai.runtime::structural-hash a) (holai.runtime::structural-hash b))))
(dolist (index '(-1 2 1/2))
  (check-tuple (handler-case (progn (holai.runtime:tuple-ref (holai.runtime:tuple 1 2) index) nil)
                 (type-error () t))))
(check-tuple (holai.runtime:match (holai.runtime:tuple) ((holai.runtime:tuple) t) (_ nil)))
(format t "~&Tuple-list checks passed: ~d~%" *tuple-list-checks*)
