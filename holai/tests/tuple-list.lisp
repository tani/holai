(require :asdf)
(let ((root (uiop:pathname-parent-directory-pathname
             (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))))
  (asdf:initialize-source-registry
   `(:source-registry (:directory ,root) :inherit-configuration)))
(setf asdf:*asdf-verbose* nil *compile-verbose* nil *load-verbose* nil)
(asdf:load-system "holai/runtime")
(uiop:define-package :holai.tests.tuple-list (:use :cl))
(in-package :holai.tests.tuple-list)
(defvar *tuple-list-checks* 0)
(defun check-tuple (value) (incf *tuple-list-checks*) (unless value (error "Tuple-list check ~d failed" *tuple-list-checks*)))
(let* ((inner (holai.runtime.data:tuple 3 4)) (pair (holai.runtime.data:tuple nil inner)))
  (check-tuple (equal (holai.runtime.data:tuple-items pair) (list nil inner)))
  (check-tuple (not (vectorp (holai.runtime.data:tuple-items pair))))
  (check-tuple (null (holai.runtime.data:fst pair)))
  (check-tuple (eq inner (holai.runtime.data:snd pair)))
  (check-tuple (holai.runtime.pattern:match pair ((holai.runtime.data:tuple nil (holai.runtime.data:tuple 3 4)) t) (_ nil)))
  (check-tuple (holai.runtime.pattern:match pair ((holai.runtime.data:tuple _) nil) (_ t)))
  (check-tuple (holai.runtime.pattern:match pair ((holai.runtime.data:tuple _ _ _) nil) (_ t)))
  (check-tuple (handler-case (progn (holai.runtime.core:= pair (list nil inner)) nil) (holai.runtime.core:invalid_argument () t))))
(check-tuple (holai.runtime.core:< (holai.runtime.data:tuple 99 99) (holai.runtime.data:tuple 0 0 0)))
(check-tuple (holai.runtime.core:< (holai.runtime.data:tuple 1 8) (holai.runtime.data:tuple 2 0)))
(let ((a (holai.runtime.data:tuple 1 (holai.runtime.data:tuple 2 3)))
      (b (holai.runtime.data:tuple 1 (holai.runtime.data:tuple 2 3))))
  (check-tuple (holai.runtime.core:= a b))
  (check-tuple (= (holai.runtime.core::structural-hash a) (holai.runtime.core::structural-hash b))))
(dolist (index '(-1 2 1/2))
  (check-tuple (handler-case (progn (holai.runtime.data:tuple-ref (holai.runtime.data:tuple 1 2) index) nil)
                 (type-error () t))))
(check-tuple (holai.runtime.pattern:match (holai.runtime.data:tuple) ((holai.runtime.data:tuple) t) (_ nil)))
(format t "~&Tuple-list checks passed: ~d~%" *tuple-list-checks*)
