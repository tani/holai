(require :asdf)
(let ((root (uiop:pathname-parent-directory-pathname
             (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))))
  (asdf:initialize-source-registry
   `(:source-registry (:directory ,root) :inherit-configuration)))
(setf asdf:*asdf-verbose* nil *compile-verbose* nil *load-verbose* nil)
(asdf:load-system "holai/runtime")
(defvar *protocol-checks* 0)
(defun ensure-protocol (test) (incf *protocol-checks*) (unless test (error "Protocol check ~d" *protocol-checks*)))
(defun protocol-gc ()
  #+sbcl (sb-ext:gc :full t)
  #+ecl (si::gc t)
  #+(or abcl clisp) (ext:gc)
  #-(or sbcl ecl abcl clisp) (error "No GC test adapter for ~A" (lisp-implementation-type)))
(defun protocol-weak-pointer (value)
  #+sbcl (sb-ext:make-weak-pointer value)
  #+ecl (ext:make-weak-pointer value)
  #+clisp (ext:make-weak-pointer value)
  #+abcl (ext:make-weak-reference value)
  #-(or sbcl ecl abcl clisp)
  (error "No weak-pointer test adapter for ~A" (lisp-implementation-type)))
(defun protocol-weak-pointer-value (pointer)
  #+sbcl (sb-ext:weak-pointer-value pointer)
  #+ecl (ext:weak-pointer-value pointer)
  #+clisp (ext:weak-pointer-value pointer)
  #+abcl (ext:weak-reference-value pointer)
  #-(or sbcl ecl abcl clisp)
  (error "No weak-pointer test adapter for ~A" (lisp-implementation-type)))
(defun protocol-cache-weakness (table)
  #+sbcl (sb-ext:hash-table-weakness table)
  #+ecl (ext:hash-table-weakness table)
  #+clisp (ext:hash-table-weak-p table)
  #+abcl (sys:hash-table-weakness table)
  #-(or sbcl ecl abcl clisp)
  (error "No weak-table test adapter for ~A" (lisp-implementation-type)))
(holai.runtime:defunc foo (a b c) (+ (* 100 a) (* 10 b) c))
(ensure-protocol (= 123 (foo 1 2 3)))
(ensure-protocol (= 123 (funcall (funcall (foo 1) 2) 3)))
(ensure-protocol (= 123 (funcall (foo 1 2) 3)))
(ensure-protocol (= 123 (funcall (foo 1) 2 3)))
(ensure-protocol (= 123 (funcall (funcall (funcall (foo) 1) 2) 3)))
(holai.runtime:defunc returned-adder (x)
  (holai.runtime:lambdac (y) (+ x y)))
(ensure-protocol (= 30 (returned-adder 10 20)))
(ensure-protocol (= 30 (funcall (returned-adder 10) 20)))
(holai.runtime:defunc three-stages (x)
  (holai.runtime:lambdac (y) (holai.runtime:lambdac (z) (+ x y z))))
(ensure-protocol (= 6 (three-stages 1 2 3)))
(ensure-protocol (= 6 (funcall (three-stages 1 2) 3)))
(let ((f (holai.runtime:lambdac (a b c) (+ a b c))))
  (ensure-protocol (= 6 (funcall (funcall (funcall f 1) 2) 3)))
  (ensure-protocol (= 6 (funcall f 1 2 3))))
(holai.runtime:labelsc ((even-p (x) (if (zerop x) t (odd-p (1- x))))
                       (odd-p (x) (if (zerop x) nil (even-p (1- x)))))
  (ensure-protocol (even-p 10))
  (ensure-protocol (odd-p 9))
  (ensure-protocol (funcall (even-p) 10)))
(flet ((same (x) (+ 100 x)))
  (holai.runtime:fletc ((same (x y) (+ (same x) y)))
    (ensure-protocol (= 105 (same 2 3)))
    (ensure-protocol (= 105 (funcall (same 2) 3)))))
(let ((f (holai.runtime:fletc ((capture (x y) (+ x y))) #'capture)))
  (ensure-protocol (= 5 (funcall (funcall f 2) 3))))
(defparameter *old-foo* (symbol-function 'foo))
(holai.runtime:defunc foo (a b c) (* a b c))
(ensure-protocol (= 123 (funcall (funcall *old-foo* 1) 2 3)))
(ensure-protocol (= 6 (foo 1 2 3)))
(let* ((fn #'+) (a (holai.runtime:function-value fn 2))
       (b (holai.runtime:function-value fn 2)))
  (ensure-protocol (eq a b))
  (ensure-protocol (= 7 (funcall (funcall a 3) 4)))
  (protocol-gc)
  (ensure-protocol (eq a (holai.runtime:function-value fn 2))))
(ensure-protocol
  (eq :key-and-value
      (protocol-cache-weakness
        (gethash 2 holai.runtime::*native-function-adapters*))))
(ensure-protocol (multiple-value-bind (symbol present) (find-symbol "*FUNCTION-ARITIES*" :holai.runtime)
                    (or (not present) (not (boundp symbol)))))
(ensure-protocol (handler-case (progn (foo 1 2 3 4) nil) (type-error () t)))
(defvar *body-count* 0)
(holai.runtime:defunc once-only (x)
  (incf *body-count*)
  (holai.runtime:lambdac (y) (+ x y)))
(ensure-protocol (and (= 30 (once-only 10 20)) (= 1 *body-count*)))
(defun dead-native-adapter ()
  (let* ((cell (vector 0))
         (fn (lambda (x) (incf (aref cell 0) x)))
         (adapter (holai.runtime:function-value fn 1)))
    (vector (protocol-weak-pointer adapter)
            (protocol-weak-pointer fn)
            (protocol-weak-pointer cell))))
;; Separate top-level forms let the creation frame/registers cease retaining
;; the otherwise dead adapter before testing collection.
(defparameter *dead-native-pointer* (dead-native-adapter))
(protocol-gc)
(protocol-gc)
(ensure-protocol (every (lambda (pointer)
                          (null (protocol-weak-pointer-value pointer)))
                        *dead-native-pointer*))
(let ((p (foo 1)))
  (protocol-gc)
  (ensure-protocol (= 6 (funcall p 2 3))))
(format t "Protocol checks passed: ~d~%" *protocol-checks*)
