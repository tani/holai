(uiop:define-package :holai.tests.user-dsl
  (:use :cl)
  (:import-from :holai.user :term :read-term :hol-type :prove :defthm :defhol
                          :definductive :defrecursive :defdatatype :theorem :dsl-error)
  (:export :run-tests :run-definition-tests))
(in-package :holai.tests.user-dsl)

(defun run-definition-tests ()
  (let ((*checks* 0)
        (axioms (copy-list (holai.fusion:axioms holai.runtime.data:unit))))
    (defdatatype u_tree (u_leaf a) (u_node u_tree u_tree))
    (check (= 1 (holai.fusion:get_type_arity "u_tree")) "Inferred datatype parameter")
    (dolist (name '(u_tree u_tree.induction u_tree.recursion u_tree.cases
                   u_tree.distinct u_tree.injective))
      (check (null (holai.fusion:hyp (theorem name))) "Closed datatype principle"))
    (check-proof (prove (not (= (u_leaf (x :type num)) (u_node l r)))
                   (rewrite u_tree.distinct)) "~(u_leaf (x:num) = u_node l r)")
    (check-proof (prove (iff (= (u_leaf (x :type num)) (u_leaf y)) (= x y))
                   (rewrite u_tree.injective)) "(u_leaf (x:num) = u_leaf y) <=> (x = y)")
    (defrecursive u-size
      (:recursion u_tree.recursion)
      (= (u_size (u_leaf x)) 1)
      (forall (l r) (= (u_size (u_node l r)) (+ (u_size l) (u_size r)))))
    (check-proof (prove (= (u_size (u_node (u_leaf 0) (u_leaf 1))) 2)
                   (rewrite u-size.equations) arith)
                 "u_size (u_node (u_leaf 0) (u_leaf 1)) = 2")
    (check-proof (prove (forall ((t0 :type (u_tree num))) (<= 1 (u_size t0)))
                   (induct u_tree.induction) (asm-rewrite u-size) asm-arith)
                 "!t0:(num)u_tree. 1 <= u_size t0")
    (defrecursive u-size-auto
      (= (u_size_auto (u_leaf x)) 1)
      (forall (l r) (= (u_size_auto (u_node l r)) (+ (u_size_auto l) (u_size_auto r)))))
    (check-proof (prove (= (u_size_auto (u_leaf 0)) 1) (rewrite u-size-auto))
                 "u_size_auto (u_leaf 0) = 1")
    (defrecursive u-copy
      (= (u_copy 0) 0)
      (forall (n) (= (u_copy ("SUC" n)) ("SUC" (u_copy n)))))
    (check-proof (prove (forall ((n :type num)) (= (u_copy n) n))
                   induct (asm-rewrite u-copy)) "!n:num. u_copy n = n")
    (definductive u-even
      (u_even 0)
      (forall (n) (implies (u_even n) (u_even (+ n 2)))))
    (dolist (name '(u-even u-even.rules u-even.induction u-even.cases))
      (check (null (holai.fusion:hyp (theorem name))) "Closed inductive principle"))
    (check-proof (prove (u_even (+ 0 2)) (meson u-even.rules)) "u_even (0 + 2)")
    (check-proof (prove (forall ((n :type num)) (implies (u_even n) (<= 0 n)))
                   (induct u-even.induction) arith) "!n:num. u_even n ==> 0 <= n")
    (check-proof
      (prove (forall ((n :type num))
               (implies (u_even n) (or (= n 0) (exists (m) (= n (+ m 2))))))
        (meson u-even.cases)) "!n:num. u_even n ==> n = 0 \\/ (?m. n = m + 2)")
    (definductive u-mutual
      (u_left true)
      (forall ((x :type bool)) (implies (u_left x) (u_right x)))
      (forall ((x :type bool)) (implies (u_right x) (u_left x))))
    (check-proof (prove (u_right true) (meson u-mutual.rules)) "u_right T")
    (defdatatype u_flag u_off u_on)
    (check (= 0 (holai.fusion:get_type_arity "u_flag")) "Ground enum")
    (check-proof (prove (not (= u_off u_on)) (rewrite u_flag.distinct)) "~(u_off = u_on)")
    (defdatatype u_box (u_box_value num))
    (check (null (holai.fusion:hyp (theorem 'u_box.injective))) "Single constructor injectivity")
    (defdatatype u_rose (u_rose_node a (list u_rose)))
    (check (= 1 (holai.fusion:get_type_arity "u_rose")) "Nested recursive datatype")
    (check (null (holai.fusion:hyp (theorem 'u_rose.recursion))) "Nested recursion principle")
    (defdatatype u_fun (u_fun_value (-> num a)))
    (check (holai.runtime.core:= (holai.fusion:get_const_type "u_fun_value")
                                (hol-type '(-> (-> num a) (u_fun a))))
           "Function-valued datatype field")
    (rejects (theorem 'u_box.distinct))
    (rejects (theorem 'u_flag.injective))
    (rejects (defdatatype u_duplicate (u_same num) (u_same bool)))
    (rejects (defdatatype u_no_constructors))
    (rejects (defdatatype "u_bad; bogus" u_bad_constructor))
    (rejects (defdatatype u_bad_field (u_bad_value (-> num))))
    (rejects (defrecursive u-invalid true))
    (let ((saved (theorem 'u-size)))
      (rejects (defrecursive u-size true))
      (check (eq saved (theorem 'u-size)) "Failed definition preserves registered theorem"))
    (rejects (defrecursive u-no-equations))
    (rejects (defrecursive u-bad-reference (:recursion no-such-theorem) (= (u_bad 0) 0)))
    (rejects (definductive u-empty))
    (rejects (definductive u-negative
               (forall ((x :type bool)) (implies (not (u_negative x)) (u_negative x)))))
    (check (handler-case (progn (holai.fusion:get_const_type "u_negative") nil)
             (holai.runtime.core:failure () t)) "Nonmonotone relation not introduced")
    (check (holai.runtime.core:= axioms (holai.fusion:axioms holai.runtime.data:unit))
           "Definitions introduce no axioms")
    (format t "~&User definition DSL checks passed: ~d~%" *checks*)
    t))
