(in-package :holai.tests.user-dsl)
(declaim (ftype function check-compiled-development))

(cl:defun run-definition-tests ()
  (let ((*checks* 0) (axioms (copy-list (holai.fusion:axioms holai.runtime.data:unit))))
    (deftype predicate (?a) (-> ?a bool))
    (check (holai.runtime.core:= (hol-type '(predicate num)) (hol-type '(-> num bool))) "Type alias")
    (defun identity-function (x) "Identity." (declare (type ?a x)) x)
    (check-proof (prove (x) (declare (type num x)) (= (identity-function x) x) (simp identity-function))
                 '(forall (x) (declare (type num x)) (= (identity-function x) x)))
    (check-proof (prove (x) (declare (type bool x)) (= (identity-function x) x) (rewrite identity-function.definition))
                 '(forall (x) (declare (type bool x)) (= (identity-function x) x)))
    (defconstant empty-numbers (the (list num) (list)) "Empty list.")
    (check-proof (prove () (= empty-numbers (list)) (simp empty-numbers)) '(= empty-numbers (list)))
    (defun twice-function (x) (declare (type num x)) (twice x))
    (let ((saved (theorem 'twice-function.definition)))
      (defun twice-function (x) (declare (type num x)) (twice x))
      (check (eq saved (theorem 'twice-function.definition)) "Macro gensym reload is canonical"))
    (defdatatype tree (?a)
      (leaf (value ?a))
      (node (left (tree ?a)) (right (tree ?a))))
    (dolist (suffix '(".induction" ".recursion" ".cases" ".injective" ".distinct"))
      (check (null (holai.fusion:hyp (theorem (holai.user::result-name 'tree suffix)))) "Closed datatype principles"))
    (check-proof (prove (x l r)
                   (declare (type num x) (type (tree num) l r))
                   (not (= (leaf x) (node l r))) (rewrite tree.distinct))
                 '(forall (x l r) (declare (type num x) (type (tree num) l r))
                   (not (= (leaf x) (node l r)))))
    (defun tree-size (tree)
      (declare (type (tree ?a) tree) (values num))
      (match tree ((leaf value) 1)
                  ((node left right) (+ (tree-size left) (tree-size right)))))
    (check-proof (prove () (= (tree-size (node (leaf 0) (leaf 1))) 2) (simp tree-size) (arith))
                 '(= (tree-size (node (leaf 0) (leaf 1))) 2))
    (check-proof (prove (tree) (declare (type (tree ?a) tree)) (>= (tree-size tree) 1)
                   (induct tree) (simp tree-size) (asm-arith))
                 '(forall (tree) (declare (type (tree ?a) tree)) (>= (tree-size tree) 1)))
    (defun tree-tag (tree)
      (declare (type (tree ?a) tree) (values num))
      (match tree ((leaf _) 0) ((node _ _) 1)))
    (check-proof (prove () (= (tree-tag (node (leaf 0) (leaf 1))) 1) (simp tree-tag))
                 '(= (tree-tag (node (leaf 0) (leaf 1))) 1))
    (check-proof (prove () (= (match (node (leaf 0) (leaf 1)) ((leaf _) 0) ((node _ _) 1)) 1) (simp))
                 '(= (match (node (leaf 0) (leaf 1)) ((leaf _) 0) ((node _ _) 1)) 1))
    (defequations tree-size-equations (tree)
      (declare (type (tree ?a) tree) (recursion tree.recursion))
      (leaf-case (x) (= (tree-size-equations (leaf x)) 1))
      (node-case (l r) (= (tree-size-equations (node l r))
                          (+ (tree-size-equations l) (tree-size-equations r)))))
    (check-proof (prove () (= (tree-size-equations (leaf 0)) 1) (simp tree-size-equations))
                 '(= (tree-size-equations (leaf 0)) 1))
    (defdatatype flag () (off) (on))
    (defequations flag-number (flag)
      (declare (type flag flag) (values num))
      (off-value () (= (flag-number (off)) 0))
      (on-value () (= (flag-number (on)) 1)))
    (check-proof (prove () (= (flag-number on) 1) (simp flag-number)) '(= (flag-number on) 1))
    (check-proof (prove () (not (= off on)) (rewrite flag.distinct)) '(not (= off on)))
    (check-term (term (match (on) ((off) 0) ((on) 1)))
                '(match on ((off) 0) ((on) 1)))
    (defdatatype rose (?a) (rose-node (value ?a) (children (list (rose ?a)))))
    (check (= 1 (holai.fusion:get_type_arity (first (gethash 'rose holai.user::*types*)))) "Nested recursive type")
    (defdatatype function-box (?a) (function-value (call (-> num ?a))))
    (check (holai.runtime.core:= (holai.fusion:type_of (read-term '(function-value (lambda (x) (declare (type num x)) x))))
                                (hol-type '(function-box num))) "Function-valued field")
    (defdatatype ordered-params (?b ?a)
      (ordered-value (a ?a) (b ?b)))
    (check (holai.runtime.core:= (holai.fusion:type_of (read-term '(ordered-value (the num 0) true)))
                                (hol-type '(ordered-params bool num))) "Declared parameter order")
    (defdatatypes mutually-linked (?a)
      (mtree (mtree-node (value ?a) (children (mforest ?a))))
      (mforest (empty-forest) (forest-cons (head (mtree ?a)) (tail (mforest ?a)))))
    (check (null (holai.fusion:hyp (theorem 'mutually-linked.recursion))) "Mutual datatype recursion")
    (defstruct point (?a) (x ?a) (y ?a))
    (check-proof (prove (x y) (declare (type num x y)) (= (point-x (make-point x y)) x) (simp point-x))
                 '(forall (x y) (declare (type num x y)) (= (point-x (make-point x y)) x)))
    (definductive even (n)
      (declare (type num n))
      (zero () (even 0))
      (step (k) (implies (even k) (even (+ k 2)))))
    (check-proof (prove () (even (+ 0 2)) (meson even.rules)) '(even (+ 0 2)))
    (check-proof (theorem 'even.rules.step)
                 '(forall (k) (declare (type num k)) (implies (even k) (even (+ k 2)))))
    (defrelations parity ()
      (parity-even (n) (declare (type num n))
        (zero () (parity-even 0))
        (even-step (k) (implies (parity-odd k) (parity-even (succ k)))))
      (parity-odd (n) (declare (type num n))
        (odd-step (k) (implies (parity-even k) (parity-odd (succ k))))))
    (check-proof (prove () (parity-odd (succ 0)) (meson parity.rules)) '(parity-odd (succ 0)))
    ;; Identical declarations preserve the actual existing kernel result.
    (let ((old (theorem 'identity-function.definition)))
      (defun identity-function (x) "New documentation." (declare (type ?a x)) x)
      (check (eq old (theorem 'identity-function.definition)) "Reload reuses definition")
      (rejects (defun identity-function (x) (declare (type ?a x)) true))
      (check (eq old (theorem 'identity-function.definition)) "Conflict preserves original definition"))
    (rejects (defun bad-free (x) (+ x unknown-value)))
    (rejects (defun bad-options (x) (declare (unknown-option t)) x))
    (rejects (defdatatype empty-type ()))
    (rejects (defdatatype malformed-constructor () bare-constructor))
    (rejects (deftype undeclared-alias (?a) (list ?b)))
    (rejects (defdatatype phantom (?a) (phantom-value)))
    (rejects (defdatatype undeclared () (undeclared-value (value ?a))))
    (rejects (defdatatype duplicate () (same-value) (same-value)))
    (rejects (defdatatype bad-field () (bad-value (x :type num))))
    (rejects (defdatatype negative () (negative-value (function (-> negative num)))))
    (rejects (defdatatype no-base () (cycle (next no-base))))
    (rejects (defun partial (flag) (declare (type flag flag)) (match flag ((off) 0))))
    (rejects (term (match off ((off) 0))))
    (rejects (definductive empty-relation (n)))
    (rejects (definductive nonmonotone (n) (declare (type num n))
               (bad (k) (implies (not (nonmonotone k)) (nonmonotone k)))))
    (check (not (gethash 'nonmonotone holai.user::*constants*)) "Rejected relation not published")
    (check (not holai.user::*kernel-uncertain*) "Preflight rejections leave the kernel usable")
    (check-compiled-development)
    (check (holai.runtime.core:= axioms (holai.fusion:axioms holai.runtime.data:unit)) "Definitions add no axioms")
    (format t "~&User definition DSL checks passed: ~d~%" *checks*) t))

(cl:defun check-compiled-development ()
  (uiop:call-with-temporary-file
    (lambda (stream source)
      (let* ((name (symbol-name (gensym "HOLAI.TESTS.COMPILED.")))
             (fasl (compile-file-pathname source)))
        (unwind-protect
             (progn
               (format stream "(defpackage ~s (:use :cl :holai.user) (:shadowing-import-from :holai.user :defun :defconstant :deftype :defstruct))~%(in-package ~s)~%(defun compiled-identity (x) (declare (type num x)) x)~%(defthm compiled-identity-proof (x) (declare (type num x)) (= (compiled-identity x) x) (simp compiled-identity))~%" name name)
               (finish-output stream)
               (let ((before-constants (holai.fusion:constants holai.runtime.data:unit))
                     (before-types (holai.fusion:types holai.runtime.data:unit)))
                 (multiple-value-bind (output warnings failure) (compile-file source :output-file fasl)
                   (check (not (or warnings failure)) "Development compilation has no diagnostics")
                   (check (holai.runtime.core:= before-constants (holai.fusion:constants holai.runtime.data:unit))
                          "Compilation introduces no kernel constants")
                   (check (holai.runtime.core:= before-types (holai.fusion:types holai.runtime.data:unit))
                          "Compilation introduces no kernel types")
                   (load output)
                   (let* ((package (find-package name))
                          (proof (theorem (find-symbol "COMPILED-IDENTITY-PROOF" package)))
                          (constants (holai.fusion:constants holai.runtime.data:unit)))
                     (check (null (holai.fusion:hyp proof)) "Compiled proof is closed")
                     (load output)
                     (check (holai.runtime.core:= constants (holai.fusion:constants holai.runtime.data:unit))
                            "FASL reload reuses constants")))))
          (when (probe-file fasl) (delete-file fasl)))))
    :prefix "holai-user-" :type "lisp"))
