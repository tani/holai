(require :asdf)
(asdf:initialize-source-registry `(:source-registry (:directory ,(truename ".")) :inherit-configuration))
(setf asdf:*asdf-verbose* nil *compile-verbose* nil *load-verbose* nil)
(asdf:load-system "holai/runtime")
(holai.runtime:defunc inspect-add (a b c) (+ a b c))
(defun inspect-call () (inspect-add 1 2 3))
(format t "~&DEFUNC EXPANSION~%")
(pprint (macroexpand-1 '(holai.runtime:defunc inspect-add (a b c) (+ a b c))))
(format t "~&FLETC EXPANSION~%")
(pprint (macroexpand-1 '(holai.runtime:fletc ((foo (a b c) (+ a b c))) (foo 1 2 3))))
(format t "~&DEFUNC ENTRY~%")
(disassemble #'inspect-add)
(format t "~&NAMED CALL~%")
(disassemble #'inspect-call)
(format t "~&LAMBDAC ENTRY~%")
(disassemble (holai.runtime:lambdac (a b c) (+ a b c)))
(format t "~&LABELSC ENTRY~%")
(disassemble (holai.runtime:labelsc ((foo (a b c) (+ a b c))) #'foo))
(format t "~&FLETC ENTRY~%")
(disassemble (holai.runtime:fletc ((foo (a b c) (+ a b c))) #'foo))
