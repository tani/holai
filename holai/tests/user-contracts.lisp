;; Run in a separate process: this fixture intentionally extends the logic and
;; finally tests the irreversible kernel-uncertain state.
(uiop:define-package :holai.tests.user-contracts
  (:use :cl :holai.user)
  (:shadowing-import-from :holai.user :defun :defconstant :deftype :defstruct)
  (:export :run-contract-tests))
(in-package :holai.tests.user-contracts)
(cl:defun run-contract-tests ()
  (let ((checks 0) (before (length (holai.fusion:axioms holai.runtime.data:unit)))
        (*package* (find-package :holai.tests.user-contracts)))
    (flet ((verify (test) (incf checks) (unless test (error "User contract check failed"))))
      (with-axiomatic-extensions ()
        (declare-type 'explicit-type 0)
        (declare-constant 'explicit-constant 'explicit-type)
        (defaxiom explicit-axiom true)
        (defaxiom explicit-axiom true))
      (verify (= (1+ before) (length (holai.fusion:axioms holai.runtime.data:unit))))
      (verify (= 3 (length holai.user::*axiom-log*)))
      (verify (null (holai.fusion:hyp (theorem 'explicit-axiom))))
      (verify (not holai.user::*kernel-uncertain*))
      (deftactic delayed-mutation (name)
        (declare (argument-kinds :syntax))
        (lambda (goal)
          (let ((parts (holai.runtime.data:tuple-items (holai.tactics:REFL_TAC goal))))
            (holai.runtime.data:tuple (first parts) (second parts)
              (holai.runtime.core:lambdac (inst thms)
                (holai.fusion:new_constant
                  (holai.runtime.data:tuple (holai.user::encoded-name name) (hol-type 'bool)))
                (funcall (third parts) inst thms))))))
      (verify (handler-case
                (progn (defspec (delayed-witness) ()
                         (exists (x) (declare (type num x)) (= x 1))
                         (witness 1) (delayed-mutation definition-smuggled)) nil)
                (kernel-state-uncertain () t)))
      (verify (not (gethash 'delayed-witness holai.user::*constants*)))
      (goal '(= 1 1))
      (verify (handler-case
                (progn (proof-step '(delayed-mutation interactive-smuggled)) nil)
                (kernel-state-uncertain () t)))
      (verify (= 1 (length (goals))))
      (abort-proof)
      (deftactic forbidden-mutation ()
        (lambda (goal)
          (holai.fusion:new_constant
            (holai.runtime.data:tuple (holai.user::encoded-name 'smuggled-constant) (hol-type 'bool)))
          (holai.tactics:ALL_TAC goal)))
      (verify (handler-case (progn (prove () true (forbidden-mutation)) nil)
                (kernel-state-uncertain () t)))
      (verify holai.user::*kernel-uncertain*)
      (verify (handler-case (progn (defun after-uncertainty (x) x) nil)
                (kernel-state-uncertain () t)))
      (verify (not (gethash 'after-uncertainty holai.user::*constants*)))
      (format t "User isolated contract checks passed: ~d~%" checks))))
