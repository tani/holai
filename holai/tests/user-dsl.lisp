(uiop:define-package :holai.tests.user-dsl
  (:use :cl :holai.user)
  (:shadow :check)
  (:shadowing-import-from :holai.user :defun :defconstant :deftype :defstruct)
  (:export :run-tests :run-definition-tests))
(in-package :holai.tests.user-dsl)

(defvar *checks* 0)
(declaim (ftype function run-namespace-tests))
(cl:defun check (test message)
  (incf *checks*) (unless test (error "User DSL check failed: ~a" message)))
(cl:defun check-term (actual expected)
  (check (holai.fusion:aconv actual (read-term expected)) expected))
(cl:defun check-proof (actual expected)
  (check (null (holai.fusion:hyp actual)) "No open hypotheses")
  (check-term (holai.fusion:concl actual) expected))
(defmacro rejects (&body forms)
  `(check (handler-case (progn ,@forms nil) (dsl-error () t)) ',forms))
(defmacro logical-when (condition result)
  `(implies ,condition ,result))

(defmacro twice (value)
  (let ((variable (gensym "TWICE")))
    `(let ((,variable ,value)) (+ ,variable ,variable))))

(cl:defun run-tests ()
  (setf *checks* 0)
  (let ((axioms (copy-list (holai.fusion:axioms holai.runtime.data:unit)))
        (stack (holai.runtime.data:deref holai.tactics:current_goalstack)))
    (check (eq (find-package :holai.user) (find-package :holai-user)) "Nickname")
    (check (not (eq 'defun 'cl:defun)) "Logical DEFUN has its own symbol")
    (check (not (eq 'deftype 'cl:deftype)) "Logical DEFTYPE has its own symbol")
    (check (holai.runtime.core:= (hol-type '(-> ?a ?b bool))
                                (holai.fusion:mk_fun_ty (hol-type '?a)
                                  (holai.fusion:mk_fun_ty (hol-type '?b) (hol-type 'bool)))) "Right-associative arrow")
    (check-term (read-term '(+ x y) :expected-type 'num)
                '(+ (the num x) (the num y)))
    (check-term (term (lambda (x) (declare (type bool x)) x))
                '(lambda (x) (declare (type bool x)) x))
    (check-term (term (the bool nil)) 'false)
    (check-term (read-term nil :expected-type '(list num)) '(the (list num) (list)))
    (check-term (term (= nil (list 1))) '(= (list) (list 1)))
    (check-term (term (let ((x true)) (and x true))) '((lambda (x) (and x true)) true))
    (check-term (term (and)) 'true)
    (check-term (term (or)) 'false)
    (check-term (term (and true)) 'true)
    (check-term (term (cond (p true) (t false))) '(if p true false))
    (check (holai.runtime.core:= (holai.fusion:type_of (term (the real 1/2))) (hol-type 'real)) "Exact ratio")
    (check-proof (prove (p) (declare (type bool p)) (implies p p) (assume h) (exact h))
                 '(forall (p) (declare (type bool p)) (implies p p)))
    (check-proof (prove (x) (declare (type ?a x)) (= x x) (refl))
                 '(forall (x) (declare (type ?a x)) (= x x)))
    (check-proof (prove () (forall (x) (declare (type num x)) (= x x)) (fix z) (refl))
                 '(forall (x) (declare (type num x)) (= x x)))
    (check-proof (prove (p q) (declare (type bool p q)) (implies (and p q) (and q p)) (meson))
                 '(forall (p q) (declare (type bool p q)) (implies (and p q) (and q p))))
    (check-proof (prove () (and true true) (thenl (split) (simp) (simp))) '(and true true))
    (check-proof (prove (p) (declare (type bool p)) (implies p p)
                   (proof (assume h p) (have local-p p (exact h)) (show p (exact local-p))))
                 '(forall (p) (declare (type bool p)) (implies p p)))
    (check-proof (prove () (forall (x) (declare (type num x)) (exists (y) (= y x)))
                   (fix z) (witness z) (refl))
                 '(forall (x) (declare (type num x)) (exists (y) (= y x))))
    (check-proof (prove (p) (declare (type bool p)) (implies p p)
                   (orelse (fail) (intro)) (assumption))
                 '(forall (p) (declare (type bool p)) (implies p p)))
    (check-proof (prove () true (repeat (skip) :max-steps 2) (simp)) 'true)
    (check-proof (prove (p) (declare (type bool p)) (logical-when p p) (taut))
                 '(forall (p) (declare (type bool p)) (implies p p)))
    (macrolet ((local-implies (p) `(implies ,p ,p)))
      (check-proof (prove (p) (declare (type bool p)) (local-implies p) (taut))
                   '(forall (p) (declare (type bool p)) (implies p p))))
    (defthm named-identity (p) (declare (type bool p)) (implies p p) (taut))
    (check-proof (theorem 'named-identity) '(forall (p) (declare (type bool p)) (implies p p)))
    (let ((old (theorem 'named-identity)))
      (rejects (defthm named-identity () false (refl)))
      (check (eq old (theorem 'named-identity)) "Failed proof preserves old theorem"))
    (check-proof (prove (q) (declare (type bool q)) (implies q q) (exact named-identity))
                 '(forall (q) (declare (type bool q)) (implies q q)))
    (rejects (prove (x) (declare (type ?a x) (type-variables)) true (simp)))
    (rejects (prove (x) (declare (type ?a x)) (= x true) (refl)))
    (rejects (hol-type 'a))
    (rejects (hol-type '(list bool bool)))
    (rejects (hol-type '(-> ?a)))
    (rejects (read-term '(x x)))
    (rejects (read-term nil))
    (rejects (term 0.5))
    (rejects (prove () unknown-proposition (taut)))
    (rejects (prove (p) (declare (type num p)) p (taut)))
    (rejects (prove () false (exact holai.bool:TRUTH)))
    (rejects (prove () true (skip)))
    (rejects (prove (p) (declare (type bool p)) p (assume h)))
    (rejects (prove (p) (declare (type bool p)) p (have bogus p (exact bogus)) (exact bogus)))
    (rejects (prove () true (eval (print :executed))))
    (rejects (prove () true (orelse (exact missing-theorem) (refl))))
    (rejects (prove () (and true true) (thenl (split) (refl))))
    (rejects (prove (x x) (= x x) (refl)))
    (rejects (prove (&rest xs) true (refl)))
    (rejects (prove (x) (declare (type bool y)) (= x x) (refl)))
    (rejects (prove () true (show false (refl))))
    (rejects (prove () true (assume h)))
    (rejects (term (forall () true)))
    (rejects (term (forall (x x) x)))
    (rejects (term (if true 1)))
    (rejects (term (cond (p true))))
    (rejects (prove (x) (declare (type ?a x) (type-variables)) (= x x) (refl)))
    (check-proof (prove (x) (declare (type ?a x) (type-variables ?a)) (= x x) (refl))
                 '(forall (x) (declare (type ?a x)) (= x x)))
    (run-namespace-tests)
    (check (holai.runtime.core:= axioms (holai.fusion:axioms holai.runtime.data:unit)) "No new axioms")
    (check (eq stack (holai.runtime.data:deref holai.tactics:current_goalstack)) "Batch goal stack unchanged"))
  (format t "~&User DSL checks passed: ~d~%" *checks*) t)

(defpackage :holai.tests.user-left
  (:use :cl :holai.user)
  (:shadowing-import-from :holai.user :defun :defconstant :deftype :defstruct)
  (:export :tag :same-proof :token :mark :?a))
(defpackage :holai.tests.user-right
  (:use :cl :holai.user)
  (:shadowing-import-from :holai.user :defun :defconstant :deftype :defstruct)
  (:export :tag :same-proof :token :mark :?a))
(cl:defun run-namespace-tests ()
  (let ((*package* (find-package :holai.tests.user-left)))
    (eval '(defun holai.tests.user-left:tag (x) (declare (type num x)) (+ x 1)))
    (eval '(defthm holai.tests.user-left:same-proof (x) (declare (type num x)) (= x x) (refl)))
    (eval '(defdatatype holai.tests.user-left:token () (holai.tests.user-left:mark))))
  (let ((*package* (find-package :holai.tests.user-right)))
    (eval '(defun holai.tests.user-right:tag (x) (declare (type num x)) (+ x 2)))
    (eval '(defthm holai.tests.user-right:same-proof (x) (declare (type bool x)) (= x x) (refl)))
    (eval '(defdatatype holai.tests.user-right:token () (holai.tests.user-right:mark))))
  (check (not (holai.runtime.core:= (hol-type 'holai.tests.user-left:?a)
                                    (hol-type 'holai.tests.user-right:?a)))
         "Type variable symbols retain their package")
  (check (not (eq (theorem 'holai.tests.user-left:same-proof)
                  (theorem 'holai.tests.user-right:same-proof))) "Theorem symbols retain their package")
  (check (not (holai.runtime.core:= (hol-type 'holai.tests.user-left:token)
                                    (hol-type 'holai.tests.user-right:token))) "Datatype packages are independent")
  (check-proof (prove () (= (holai.tests.user-left:tag 0) 1)
                 (simp holai.tests.user-left:tag) (arith))
               '(= (holai.tests.user-left:tag 0) 1))
  (check-proof (prove () (= (holai.tests.user-right:tag 0) 2)
                 (simp holai.tests.user-right:tag) (arith))
               '(= (holai.tests.user-right:tag 0) 2))
  (check (not (holai.fusion:aconv (read-term 'holai.tests.user-left:mark)
                                  (read-term 'holai.tests.user-right:mark))) "Constructors retain their package"))
