(uiop:define-package :holai.tests.user-dsl
  (:use :cl)
  (:import-from :holai.user :term :read-term :hol-type :prove :defthm :defhol
                          :theorem :dsl-error)
  (:export :run-tests))
(in-package :holai.tests.user-dsl)

(defvar *checks* 0)

(defun check (test message)
  (incf *checks*)
  (unless test (error "User DSL check failed: ~a" message)))

(defun check-term (term expected)
  (check (holai.fusion:aconv term (holai.parser:parse_term expected)) expected))

(defun check-proof (theorem expected)
  (check (null (holai.fusion:hyp theorem)) "No open hypotheses")
  (check-term (holai.fusion:concl theorem) expected))

(defmacro rejects (&body forms)
  `(check (handler-case (progn ,@forms nil) (dsl-error () t))
          ',forms))

(defun run-tests ()
  (setf *checks* 0)
  (let ((axioms (copy-list (holai.fusion:axioms holai.runtime.data:unit)))
        (stack (holai.runtime.data:deref holai.tactics:current_goalstack)))
    (check (eq (find-package :holai.user) (find-package :holai-user)) "Nickname")
    (check (holai.runtime.core:= (hol-type '(-> a b c))
                                (holai.parser:parse_type "a->b->c")) "Arrow associativity")
    (check (holai.runtime.core:= (hol-type '(list num))
                                (holai.parser:parse_type "num list")) "Type application")
    (check-term (term (lambda ((x :type bool)) x)) "\\x:bool. x")
    (check-term (term (forall ((x :type num)) (= (+ x 1) (+ 1 x))))
                "!x:num. x + 1 = 1 + x")
    (check-term (term ((lambda (x) x) true)) "(\\x:bool. x) T")
    (check-term (term (if p true false)) "if p then T else F")
    (check-term (term (exists1 ((x :type bool)) x)) "?!x:bool. x")
    (check-term (term (the bool p)) "p:bool")
    (check-term (term (p :type bool)) "p:bool")
    (check-term (term nil) "F")
    (check-term (term t) "T")
    (check-term (term 17) "17")
    (check-term (read-term 'p :expected-type 'bool) "p:bool")
    (check-term (read-term "p" :expected-type 'bool) "p:bool")
    ;; Result constraints flow backwards to overload resolution and arguments.
    (check-term (read-term '(+ x y) :expected-type 'num) "(x:num) + y")
    (check-term (read-term '(+ x y) :expected-type 'real) "(x:real) + y")
    (check-term (term (lambda (x) (and x true))) "\\x:bool. x /\\ T")
    (let* ((tm (term (lambda (x) x)))
           (ty (holai.fusion:type_of tm))
           (parts (holai.fusion:dest_type ty)))
      (check (string= (holai.runtime.data:fst parts) "fun") "Inferred function type")
      (check (holai.runtime.core:= (first (holai.runtime.data:snd parts))
                                  (second (holai.runtime.data:snd parts)))
             "Residual type is shared polymorphically"))
    (let ((x (holai.parser:parse_term "x:bool")))
      (check-term (read-term 'x :variables (list x)) "x:bool"))
    ;; Shadowing stays lexical and each constant use has a fresh type instance.
    (check-term (term (lambda ((x :type num))
                        (and (= x x) (forall ((x :type bool)) (= x x)))))
                "\\x:num. (x = x) /\\ (!x:bool. x = x)")
    (check-proof (prove (implies p p) (assume h) (exact h)) "p ==> p")
    (check-proof (prove "p ==> p" intro assumption) "p ==> p")
    (let* ((th (prove (forall (x) (= x x)) intro refl))
           (variables (holai.fusion:type_vars_in_term (holai.fusion:concl th))))
      (check (= (length variables) 1) "Polymorphic theorem has one type variable")
      (check-proof (holai.fusion:INST_TYPE
                     (list (holai.runtime.data:tuple (hol-type 'bool) (first variables))) th)
                   "!x:bool. x = x"))
    (check-proof (prove (implies (and p q) (and q p)) (meson))
                 "p /\\ q ==> q /\\ p")
    (check-proof (prove (and true (implies p p))
                   (thenl split (exact holai.bool:TRUTH) (then intro assumption)))
                 "T /\\ (p ==> p)")
    (check-proof (prove (implies p p) (orelse fail intro) (try refl) assumption)
                 "p ==> p")
    (check-proof (prove (forall ((x :type num)) (= x x)) (repeat intro) refl)
                 "!x:num. x = x")
    (check-proof (prove (forall ((x :type bool)) (exists (y) (= y x)))
                   intro (witness x) refl)
                 "!x:bool. ?y:bool. y = x")
    (check-proof (prove (forall ((x :type num)) (exists (y) (= y x)))
                   (fix z) (witness z) refl)
                 "!x:num. ?y:num. y = x")
    (check-proof (prove (forall ((p :type bool)) (or p (not p)))
                   intro (cases p) (rewrite))
                 "!p:bool. p \\/ ~p")
    (check-proof (prove (implies p p)
                   (assume h) (have lemma p (exact h)) (exact lemma))
                 "p ==> p")
    (check-proof (prove (implies p p) (assume h) (rewrite h)) "p ==> p")
    (check-proof (prove (implies p p) intro (asm-simp)) "p ==> p")
    (check-proof (prove (implies p p) intro (asm-rewrite)) "p ==> p")
    (check-proof (prove (forall ((n :type num)) (= (+ n 0) n)) (arith))
                 "!n:num. n + 0 = n")
    (defthm dsl-identity (implies p p) intro assumption)
    (defthm dsl-polymorphic (forall (x) (= x x)) intro refl)
    (check-proof (prove (forall ((x :type num)) (= x x)) (exact dsl-polymorphic))
                 "!x:num. x = x")
    (check-proof (theorem 'dsl-identity) "p ==> p")
    (check-proof (prove (implies q q) intro (apply dsl-identity) assumption) "q ==> q")
    (check-proof (prove (implies p p) (exact dsl-identity)) "p ==> p")
    (check-proof (prove (implies p p) taut) "p ==> p")
    (check-proof (prove true (simp)) "T")
    (check-proof (theorem 'holai.bool:TRUTH) "T")
    (rejects (prove false (exact holai.bool:TRUTH)))
    (rejects (prove true (skip)))
    (rejects (prove p (assume h)))
    (rejects (prove (and true true) (thenl split (exact holai.bool:TRUTH))))
    (rejects (prove p (have bogus p (exact bogus)) (exact bogus)))
    (rejects (prove true (eval (print :executed))))
    (rejects (prove true (missing-command)))
    (rejects (prove true (intro unexpected)))
    (rejects (theorem 'missing-theorem))
    (rejects (defthm dsl-identity false (exact holai.bool:TRUTH)))
    (check-proof (theorem 'dsl-identity) "p ==> p")
    (rejects (read-term '(x x))) ; occurs check
    (rejects (read-term '(and (p :type num) true)))
    (rejects (read-term '(+ (x :type bool) (y :type num))))
    (rejects (read-term 'p :expected-type 'num :variables
                         (list (holai.parser:parse_term "p:bool"))))
    (rejects (read-term '((lambda (x) (x x)) true)))
    (rejects (term (and p)))
    (rejects (term (p :type bool extra)))
    (rejects (term (p :type)))
    (rejects (term (forall (x x) x)))
    (rejects (term (forall () true)))
    (rejects (term (forall ((x :type bool extra)) x)))
    (rejects (term (forall (and) true)))
    (rejects (read-term '(f . x)))
    (rejects (term -1))
    (rejects (read-term "p:bool trailing )"))
    (rejects (hol-type '(-> a)))
    ;; Definition is deliberately last: kernel definitions are persistent.
    (unless (gethash "dsl-id-def" holai.user::*theorems*)
      (defhol dsl-id-def (= (dsl_id x) x)))
    (check-proof (prove (forall ((x :type bool)) (= (dsl_id x) x))
                   (rewrite dsl-id-def)) "!x:bool. dsl_id x = x")
    (check-proof (prove (and (= (dsl_id true) true) (= (dsl_id 0) 0))
                   (rewrite dsl-id-def)) "(dsl_id T = T) /\\ (dsl_id 0 = 0)")
    (check-term (term ("MAP" (lambda ((x :type num)) (+ x 1)) "[0; 1]"))
                "MAP (\\x:num. x + 1) [0; 1]")
    (check (holai.runtime.core:= axioms (holai.fusion:axioms holai.runtime.data:unit))
           "No new axioms")
    (check (eq stack (holai.runtime.data:deref holai.tactics:current_goalstack))
           "Batch proofs preserve interactive goal stack"))
  (format t "~&User DSL checks passed: ~d~%" *checks*)
  t)
