(require :asdf)
(uiop:define-package :holai.tests.compatibility-fixtures (:use :cl))
(in-package :holai.tests.compatibility-fixtures)
(let ((root (uiop:pathname-parent-directory-pathname
             (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))))
  (asdf:initialize-source-registry
   `(:source-registry (:directory ,root) :inherit-configuration))
  (setf asdf:*asdf-verbose* nil *compile-verbose* nil *load-verbose* nil)
  (asdf:load-system "holai/runtime")
  (let ((directory (uiop:getenv "HOLAI_COMPATIBILITY_FIXTURES")))
    (unless directory (error "HOLAI_COMPATIBILITY_FIXTURES is required"))
    (dolist (name '("semantics" "compatibility_observations" "star_names"))
      (let ((path (merge-pathnames (concatenate 'string name ".lisp")
                                   (uiop:ensure-directory-pathname directory))))
        (multiple-value-bind (fasl warnings failure) (compile-file path)
          (declare (ignore warnings))
          (when failure (error "Compatibility fixture compilation failed: ~a" path))
          (load fasl))))))
(dolist (name '("T%" "T%%" "NIL%" "PI%" "PI%%" "NAME" "NAME%" "NAME%%" "NAME%%%"))
  (unless (eq :external (nth-value 1 (find-symbol name :holai.star_names)))
    (error "Missing allocated export: ~a" name)))
(format t "~&__HOLAI_COMPATIBILITY_OBSERVATIONS__~%")
(dolist (line (append (holai.compatibility_observations:compatibility_observations holai.runtime.data:unit)
                     (holai.star_names:observations holai.runtime.data:unit)))
  (write-line line))
(format t "__HOLAI_COMPATIBILITY_END__~%")
