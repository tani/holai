(require :asdf)
(asdf:initialize-source-registry `(:source-registry (:directory ,(truename ".")) :inherit-configuration))
(setf asdf:*asdf-verbose* nil *compile-verbose* nil *load-verbose* nil)
(asdf:load-system "holai/runtime")
(defvar *optional-checks* 0)
(defun check-optional (x)
  (incf *optional-checks*) (unless x (error "Optional entry check ~d failed" *optional-checks*)))
(holai.runtime:defunc optional-triple (a b c) (list a b c))
(let ((functions
        (list #'optional-triple
              (holai.runtime:lambdac (a b c) (list a b c))
              (holai.runtime:labelsc ((triple (a b c) (list a b c))) #'triple)
              (holai.runtime:fletc ((triple (a b c) (list a b c))) #'triple))))
  (dolist (f functions)
    (dolist (values '((nil nil nil) (1 nil 3) (nil 2 nil)))
      (dotimes (prefix 4)
        (let ((result (apply f (subseq values 0 prefix))))
          (check-optional
            (equal values (if (= prefix 3) result
                              (apply result (nthcdr prefix values))))))))
    (check-optional (equal '(1 2 3) (funcall (funcall (funcall f 1) 2) 3)))
    (check-optional (handler-case (progn (funcall f 1 2 3 4) nil) (type-error () t)))))
(holai.runtime:defunc optional-zero () (values 17 18))
(let ((functions
        (list #'optional-zero
              (holai.runtime:lambdac () (values 17 18))
              (holai.runtime:labelsc ((zero () (values 17 18))) #'zero)
              (holai.runtime:fletc ((zero () (values 17 18))) #'zero))))
  (dolist (f functions)
    (check-optional (equal '(17) (multiple-value-list (funcall f))))
    (check-optional (handler-case (progn (funcall f nil) nil) (type-error () t)))))
(defvar *optional-body-count* 0)
(holai.runtime:defunc optional-excess (a b c)
  (incf *optional-body-count*)
  (holai.runtime:lambdac (d e) (list a b c d e)))
(dolist (prefix '(0 1 2 3 4 5))
  (let* ((values '(nil 2 nil 4 nil))
         (before *optional-body-count*)
         (result (apply #'optional-excess (subseq values 0 prefix))))
    (when (< prefix 3) (check-optional (= before *optional-body-count*)))
    (check-optional (equal values (if (= prefix 5) result
                                    (apply result (nthcdr prefix values)))))
  (check-optional (= (1+ prefix) *optional-body-count*))))
(holai.runtime:defunc optional-replaced (a) (holai.runtime:lambdac (b) (+ a b)))
(defun optional-live-call () (optional-replaced 10 20))
(defparameter *optional-old* #'optional-replaced)
(defparameter *optional-prefix* (optional-replaced 10))
(holai.runtime:defunc optional-replaced (a b c) (+ a b c))
(check-optional (= 30 (funcall *optional-old* 10 20)))
(check-optional (= 30 (funcall *optional-prefix* 20)))
(check-optional (= 60 (funcall (optional-live-call) 30)))
(check-optional
  (= 14 (holai.runtime:fletc ((outer (x) (+ x 10)))
          (holai.runtime:fletc ((outer (x y) (+ (outer x) y)))
            (outer 1 3)))))
(check-optional
  (holai.runtime:labelsc ((even (n) (if (zerop n) t (odd (1- n))))
                          (odd (n) (if (zerop n) nil (even (1- n)))))
    (and (even 10) (funcall (even) 10) (odd 9))))
(format t "~&Optional entry checks passed: ~d~%" *optional-checks*)
