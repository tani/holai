(require :asdf)
(defvar *core-profile* nil)
(defun profile-core-operation (operation component action)
  (let ((path (namestring (asdf:component-pathname component))))
    (if (search "/generated/" path)
        (let ((start (get-internal-real-time)) (name (asdf:component-name component)))
          (format t "~&PROFILE_START ~a ~a~%" operation name) (finish-output)
          (prog1 (cl:funcall action)
            (let ((seconds (/ (- (get-internal-real-time) start)
                              (float internal-time-units-per-second 1.0d0))))
              (push (list operation name seconds) *core-profile*)
              (format t "~&PROFILE_END ~a ~a ~,3f~%" operation name seconds)
              (finish-output))))
        (cl:funcall action))))
(defmethod asdf:perform :around ((operation asdf:compile-op) (component asdf:cl-source-file))
  (profile-core-operation "compile" component (lambda () (call-next-method))))
(defmethod asdf:perform :around ((operation asdf:load-op) (component asdf:cl-source-file))
  (profile-core-operation "load" component (lambda () (call-next-method))))
(load "holai/tests/bootstrap.lisp")
(holai.runtime:print-flush holai.runtime:unit)
(unless (holai.runtime:= (holai.fusion:axioms holai.runtime:unit)
                         (list holai.nums:INFINITY_AX holai.class:SELECT_AX holai.class:ETA_AX))
  (error "Full initialization introduced an unexpected axiom"))
(format t "~&INITIAL_COUNTS ~d ~d ~d ~d~%"
  (length (holai.fusion:types holai.runtime:unit))
  (length (holai.fusion:constants holai.runtime:unit))
  (length (holai.fusion:definitions holai.runtime:unit))
  (length (holai.fusion:axioms holai.runtime:unit)))
(format t "~&CORE_INITIALIZATION_COMPLETE~%")
(when (sb-ext:posix-getenv "HOLAI_DEVELOPMENT_IMAGE")
  (setf (holai.runtime::formatter-stream holai.runtime:std-formatter) *standard-output*)
  (sb-ext:save-lisp-and-die (sb-ext:posix-getenv "HOLAI_DEVELOPMENT_IMAGE")))
