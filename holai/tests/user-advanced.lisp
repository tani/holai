(in-package :holai.tests.user-dsl)
(export 'run-advanced-tests)

(cl:defun run-advanced-tests ()
 (let ((*checks* 0) (axioms (copy-list (holai.fusion:axioms holai.runtime.data:unit)))
       (stack (holai.runtime.data:deref holai.tactics:current_goalstack))
       (interface (holai.runtime.data:deref holai.printer:the_interface)))
  (check (holai.runtime.core:= (hol-type '(cart real (finite 3)))
                              (holai.fusion:mk_type (holai.runtime.data:tuple "cart"
                                 (list (hol-type 'real) (holai.fusion:mk_type (holai.runtime.data:tuple "tybit1" (list (hol-type 'holai.user:one)))))))) "Finite dimension")
  (rejects (hol-type '(finite 0)))
  (check (handler-case (progn (read-term '(+ x y)) nil) (dsl-overload-error () t)) "Overload condition")
  (rejects (read-term '(+ 1 2)))
  (check (handler-case (progn (read-term 'true :expected-type 'num) nil)
           (dsl-type-error (condition) (eq (dsl-error-expected condition) 'num))) "Native type failure classified with expected type")
  (check (handler-case (progn (prove () false (refl)) nil)
           (dsl-proof-failure (condition) (not (null (dsl-error-expected condition))))) "Native proof failure classified")
  (check (eq interface (holai.runtime.data:deref holai.printer:the_interface)) "Overload candidates restored after rejection")
  (check-term (read-term '(decimal "1.25")) '(the real 5/4))
  (check (nth-value 3 (holai.user:check '(lambda (x) x))) "Inspection type variables")
  (check (find "+" (nth-value 4 (holai.user:check '(the real (+ 1 2))))
               :key (lambda (choice) (getf choice :operator)) :test #'equal) "Inspection overload choices")
  (rejects (read-term '(decimal "1.2.3")))
  (rejects (read-term '(decimal "1-2.0")))
  (dolist (entry '((holai.user::num-reduce (the num (+ 2 3)) 5)
                   (holai.user::int-reduce (the int (+ 2 3)) (the int 5))
                   (holai.user::real-rat-reduce (the real (+ 1/2 1/4)) (the real 3/4))))
    (let ((th (apply-conversion (first entry) (read-term (second entry)))))
      (check-proof th `(= ,(second entry) ,(third entry)))))
  (check-proof (apply-conversion 'holai.user::beta (read-term '((lambda (x) x) 2)))
                '(= ((lambda (x) x) 2) 2))
  (check-proof (apply-conversion '(holai.user::depth holai.user::beta) (read-term '(pair ((lambda (x) x) 2) 3)))
                '(= (pair ((lambda (x) x) 2) 3) (pair 2 3)))
  (check-proof (prove () (= (match (pair 1 true) ((pair x y) x)) 1) (simp))
                '(= (match (pair 1 true) ((pair x y) x)) 1))
  (check-proof (prove () (= (match (list 1 2) ((list) 0) ((cons x xs) x)) 1) (simp))
                '(= (match (list 1 2) ((list) 0) ((cons x xs) x)) 1))
  (check-proof (prove () (= (match (pair 1 true) ((as p (pair x y)) (first-component p))) 1) (simp))
                '(= (match (pair 1 true) ((as p (pair x y)) (first-component p))) 1))
  (check (handler-case (progn (read-term '(match (pair 1 true) ((as x (pair x y)) x))) nil)
           (dsl-pattern-error () t)) "Nonlinear pattern condition")
  (defstruct advanced-point () (x num) (y bool))
  (check-proof (prove () (= (advanced-point-x (record-update advanced-point (make-advanced-point 1 true) (x 2))) 2)
                 (simp advanced-point-x advanced-point-y))
                '(= (advanced-point-x (record-update advanced-point (make-advanced-point 1 true) (x 2))) 2))
  (rejects (read-term '(record-update advanced-point (make-advanced-point 1 true) (z 2))))
  (check (theorem 'make-advanced-point.injective) "Constructor-specific injectivity")
  (with-proof-context (p)
    (declare (type bool p) (assumption h p))
    (lemma local-context-lemma () p (exact h))
    (defthm closed-context () p (exact h))
    (check (theorem 'local-context-lemma) "Local lemma visible"))
  (check-proof (theorem 'closed-context) '(forall (p) (declare (type bool p)) (implies p p)))
  (rejects (theorem 'local-context-lemma))
  (rejects (lemma illegal-local () true (taut)))
  (with-proof-context (p)
    (declare (type bool p) (assumption h p))
    (with-proof-context (q)
      (declare (type bool q) (assumption k q))
      (defthm nested-context () (and p q) (split) (assumption))))
  (check-proof (theorem 'nested-context)
    '(forall (p q) (declare (type bool p q)) (implies p (implies q (and p q)))))
  (defspec (advanced-chosen) () (exists (x) (declare (type num x)) (= x 3)) (witness 3) (refl))
  (check-proof (theorem 'advanced-chosen.specification) '(= advanced-chosen 3))
  (rejects (defspec (bad-count) () (exists (x y) (declare (type num x y)) (= x y)) (witness 0) (witness 0) (refl)))
  (check (not (gethash 'bad-count holai.user::*constants*)) "Rejected specification introduces no constant")
  (defsubset advanced-positive () (declare (representation-type num))
    (lambda (n) (> n 0)) (by (witness 1) (conv (depth beta)) (arith)))
  (dolist (suffix '(".abs-rep" ".rep-abs" ".membership"))
    (check (null (holai.fusion:hyp (theorem (holai.user::result-name 'advanced-positive suffix)))) "Closed subset theorem"))
  (rejects (defsubset empty-subset () (declare (representation-type num))
             (lambda (n) false) (by (witness 0) (simp))))
  (check (not (gethash 'empty-subset holai.user::*types*)) "No empty subset type")
  (defquotient advanced-quotient () (declare (representation-type num))
    (lambda (x y) (= x y)) (by (conv (depth beta)) (meson)))
  (dolist (suffix '(".abs-rep" ".rep-abs" ".equivalence" ".class-equality"))
    (check (null (holai.fusion:hyp (theorem (holai.user::result-name 'advanced-quotient suffix)))) "Closed quotient theorem"))
  (check-proof (prove (x y) (declare (type num x y))
                  (iff (= (advanced-quotient.class x) (advanced-quotient.class y)) (= x y))
                  (exact (convert (depth beta) (spec advanced-quotient.class-equality x y))))
    '(forall (x y) (declare (type num x y))
       (iff (= (advanced-quotient.class x) (advanced-quotient.class y)) (= x y))))
  (defun advanced-successor (n) (declare (type num n) (values num)) (succ n))
  (deflift quotient-successor (q)
    (declare (type advanced-quotient q) (values advanced-quotient)
             (quotients advanced-quotient) (lift-positions 1))
    advanced-successor (by (conv (depth beta)) (simp advanced-successor) (meson)))
  (check (null (holai.fusion:hyp (theorem 'quotient-successor.lifting))) "Lift well-definedness")
  (defsimpset advanced-simp (rewrites advanced-successor))
  (defsimpset inherited-simp (extends advanced-simp))
  (check-proof (prove () (= (advanced-successor 0) 1) (simp :set inherited-simp) (arith)) '(= (advanced-successor 0) 1))
  (rejects (prove () true (simp advanced-successor :using (advanced-successor))))
  (check (handler-case (progn (prove () true (simp :unknown t)) nil) (dsl-option-error () t)) "Option condition")
  (check-proof (prove () (= (advanced-successor 0) 1)
                  (rewrite advanced-successor :at (subterm goal (rator rand))) (arith))
                '(= (advanced-successor 0) 1))
  (check-proof (prove (x) (declare (type num x)) (implies (= (advanced-successor x) 1) (= (succ x) 1))
                 (assume h) (rewrite advanced-successor :at (hypothesis h)) (exact h))
                '(forall (x) (declare (type num x)) (implies (= (advanced-successor x) 1) (= (succ x) 1))))
  (defcompset advanced-computation (equations advanced-successor.equations) (conversions holai.user::num-reduce))
  (check-proof (prove () (= (advanced-successor 2) 3) (compute :set advanced-computation)) '(= (advanced-successor 2) 3))
  (defthm advanced-identity (x) (declare (type ?a x)) (= x x) (refl))
  (check-proof (prove () (= 3 3) (exact (spec advanced-identity 3))) '(= 3 3))
  (check-proof (prove () (= 3 3) (exact (rule sym (spec advanced-identity 3)))) '(= 3 3))
  (defrule double-symmetry (th) (declare (argument-kinds :theorem))
    (holai.equal:SYM (holai.equal:SYM th)))
  (check-proof (prove () (= 3 3) (exact (rule double-symmetry (spec advanced-identity 3)))) '(= 3 3))
  (deftactic custom-reflexivity () #'holai.tactics:REFL_TAC)
  (check-proof (prove () (= 3 3) (custom-reflexivity)) '(= 3 3))
  (deftactic explicit-tactic-failure ()
    (lambda (goal) (declare (ignore goal))
      (error 'tactic-failure :form 'explicit-tactic-failure :cause "Expected failure")))
  (check-proof (prove () true (orelse (explicit-tactic-failure) (taut))) 'true)
  (defconversion identity-conversion () (lambda (tm) (holai.fusion:REFL tm)))
  (check-proof (apply-conversion '(identity-conversion) (read-term '3)) '(= 3 3))
  (defconversion wrong-conversion () (lambda (tm) (declare (ignore tm)) (holai.fusion:REFL (read-term '4))))
  (rejects (apply-conversion '(wrong-conversion) (read-term '3)))
  (check-proof (prove (p) (declare (type bool p)) (implies p (or false p)) (assume h) (right) (exact h))
               '(forall (p) (declare (type bool p)) (implies p (or false p))))
  (check-proof (prove () (forall (x y) (declare (type num x y)) (= x x)) (fix x y) (refl))
               '(forall (x y) (declare (type num x y)) (= x x)))
  (check-proof (prove () (= (the num (+ 1 2)) 3)
                 (calc (the num (+ 1 2)) (= 3 (arith)))) '(= (the num (+ 1 2)) 3))
  (check-proof (prove () true (first (fail) (taut))) 'true)
  (check-proof (prove () (exists (x) (declare (type num x)) (= x x))
                 (witness 0) (refl)) '(exists (x) (declare (type num x)) (= x x)))
  (deffunctions advanced-parity
    (advanced-even (n) (declare (type num n) (values bool)) (if (= n 0) true (advanced-odd (- n 1))))
    (advanced-odd (n) (declare (type num n) (values bool)) (if (= n 0) false (advanced-even (- n 1)))))
  (defcompset parity-computation (equations advanced-parity.equations) (conversions holai.user::num-reduce))
  (check-proof (prove () (advanced-even 4) (compute :set parity-computation)) '(advanced-even 4))
  (check-proof (prove () (advanced-odd 3) (compute :set parity-computation)) '(advanced-odd 3))
  (defun measured-copy (n) (declare (type num n) (values num) (measure n))
    (if (= n 0) 0 (succ (measured-copy (- n 1)))))
  (check (null (holai.fusion:hyp (theorem 'measured-copy.equations))) "Measured recursion")
  (defrelations advanced-reach (r)
    (declare (type (-> num num bool) r) (strong-induction t))
    (advanced-reachable (x y) (declare (type num x y))
      (edge (x y) (declare (type num x y)) (implies (r x y) (advanced-reachable x y)))
      (chain (x y z) (declare (type num x y z))
        (implies (and (advanced-reachable x y) (advanced-reachable y z)) (advanced-reachable x z)))))
  (check (null (holai.fusion:hyp (theorem 'advanced-reach.strong-induction))) "Strong schematic induction")
  (check-proof (prove (r x y) (declare (type (-> num num bool) r) (type num x y))
                  (implies (r x y) (advanced-reachable r x y)) (meson advanced-reach.rules.edge))
               '(forall (r x y) (declare (type (-> num num bool) r) (type num x y))
                  (implies (r x y) (advanced-reachable r x y))))
  (goal '(and (= 1 1) (= 2 2)))
  (check (= 1 (length (goals))) "Interactive initial goal")
  (check (handler-case (progn (proof-step '(refl)) nil) (dsl-proof-failure () t)) "Interactive proof failure classified")
  (check (= 1 (length (goals))) "Failed interactive step preserves state")
  (proof-step '(split))
  (check (= 2 (length (goals))) "Interactive split")
  (undo)
  (check (= 1 (length (goals))) "Interactive undo")
  (check-proof (proof-step '(thenl (split) (refl) (refl))) '(and (= 1 1) (= 2 2)))
  (abort-proof)
  (rejects (goals))
  (check (eq stack (holai.runtime.data:deref holai.tactics:current_goalstack)) "Generated interactive state untouched")
  (check (getf (gethash 'advanced-identity holai.user::*provenance*) :version) "Theorem provenance")
  (check (find 'advanced-identity (find-theorems "ADVANCED-IDENTITY") :key #'car) "Theorem search")
  (check (find 'advanced-identity (find-theorems :pattern '(= x x)) :key #'car) "Typed pattern search")
  (check (find 'advanced-identity (find-theorems :pattern '(forall (renamed) (= renamed renamed))) :key #'car) "Binder-aware pattern search")
  (check (find 'advanced-successor.equations
               (find-theorems :pattern '(= (advanced-successor x) (succ x))) :key #'car) "Constant-constrained theorem pattern")
  (goal '(implies free-proposition free-proposition))
  (check-proof (proof-step '(then (assume h) (exact h))) '(implies free-proposition free-proposition))
  (abort-proof)
  (rejects (declare-type 'forbidden-type 0))
  (rejects (declare-constant 'forbidden-constant 'num))
  (rejects (defaxiom forbidden-axiom true))
  (check (= 46 (length holai.user::*standard-modules*)) "All pinned core modules inventoried")
  (check (find :theorem (standard-descriptors "lists") :key (lambda (d) (getf d :kind))) "Standard theorem descriptors")
  (check-proof (prove () (= (holai.lists:APPEND (list 1) (list 2)) (list 1 2))
                  (simp (ref holai.lists:APPEND))) '(= (append (list 1) (list 2)) (list 1 2)))
  (dolist (engine '(meson metis leancop nanocop))
    (check-proof (holai.user::prove-declaration '(p)
                   `((declare (type bool p)) (implies p p) (,engine :timeout 5)))
                 '(forall (p) (declare (type bool p)) (implies p p))))
  (check-proof (prove (x) (declare (type real x)) (= (* x (+ x 1)) (+ (* x x) x)) (ring))
               '(forall (x) (declare (type real x)) (= (* x (+ x 1)) (+ (* x x) x))))
  (check-proof (prove (x) (declare (type int x)) (= (* x (+ x 1)) (+ (* x x) x)) (ring))
               '(forall (x) (declare (type int x)) (= (* x (+ x 1)) (+ (* x x) x))))
  (check-proof (prove (x) (declare (type real x)) (implies (not (= x 0)) (= (/ x x) 1)) (field))
               '(forall (x) (declare (type real x)) (implies (not (= x 0)) (= (/ x x) 1))))
  (defthm advanced-existence () (exists (x) (declare (type num x)) (= x 3)) (witness 3) (refl))
  (check-proof (prove () (exists (x) (declare (type num x)) (= x 3))
                  (obtain (w) advanced-existence ((hw (= w 3)))) (witness w) (exact hw))
               '(exists (x) (declare (type num x)) (= x 3)))
  (rejects (prove (w) (declare (type num w)) (= w 3)
             (obtain (w) advanced-existence ((hw (= w 3)))) (exact hw)))
  (check-proof (prove () (= 3 3) (exact (spec (inst advanced-identity :types ((?a num))) 3))) '(= 3 3))
  (defdatatype advanced-tree () (advanced-tip (value num))
      (advanced-fork (left advanced-tree) (right advanced-tree)))
  (check-proof (prove (tree) (declare (type advanced-tree tree)) (= tree tree)
                 (thenl (cases tree)
                   (branch advanced-tip (x) (refl))
                   (branch advanced-fork (l r) (refl))))
               '(forall (tree) (declare (type advanced-tree tree)) (= tree tree)))
  (check-proof (prove (n) (declare (type num n)) (>= n 0)
                 (thenl (induct n) (branch holai.user::base () (arith))
                                     (branch holai.user::step (k) (arith))))
               '(forall (n) (declare (type num n)) (>= n 0)))
  (with-proof-context (offset)
    (declare (type num offset) (assumption positive (> offset 0)))
    (defun contextual-add (x) (declare (type num x) (values num)) (+ offset x))
    (lemma contextual-positive () (> (contextual-add 1) 0) (simp contextual-add) (asm-arith))
    (defthm contextual-use () (> (contextual-add 1) 0) (exact contextual-positive)))
  (check-proof (theorem 'contextual-use)
    '(forall (offset) (declare (type num offset)) (implies (> offset 0) (> (contextual-add offset 1) 0))))
  (check-proof (prove () (= (contextual-add 2 3) 5) (simp contextual-add) (arith)) '(= (contextual-add 2 3) 5))
  (defun advanced-above-zero (n) (declare (type num n)) (> n 0))
  (unless (gethash 'advanced-pending-copy holai.user::*constants*)
    (rejects (defun advanced-pending-copy (n) (declare (type num n) (values num))
               (if (advanced-above-zero n) (succ (advanced-pending-copy (- n 1))) 0)))
    (check (obligations 'advanced-pending-copy) "Stable pending obligations")
    (check (not (gethash 'advanced-pending-copy holai.user::*constants*)) "Pending constant is unavailable")
    (rejects (defun advanced-pending-copy (n) (declare (type num n)) n))
    (rejects (complete-definition 'advanced-pending-copy nil))
    (complete-definition 'advanced-pending-copy
       '((:obligation-1 (by (witness (measure (lambda (n) (declare (type num n)) n)))
                              (simp advanced-above-zero holai.wf:WF_MEASURE (ref holai.wf:MEASURE)) (arith))))))
  (check (gethash 'advanced-pending-copy holai.user::*definitions*) "Completed plan cached for reload")
  (check (null (obligations 'advanced-pending-copy)) "Completed obligations removed")
  (check (null (holai.fusion:hyp (theorem 'advanced-pending-copy.equations))) "Closed completed recursion")
  (with-proof-context ()
    (declare (automation :timeout 0.01))
    (deftactic exhausted-search () (lambda (goal) (declare (ignore goal)) (loop)))
    (check (handler-case (progn (prove () true (exhausted-search)) nil)
             (dsl-resource-exhausted () t)) "Timeout distinguished from ordinary tactic failure"))
  (defun advanced-list-length (xs) (declare (type (list ?a) xs) (values num))
    (match xs ((list) 0) ((as whole (cons x tail)) (succ (advanced-list-length tail)))))
  (check-proof (prove () (= (advanced-list-length (list true false)) 2) (simp advanced-list-length) (arith))
               '(= (advanced-list-length (list true false)) 2))
  (defun advanced-boolean-number (b) (declare (type bool b) (values num))
    (match b ((true) 1) ((false) 0)))
  (check-proof (prove () (= (advanced-boolean-number true) 1) (simp advanced-boolean-number)) '(= (advanced-boolean-number true) 1))
  (check-proof (prove () (and (= 1 1) (= 2 2)) (split) (focus 2 (refl)) (refl))
               '(and (= 1 1) (= 2 2)))
  (rejects (prove () (= 1 1) (focus 2 (refl))))
  (rejects (prove () (= 1 1) (focus nonexistent (refl))))
  (defrule optional-rule (tm &optional dummy)
    (declare (argument-kinds :term :syntax) (ignore dummy)) (holai.fusion:REFL tm))
  (check-proof (prove () (= 3 3) (exact (rule optional-rule 3 nil))) '(= 3 3))
  (defrule keyword-rule (tm &key again)
    (declare (argument-kinds :term :syntax) (ignore again)) (holai.fusion:REFL tm))
  (check-proof (prove () (= 3 3) (exact (rule keyword-rule 3 :again true))) '(= 3 3))
  (defrule variadic-rule (&rest thms) (declare (argument-kinds :theorem)) (car thms))
  (check-proof (prove () (= 3 3) (exact (rule variadic-rule (spec advanced-identity 3)))) '(= 3 3))
  (check-proof (apply-conversion '(repeat-conv (identity-conversion)) (read-term '3)) '(= 3 3))
  (check-proof (apply-conversion '(rator (identity-conversion)) (read-term '(succ 3))) '(= (succ 3) (succ 3)))
  (with-proof-context (n)
    (declare (type num n) (assumption positive (> n 0)))
    (defspec (context-witness-a context-witness-b) ()
      (exists (x y) (declare (type num x y)) (and (= x n) (= y (succ x))))
      (witness n) (witness (succ n)) (simp))
    (defthm use-context-witness ()
      (and (= context-witness-a n) (= context-witness-b (succ context-witness-a)))
      (meson context-witness-a.specification)))
  (check-proof (theorem 'use-context-witness)
    '(forall (n) (declare (type num n))
       (implies (> n 0) (and (= (context-witness-a n) n)
                             (= (context-witness-b n) (succ (context-witness-a n)))))))
  (check (getf (gethash 'use-context-witness holai.user::*provenance*) :references) "Versioned proof references")
  (check (equal (theorem-data (prove () (forall (x) (declare (type num x)) (= x x)) (intros) (refl)))
                (theorem-data (prove () (forall (y) (declare (type num y)) (= y y)) (intros) (refl)))) "Alpha-normalized theorem metadata")
  (let ((source (merge-pathnames "_build/user-replay.lisp" (asdf:system-source-directory "holai"))))
    (save-development source '((in-package :holai.tests.user-dsl)
                                (defthm saved-reflexivity () (= 1 1) (refl))))
    (load source)
    (check-proof (theorem 'saved-reflexivity) '(= 1 1))
    (let ((*read-eval* nil))
      (with-open-file (stream (concatenate 'string (namestring source) ".manifest.lisp"))
        (let ((manifest (read stream)))
          (check (eq (getf manifest :trust) :replay-common-lisp-source) "Source replay trust recorded")
          (check (getf manifest :theorems) "Inert theorem manifest")
          (check (getf manifest :axioms) "Conservative axiom dependencies recorded")))))
  (defun advanced-obscure (p) (declare (type (-> num bool) p)) (lambda (n) (p n)))
  (unless (gethash 'advanced-pending-relation holai.user::*constants*)
    (rejects (definductive advanced-pending-relation (n) (declare (type num n))
               (cycle (n) (implies ((advanced-obscure advanced-pending-relation) n) (advanced-pending-relation n)))))
    (check (obligations 'advanced-pending-relation) "Monotonicity obligations exposed")
    (check (not (gethash 'advanced-pending-relation holai.user::*constants*)) "Pending relation unavailable")
    (complete-definition 'advanced-pending-relation
      '((:obligation-1 (by (simp advanced-obscure) (meson))))))
  (check (null (obligations 'advanced-pending-relation)) "Monotonicity completed")
  (check (null (holai.fusion:hyp (theorem 'advanced-pending-relation.induction))) "Closed completed induction")
  (defrelations duplicate-label-parity ()
    (duplicate-even (n) (declare (type num n))
      (zero () (duplicate-even 0)) (step (k) (implies (duplicate-odd k) (duplicate-even (succ k)))))
    (duplicate-odd (n) (declare (type num n))
      (step (k) (implies (duplicate-even k) (duplicate-odd (succ k))))))
  (check (theorem 'duplicate-even.rules.step) "First local STEP label")
  (check (theorem 'duplicate-odd.rules.step) "Second local STEP label")
  (check (theorem 'duplicate-label-parity.rules.duplicate-odd.step) "Qualified group rule label")
  (rejects (theorem 'duplicate-label-parity.rules.step))
  (dolist (name '(duplicate-even.induction duplicate-odd.induction duplicate-even.cases duplicate-odd.cases))
    (check (null (holai.fusion:hyp (theorem name))) "Derived mutual component"))
  (definductive escaped-rule-labels (n) (declare (type num n))
    (|step| () (escaped-rule-labels 0)) (step () (escaped-rule-labels 0)))
  (check (not (eq (holai.user::result-name 'escaped-rule-labels ".rules.step")
                  (holai.user::result-name 'escaped-rule-labels ".rules.STEP"))) "Escaped rule label case preserved")
  (check (theorem (holai.user::result-name 'escaped-rule-labels ".rules.step")) "Lowercase generated rule label")
  (defun conditional-target (n) (declare (type num n)) (succ n))
  (defun condition-always (n) (declare (type num n)) true)
  (defthm conditional-target-correct (n) (declare (type num n))
    (implies (condition-always n) (= (conditional-target n) (succ n))) (simp conditional-target))
  (defsimpset conditional-resource (rewrites conditional-target-correct)
    (condition-provers (simp condition-always)))
  (check-proof (prove () (= (conditional-target 7) (succ 7)) (simp :set conditional-resource))
               '(= (conditional-target 7) (succ 7)))
  (defthm conditional-false-rule (n) (declare (type num n))
    (implies false (= (conditional-target n) 0)) (taut))
  (check (handler-case (progn (prove () (= (conditional-target 7) 0) (rewrite conditional-false-rule :strict t)) nil)
           (dsl-obligation-error (condition) (not (null (dsl-error-actual condition))))) "Strict unresolved conditions reported")
  (defsimpset advanced-simp (rewrites))
  (check-proof (prove () (= (advanced-successor 0) 1) (simp :set inherited-simp) (arith)) '(= (advanced-successor 0) 1))
  (defcompset computation-child (extends advanced-computation))
  (defcompset advanced-computation (equations))
  (check-proof (prove () (= (advanced-successor 2) 3) (compute :set computation-child)) '(= (advanced-successor 2) 3))
  (let ((old-auto (holai.runtime.data:deref holai.compute.compute::auto_import_definitions))
        (old-stops (holai.runtime.data:deref holai.compute.compute:stoppers)))
    (check-proof (apply-conversion '(eval :set computation-child :stops (advanced-successor))
                    (read-term '(advanced-successor (+ 1 1))))
                 '(= (advanced-successor (+ 1 1)) (advanced-successor 2)))
    (check (eq old-auto (holai.runtime.data:deref holai.compute.compute::auto_import_definitions)) "Compute auto-import setting restored")
    (check (eq old-stops (holai.runtime.data:deref holai.compute.compute:stoppers)) "Compute stops restored"))
  (deffunctions ground-constants
    (ground-first () (declare (values num)) (succ ground-second))
    (ground-second () (declare (values num)) 0))
  (check-proof (prove () (= ground-first 1) (simp ground-first ground-second) (arith)) '(= ground-first 1))
  (defdatatypes advanced-mutual-trees ()
    (advanced-tree-a (advanced-az) (advanced-ab (b advanced-tree-b)))
    (advanced-tree-b (advanced-ba (a advanced-tree-a))))
  (deffunctions mutual-tree-walks
    (walk-tree-a (a) (declare (type advanced-tree-a a) (values num))
      (match a ((advanced-az) 0) ((advanced-ab b) (succ (walk-tree-b b)))))
    (walk-tree-b (b) (declare (type advanced-tree-b b) (values num))
      (match b ((advanced-ba a) (succ (walk-tree-a a))))))
  (check-proof (prove () (= (walk-tree-a (advanced-ab (advanced-ba advanced-az))) 2)
                  (simp walk-tree-a walk-tree-b) (arith))
               '(= (walk-tree-a (advanced-ab (advanced-ba advanced-az))) 2))
  (with-proof-context (bound) (declare (type num bound))
    (definductive context-relation (n) (declare (type num n))
      (initial (n) (implies (> n bound) (context-relation n))))
    (defthm context-relation-use (n) (declare (type num n))
      (implies (> n bound) (context-relation n)) (meson context-relation.rules.initial)))
  (check-proof (theorem 'context-relation-use)
    '(forall (bound n) (declare (type num bound n)) (implies (> n bound) (context-relation bound n))))
  (rejects (defun hidden-type (n) (declare (type num n)) (let ((x (arbitrary ?b))) n)))
  (check (not holai.user::*kernel-uncertain*) "Type preflight does not poison kernel state")
  (check-proof (prove (n x) (declare (type num n) (type real x)) (= x x)
                 (induct n :generalizing (x)) (refl))
               '(forall (n x) (declare (type num n) (type real x)) (= x x)))
  (definductive zero-only (n) (declare (type num n)) (base () (zero-only 0)))
  (check-proof (prove (n) (declare (type num n)) (implies (zero-only n) (= n 0))
                 (assume h) (cases h :using zero-only.cases) (refl))
               '(forall (n) (declare (type num n)) (implies (zero-only n) (= n 0))))
  (check-proof (prove () (implies true (implies ((lambda (p) p) true) true))
                 (assume k) (assume h)
                 (exact (convert (depth beta) (convert (depth beta) h :at (hypothesis 1)))))
               '(implies true (implies ((lambda (p) p) true) true)))
  (deftactic frozen-condition-prover ()
    (holai.user::command-tactic '(simp condition-always)))
  (defsimpset frozen-conditions (rewrites conditional-target-correct)
    (condition-provers (frozen-condition-prover)))
  (deftactic frozen-condition-prover () holai.tactics:NO_TAC)
  (check-proof (prove () (= (conditional-target 7) (succ 7)) (simp :set frozen-conditions))
               '(= (conditional-target 7) (succ 7)))
  (defthm frozen-compute-basis (n) (declare (type num n))
    (= (advanced-successor n) (succ n)) (simp advanced-successor))
  (defconversion frozen-numeral-conversion ()
    (lambda (tm)
      (funcall (holai.user::native "HOLAI.SIMP" "REWRITE_CONV" (list (theorem 'frozen-compute-basis))) tm)))
  (defcompset frozen-conversions (conversions num-reduce (advanced-successor 1 (frozen-numeral-conversion))))
  (defthm frozen-compute-basis () true (taut))
  (check-proof (prove () (= (advanced-successor 2) 3) (compute :set frozen-conversions)) '(= (advanced-successor 2) 3))
  (rejects (defun duplicate-type-declaration (n) (declare (type num n) (type real n)) n))
  (rejects (defun many-values (n) (declare (type num n) (values num num)) n))
  (defthm successor-source-injective (x y) (declare (type num x y))
    (iff (= (advanced-successor x) (advanced-successor y)) (= x y)) (simp advanced-successor) (arith))
  (check-proof (prove (x y) (declare (type advanced-quotient x y))
                  (iff (= (quotient-successor x) (quotient-successor y)) (= x y))
                  (exact (spec (lift-theorem advanced-quotient successor-source-injective) x y)))
               '(forall (x y) (declare (type advanced-quotient x y))
                  (iff (= (quotient-successor x) (quotient-successor y)) (= x y))))
  (defquotient polymorphic-quotient (?a) (declare (representation-type ?a))
    (lambda (x y) (= x y)) (by (conv (depth beta)) (meson)))
  (defun lifting-identity (x) (declare (type ?a x)) x)
  (deflift quotient-identity (x)
    (declare (type (polymorphic-quotient ?a) x) (values (polymorphic-quotient ?a))
             (quotients polymorphic-quotient) (lift-positions 1))
    lifting-identity (by (simp lifting-identity)))
  (defthm identity-related (x) (declare (type ?a x))
    (polymorphic-quotient.relation (lifting-identity x) x) (simp polymorphic-quotient.relation lifting-identity))
  (check-proof (prove (x) (declare (type (polymorphic-quotient ?a) x)) (= (quotient-identity x) x)
                  (exact (spec (lift-theorem polymorphic-quotient identity-related) x)))
               '(forall (x) (declare (type (polymorphic-quotient ?a) x)) (= (quotient-identity x) x)))
  (check (null (holai.fusion:hyp (theorem 'polymorphic-quotient.class-relation))) "Canonical class relation")
  (check (equalp axioms (holai.fusion:axioms holai.runtime.data:unit)) "No DSL axioms")
  (format t "User advanced DSL checks passed: ~d~%" *checks*)))
