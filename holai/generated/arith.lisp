;; (* ------------------------------------------------------------------------- *)
;; (* The predecessor function.                                                 *)
;; (* ------------------------------------------------------------------------- *)


(defparameter PRE
  (#`new_recursive_definition
    num_RECURSION
    (parse_term "(PRE 0 = 0) /\\
  (!n. PRE (SUC n) = n)")))

;; (* ------------------------------------------------------------------------- *)
;; (* Addition.                                                                 *)
;; (* ------------------------------------------------------------------------- *)


(defparameter ADD
  (#`new_recursive_definition
    num_RECURSION
    (parse_term "(!n. 0 + n = n) /\\
  (!m n. (SUC m) + n = SUC(m + n))")))

(defparameter ADD_0
  (prove
    (tuple
      (parse_term "!m. m + 0 = m")
      (holai.runtime:proof INDUCT_TAC THEN (#`ASM_REWRITE_TAC (cl:cons ADD nil))))))

(defparameter ADD_SUC
  (prove
    (tuple
      (parse_term "!m n. m + (SUC n) = SUC(m + n)")
      (holai.runtime:proof INDUCT_TAC THEN (#`ASM_REWRITE_TAC (cl:cons ADD nil))))))

(defparameter ADD_CLAUSES
  (prove
    (tuple
      (parse_term
        "(!n. 0 + n = n) /\\
   (!m. m + 0 = m) /\\
   (!m n. (SUC m) + n = SUC(m + n)) /\\
   (!m n. m + (SUC n) = SUC(m + n))")
      (REWRITE_TAC (cl:cons ADD (cl:cons ADD_0 (cl:cons ADD_SUC nil)))))))

(defparameter ADD_SYM
  (prove
    (tuple
      (parse_term "!m n. m + n = n + m")
      (holai.runtime:proof INDUCT_TAC THEN (#`ASM_REWRITE_TAC (cl:cons ADD_CLAUSES nil))))))

(defparameter ADD_ASSOC
  (prove
    (tuple
      (parse_term "!m n p. m + (n + p) = (m + n) + p")
      (holai.runtime:proof INDUCT_TAC THEN (#`ASM_REWRITE_TAC (cl:cons ADD_CLAUSES nil))))))

(defparameter ADD_AC
  (prove
    (tuple
      (parse_term
        "(m + n = n + m) /\\
   ((m + n) + p = m + (n + p)) /\\
   (m + (n + p) = n + (m + p))")
      (MESON_TAC (cl:cons ADD_ASSOC (cl:cons ADD_SYM nil))))))

(defparameter ADD_EQ_0
  (prove
    (tuple
      (parse_term "!m n. (m + n = 0) <=> (m = 0) /\\ (n = 0)")
      (holai.runtime:proof (REPEAT INDUCT_TAC)
        THEN (REWRITE_TAC (cl:cons ADD_CLAUSES (cl:cons NOT_SUC nil)))))))

(defparameter EQ_ADD_LCANCEL
  (prove
    (tuple
      (parse_term "!m n p. (m + n = m + p) <=> (n = p)")
      (holai.runtime:proof INDUCT_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons ADD_CLAUSES (cl:cons SUC_INJ nil)))))))

(defparameter EQ_ADD_RCANCEL
  (prove
    (tuple
      (parse_term "!m n p. (m + p = n + p) <=> (m = n)")
      (holai.runtime:proof (ONCE_REWRITE_TAC (cl:cons ADD_SYM nil))
        THEN (#`MATCH_ACCEPT_TAC EQ_ADD_LCANCEL)))))

(defparameter EQ_ADD_LCANCEL_0
  (prove
    (tuple
      (parse_term "!m n. (m + n = m) <=> (n = 0)")
      (holai.runtime:proof INDUCT_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons ADD_CLAUSES (cl:cons SUC_INJ nil)))))))

(defparameter EQ_ADD_RCANCEL_0
  (prove
    (tuple
      (parse_term "!m n. (m + n = n) <=> (m = 0)")
      (holai.runtime:proof (ONCE_REWRITE_TAC (cl:cons ADD_SYM nil))
        THEN (#`MATCH_ACCEPT_TAC EQ_ADD_LCANCEL_0)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Now define "bitwise" binary representation of numerals.                   *)
;; (* ------------------------------------------------------------------------- *)


(defparameter BIT0
  (prove
    (tuple
      (parse_term "!n. BIT0 n = n + n")
      (holai.runtime:proof INDUCT_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons BIT0_DEF (cl:cons ADD_CLAUSES nil)))))))

(defparameter BIT1
  (prove
    (tuple
      (parse_term "!n. BIT1 n = SUC(n + n)")
      (REWRITE_TAC (cl:cons BIT1_DEF (cl:cons BIT0 nil))))))

(defparameter BIT0_THM
  (prove
    (tuple
      (parse_term "!n. NUMERAL (BIT0 n) = NUMERAL n + NUMERAL n")
      (REWRITE_TAC (cl:cons NUMERAL (cl:cons BIT0 nil))))))

(defparameter BIT1_THM
  (prove
    (tuple
      (parse_term "!n. NUMERAL (BIT1 n) = SUC(NUMERAL n + NUMERAL n)")
      (REWRITE_TAC (cl:cons NUMERAL (cl:cons BIT1 nil))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Following is handy before num_CONV arrives.                               *)
;; (* ------------------------------------------------------------------------- *)


(defparameter ONE
  (prove
    (tuple
      (parse_term "1 = SUC 0")
      (REWRITE_TAC
        (cl:cons
          BIT1
          (cl:cons (REWRITE_RULE (cl:cons NUMERAL nil) ADD_CLAUSES) (cl:cons NUMERAL nil)))))))

(defparameter TWO
  (prove
    (tuple
      (parse_term "2 = SUC 1")
      (REWRITE_TAC
        (cl:cons
          BIT0
          (cl:cons
            BIT1
            (cl:cons
              (REWRITE_RULE (cl:cons NUMERAL nil) ADD_CLAUSES)
              (cl:cons NUMERAL nil))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* One immediate consequence.                                                *)
;; (* ------------------------------------------------------------------------- *)


(defparameter ADD1
  (prove
    (tuple
      (parse_term "!m. SUC m = m + 1")
      (REWRITE_TAC (cl:cons BIT1_THM (cl:cons ADD_CLAUSES nil))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Multiplication.                                                           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter MULT
  (#`new_recursive_definition
    num_RECURSION
    (parse_term "(!n. 0 * n = 0) /\\
  (!m n. (SUC m) * n = (m * n) + n)")))

(defparameter MULT_0
  (prove
    (tuple
      (parse_term "!m. m * 0 = 0")
      (holai.runtime:proof INDUCT_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons MULT (cl:cons ADD_CLAUSES nil)))))))

(defparameter MULT_SUC
  (prove
    (tuple
      (parse_term "!m n. m * (SUC n) = m + (m * n)")
      (holai.runtime:proof INDUCT_TAC
        THEN
          (#`ASM_REWRITE_TAC (cl:cons MULT (cl:cons ADD_CLAUSES (cl:cons ADD_ASSOC nil))))))))

(defparameter MULT_CLAUSES
  (prove
    (tuple
      (parse_term
        "(!n. 0 * n = 0) /\\
   (!m. m * 0 = 0) /\\
   (!n. 1 * n = n) /\\
   (!m. m * 1 = m) /\\
   (!m n. (SUC m) * n = (m * n) + n) /\\
   (!m n. m * (SUC n) = m + (m * n))")
      (REWRITE_TAC
        (cl:cons
          BIT1_THM
          (cl:cons MULT (cl:cons MULT_0 (cl:cons MULT_SUC (cl:cons ADD_CLAUSES nil)))))))))

(defparameter MULT_SYM
  (prove
    (tuple
      (parse_term "!m n. m * n = n * m")
      (holai.runtime:proof INDUCT_TAC
        THEN
          (#`ASM_REWRITE_TAC
            (cl:cons MULT_CLAUSES (cl:cons (#`EQT_INTRO (SPEC_ALL ADD_SYM)) nil)))))))

(defparameter LEFT_ADD_DISTRIB
  (prove
    (tuple
      (parse_term "!m n p. m * (n + p) = (m * n) + (m * p)")
      (holai.runtime:proof #'GEN_TAC
        THEN INDUCT_TAC
        THEN
          (#`ASM_REWRITE_TAC (cl:cons ADD (cl:cons MULT_CLAUSES (cl:cons ADD_ASSOC nil))))))))

(defparameter RIGHT_ADD_DISTRIB
  (prove
    (tuple
      (parse_term "!m n p. (m + n) * p = (m * p) + (n * p)")
      (holai.runtime:proof (ONCE_REWRITE_TAC (cl:cons MULT_SYM nil))
        THEN (#`MATCH_ACCEPT_TAC LEFT_ADD_DISTRIB)))))

(defparameter MULT_ASSOC
  (prove
    (tuple
      (parse_term "!m n p. m * (n * p) = (m * n) * p")
      (holai.runtime:proof INDUCT_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons MULT_CLAUSES (cl:cons RIGHT_ADD_DISTRIB nil)))))))

(defparameter MULT_AC
  (prove
    (tuple
      (parse_term
        "(m * n = n * m) /\\
   ((m * n) * p = m * (n * p)) /\\
   (m * (n * p) = n * (m * p))")
      (MESON_TAC (cl:cons MULT_ASSOC (cl:cons MULT_SYM nil))))))

(defparameter MULT_EQ_0
  (prove
    (tuple
      (parse_term "!m n. (m * n = 0) <=> (m = 0) \\/ (n = 0)")
      (holai.runtime:proof (REPEAT INDUCT_TAC)
        THEN
          (REWRITE_TAC (cl:cons MULT_CLAUSES (cl:cons ADD_CLAUSES (cl:cons NOT_SUC nil))))))))

(defparameter EQ_MULT_LCANCEL
  (prove
    (tuple
      (parse_term "!m n p. (m * n = m * p) <=> (m = 0) \\/ (n = p)")
      (holai.runtime:proof INDUCT_TAC
        THEN (REWRITE_TAC (cl:cons MULT_CLAUSES (cl:cons NOT_SUC nil)))
        THEN (REPEAT INDUCT_TAC)
        THEN
          (#`ASM_REWRITE_TAC
            (cl:cons
              MULT_CLAUSES
              (cl:cons ADD_CLAUSES (cl:cons (#`GSYM NOT_SUC) (cl:cons NOT_SUC nil)))))
        THEN
          (#`ASM_REWRITE_TAC
            (cl:cons SUC_INJ (cl:cons (#`GSYM ADD_ASSOC) (cl:cons EQ_ADD_LCANCEL nil))))))))

(defparameter EQ_MULT_RCANCEL
  (prove
    (tuple
      (parse_term "!m n p. (m * p = n * p) <=> (m = n) \\/ (p = 0)")
      (holai.runtime:proof (ONCE_REWRITE_TAC (cl:cons MULT_SYM (cl:cons DISJ_SYM nil)))
        THEN (#`MATCH_ACCEPT_TAC EQ_MULT_LCANCEL)))))

(defparameter MULT_2
  (prove
    (tuple
      (parse_term "!n. 2 * n = n + n")
      (holai.runtime:proof #'GEN_TAC
        THEN
          (REWRITE_TAC
            (cl:cons BIT0_THM (cl:cons MULT_CLAUSES (cl:cons RIGHT_ADD_DISTRIB nil))))))))

(defparameter MULT_EQ_1
  (prove
    (tuple
      (parse_term "!m n. (m * n = 1) <=> (m = 1) /\\ (n = 1)")
      (holai.runtime:proof INDUCT_TAC
        THEN INDUCT_TAC
        THEN
          (REWRITE_TAC
            (cl:cons
              MULT_CLAUSES
              (cl:cons
                ADD_CLAUSES
                (cl:cons BIT0_THM (cl:cons BIT1_THM (cl:cons (#`GSYM NOT_SUC) nil))))))
        THEN (REWRITE_TAC (cl:cons SUC_INJ (cl:cons ADD_EQ_0 (cl:cons MULT_EQ_0 nil))))
        THEN (#`CONV_TAC TAUT)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Exponentiation.                                                           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter EXP
  (#`new_recursive_definition
    num_RECURSION
    (parse_term "(!m. m EXP 0 = 1) /\\
  (!m n. m EXP (SUC n) = m * (m EXP n))")))

(defparameter EXP_EQ_0
  (prove
    (tuple
      (parse_term "!m n. (m EXP n = 0) <=> (m = 0) /\\ ~(n = 0)")
      (holai.runtime:proof (REPEAT INDUCT_TAC)
        THEN
          (#`ASM_REWRITE_TAC
            (cl:cons
              BIT1_THM
              (cl:cons
                NOT_SUC
                (cl:cons
                  NOT_SUC
                  (cl:cons
                    EXP
                    (cl:cons MULT_CLAUSES (cl:cons ADD_CLAUSES (cl:cons ADD_EQ_0 nil))))))))))))

(defparameter EXP_EQ_1
  (prove
    (tuple
      (parse_term "!x n. x EXP n = 1 <=> x = 1 \\/ n = 0")
      (holai.runtime:proof #'GEN_TAC
        THEN INDUCT_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons EXP (cl:cons MULT_EQ_1 (cl:cons NOT_SUC nil))))
        THEN (#`CONV_TAC TAUT)))))

(defparameter EXP_ZERO
  (prove
    (tuple
      (parse_term "!n. 0 EXP n = if n = 0 then 1 else 0")
      (holai.runtime:proof #'GEN_TAC
        THEN COND_CASES_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons EXP_EQ_0 (cl:cons EXP_EQ_1 nil)))))))

(defparameter EXP_ADD
  (prove
    (tuple
      (parse_term "!m n p. m EXP (n + p) = (m EXP n) * (m EXP p)")
      (holai.runtime:proof #'GEN_TAC
        THEN #'GEN_TAC
        THEN INDUCT_TAC
        THEN
          (#`ASM_REWRITE_TAC
            (cl:cons
              EXP
              (cl:cons ADD_CLAUSES (cl:cons MULT_CLAUSES (cl:cons MULT_AC nil)))))))))

(defparameter EXP_ONE
  (prove
    (tuple
      (parse_term "!n. 1 EXP n = 1")
      (holai.runtime:proof INDUCT_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons EXP (cl:cons MULT_CLAUSES nil)))))))

(defparameter EXP_1
  (prove
    (tuple
      (parse_term "!n. n EXP 1 = n")
      (REWRITE_TAC
        (cl:cons ONE (cl:cons EXP (cl:cons MULT_CLAUSES (cl:cons ADD_CLAUSES nil))))))))

(defparameter EXP_2
  (prove
    (tuple
