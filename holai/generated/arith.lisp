;; (* ------------------------------------------------------------------------- *)
;; (* Conversion that elimimates every occurrence of `NUMERAL`, `BIT0`,         *)
;; (* `BIT1`, `_0` that is not part of a well-formed numeral.                   *)
;; (* ------------------------------------------------------------------------- *)


(defparameter BITS_ELIM_CONV
  (match
    (tuple
      (prove
        (tuple (parse_term "m = n <=> NUMERAL m = n") (REWRITE_TAC (cl:cons NUMERAL nil))))
      (#`GSYM (REWRITE_CONV (cl:cons NUMERAL nil) (parse_term "0")))
      (CONJ_PAIR
        (prove
          (tuple
            (parse_term
              "(m = n <=> BIT0 m = 2 * n) /\\
           (m = n <=> BIT1 m = 2 * n + 1)")
            (holai.runtime:proof #'CONJ_TAC
              THEN
                (GEN_REWRITE_TAC
                  (o #'RAND_CONV LAND_CONV)
                  (cl:cons BIT0 (cl:cons BIT1 nil)))
              THEN
                (REWRITE_TAC
                  (cl:cons ADD1 (cl:cons EQ_ADD_RCANCEL (cl:cons (#`GSYM MULT_2) nil))))
              THEN (REWRITE_TAC (cl:cons EQ_MULT_LCANCEL nil))
              THEN (REWRITE_TAC (cl:cons TWO (cl:cons NOT_SUC nil)))))))
      (tuple (parse_term "m:num") (parse_term "n:num")))
    ((tuple NUMERAL_pth ZERO_pth (tuple BIT0_pth BIT1_pth) (tuple mvar nvar))
      (labelsc
        ((BITS_ELIM_CONV% (tm)
          (match tm
            ((Const "_0" _) ZERO_pth)
            ((cl:or (Var _) (Const _)) (REFL tm))
            ((Comb (Const "NUMERAL" _) mtm)
              (if (#`is_numeral tm)
                (REFL tm)
                (let ((th (BITS_ELIM_CONV% mtm)))
                  (cl:declare (cl:ignorable th))
                  (EQ_MP
                    (INST%
                      (cl:cons
                        (tuple mtm mvar)
                        (cl:cons (tuple (rand (concl th)) nvar) nil))
                      NUMERAL_pth)
                    th))))
            ((Comb (Const "BIT0" _) mtm)
              (let ((th (BITS_ELIM_CONV% mtm)))
                (cl:declare (cl:ignorable th))
                (EQ_MP
                  (INST%
                    (cl:cons
                      (tuple mtm mvar)
                      (cl:cons (tuple (rand (concl th)) nvar) nil))
                    BIT0_pth)
                  th)))
            ((Comb (Const "BIT1" _) mtm)
              (let ((th (BITS_ELIM_CONV% mtm)))
                (cl:declare (cl:ignorable th))
                (EQ_MP
                  (INST%
                    (cl:cons
                      (tuple mtm mvar)
                      (cl:cons (tuple (rand (concl th)) nvar) nil))
                    BIT1_pth)
                  th)))
            ((Comb _) (#`COMB_CONV #'BITS_ELIM_CONV% tm))
            ((Abs _) (ABS_CONV #'BITS_ELIM_CONV% tm)))))
        #'BITS_ELIM_CONV%))))

