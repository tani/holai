;; (* ------------------------------------------------------------------------- *)
;; (* Pushing and pulling to combine nested MOD terms into a single MOD.        *)
;; (* ------------------------------------------------------------------------- *)


(defparameter MOD_DOWN_CONV
  (let*
    ((MOD_SUC_MOD
      (METIS
        (cl:cons ADD1 (cl:cons MOD_ADD_MOD (cl:cons MOD_MOD_REFL nil)))
        (parse_term "(SUC(m MOD n)) MOD n = SUC m MOD n")))
      (addmul_conv
        (GEN_REWRITE_CONV
          #'I
          (cl:cons
            (#`GSYM MOD_SUC_MOD)
            (cl:cons
              (#`GSYM MOD_ADD_MOD)
              (cl:cons (#`GSYM MOD_MULT_MOD2) (cl:cons (#`GSYM MOD_EXP_MOD) nil))))))
      (mod_conv (GEN_REWRITE_CONV #'I (cl:cons MOD_MOD_REFL nil))))
    (cl:declare (cl:ignorable MOD_SUC_MOD addmul_conv mod_conv))
    (let ((downconv nil) (upconv nil))
      (cl:declare (cl:ignorable downconv upconv))
      (setf
        downconv
        (lambdac (tm)
          (ORELSEC
            (ORELSEC (THENC addmul_conv (#`LAND_CONV downconv)) (THENC mod_conv downconv))
            (SUB_CONV downconv)
            tm))
        upconv
        (GEN_REWRITE_CONV
          DEPTH_CONV
          (cl:cons
            MOD_SUC_MOD
            (cl:cons
              MOD_ADD_MOD
              (cl:cons MOD_MULT_MOD2 (cl:cons MOD_EXP_MOD (cl:cons MOD_MOD_REFL nil)))))))
      (THENC downconv upconv))))

;; (* ------------------------------------------------------------------------- *)
;; (* Crude but useful conversion for cancelling down equations.                *)
;; (* ------------------------------------------------------------------------- *)


(defparameter NUM_CANCEL_CONV
  (labelsc
    ((minter (i% l1% l2% l1 l2)
      (if (= l1 nil)
        (tuple i% l1% (append l2% l2))
        (if (= l2 nil)
          (tuple i% (append l1 l1%) l2%)
          (let ((h1 (hd l1)) (h2 (hd l2)))
            (cl:declare (cl:ignorable h1 h2))
            (if (= h1 h2)
              (minter (cl:cons h1 i%) l1% l2% (tl l1) (tl l2))
              (if (< h1 h2)
                (minter i% (cl:cons h1 l1%) l2% (tl l1) l2)
                (minter i% l1% (cl:cons h2 l2%) l1 (tl l2)))))))))
    (let ((add_tm (parse_term "(+)")) (eq_tm (parse_term "(=) :num->num->bool")))
      (cl:declare (cl:ignorable add_tm eq_tm))
      (let*
        ((EQ_ADD_LCANCEL_0%
          (GEN_REWRITE_RULE
            (o (funpow 2 #'BINDER_CONV) LAND_CONV)
            (cl:cons EQ_SYM_EQ nil)
            EQ_ADD_LCANCEL_0))
          (AC_RULE (AC ADD_AC)))
        (cl:declare (cl:ignorable EQ_ADD_LCANCEL_0% AC_RULE))
        (lambdac (tm)
          (match (dest_eq tm)
            ((tuple l r%)
              (let
                ((lats (sort (function-value #'<= 2) (binops (parse_term "(+)") l)))
                  (rats (sort (function-value #'<= 2) (binops (parse_term "(+)") r%))))
                (cl:declare (cl:ignorable lats rats))
                (match (minter nil nil nil lats rats)
                  ((tuple i% lats% rats%)
                    (let
                      ((l% (list_mk_binop add_tm (append i% lats%)))
                        (r%% (list_mk_binop add_tm (append i% rats%))))
                      (cl:declare (cl:ignorable l% r%%))
                      (let
                        ((lth (#`AC_RULE (#`mk_eq (tuple l l%))))
                          (rth (#`AC_RULE (#`mk_eq (tuple r% r%%)))))
                        (cl:declare (cl:ignorable lth rth))
                        (let ((eth (MK_COMB% (tuple (AP_TERM eq_tm lth) rth))))
                          (cl:declare (cl:ignorable eth))
                          (GEN_REWRITE_RULE
                            (o #'RAND_CONV REPEATC)
                            (cl:cons
                              EQ_ADD_LCANCEL
                              (cl:cons EQ_ADD_LCANCEL_0 (cl:cons EQ_ADD_LCANCEL_0% nil)))
                            eth))))))))))))))

