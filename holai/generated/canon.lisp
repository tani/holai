;; (* ------------------------------------------------------------------------- *)
;; (* Depth conversion to apply at "atomic" formulas in "first-order" term.     *)
;; (* ------------------------------------------------------------------------- *)


(defunc PROP_ATOM_CONV (conv tm)
  (match tm
    ((Comb (cl:or (cl:or (Const "!" _) (Const "?" _)) (Const "?!" _)) (Abs _ _))
      (BINDER_CONV (PROP_ATOM_CONV conv) tm))
    ((Comb
      (Comb
        (cl:or
          (cl:or (cl:or (Const "/\\" _) (Const "\\/" _)) (Const "==>" _))
          (Const "=" (Tyapp "fun" (cl:cons (Tyapp "bool" nil) (cl:cons _ nil)))))
        _)
      _)
      (BINOP_CONV (PROP_ATOM_CONV conv) tm))
    ((Comb (Const "~" _) _) (RAND_CONV (PROP_ATOM_CONV conv) tm))
    (_ (TRY_CONV conv tm))))

