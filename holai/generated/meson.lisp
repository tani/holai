            (rules (#`optimize_rules (#`fol_of_hol_clauses ths%))))
          (cl:declare (cl:ignorable ths% rules))
          (match (solve_goal rules (deref meson_depth) min% max% inc (tuple 1 nil))
            ((tuple proof (tuple insts _ _))
