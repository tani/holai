    THEN (REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN% ASSUME_TAC)))
    THEN (RULE_ASSUM_TAC (CONV_RULE (ASSOC_CONV DISJ_ASSOC)))
    THEN (REPEAT (FIRST_X_ASSUM #'SUBST_VAR_TAC))
    THEN (PURE_MESON_TAC min% max% step)))

;; (* ------------------------------------------------------------------------- *)
;; (* Common cases.                                                             *)
;; (* ------------------------------------------------------------------------- *)


(defparameter ASM_MESON_TAC (GEN_MESON_TAC 0 50 1))

(defunc MESON_TAC (ths)
  (holai.runtime:proof (POP_ASSUM_LIST (K #'ALL_TAC)) THEN (#`ASM_MESON_TAC ths)))

;; (* ------------------------------------------------------------------------- *)
;; (* Also introduce a rule.                                                    *)
;; (* ------------------------------------------------------------------------- *)


(defunc MESON (ths tm)
  (let ((th (TAC_PROOF (tuple (tuple nil tm) (MESON_TAC ths)))))
    (cl:declare (cl:ignorable th))
    (match (dest_thm th)
      ((tuple asl tm%)
        (if (cl:and (<> asl nil) (not (subset asl (unions (map #'hyp ths)))))
          (failwith "MESON: too many assumptions in result")
          (if (= tm% tm)
            th
            (handler-case
              (EQ_MP (ALPHA tm% tm) th)
              (holai.runtime:ocaml-condition
                (exception~3929)
                (match exception~3929
                  ((Failure _) (failwith "MESON: the wrong result"))
                  (_ (raise exception~3929)))))))))))

