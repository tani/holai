              ((tuple (cl:and br (Branch p b l r)) (cl:and lf (Leaf k% lis)))
                (if (= (logand k% (- b 1)) p)
                  (if (= (logand k% b) 0)
                    (match (combine% op z l lf) ((Empty) r) (l% (make-Branch p b l% r)))
                    (match (combine% op z r lf) ((Empty) l) (r% (make-Branch p b l r%))))
