;; (* ------------------------------------------------------------------------- *)


(defunc warn (cond% s) (if cond% (report (string-concat "Warning: " s)) unit))

;; (* ------------------------------------------------------------------------- *)
;; (* Flags to switch on verbose mode.                                          *)
;; (* ------------------------------------------------------------------------- *)


(defparameter verbose (ref cl:t))

(defparameter report_timing (ref cl:t))

;; (* ------------------------------------------------------------------------- *)
;; (* Switchable version of "report".                                           *)
;; (* ------------------------------------------------------------------------- *)


(defunc remark (s) (if (deref verbose) (report s) unit))

;; (* ------------------------------------------------------------------------- *)
;; (* Time a function.                                                          *)
;; (* ------------------------------------------------------------------------- *)


(defunc time (f x)
  (if (not (deref report_timing))
    (funcall f x)
    (let ((start_time (cpu-time unit)))
      (cl:declare (cl:ignorable start_time))
      (handler-case
        (let* ((result (funcall f x)) (finish_time (cpu-time unit)))
          (cl:declare (cl:ignorable result finish_time))
          (progn
            (report
              (string-concat
                "CPU time (user): "
                (string-of-float (- finish_time start_time))))
            result))
        (holai.runtime:ocaml-condition
          (exception~1637)
          (match exception~1637
            (e
              (let* ((finish_time (cpu-time unit)) (msg (exception-string e)))
                (cl:declare (cl:ignorable finish_time msg))
                (progn
                  (report
                    (string-concat
                      "Failed after (user) CPU time of "
                      (string-concat
                        (string-of-float (- finish_time start_time))
                        (string-concat ": " msg))))
                  (raise e))))
            (_ (raise exception~1637))))))))

