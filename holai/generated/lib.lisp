        (cl:declare (cl:ignorable h% t%%))
        (if (cl:and (== h% h) (== t%% t%)) l (cl:cons h% t%%))))
    (_ l)))

;; (* ------------------------------------------------------------------------- *)
;; (* Merging and bottom-up mergesort.                                          *)
;; (* ------------------------------------------------------------------------- *)


(defunc merge (ord l1 l2)
  (match l1
    (nil l2)
    ((cl:cons h1 t1)
      (match l2
        (nil l1)
        ((cl:cons h2 t2)
          (if (funcall ord h1 h2)
            (cl:cons h1 (merge ord t1 l2))
            (cl:cons h2 (merge ord l1 t2))))))))

(defunc mergesort (ord)
  (labelsc
    ((mergepairs
      (l1 l2)
      (match (tuple l1 l2)
        ((tuple (cl:cons s nil) nil) s)
        ((tuple l nil) (mergepairs nil l))
        ((tuple l (cl:cons s1 nil)) (mergepairs (cl:cons s1 l) nil))
        ((tuple l (cl:cons s1 (cl:cons s2 ss)))
          (mergepairs (cl:cons (merge ord s1 s2) l) ss)))))
    (lambdac (l)
      (if (= l nil) nil (mergepairs nil (map (lambdac (x) (cl:cons x nil)) l))))))

