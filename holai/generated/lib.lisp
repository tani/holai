                    (if (= (logand p2 b1) 0)
                      (match (combine% op z l1 t2)
                        ((Empty) r1)
                        (l (make-Branch p1 b1 l r1)))
                      (match (combine% op z r1 t2)
                        ((Empty) l1)
                        (r (make-Branch p1 b1 l1 r)))))
                  (if (< b2 b1)
