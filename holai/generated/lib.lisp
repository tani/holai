              (nil (cl:cons xy nil))))))
        (combine_list
          (op z l1 l2)
          (match (tuple l1 l2)
            ((tuple nil _) l2)
            ((tuple _ nil) l1)
            ((tuple
              (cl:cons (cl:and xy1 (tuple x1 y1)) t1)
              (cl:cons (cl:and xy2 (tuple x2 y2)) t2))
              (let ((c% (compare x1 x2)))
                (cl:declare (cl:ignorable c%))
                (if (< c% 0)
                  (cl:cons xy1 (combine_list op z t1 l2))
                  (if (> c% 0)
