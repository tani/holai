;; (* ------------------------------------------------------------------------- *)
;; (* Additional commutativity properties of the inclusion map.                 *)
;; (* ------------------------------------------------------------------------- *)


(defparameter REAL_OF_NUM_LT
  (prove
    (tuple
      (parse_term "!m n. &m < &n <=> m < n")
      (REWRITE_TAC
        (cl:cons real_lt (cl:cons (#`GSYM NOT_LE) (cl:cons REAL_OF_NUM_LE nil)))))))

(defparameter REAL_OF_NUM_GE
  (prove
    (tuple
      (parse_term "!m n. &m >= &n <=> m >= n")
      (REWRITE_TAC (cl:cons GE (cl:cons real_ge (cl:cons REAL_OF_NUM_LE nil)))))))

(defparameter REAL_OF_NUM_GT
  (prove
    (tuple
      (parse_term "!m n. &m > &n <=> m > n")
      (REWRITE_TAC (cl:cons GT (cl:cons real_gt (cl:cons REAL_OF_NUM_LT nil)))))))

(defparameter REAL_OF_NUM_MAX
  (prove
    (tuple
      (parse_term "!m n. max (&m) (&n) = &(MAX m n)")
      (REWRITE_TAC
        (cl:cons
          REAL_OF_NUM_LE
          (cl:cons MAX (cl:cons real_max (cl:cons (#`GSYM COND_RAND) nil))))))))

(defparameter REAL_OF_NUM_MIN
  (prove
    (tuple
      (parse_term "!m n. min (&m) (&n) = &(MIN m n)")
      (REWRITE_TAC
        (cl:cons
          REAL_OF_NUM_LE
          (cl:cons MIN (cl:cons real_min (cl:cons (#`GSYM COND_RAND) nil))))))))

(defparameter REAL_OF_NUM_SUC
  (prove
    (tuple
      (parse_term "!n. &n + &1 = &(SUC n)")
      (REWRITE_TAC (cl:cons ADD1 (cl:cons REAL_OF_NUM_ADD nil))))))

(defparameter REAL_OF_NUM_SUB
  (prove
    (tuple
      (parse_term "!m n. m <= n ==> (&n - &m = &(n - m))")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN (REWRITE_TAC (cl:cons LE_EXISTS nil))
        THEN #'STRIP_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons ADD_SUB2 nil))
        THEN (REWRITE_TAC (cl:cons (#`GSYM REAL_OF_NUM_ADD) nil))
        THEN (ONCE_REWRITE_TAC (cl:cons REAL_ADD_SYM nil))
        THEN (REWRITE_TAC (cl:cons real_sub (cl:cons (#`GSYM REAL_ADD_ASSOC) nil)))
        THEN
          (MESON_TAC
            (cl:cons REAL_ADD_LINV (cl:cons REAL_ADD_SYM (cl:cons REAL_ADD_LID nil))))))))

(defparameter REAL_OF_NUM_SUB_CASES
  (prove
    (tuple
      (parse_term "!m n. &m - &n = if n <= m then &(m - n) else -- &(n - m)")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN COND_CASES_TAC
        THEN (#`ASM_SIMP_TAC (cl:cons REAL_OF_NUM_SUB nil))
        THEN (GEN_REWRITE_TAC LAND_CONV (cl:cons (#`GSYM REAL_NEG_SUB) nil))
        THEN AP_TERM_TAC
        THEN (MATCH_MP_TAC REAL_OF_NUM_SUB)
        THEN (#`ASM_MESON_TAC (cl:cons LE_CASES nil))))))

(defparameter REAL_OF_NUM_CLAUSES
  (prove
    (tuple
      (parse_term
        "(!m n. &m:real = &n <=> m = n) /\\
   (!m n. &m:real >= &n <=> m >= n) /\\
   (!m n. &m:real > &n <=> m > n) /\\
   (!m n. &m:real <= &n <=> m <= n) /\\
   (!m n. &m:real < &n <=> m < n) /\\
   (!m n. max (&m) (&n):real = &(MAX m n)) /\\
   (!m n. min (&m) (&n):real = &(MIN m n)) /\\
   (!m n. &m + &n:real = &(m + n)) /\\
   (!m n. &m * &n:real = &(m * n)) /\\
   (!x n. (&x:real) pow n = &(x EXP n))")
      (REWRITE_TAC
        (cl:cons
          REAL_OF_NUM_EQ
          (cl:cons
            REAL_OF_NUM_GE
            (cl:cons
              REAL_OF_NUM_GT
              (cl:cons
                REAL_OF_NUM_LE
                (cl:cons
                  REAL_OF_NUM_LT
                  (cl:cons
                    REAL_OF_NUM_MAX
                    (cl:cons
                      REAL_OF_NUM_MIN
                      (cl:cons
                        REAL_OF_NUM_ADD
                        (cl:cons REAL_OF_NUM_MUL (cl:cons REAL_OF_NUM_POW nil))))))))))))))

