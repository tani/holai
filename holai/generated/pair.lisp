;; (* ------------------------------------------------------------------------- *)
;; (* Analog of ABS_CONV for generalized abstraction.                           *)
;; (* ------------------------------------------------------------------------- *)


(defunc GABS_CONV (conv tm)
  (if (is_abs tm)
    (ABS_CONV conv tm)
    (match (dest_comb tm)
      ((tuple gabs bod)
        (match (dest_abs bod)
          ((tuple f qtm)
            (match (#`strip_forall qtm)
              ((tuple xs bod%)
                (AP_TERM gabs (ABS% f (itlist MK_FORALL xs (RAND_CONV conv bod%))))))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* General beta-conversion over linear pattern of nested constructors.       *)
;; (* ------------------------------------------------------------------------- *)


(defparameter GEN_BETA_CONV
  (let ((projection_cache (ref nil)))
    (cl:declare (cl:ignorable projection_cache))
    (labelsc
      ((create_projections (conname)
        (handler-case
          (assoc conname (deref projection_cache))
          (holai.runtime:ocaml-condition
            (exception~705)
            (match exception~705
              ((Failure _)
                (let*
                  ((genty (get_const_type conname))
                    (conty
                      (holai.runtime:fst
                        (dest_type
                          (holai.lib:repeat
                            (o (function-value #'holai.runtime:snd 1) #'dest_fun_ty)
                            genty)))))
                  (cl:declare (cl:ignorable genty conty))
                  (match (assoc conty (deref inductive_type_store))
                    ((tuple _ _ rth)
                      (let ((sth (SPEC_ALL rth)))
                        (cl:declare (cl:ignorable sth))
                        (match (#`strip_exists (concl sth))
                          ((tuple evs bod)
                            (let*
                              ((cjs (#`conjuncts bod))
                                (ourcj
                                  (find
                                    (o
                                      (o
                                        (o
                                          (o
                                            (o
                                              (o
                                                (o
                                                  (o
                                                    (partial
                                                      (function-value #'= 2)
                                                      conname)
                                                    (function-value #'holai.runtime:fst 1))
                                                  #'dest_const)
                                                (function-value #'holai.runtime:fst 1))
                                              strip_comb)
                                            #'rand)
                                          lhand)
                                        (function-value #'holai.runtime:snd 1))
                                      strip_forall)
                                    cjs))
                                (n (index ourcj cjs)))
                              (cl:declare (cl:ignorable cjs ourcj n))
                              (match (#`strip_forall ourcj)
                                ((tuple avs eqn)
                                  (match (#`strip_comb (rand eqn))
                                    ((tuple con% args)
                                      (match (chop_list (#`length avs) args)
                                        ((tuple aargs zargs)
                                          (let*
                                            ((gargs (map (o genvar #'type_of) zargs))
                                              (gcon
                                                (#`genvar
                                                  (itlist
                                                    (o #'mk_fun_ty #'type_of)
                                                    avs
                                                    (type_of (rand eqn)))))
                                              (bth
                                                (INST%
                                                  (cl:cons
                                                    (tuple
                                                      (list_mk_abs
                                                        (tuple
                                                          (append aargs gargs)
                                                          (list_mk_comb (tuple gcon avs))))
                                                      con%)
                                                    nil)
                                                  sth))
                                              (cth
                                                (el
                                                  n
                                                  (#`holai.bool:CONJUNCTS
                                                    (ASSUME
                                                      (holai.runtime:snd
                                                        (#`strip_exists (concl bth)))))))
                                              (dth
                                                (CONV_RULE
                                                  (funpow
                                                    (#`length avs)
                                                    #'BINDER_CONV
                                                    (RAND_CONV #'BETAS_CONV))
                                                  cth))
                                              (eth
                                                (SIMPLE_EXISTS
                                                  (rator
                                                    (#`lhand
                                                      (holai.runtime:snd
                                                        (#`strip_forall (concl dth)))))
                                                  dth))
                                              (fth
                                                (PROVE_HYP
                                                  bth
                                                  (itlist #'SIMPLE_CHOOSE evs eth)))
                                              (zty
                                                (type_of
                                                  (rand
                                                    (holai.runtime:snd
                                                      (#`strip_forall (concl dth)))))))
                                            (cl:declare
                                              (cl:ignorable
                                                gargs
                                                gcon
                                                bth
                                                cth
                                                dth
                                                eth
                                                fth
                                                zty))
                                            (labelsc
                                              ((mk_projector (a%)
                                                (let*
                                                  ((ity (type_of a%))
                                                    (th
                                                      (#`BETA_RULE
                                                        (PINST
                                                          (cl:cons (tuple ity zty) nil)
                                                          (cl:cons
                                                            (tuple
                                                              (list_mk_abs (tuple avs a%))
                                                              gcon)
                                                            nil)
                                                          fth))))
                                                  (cl:declare (cl:ignorable ity th))
                                                  (SYM (SPEC_ALL (#`SELECT_RULE th))))))
                                              (let ((ths (map #'mk_projector avs)))
                                                (cl:declare (cl:ignorable ths))
                                                (progn
                                                  (assign
                                                    projection_cache
                                                    (cl:cons
                                                      (tuple conname ths)
                                                      (deref projection_cache)))
                                                  ths))))))))))))))))))
              (_ (raise exception~705)))))))
      (let
        ((GEQ_CONV (#`REWR_CONV (#`GSYM GEQ_DEF)))
          (DEGEQ_RULE (CONV_RULE (#`REWR_CONV GEQ_DEF))))
        (cl:declare (cl:ignorable GEQ_CONV DEGEQ_RULE))
        (let
          ((GABS_RULE
            (let
              ((pth
                (prove
                  (tuple
                    (parse_term "(?) P ==> P (GABS P)")
                    (SIMP_TAC (cl:cons GABS_DEF (cl:cons SELECT_AX (cl:cons ETA_AX nil))))))))
              (cl:declare (cl:ignorable pth))
              (MATCH_MP pth))))
          (cl:declare (cl:ignorable GABS_RULE))
          (labelsc
            ((create_iterated_projections (tm)
              (if (= (frees tm) nil)
                nil
                (if (is_var tm)
                  (cl:cons (REFL tm) nil)
                  (match (#`strip_comb tm)
                    ((tuple con args)
                      (let*
                        ((prjths
                          (create_projections (holai.runtime:fst (dest_const con))))
                          (atm (rand (rand (concl (hd prjths)))))
                          (instn (#`term_match nil atm tm))
                          (arths (map (#`INSTANTIATE% instn) prjths))
                          (ths
                            (map
                              (lambdac (arth)
                                (let
                                  ((sths
                                    (create_iterated_projections (#`lhand (concl arth)))))
                                  (cl:declare (cl:ignorable sths))
                                  (map
                                    (CONV_RULE (RAND_CONV (SUBS_CONV (cl:cons arth nil))))
                                    sths)))
                              arths)))
                        (cl:declare (cl:ignorable prjths atm instn arths ths))
                        (unions% #'equals_thm ths)))))))
              (GEN_BETA_CONV% (tm)
                (handler-case
                  (BETA_CONV tm)
                  (holai.runtime:ocaml-condition
                    (exception~1030)
                    (match exception~1030
                      ((Failure _)
                        (match (dest_comb tm)
                          ((tuple l r%)
                            (match (#`dest_gabs l)
                              ((tuple vstr bod)
                                (let*
                                  ((instn (#`term_match nil vstr r%))
                                    (prjs (create_iterated_projections vstr))
                                    (th1 (SUBS_CONV prjs bod))
                                    (bod% (rand (concl th1)))
                                    (gv (#`genvar (type_of vstr)))
                                    (pat
                                      (mk_abs
                                        (tuple
                                          gv
                                          (#`subst (cl:cons (tuple gv vstr) nil) bod%))))
                                    (th2
                                      (TRANS
                                        (BETA_CONV (mk_comb (tuple pat vstr)))
                                        (SYM th1)))
                                    (avs
                                      (holai.runtime:fst (#`strip_forall (body (rand l)))))
                                    (th3
                                      (#`GENL
                                        (holai.runtime:fst
                                          (#`strip_forall (body (rand l))))
                                        th2))
                                    (efn (#`genvar (type_of pat)))
                                    (th4
                                      (#`EXISTS
                                        (tuple
                                          (#`mk_exists
                                            (tuple
                                              efn
                                              (#`subst
                                                (cl:cons (tuple efn pat) nil)
                                                (concl th3))))
                                          pat)
                                        th3))
                                    (th5
                                      (CONV_RULE
                                        (funpow
                                          (+ (#`length avs) 1)
                                          #'BINDER_CONV
                                          GEQ_CONV)
                                        th4))
                                    (th6 (CONV_RULE #'BETA_CONV (#`GABS_RULE th5))))
                                  (cl:declare
                                    (cl:ignorable
                                      instn
                                      prjs
                                      th1
                                      bod%
                                      gv
                                      pat
                                      th2
                                      avs
                                      th3
                                      efn
                                      th4
                                      th5
                                      th6))
                                  (#`INSTANTIATE% instn (#`DEGEQ_RULE (SPEC_ALL th6)))))))))
                      (_ (raise exception~1030)))))))
            #'GEN_BETA_CONV%))))))

