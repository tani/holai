                                  (cl:declare
                                    (cl:ignorable th1 slist th2 xreps threps th3 th4))
                                  (progn
                                    (assign
                                      the_definitions
                                      (cl:cons th4 (deref the_definitions)))
                                    th4))))))))))
                (_ (raise exception~495))))))))))

