;; (* ------------------------------------------------------------------------- *)
;; (* More stuff about equality.                                                *)
;; (* ------------------------------------------------------------------------- *)


(defparameter EQ_REFL
  (prove
    (tuple (parse_term "!x:A. x = x") (holai.runtime:proof #'GEN_TAC THEN #'REFL_TAC))))

(defparameter REFL_CLAUSE
  (prove
    (tuple
      (parse_term "!x:A. (x = x) <=> T")
      (holai.runtime:proof #'GEN_TAC
        THEN (funcall MATCH_ACCEPT_TAC (funcall EQT_INTRO (SPEC_ALL EQ_REFL)))))))

(defparameter EQ_SYM
  (prove
    (tuple
      (parse_term "!(x:A) y. (x = y) ==> (y = x)")
      (holai.runtime:proof (REPEAT #'GEN_TAC) THEN (DISCH_THEN (o ACCEPT_TAC #'SYM))))))

(defparameter EQ_SYM_EQ
  (prove
    (tuple
      (parse_term "!(x:A) y. (x = y) <=> (y = x)")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THEN (funcall MATCH_ACCEPT_TAC EQ_SYM)))))

(defparameter EQ_TRANS
  (prove
    (tuple
      (parse_term "!(x:A) y z. (x = y) /\\ (y = z) ==> (x = z)")
      (holai.runtime:proof (REPEAT #'STRIP_TAC)
        THEN (funcall PURE_ASM_REWRITE_TAC nil)
        THEN #'REFL_TAC))))

;; (* ------------------------------------------------------------------------- *)
;; (* The following is a common special case of ordered rewriting.              *)
;; (* ------------------------------------------------------------------------- *)


(defunc AC (acsuite)
  (o #'EQT_ELIM (PURE_REWRITE_CONV (cl:cons acsuite (cl:cons REFL_CLAUSE nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* A couple of theorems about beta reduction.                                *)
;; (* ------------------------------------------------------------------------- *)


(defparameter BETA_THM
  (prove
    (tuple
      (parse_term "!(f:A->B) y. (\\x. (f:A->B) x) y = f y")
      (holai.runtime:proof (REPEAT #'GEN_TAC) THEN BETA_TAC THEN #'REFL_TAC))))

(defparameter ABS_SIMP
  (prove
    (tuple
      (parse_term "!(t1:A) (t2:B). (\\x. t1) t2 = t1")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN (REWRITE_TAC (cl:cons BETA_THM (cl:cons REFL_CLAUSE nil)))))))

;; (* ------------------------------------------------------------------------- *)
;; (* A few "big name" intuitionistic tautologies.                              *)
;; (* ------------------------------------------------------------------------- *)


(defparameter CONJ_ASSOC
  (prove
    (tuple (parse_term "!t1 t2 t3. t1 /\\ t2 /\\ t3 <=> (t1 /\\ t2) /\\ t3") ITAUT_TAC)))

(defparameter CONJ_SYM
  (prove (tuple (parse_term "!t1 t2. t1 /\\ t2 <=> t2 /\\ t1") ITAUT_TAC)))

(defparameter CONJ_ACI
  (prove
    (tuple
      (parse_term
        "(p /\\ q <=> q /\\ p) /\\
   ((p /\\ q) /\\ r <=> p /\\ (q /\\ r)) /\\
   (p /\\ (q /\\ r) <=> q /\\ (p /\\ r)) /\\
   (p /\\ p <=> p) /\\
   (p /\\ (p /\\ q) <=> p /\\ q)")
      ITAUT_TAC)))

(defparameter DISJ_ASSOC
  (prove
    (tuple (parse_term "!t1 t2 t3. t1 \\/ t2 \\/ t3 <=> (t1 \\/ t2) \\/ t3") ITAUT_TAC)))

(defparameter DISJ_SYM
  (prove (tuple (parse_term "!t1 t2. t1 \\/ t2 <=> t2 \\/ t1") ITAUT_TAC)))

(defparameter DISJ_ACI
  (prove
    (tuple
      (parse_term
        "(p \\/ q <=> q \\/ p) /\\
   ((p \\/ q) \\/ r <=> p \\/ (q \\/ r)) /\\
   (p \\/ (q \\/ r) <=> q \\/ (p \\/ r)) /\\
   (p \\/ p <=> p) /\\
   (p \\/ (p \\/ q) <=> p \\/ q)")
      ITAUT_TAC)))

(defparameter IMP_CONJ
  (prove (tuple (parse_term "p /\\ q ==> r <=> p ==> q ==> r") ITAUT_TAC)))

(defparameter IMP_IMP (funcall GSYM IMP_CONJ))

(defparameter IMP_CONJ_ALT
  (prove (tuple (parse_term "p /\\ q ==> r <=> q ==> p ==> r") ITAUT_TAC)))

;; (* ------------------------------------------------------------------------- *)
;; (* A couple of "distribution" tautologies are useful.                        *)
;; (* ------------------------------------------------------------------------- *)


(defparameter LEFT_OR_DISTRIB
  (prove (tuple (parse_term "!p q r. p /\\ (q \\/ r) <=> p /\\ q \\/ p /\\ r") ITAUT_TAC)))

(defparameter RIGHT_OR_DISTRIB
  (prove (tuple (parse_term "!p q r. (p \\/ q) /\\ r <=> p /\\ r \\/ q /\\ r") ITAUT_TAC)))

;; (* ------------------------------------------------------------------------- *)
;; (* Degenerate cases of quantifiers.                                          *)
;; (* ------------------------------------------------------------------------- *)


(defparameter FORALL_SIMP (prove (tuple (parse_term "!t. (!x:A. t) = t") ITAUT_TAC)))

(defparameter EXISTS_SIMP (prove (tuple (parse_term "!t. (?x:A. t) = t") ITAUT_TAC)))

;; (* ------------------------------------------------------------------------- *)
;; (* I also use this a lot (as a prelude to congruence reasoning).             *)
;; (* ------------------------------------------------------------------------- *)


(defparameter EQ_IMP (ITAUT (parse_term "(a <=> b) ==> a ==> b")))

;; (* ------------------------------------------------------------------------- *)
;; (* Start building up the basic rewrites; we add a few more later.            *)
;; (* ------------------------------------------------------------------------- *)


(defparameter EQ_CLAUSES
  (prove
    (tuple
      (parse_term
        "!t. ((T <=> t) <=> t) /\\ ((t <=> T) <=> t) /\\
       ((F <=> t) <=> ~t) /\\ ((t <=> F) <=> ~t)")
      ITAUT_TAC)))

(defparameter NOT_CLAUSES_WEAK
  (prove (tuple (parse_term "(~T <=> F) /\\ (~F <=> T)") ITAUT_TAC)))

(defparameter AND_CLAUSES
  (prove
    (tuple
      (parse_term
        "!t. (T /\\ t <=> t) /\\ (t /\\ T <=> t) /\\ (F /\\ t <=> F) /\\
       (t /\\ F <=> F) /\\ (t /\\ t <=> t)")
      ITAUT_TAC)))

(defparameter OR_CLAUSES
  (prove
    (tuple
      (parse_term
        "!t. (T \\/ t <=> T) /\\ (t \\/ T <=> T) /\\ (F \\/ t <=> t) /\\
       (t \\/ F <=> t) /\\ (t \\/ t <=> t)")
      ITAUT_TAC)))

(defparameter IMP_CLAUSES
  (prove
    (tuple
      (parse_term
        "!t. (T ==> t <=> t) /\\ (t ==> T <=> T) /\\ (F ==> t <=> T) /\\
       (t ==> t <=> T) /\\ (t ==> F <=> ~t)")
      ITAUT_TAC)))

(funcall
  extend_basic_rewrites
  (cl:cons
    REFL_CLAUSE
    (cl:cons
      EQ_CLAUSES
      (cl:cons
        NOT_CLAUSES_WEAK
        (cl:cons
          AND_CLAUSES
          (cl:cons
            OR_CLAUSES
            (cl:cons
              IMP_CLAUSES
              (cl:cons
                FORALL_SIMP
                (cl:cons
                  EXISTS_SIMP
                  (cl:cons
                    BETA_THM
                    (cl:cons
                      (let
                        ((IMP_EQ_CLAUSE
                          (prove
                            (tuple
                              (parse_term "((x = x) ==> p) <=> p")
                              (REWRITE_TAC
                                (cl:cons
                                  (funcall EQT_INTRO (SPEC_ALL EQ_REFL))
                                  (cl:cons IMP_CLAUSES nil)))))))
                        (cl:declare (cl:ignorable IMP_EQ_CLAUSE))
                        IMP_EQ_CLAUSE)
                      nil)))))))))))

(funcall
  extend_basic_congs
  (cl:cons
    (ITAUT (parse_term "(p <=> p') ==> (p' ==> (q <=> q')) ==> (p ==> q <=> p' ==> q')"))
    nil))

;; (* ------------------------------------------------------------------------- *)
;; (* Rewrite rule for unique existence.                                        *)
;; (* ------------------------------------------------------------------------- *)


(defparameter EXISTS_UNIQUE_THM
  (prove
    (tuple
      (parse_term "!P. (?!x:A. P x) <=> (?x. P x) /\\ (!x x'. P x /\\ P x' ==> (x = x'))")
      (holai.runtime:proof #'GEN_TAC THEN (REWRITE_TAC (cl:cons EXISTS_UNIQUE_DEF nil))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Trivial instances of existence.                                           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter EXISTS_REFL
  (prove
    (tuple
      (parse_term "!a:A. ?x. x = a")
      (holai.runtime:proof #'GEN_TAC
        THEN (funcall EXISTS_TAC (parse_term "a:A"))
        THEN #'REFL_TAC))))

(defparameter EXISTS_UNIQUE_REFL
  (prove
    (tuple
      (parse_term "!a:A. ?!x. x = a")
      (holai.runtime:proof #'GEN_TAC
        THEN (REWRITE_TAC (cl:cons EXISTS_UNIQUE_THM nil))
        THEN (REPEAT (holai.runtime:proof #'EQ_TAC #'ORELSE #'STRIP_TAC))
        THENL
          (cl:cons
            (funcall EXISTS_TAC (parse_term "a:A"))
            (cl:cons (funcall ASM_REWRITE_TAC nil) nil))
        THEN #'REFL_TAC))))

;; (* ------------------------------------------------------------------------- *)
;; (* Unwinding.                                                                *)
;; (* ------------------------------------------------------------------------- *)


(defparameter UNWIND_THM1
  (prove
    (tuple
      (parse_term "!P (a:A). (?x. a = x /\\ P x) <=> P a")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THENL
          (cl:cons
            (DISCH_THEN (CHOOSE_THEN (CONJUNCTS_THEN2 #'SUBST1_TAC ACCEPT_TAC)))
            (cl:cons
              (holai.runtime:proof DISCH_TAC
                THEN (funcall EXISTS_TAC (parse_term "a:A"))
                THEN #'CONJ_TAC
                THEN (TRY (FIRST_ASSUM MATCH_ACCEPT_TAC))
                THEN #'REFL_TAC)
              nil))))))

(defparameter UNWIND_THM2
  (prove
    (tuple
      (parse_term "!P (a:A). (?x. x = a /\\ P x) <=> P a")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN (funcall CONV_TAC (funcall LAND_CONV (funcall ONCE_DEPTH_CONV #'SYM_CONV)))
        THEN (funcall MATCH_ACCEPT_TAC UNWIND_THM1)))))

(defparameter FORALL_UNWIND_THM2
  (prove
    (tuple
      (parse_term "!P (a:A). (!x. x = a ==> P x) <=> P a")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THENL
          (cl:cons
            (holai.runtime:proof (DISCH_THEN
                (o #'MP_TAC (funcall SPEC (parse_term "a:A"))))
              THEN (REWRITE_TAC nil))
            (cl:cons
              (holai.runtime:proof DISCH_TAC
                THEN #'GEN_TAC
                THEN (DISCH_THEN #'SUBST1_TAC)
                THEN (funcall ASM_REWRITE_TAC nil))
              nil))))))

(defparameter FORALL_UNWIND_THM1
  (prove
    (tuple
      (parse_term "!P (a:A). (!x. a = x ==> P x) <=> P a")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN (funcall CONV_TAC (funcall LAND_CONV (funcall ONCE_DEPTH_CONV #'SYM_CONV)))
        THEN (funcall MATCH_ACCEPT_TAC FORALL_UNWIND_THM2)))))

