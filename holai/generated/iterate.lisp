      (holai.runtime:proof (REWRITE_TAC
          (cl:cons
            IN_SUPPORT
            (cl:cons EXTENSION (cl:cons IN_ELIM_THM (cl:cons NOT_IN_EMPTY nil)))))
        THEN (MESON_TAC nil)))))

