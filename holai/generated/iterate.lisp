(defparameter neutral
  (funcall
    new_definition
    (parse_term "neutral op = @x:A. !y. (op x y = y) /\\ (op y x = y)")))

(defparameter monoidal
  (funcall
    new_definition
    (parse_term
      "monoidal op <=> (!x y. op x y = op y x) /\\
                   (!x y z. op x (op y z) = op (op x y) z) /\\
                   (!x:A. op (neutral op) x = x)")))

(defparameter MONOIDAL_AC
  (prove
    (tuple
      (parse_term
        "!op. monoidal op
        ==> (!a:A. op (neutral op) a = a) /\\
            (!a. op a (neutral op) = a) /\\
            (!a b. op a b = op b a) /\\
            (!a b c. op (op a b) c = op a (op b c)) /\\
            (!a b c. op a (op b c) = op b (op a c))")
      (holai.runtime:proof (REWRITE_TAC (cl:cons monoidal nil)) THEN (MESON_TAC nil)))))

(defparameter support
  (funcall
    new_definition
    (parse_term "support op (f:A->B) s = {x | x IN s /\\ ~(f x = neutral op)}")))

(defparameter iterate
  (funcall
    new_definition
    (parse_term
      "iterate op s (f:A->B) =
        if FINITE(support op f s)
        then ITSET (\\x a. op (f x) a) (support op f s) (neutral op)
        else neutral op")))

(defparameter IN_SUPPORT
