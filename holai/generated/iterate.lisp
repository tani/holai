(defparameter EXPAND_SUM_CONV
  (match
    (tuple
      (o
        CONJUNCTS
        #'prove
        (tuple
          (parse_term
            "(n < m ==> sum(m..n) f = &0) /\\
     sum(m..m) f = f m /\\
     (m <= n ==> sum (m..n) f = f m + sum (m + 1..n) f)")
          (REWRITE_TAC
            (cl:cons
              SUM_CLAUSES_LEFT
              (cl:cons SUM_SING_NUMSEG (cl:cons SUM_TRIV_NUMSEG nil))))))
      (parse_term "..")
      (parse_term "f:num->real")
      (parse_term "m:num")
      (parse_term "n:num"))
    ((tuple (cl:cons pth_0 (cl:cons pth_1 (cl:cons pth_2 nil))) ns_tm f_tm m_tm n_tm)
      (labelsc
        ((conv
          (tm)
          (match (dest_comb tm)
            ((tuple smn ftm)
              (match (dest_comb smn)
                ((tuple s mn)
                  (if (not (cl:and (is_const s) (= (fst (dest_const s)) "sum")))
                    (failwith "EXPAND_SUM_CONV")
                    (match (dest_binop ns_tm mn)
                      ((tuple mtm ntm)
                        (let
                          ((m (funcall dest_numeral mtm)) (n (funcall dest_numeral ntm)))
                          (cl:declare (cl:ignorable m n))
                          (if (< n m)
                            (let
                              ((th1
                                (INST%
                                  (cl:cons
                                    (tuple ftm f_tm)
                                    (cl:cons
                                      (tuple mtm m_tm)
                                      (cl:cons (tuple ntm n_tm) nil)))
                                  pth_0)))
                              (cl:declare (cl:ignorable th1))
                              (funcall
                                MP
                                th1
                                (EQT_ELIM
                                  (funcall NUM_LT_CONV (funcall lhand (concl th1))))))
                            (if (= n m)
                              (CONV_RULE
                                (RAND_CONV (TRY_CONV #'BETA_CONV))
                                (INST%
                                  (cl:cons
                                    (tuple ftm f_tm)
                                    (cl:cons (tuple mtm m_tm) nil))
                                  pth_1))
                              (let*
                                ((th1
                                  (INST%
                                    (cl:cons
                                      (tuple ftm f_tm)
                                      (cl:cons
                                        (tuple mtm m_tm)
                                        (cl:cons (tuple ntm n_tm) nil)))
                                    pth_2))
                                  (th2
                                    (funcall
                                      MP
                                      th1
                                      (EQT_ELIM
                                        (funcall NUM_LE_CONV (funcall lhand (concl th1)))))))
                                (cl:declare (cl:ignorable th1 th2))
                                (CONV_RULE
                                  (RAND_CONV
                                    (COMB2_CONV
                                      (RAND_CONV (TRY_CONV #'BETA_CONV))
                                      (THENC
                                        (funcall
                                          LAND_CONV
                                          (funcall LAND_CONV NUM_ADD_CONV))
                                        #'conv)))
                                  th2))))))))))))))
        #'conv))))

