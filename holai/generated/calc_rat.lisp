;; (* ------------------------------------------------------------------------- *)
;; (* Extend normalizer to handle "inv" and division by rational constants, and *)
;; (* normalize inside nested "max", "min" and "abs" terms.                     *)
;; (* ------------------------------------------------------------------------- *)


(defparameter REAL_POLY_CONV
  (let
    ((neg_tm (parse_term "(--):real->real"))
      (inv_tm (parse_term "inv:real->real"))
      (add_tm (parse_term "(+):real->real->real"))
      (sub_tm (parse_term "(-):real->real->real"))
      (mul_tm (parse_term "(*):real->real->real"))
      (div_tm (parse_term "(/):real->real->real"))
      (pow_tm (parse_term "(pow):real->num->real"))
      (abs_tm (parse_term "abs:real->real"))
      (max_tm (parse_term "max:real->real->real"))
      (min_tm (parse_term "min:real->real->real"))
      (div_conv (#`REWR_CONV real_div)))
    (cl:declare
      (cl:ignorable
        neg_tm
        inv_tm
        add_tm
        sub_tm
        mul_tm
        div_tm
        pow_tm
        abs_tm
        max_tm
        min_tm
        div_conv))
    (labelsc
      ((REAL_POLY_CONV% (tm)
        (if (cl:or (not (is_comb tm)) (is_ratconst tm))
          (REFL tm)
          (match (dest_comb tm)
            ((tuple lop r%)
              (if (= lop neg_tm)
                (let ((th1 (AP_TERM lop (REAL_POLY_CONV% r%))))
                  (cl:declare (cl:ignorable th1))
                  (TRANS th1 (#`REAL_POLY_NEG_CONV (rand (concl th1)))))
                (if (= lop inv_tm)
                  (let ((th1 (AP_TERM lop (REAL_POLY_CONV% r%))))
                    (cl:declare (cl:ignorable th1))
                    (TRANS th1 (TRY_CONV REAL_RAT_INV_CONV (rand (concl th1)))))
                  (if (= lop abs_tm)
                    (AP_TERM lop (REAL_POLY_CONV% r%))
                    (if (not (is_comb lop))
                      (REFL tm)
                      (match (dest_comb lop)
                        ((tuple op l)
                          (if (= op pow_tm)
                            (let ((th1 (AP_THM (AP_TERM op (REAL_POLY_CONV% l)) r%)))
                              (cl:declare (cl:ignorable th1))
                              (TRANS th1 (TRY_CONV REAL_POLY_POW_CONV (rand (concl th1)))))
                            (if (cl:or (= op add_tm) (cl:or (= op mul_tm) (= op sub_tm)))
                              (let*
                                ((th1
                                  (MK_COMB%
                                    (tuple
                                      (AP_TERM op (REAL_POLY_CONV% l))
                                      (REAL_POLY_CONV% r%))))
                                  (fn
                                    (if (= op add_tm)
                                      REAL_POLY_ADD_CONV
                                      (if (= op mul_tm)
                                        REAL_POLY_MUL_CONV
                                        REAL_POLY_SUB_CONV))))
                                (cl:declare (cl:ignorable th1 fn))
                                (TRANS th1 (#`fn (rand (concl th1)))))
                              (if (= op div_tm)
                                (let ((th1 (#`div_conv tm)))
                                  (cl:declare (cl:ignorable th1))
                                  (TRANS th1 (REAL_POLY_CONV% (rand (concl th1)))))
                                (if (cl:or (= op min_tm) (= op max_tm))
                                  (MK_COMB%
                                    (tuple
                                      (AP_TERM op (REAL_POLY_CONV% l))
                                      (REAL_POLY_CONV% r%)))
                                  (REFL tm))))))))))))))))
      #'REAL_POLY_CONV%)))

