;; (* ------------------------------------------------------------------------- *)
;; (* Constant for decimal fractions written #xxx.yyy                           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter DECIMAL (#`new_definition (parse_term "DECIMAL x y = &x / &y")))

;; (* ------------------------------------------------------------------------- *)
;; (* Various handy lemmas.                                                     *)
;; (* ------------------------------------------------------------------------- *)


(defparameter RAT_LEMMA1
  (prove
    (tuple
      (parse_term
        "~(y1 = &0) /\\ ~(y2 = &0) ==>
      ((x1 / y1) + (x2 / y2) = (x1 * y2 + x2 * y1) * inv(y1) * inv(y2))")
      (proof #'STRIP_TAC
        THEN (REWRITE_TAC (cl:cons real_div (cl:cons REAL_ADD_RDISTRIB nil)))
        THEN BINOP_TAC
        THENL
          (cl:cons
            (proof (REWRITE_TAC (cl:cons (#`GSYM REAL_MUL_ASSOC) nil))
              THEN AP_TERM_TAC
              THEN
                (ONCE_REWRITE_TAC
                  (cl:cons (AC REAL_MUL_AC (parse_term "a * b * c = (b * a) * c")) nil)))
            (cl:cons
              (proof (REWRITE_TAC (cl:cons REAL_MUL_ASSOC nil))
                THEN AP_THM_TAC
                THEN AP_TERM_TAC)
              nil))
