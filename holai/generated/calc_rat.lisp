                (let*
                  ((th1 (#`setup_conv bod))
                    (ths (map #'BASIC_REAL_FIELD (#`conjuncts (rand (concl th1))))))
                  (cl:declare (cl:ignorable th1 ths))
                  (EQ_MP (SYM th0) (#`GENL avs (EQ_MP (SYM th1) (end_itlist CONJ ths)))))))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Useful monotone mappings between R and (-1,1)                             *)
;; (* ------------------------------------------------------------------------- *)


(defparameter REAL_SHRINK_RANGE
  (prove
    (tuple
      (parse_term "!x. abs(x / (&1 + abs x)) < &1")
      (proof #'GEN_TAC
        THEN
          (REWRITE_TAC
            (cl:cons
              REAL_ABS_DIV
              (cl:cons (#`REAL_ARITH (parse_term "abs(&1 + abs x) = &1 + abs x")) nil)))
        THEN
          (SIMP_TAC
            (cl:cons
              REAL_LT_LDIV_EQ
              (cl:cons (#`REAL_ARITH (parse_term "&0 < &1 + abs x")) nil)))
        THEN REAL_ARITH_TAC))))

(defparameter REAL_SHRINK_LT
  (prove
    (tuple
      (parse_term "!x y. x / (&1 + abs x) < y / (&1 + abs y) <=> x < y")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (MATCH_MP_TAC
            (#`REAL_ARITH
              (parse_term
                "(&0 < x' <=> &0 < x) /\\ (&0 < y' <=> &0 < y) /\\
    (abs x' < abs y' <=> abs x < abs y) /\\ (abs y' < abs x' <=> abs y < abs x)
    ==> (x' < y' <=> x < y)")))
        THEN
          (SIMP_TAC
            (cl:cons
              REAL_LT_RDIV_EQ
              (cl:cons
                (#`REAL_ARITH (parse_term "&0 < &1 + abs x"))
                (cl:cons REAL_MUL_LZERO nil))))
        THEN
          (MAP_EVERY
            (lambdac (t%) (SPEC_TAC (tuple t% t%)))
            (cl:cons (parse_term "y:real") (cl:cons (parse_term "x:real") nil)))
        THEN
          (REWRITE_TAC
            (cl:cons
              (MESON nil (parse_term "(!x y. P x y /\\ P y x) <=> (!x y. P x y)"))
              nil))
        THEN (REPEAT #'GEN_TAC)
        THEN
          (REWRITE_TAC
            (cl:cons
              REAL_ABS_DIV
              (cl:cons (#`REAL_ARITH (parse_term "abs(&1 + abs x) = &1 + abs x")) nil)))
        THEN
          (SIMP_TAC
            (cl:cons
              REAL_LT_RDIV_EQ
              (cl:cons (#`REAL_ARITH (parse_term "&0 < &1 + abs x")) nil)))
        THEN
          (ONCE_REWRITE_TAC
            (cl:cons (#`REAL_ARITH (parse_term "a / b * c:real = (a * c) / b")) nil))
        THEN
          (SIMP_TAC
            (cl:cons
              REAL_LT_LDIV_EQ
              (cl:cons (#`REAL_ARITH (parse_term "&0 < &1 + abs x")) nil)))
        THEN REAL_ARITH_TAC))))

(defparameter REAL_SHRINK_LE
  (prove
    (tuple
      (parse_term "!x y. x / (&1 + abs x) <= y / (&1 + abs y) <=> x <= y")
      (REWRITE_TAC (cl:cons (#`GSYM REAL_NOT_LT) (cl:cons REAL_SHRINK_LT nil))))))

(defparameter REAL_SHRINK_EQ
  (prove
    (tuple
      (parse_term "!x y. x / (&1 + abs x) = y / (&1 + abs y) <=> x = y")
      (REWRITE_TAC (cl:cons (#`GSYM REAL_LE_ANTISYM) (cl:cons REAL_SHRINK_LE nil))))))

(defparameter REAL_SHRINK_GALOIS
  (prove
    (tuple
      (parse_term "!x y. x / (&1 + abs x) = y <=> abs y < &1 /\\ y / (&1 - abs y) = x")
      (proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THEN #'STRIP_TAC
        THEN (FIRST_X_ASSUM (o #'SUBST1_TAC #'SYM))
        THEN (#`ASM_REWRITE_TAC (cl:cons REAL_SHRINK_RANGE nil))
        THEN
          (#`ASM_SIMP_TAC
            (cl:cons
              REAL_ABS_DIV
              (cl:cons
                (#`REAL_ARITH (parse_term "abs(&1 + abs x) = &1 + abs x"))
                (cl:cons
                  (#`REAL_ARITH
                    (parse_term "abs y < &1 ==> abs(&1 - abs y) = &1 - abs y"))
                  nil))))
        THEN
          (MATCH_MP_TAC
            (#`REAL_ARITH (parse_term "x * inv y * inv z = x * &1 ==> x / y / z = x")))
        THEN AP_TERM_TAC
        THEN
          (MATCH_MP_TAC (#`REAL_FIELD (parse_term "x * y = &1 ==> inv x * inv y = &1")))
        THEN (REPEAT (POP_ASSUM #'MP_TAC))
        THEN (#`CONV_TAC REAL_FIELD)))))

(defparameter REAL_GROW_SHRINK
  (prove
    (tuple
      (parse_term "!x. x / (&1 + abs x) / (&1 - abs(x / (&1 + abs x))) = x")
      (MESON_TAC (cl:cons REAL_SHRINK_GALOIS (cl:cons REAL_SHRINK_RANGE nil))))))

(defparameter REAL_SHRINK_GROW_EQ
  (prove
    (tuple
      (parse_term
        "!x. x / (&1 - abs x) / (&1 + abs(x / (&1 - abs x))) = x <=> abs x < &1")
      (MESON_TAC (cl:cons REAL_SHRINK_GALOIS (cl:cons REAL_SHRINK_RANGE nil))))))

(defparameter REAL_SHRINK_GROW
  (prove
    (tuple
      (parse_term
        "!x. abs x < &1
       ==> x / (&1 - abs x) / (&1 + abs(x / (&1 - abs x))) = x")
      (REWRITE_TAC (cl:cons REAL_SHRINK_GROW_EQ nil)))))

