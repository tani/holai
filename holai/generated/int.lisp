;; (* ------------------------------------------------------------------------- *)
;; (* An initial bootstrapping procedure for the integers, enhanced later.      *)
;; (* ------------------------------------------------------------------------- *)


(defparameter INT_ARITH~1
  (let
    ((atom_CONV
      (let
        ((pth
          (prove
            (tuple
              (parse_term
                "(~(x:int <= y) <=> y + &1 <= x) /\\
        (~(x < y) <=> y <= x) /\\
        (~(x = y) <=> x + &1 <= y \\/ y + &1 <= x) /\\
        (x < y <=> x + &1 <= y)")
              (REWRITE_TAC
                (cl:cons
                  INT_NOT_LE
                  (cl:cons INT_NOT_LT (cl:cons INT_NOT_EQ (cl:cons INT_LT_DISCRETE nil)))))))))
        (cl:declare (cl:ignorable pth))
        (GEN_REWRITE_CONV #'I (cl:cons pth nil))))
      (bub_CONV
        (GEN_REWRITE_CONV
          TOP_SWEEP_CONV
          (cl:cons
            int_eq
            (cl:cons
              int_le
              (cl:cons
                int_lt
                (cl:cons
                  int_ge
                  (cl:cons
                    int_gt
                    (cl:cons
                      int_of_num_th
                      (cl:cons
                        int_neg_th
                        (cl:cons
                          int_add_th
                          (cl:cons
                            int_mul_th
                            (cl:cons
                              int_sub_th
                              (cl:cons
                                int_pow_th
                                (cl:cons
                                  int_abs_th
                                  (cl:cons int_max_th (cl:cons int_min_th nil)))))))))))))))))
    (cl:declare (cl:ignorable atom_CONV bub_CONV))
    (let*
      ((base_CONV (THENC (TRY_CONV atom_CONV) bub_CONV))
        (NNF_NORM_CONV
          (#`GEN_NNF_CONV
            cl:nil
            (tuple
              base_CONV
              (lambdac (t%) (tuple (#`base_CONV t%) (#`base_CONV (#`mk_neg t%)))))))
        (init_CONV
          (THENC
            (THENC
              (THENC
                (THENC
                  (THENC (#`TOP_DEPTH_CONV #'BETA_CONV) PRESIMP_CONV)
                  (GEN_REWRITE_CONV DEPTH_CONV (cl:cons INT_GT% (cl:cons INT_GE% nil))))
                NNF_CONV)
              (DEPTH_BINOP_CONV (parse_term "(\\/)") CONDS_ELIM_CONV))
            NNF_NORM_CONV))
        (p_tm (parse_term "p:bool"))
        (not_tm (parse_term "(~)")))
      (cl:declare (cl:ignorable base_CONV NNF_NORM_CONV init_CONV p_tm not_tm))
      (let ((pth (#`TAUT (#`mk_eq (tuple (#`mk_neg (#`mk_neg p_tm)) p_tm)))))
        (cl:declare (cl:ignorable pth))
        (lambdac (tm)
          (let
            ((th0 (INST% (cl:cons (tuple tm p_tm) nil) pth))
              (th1 (#`init_CONV (#`mk_neg tm))))
            (cl:declare (cl:ignorable th0 th1))
            (let ((th2 (#`REAL_ARITH (#`mk_neg (rand (concl th1))))))
              (cl:declare (cl:ignorable th2))
              (EQ_MP th0 (EQ_MP (AP_TERM not_tm (SYM th1)) th2)))))))))

(defparameter INT_ARITH_TAC~1 (#`CONV_TAC (o EQT_INTRO INT_ARITH~1)))

(defparameter ASM_INT_ARITH_TAC~1
  (holai.runtime:proof (REPEAT
      (FIRST_X_ASSUM
        (o #'MP_TAC (check (o (o (function-value #'not 1) is_forall) #'concl)))))
    THEN INT_ARITH_TAC~1))

