    (parse_term "int_min x y = int_of_real(min (real_of_int x) (real_of_int y))")))

(defparameter int_min_th
  (prove
    (tuple
      (parse_term "!x y. real_of_int(min x y) = min (real_of_int x) (real_of_int y)")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
