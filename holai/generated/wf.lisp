        THEN (#`ASM_REWRITE_TAC nil)
        THEN
          (DISCH_THEN
            (X_CHOOSE_THEN (parse_term "a:A") (CONJUNCTS_THEN2 #'MP_TAC ASSUME_TAC)))
        THEN (DISCH_THEN (#`X_CHOOSE_TAC (parse_term "b1:B")))
