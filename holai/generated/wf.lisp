;; (* ------------------------------------------------------------------------- *)
;; (* The Nash-Williams minimal bad sequence argument for some predicate `bad`  *)
;; (* that is a "safety property" in the Lamport/Alpern/Schneider sense.        *)
;; (* ------------------------------------------------------------------------- *)


(defparameter MINIMAL_BAD_SEQUENCE
  (prove
    (tuple
      (parse_term
        "!(<<) (bad:(num->A)->bool).
        WF(<<) /\\
        (!x. ~bad x ==> ?n. !y. (!k. k < n ==> y k = x k) ==> ~bad y) /\\
        (?x. bad x)
         ==> ?y. bad y /\\
                 !z n. bad z /\\ (!k. k < n ==> z k = y k) ==> ~(z n << y n)")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN DISCH_TAC
        THEN
          (SUBGOAL_THEN
            (parse_term
              "?x:num->A. !n. (?y. bad y /\\ (!k. k < n ==> y k = x k) /\\ y n = x n) /\\
                   !z. bad z /\\ (!k. k < n ==> z k = x k) ==> ~(z n << x n)")
            #'MP_TAC)
        THENL
          (cl:cons
            (holai.runtime:proof (MATCH_MP_TAC (MATCH_MP WF_REC_EXISTS WF_num))
              THEN (SIMP_TAC nil))
            (cl:cons
              (holai.runtime:proof (MATCH_MP_TAC MONO_EXISTS) THEN (#`ASM_MESON_TAC nil))
              nil))
        THEN
          (MAP_EVERY
            X_GEN_TAC
            (cl:cons (parse_term "x:num->A") (cl:cons (parse_term "n:num") nil)))
        THEN DISCH_TAC
        THEN
          (REWRITE_TAC
            (cl:cons
              (MESON
                nil
                (parse_term
                  "(?a. (?y. P y /\\ Q y /\\ f y = a) /\\ (!z. A z ==> ~B a z)) <=>
     ?y. (P y /\\ Q y) /\\ (!z. B (f y) z ==> ~A z)"))
              nil))
        THEN
          (MP_TAC
            (ISPECL
              (cl:cons
                (parse_term "(<<):A->A->bool")
                (cl:cons (parse_term "\\x:num->A. x n") nil))
              WF_MEASURE_GEN))
        THEN (#`ASM_REWRITE_TAC nil)
        THEN (REWRITE_TAC (cl:cons WF nil))
        THEN (DISCH_THEN #'MATCH_MP_TAC)
        THEN (POP_ASSUM_LIST (o #'MP_TAC (end_itlist CONJ)))
        THEN (SPEC_TAC (tuple (parse_term "n:num") (parse_term "n:num")))
        THEN INDUCT_TAC
        THEN (SIMP_TAC (cl:cons LT nil))
        THEN (MESON_TAC nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Tail recursion.                                                           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter WF_REC_TAIL
  (prove
    (tuple
      (parse_term "!P g h. ?f:A->B. !x. f x = if P(x) then f(g x) else h x")
      (let
        ((lemma1
          (prove
            (tuple
              (parse_term "~(P 0) ==> ((?n. P(SUC n)) <=> (?n. P(n)))")
              (MESON_TAC (cl:cons num_CASES (cl:cons NOT_SUC nil))))))
          (lemma2
            (prove
              (tuple
                (parse_term
                  "(P 0) ==> ((!m. m < n ==> P(SUC m)) <=> (!m. m < SUC n ==> P(m)))")
                (holai.runtime:proof (REPEAT
                    (holai.runtime:proof DISCH_TAC #'ORELSE #'EQ_TAC))
                  THEN INDUCT_TAC
                  THEN (#`ASM_MESON_TAC (cl:cons LT_SUC (cl:cons LT_0 nil))))))))
        (cl:declare (cl:ignorable lemma1 lemma2))
        (holai.runtime:proof (REPEAT #'GEN_TAC)
          THEN
            (MP_TAC
              (#`GEN
                (parse_term "x:A")
                (ISPECL
                  (cl:cons
                    (parse_term "x:A")
                    (cl:cons (parse_term "\\y:A n:num. g(y):A") nil))
                  num_RECURSION)))
          THEN (REWRITE_TAC (cl:cons SKOLEM_THM (cl:cons FORALL_AND_THM nil)))
          THEN (DISCH_THEN (X_CHOOSE_THEN (parse_term "s:A->num->A") STRIP_ASSUME_TAC))
          THEN
            (#`EXISTS_TAC
              (parse_term
                "\\x:A. if ?n:num. ~P(s x n)
                    then (h:A->B)(@y. ?n. (y = s x n) /\\ ~P(s x n) /\\
                                          !m. m < n ==> P(s x m))
                    else something_arbitrary:B"))
          THEN (#`X_GEN_TAC (parse_term "x:A"))
          THEN (SUBGOAL_THEN (parse_term "!n x:A. s (g x) n :A = s x (SUC n)") ASSUME_TAC)
          THENL
            (cl:cons
              (holai.runtime:proof INDUCT_TAC THEN (#`ASM_REWRITE_TAC nil))
              (cl:cons
                (UNDISCH_THEN
                  (parse_term "!x:A n. s x (SUC n) :A = g (s x n)")
                  (K #'ALL_TAC))
                nil))
          THEN (ASM_CASES_TAC (parse_term "(P:A->bool) x"))
          THEN (#`ASM_REWRITE_TAC nil)
          THENL
            (cl:cons
              (holai.runtime:proof (#`ASM_SIMP_TAC (cl:cons lemma1 nil))
                THEN COND_CASES_TAC
                THEN (#`ASM_REWRITE_TAC nil)
                THEN (#`CONV_TAC #'SYM_CONV)
                THEN (#`ASM_SIMP_TAC (cl:cons lemma2 (cl:cons lemma1 nil))))
              (cl:cons
                (holai.runtime:proof COND_CASES_TAC
                  THENL (cl:cons #'ALL_TAC (cl:cons (#`ASM_MESON_TAC nil) nil))
                  THEN AP_TERM_TAC
                  THEN (MATCH_MP_TAC SELECT_UNIQUE)
                  THEN (REWRITE_TAC nil)
                  THEN (#`X_GEN_TAC (parse_term "y:A"))
                  THEN #'EQ_TAC
                  THENL
                    (cl:cons
                      (holai.runtime:proof (SIMP_TAC (cl:cons LEFT_IMP_EXISTS_THM nil))
                        THEN INDUCT_TAC
                        THEN (#`ASM_REWRITE_TAC nil)
                        THEN (#`ASM_MESON_TAC (cl:cons LT_0 nil)))
                      (cl:cons (#`ASM_MESON_TAC (cl:cons LT nil)) nil)))
                nil)))))))

;; (* ------------------------------------------------------------------------- *)
;; (* A more general mix of tail and wellfounded recursion.                     *)
;; (* ------------------------------------------------------------------------- *)


(defparameter WF_REC_TAIL_GENERAL
  (prove
    (tuple
      (parse_term
        "!P G H. WF(<<) /\\
           (!f g x. (!z. z << x ==> (f z = g z))
                    ==> (P f x <=> P g x) /\\ G f x = G g x /\\ H f x = H g x) /\\
           (!f g x. (!z. z << x ==> (f z = g z)) ==> (H f x = H g x)) /\\
           (!f x y. P f x /\\ y << G f x ==> y << x)
           ==> ?f:A->B. !x. f x = if P f x then f(G f x) else H f x")
      (holai.runtime:proof (REPEAT #'STRIP_TAC)
        THEN
          (CHOOSE_THEN
            #'MP_TAC
            (#`prove_inductive_relations_exist
              (parse_term
                "(!x:A. ~(P f x) ==> terminates f x) /\\
      (!x. P (f:A->B) x /\\ terminates f (G f x) ==> terminates f x)")))
        THEN (REWRITE_TAC (cl:cons FORALL_AND_THM nil))
        THEN (DISCH_THEN (o STRIP_ASSUME_TAC GSYM))
        THEN
          (SUBGOAL_THEN
            (parse_term
              "?while. !f:A->B x:A. while f x = if P f x then while f (G f x) else x")
            (o STRIP_ASSUME_TAC GSYM))
        THENL
          (cl:cons
            (REWRITE_TAC (cl:cons (#`GSYM SKOLEM_THM) (cl:cons WF_REC_TAIL nil)))
            (cl:cons #'ALL_TAC nil))
        THEN
          (SUBGOAL_THEN
            (parse_term
              "?f:A->B. !x. f x = if terminates f x then H f (while f x :A) else anything")
            #'MP_TAC)
        THENL
          (cl:cons
            (holai.runtime:proof (FIRST_ASSUM (o #'MATCH_MP_TAC (MATCH_MP WF_REC)))
              THEN (REPEAT #'STRIP_TAC)
              THEN
                (MATCH_MP_TAC
                  (MESON
                    nil
                    (parse_term
                      "(a = b) /\\ (a /\\ b ==> (x = y) /\\ (f x = g x))
      ==> ((if a then f x else d) = (if b then g y else d))")))
              THEN (REPEAT #'STRIP_TAC)
              THENL
                (cl:cons
                  (holai.runtime:proof (SUBGOAL_THEN
                      (parse_term
                        "!f g x.
           (!x y. P f x /\\ y << G (f:A->B) x ==> y << x) /\\
           (!y:A. (!z:A. z << y ==> z << x)
                  ==> (P f y = P g y) /\\ (G f y = G g y))
               ==> terminates f x ==> terminates g x")
                      (lambdac (th)
                        (holai.runtime:proof #'EQ_TAC
                          THEN (MATCH_MP_TAC th)
                          THEN (#`ASM_MESON_TAC nil))))
                    THEN #'GEN_TAC
                    THEN #'GEN_TAC
                    THEN
                      (REWRITE_TAC (cl:cons RIGHT_FORALL_IMP_THM (cl:cons IMP_CONJ nil)))
                    THEN DISCH_TAC
                    THEN
                      (ONCE_REWRITE_TAC
                        (cl:cons
                          (#`TAUT (parse_term "a ==> b ==> c <=> b ==> a ==> c"))
                          nil))
                    THEN (FIRST_X_ASSUM #'MATCH_MP_TAC)
                    THEN (#`ASM_MESON_TAC nil))
                  (cl:cons
                    (holai.runtime:proof (SUBGOAL_THEN
                        (parse_term
                          "!x:A. terminates (f:A->B) x /\\
              (!y:A. (!z:A. z << y ==> z << x)
                     ==> (P f y <=> P g y) /\\ (G f y :A = G g y))
              ==> (while f x :A = while g x)")
                        (lambdac (th)
                          (holai.runtime:proof (MATCH_MP_TAC th)
                            THEN (#`ASM_MESON_TAC nil))))
                      THEN (REWRITE_TAC (cl:cons IMP_CONJ nil))
                      THEN (FIRST_X_ASSUM #'MATCH_MP_TAC)
                      THEN (#`ASM_MESON_TAC nil))
                    (cl:cons
                      (holai.runtime:proof (FIRST_X_ASSUM #'MATCH_MP_TAC)
                        THEN
                          (SUBGOAL_THEN
                            (parse_term
                              "!f:A->B. (!x:A y:A. P f x /\\ y << G f x ==> y << x)
         ==> !x. terminates f x ==> !y. y << while f x ==> y << x")
                            (lambdac (th) (#`ASM_MESON_TAC (cl:cons th nil))))
                        THEN #'GEN_TAC
                        THEN DISCH_TAC
                        THEN (FIRST_X_ASSUM #'MATCH_MP_TAC)
                        THEN (#`ASM_MESON_TAC nil))
                      nil))))
            (cl:cons
              (holai.runtime:proof (MATCH_MP_TAC MONO_EXISTS)
                THEN #'GEN_TAC
                THEN
                  (DISCH_THEN
                    (lambdac (th)
                      (holai.runtime:proof (#`ASSUME_TAC (#`GSYM th)) THEN (MP_TAC th))))
                THEN (MATCH_MP_TAC MONO_FORALL)
                THEN (#`X_GEN_TAC (parse_term "x:A"))
                THEN (ASM_CASES_TAC (parse_term "P (f:A->B) (x:A) :bool"))
                THEN (#`ASM_MESON_TAC nil))
              nil))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Tactic to apply WF induction on a free "measured" term in the goal.       *)
;; (* ------------------------------------------------------------------------- *)


(defparameter WF_INDUCT_TAC
  (let
    ((qqconv
      (let
        ((pth
          (prove
            (tuple
              (parse_term "(!x. P x ==> !y. Q x y) <=> !y x. P x ==> Q x y")
              (MESON_TAC nil)))))
        (cl:declare (cl:ignorable pth))
        (GEN_REWRITE_CONV #'I (cl:cons pth nil))))
      (eqconv
        (let
          ((pth
            (prove
              (tuple
                (parse_term "(!m. P m ==> (m = e) ==> Q) <=> (P e ==> Q)")
                (MESON_TAC nil)))))
          (cl:declare (cl:ignorable pth))
          (#`REWR_CONV pth))))
    (cl:declare (cl:ignorable qqconv eqconv))
    (labelsc
      ((qqconvs
        (tm)
        (handler-case
          (THENC qqconv (BINDER_CONV #'qqconvs) tm)
          (holai.runtime:ocaml-condition
            (exception~1448)
            (match exception~1448 ((Failure _) (#`eqconv tm)) (_ (raise exception~1448)))))))
      (lambdac (tm arg~1460)
        (match arg~1460
          ((cl:and gl (tuple asl w%))
            (let ((fvs (frees tm)) (gv (#`genvar (type_of tm))))
              (cl:declare (cl:ignorable fvs gv))
              (let*
                ((pat
                  (list_mk_forall
                    (tuple (cl:cons gv fvs) (#`mk_imp (tuple (#`mk_eq (tuple gv tm)) w%)))))
                  (th0 (UNDISCH (#`PART_MATCH #'rand num_WF pat)))
                  (th1 (#`MP (SPECL (cl:cons tm fvs) th0) (REFL tm)))
                  (th2 (CONV_RULE (#`LAND_CONV #'qqconvs) (DISCH_ALL th1))))
                (cl:declare (cl:ignorable pat th0 th1 th2))
                (#`THEN
                  (holai.runtime:proof (MATCH_MP_TAC th2)
                    THEN (MAP_EVERY X_GEN_TAC fvs)
                    THEN (#`CONV_TAC (#`LAND_CONV #'qqconvs)))
                  (DISCH_THEN ASSUME_TAC)
                  gl)))))))))

