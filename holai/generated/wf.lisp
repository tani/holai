;; (* ------------------------------------------------------------------------- *)
;; (* Wellfoundedness properties of natural numbers.                            *)
;; (* ------------------------------------------------------------------------- *)


(defparameter WF_num
  (prove (tuple (parse_term "WF(<)") (REWRITE_TAC (cl:cons WF_IND (cl:cons num_WF nil))))))

(defparameter WF_REC_num
  (prove
    (tuple
      (parse_term
        "!H. (!f g n. (!m. m < n ==> (f m = g m)) ==> (H f n = H g n))
        ==> ?f:num->A. !n. f n = H f n")
      (#`MATCH_ACCEPT_TAC (MATCH_MP WF_REC WF_num)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Natural number measures (useful in program verification).                 *)
;; (* ------------------------------------------------------------------------- *)


(defparameter MEASURE
  (#`new_definition (parse_term "MEASURE (m:A->num) = \\x y. m(x) < m(y)")))

(defparameter WF_MEASURE
  (prove
    (tuple
      (parse_term "!m:A->num. WF(MEASURE m)")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN (REWRITE_TAC (cl:cons MEASURE nil))
        THEN (MATCH_MP_TAC WF_MEASURE_GEN)
        THEN (#`MATCH_ACCEPT_TAC WF_num)))))

(defparameter MEASURE_LE
  (prove
    (tuple
      (parse_term "!m:A->num. (!y. MEASURE m y a ==> MEASURE m y b) <=> m(a) <= m(b)")
      (holai.runtime:proof (REWRITE_TAC (cl:cons MEASURE nil))
        THEN (MESON_TAC (cl:cons NOT_LE (cl:cons LTE_TRANS (cl:cons LT_REFL nil))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Trivially, a WF relation is irreflexive and antisymmetric.                *)
;; (* ------------------------------------------------------------------------- *)


(defparameter WF_ANTISYM
  (prove
    (tuple
      (parse_term "!(<<) x y:A. WF(<<) ==> ~(x << y /\\ y << x)")
      (holai.runtime:proof (REPEAT #'STRIP_TAC)
        THEN (FIRST_X_ASSUM (o #'MP_TAC (GEN_REWRITE_RULE #'I (cl:cons WF nil))))
        THEN (DISCH_THEN (o #'MP_TAC (#`SPEC (parse_term "\\z:A. z = x \\/ z = y"))))
        THEN (#`ASM_MESON_TAC nil)))))

(defparameter WF_REFL
  (prove
    (tuple (parse_term "!x:A. WF(<<) ==> ~(x << x)") (MESON_TAC (cl:cons WF_ANTISYM nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Even more trivially, the everywhere-false relation is wellfounded.        *)
;; (* ------------------------------------------------------------------------- *)


(defparameter WF_FALSE
