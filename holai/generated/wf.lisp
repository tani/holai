        THEN DISCH_TAC
        THEN (FIRST_X_ASSUM (o #'MP_TAC (#`SPEC (parse_term "\\a:A. ?b:B. P(a,b)"))))
        THEN (REWRITE_TAC (cl:cons LEFT_IMP_EXISTS_THM nil))
        THEN
