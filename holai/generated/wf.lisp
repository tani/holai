        THEN (REWRITE_TAC (cl:cons LEFT_IMP_EXISTS_THM nil))
        THEN (GEN_REWRITE_TAC #'I (cl:cons FORALL_PAIR_THM nil))
        THEN
          (MAP_EVERY
