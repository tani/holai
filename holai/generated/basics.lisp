;; (* ------------------------------------------------------------------------- *)
;; (* Free variables in assumption list and conclusion of a theorem.            *)
;; (* ------------------------------------------------------------------------- *)


(defunc thm_frees (th)
  (match (dest_thm th) ((tuple asl c%) (itlist (o #'union #'frees) asl (frees c%)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Is one term free in another?                                              *)
;; (* ------------------------------------------------------------------------- *)


(defunc free_in (tm1 tm2)
