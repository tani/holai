        (holai.runtime:ocaml-condition
          (exception~550)
          (match exception~550
            ((Failure _) (failwith "mk_const: generic type cannot be instantiated"))
            (_ (raise exception~550))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Like mk_comb, but instantiates type variables in rator if necessary.      *)
;; (* ------------------------------------------------------------------------- *)


