;; (* ------------------------------------------------------------------------- *)
;; (* Type matching.                                                            *)
;; (* ------------------------------------------------------------------------- *)


(defunc type_match (vty cty sofar)
  (if (#`is_vartype vty)
    (handler-case
      (if (= (rev_assoc vty sofar) cty) sofar (failwith "type_match"))
      (holai.runtime:ocaml-condition
        (exception~523)
        (match exception~523
          ((Failure "find") (cl:cons (tuple cty vty) sofar))
          (_ (raise exception~523)))))
