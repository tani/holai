(defparameter ASM_SIMP_TAC (ASM #'SIMP_TAC))

(defparameter PURE_ASM_SIMP_TAC (ASM #'PURE_SIMP_TAC))

(defparameter ONCE_ASM_SIMP_TAC (ASM #'ONCE_SIMP_TAC))

;; (* ------------------------------------------------------------------------- *)
;; (* Abbreviation tactics.                                                     *)
;; (* ------------------------------------------------------------------------- *)


(defunc ABBREV_TAC (tm)
  (match (dest_eq tm)
    ((tuple cvs t%)
      (match (#`strip_comb cvs)
        ((tuple v vs)
          (let*
            ((rs (list_mk_abs (tuple vs t%)))
              (eq (#`mk_eq (tuple rs v)))
              (th1
                (itlist
                  (lambdac (v% th) (CONV_RULE (#`LAND_CONV #'BETA_CONV) (AP_THM th v%)))
                  (#`rev vs)
                  (ASSUME eq)))
              (th2 (SIMPLE_CHOOSE v (SIMPLE_EXISTS v (#`GENL vs th1))))
              (th3
                (PROVE_HYP (#`EXISTS (tuple (#`mk_exists (tuple v eq)) rs) (REFL rs)) th2)))
            (cl:declare (cl:ignorable rs eq th1 th2 th3))
            (lambdac (arg~2187)
              (match arg~2187
                ((cl:and gl (tuple asl w%))
                  (let
                    ((avoids
                      (itlist
                        (o (o (o #'union #'frees) #'concl) (function-value #'snd 1))
                        asl
                        (frees w%))))
                    (cl:declare (cl:ignorable avoids))
                    (if (mem v avoids)
                      (failwith "ABBREV_TAC: variable already used")
                      (CHOOSE_THEN
                        (lambdac (th)
                          (holai.runtime:proof (RULE_ASSUM_TAC
                              (PURE_ONCE_REWRITE_RULE (cl:cons th nil)))
                            THEN (PURE_ONCE_REWRITE_TAC (cl:cons th nil))
                            THEN (#`ASSUME_TAC th)))
                        th3
                        gl))))))))))))

(defunc EXPAND_TAC (s)
  (holai.runtime:proof (FIRST_ASSUM
      (o
        (o #'SUBST1_TAC #'SYM)
        (check
          (o
            (o
              (o
                (o (partial (function-value #'= 2) s) (function-value #'fst 1))
                #'dest_var)
              rhs)
            #'concl))))
    THEN BETA_TAC))

