;; (* Slightly modified tactic from meson.ml. *)


(defunc FOL_PREPARE_TAC (ths)
  (holai.runtime.core:proof (#`REFUTE_THEN ASSUME_TAC)
    THEN (#`POLY_ASSUME_TAC (map #'GEN_ALL ths))
    THEN
      (W
        (o
          (MAP_EVERY (o (o #'UNDISCH_TAC #'concl) (function-value #'snd 1)))
          (function-value #'fst 1)))
    THEN SELECT_ELIM_TAC
    THEN
      (W
        (lambdac (arg~53322)
          (match arg~53322
            ((tuple asl w%) (MAP_EVERY (lambdac (v) (SPEC_TAC (tuple v v))) (frees w%))))))
    THEN
      (#`CONV_TAC
        (THENC
          (THENC
            (THENC (THENC PRESIMP_CONV (#`TOP_DEPTH_CONV #'BETA_CONV)) LAMBDA_ELIM_CONV)
            CONDS_CELIM_CONV)
          QUANT_BOOL_CONV))
    THEN (REPEAT (holai.runtime.core:proof #'GEN_TAC #'ORELSE DISCH_TAC))
    THEN (#`REFUTE_THEN ASSUME_TAC)
    THEN (RULE_ASSUM_TAC (CONV_RULE (THENC NNF_CONV SKOLEM_CONV)))
    THEN (REPEAT (FIRST_X_ASSUM #'CHOOSE_TAC))
    THEN ASM_FOL_TAC
    THEN (SPLIT_TAC (deref split_limit))
    THEN (RULE_ASSUM_TAC (CONV_RULE (THENC PRENEX_CONV WEAK_CNF_CONV)))
    THEN
      (RULE_ASSUM_TAC
        (holai.lib:repeat
          (lambdac (th) (#`SPEC (#`genvar (type_of (fst (#`dest_forall (concl th))))) th))))
    THEN (REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN% ASSUME_TAC)))
    THEN (RULE_ASSUM_TAC (CONV_RULE (ASSOC_CONV DISJ_ASSOC)))))

