              (_ (raise exception~53422)))))))))

(defunc SIMPLE_METIS_REFUTE (ths)
  (progn
    (#`clear_contrapos_cache unit)
    (random-init 0)
    (let ((rules (#`metis_of_clauses ths)))
      (cl:declare (cl:ignorable rules))
      (progn
        (if (deref metisverb)
          (progn
            (format-printf "Original ths:
%!")
            (list-iter (o (format-printf "%s
%!") string_of_thm) ths))
          unit)
        (let ((res (run rules)))
          (cl:declare (cl:ignorable res))
          (progn
            (if (deref metisverb) (print_proof res) unit)
            (let*
              ((ths% (map (CONV_RULE #'DISJ_CANON_CONV) ths))
                (proof
                  (without_warnings
                    (lambdac (arg~53480)
                      (match arg~53480
                        ((cl:type holai.runtime.data:unit-value) (hol_of_thm ths% res)))))))
              (cl:declare (cl:ignorable ths% proof))
