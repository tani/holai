                    (format-printf "ths:
%!")
                    (list-iter
                      (lambdac (t%) (progn (#`print_thm t%) (format-printf "
%!")))
                      ths%)
                    (format-printf "Metis theorem:
%!")
                    (#`print_thm proof)
                    (format-printf "Metis end.
%!"))
                  unit)
                (let ((allhyps (list-concat (list-map #'hyp ths%))))
                  (cl:declare (cl:ignorable allhyps))
                  (progn
