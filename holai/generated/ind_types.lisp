                          ((hackdown_rath
                            (th)
                            (match (dest_eq (concl th))
                              ((tuple ltm rtm)
                                (let*
                                  ((wargs (snd (#`strip_comb (rand ltm))))
                                    (th1 (TRANS th (#`LCONV rtm)))
                                    (th2 (TRANS th1 (#`CCONV (rand (concl th1)))))
                                    (th3
                                      (TRANS
                                        th2
                                        (funpow
                                          2
                                          #'RATOR_CONV
                                          #'BETA_CONV
                                          (rand (concl th2)))))
                                    (th4
                                      (TRANS
                                        th3
                                        (RATOR_CONV #'BETA_CONV (rand (concl th3)))))
                                    (th5 (TRANS th4 (BETA_CONV (rand (concl th4))))))
