;; (* ------------------------------------------------------------------------- *)
;; (* Also add a cached rewrite of distinctness and injectivity theorems. Since *)
;; (* there can be quadratically many distinctness clauses, it would really be  *)
;; (* preferable to have a conversion, but this seems OK up 100 constructors.   *)
;; (* ------------------------------------------------------------------------- *)


(defparameter basic_rectype_net (ref empty_net))

(defparameter distinctness_store
  (ref (cl:cons (tuple "bool" (#`TAUT (parse_term "(T <=> F) <=> F"))) nil)))

(defparameter injectivity_store (ref nil))

(defunc extend_rectype_net (arg~5234)
  (match arg~5234
    ((tuple tyname (tuple _ _ rth))
      (let
        ((ths1
          (handler-case
            (cl:cons (#`prove_constructors_distinct rth) nil)
            (holai.runtime:ocaml-condition
              (exception~5240)
              (match exception~5240 ((Failure _) nil) (_ (raise exception~5240))))))
          (ths2
            (handler-case
              (cl:cons (#`prove_constructors_injective rth) nil)
              (holai.runtime:ocaml-condition
                (exception~5249)
                (match exception~5249 ((Failure _) nil) (_ (raise exception~5249)))))))
        (cl:declare (cl:ignorable ths1 ths2))
        (let ((canon_thl (itlist (#`mk_rewrites cl:nil) (append ths1 ths2) nil)))
          (cl:declare (cl:ignorable canon_thl))
          (progn
            (assign
              distinctness_store
              (append
                (map (lambdac (th) (tuple tyname th)) ths1)
                (deref distinctness_store)))
            (assign
              injectivity_store
              (append
                (map (lambdac (th) (tuple tyname th)) ths2)
                (deref injectivity_store)))
            (assign
              basic_rectype_net
              (itlist (net_of_thm cl:t) canon_thl (deref basic_rectype_net)))))))))

(do_list #'extend_rectype_net (deref inductive_type_store))

;; (* ------------------------------------------------------------------------- *)
;; (* Return distinctness and injectivity for a type by simple lookup.          *)
;; (* ------------------------------------------------------------------------- *)


(defunc distinctness (ty) (assoc ty (deref distinctness_store)))

(defunc injectivity (ty) (assoc ty (deref injectivity_store)))

(defunc cases (ty)
  (if (= ty "num")
    num_CASES
    (match (assoc ty (deref inductive_type_store))
      ((tuple _ ith _) (#`prove_cases_thm ith)))))

