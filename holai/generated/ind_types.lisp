                                            ty%))
                                        unseqs))
                                    tys)))
                              (rethm (itlist EXISTS_EQUATION seqs rthm))
                              (fethm (#`CHOOSE (tuple fn eth) rethm))
                              (pcons
                                (map
                                  (o
                                    (o (holai.lib:repeat #'rator) #'rand)
                                    (holai.lib:repeat
                                      (o (function-value #'snd 1) dest_forall)))
                                  (#`holai.basics:conjuncts (concl rthm)))))
