;; (* ------------------------------------------------------------------------- *)
;; (* Abstract left inverses for binary injections (we could construct them...) *)
;; (* ------------------------------------------------------------------------- *)


(defparameter INJ_INVERSE2
  (prove
    (tuple
      (parse_term
        "!P:A->B->C.
    (!x1 y1 x2 y2. (P x1 y1 = P x2 y2) <=> (x1 = x2) /\\ (y1 = y2))
    ==> ?X Y. !x y. (X(P x y) = x) /\\ (Y(P x y) = y)")
      (holai.runtime:proof #'GEN_TAC
        THEN DISCH_TAC
        THEN (#`EXISTS_TAC (parse_term "\\z:C. @x:A. ?y:B. P x y = z"))
        THEN (#`EXISTS_TAC (parse_term "\\z:C. @y:B. ?x:A. P x y = z"))
        THEN (REPEAT #'GEN_TAC)
        THEN (#`ASM_REWRITE_TAC (cl:cons BETA_THM nil))
        THEN #'CONJ_TAC
        THEN (MATCH_MP_TAC SELECT_UNIQUE)
        THEN #'GEN_TAC
        THEN BETA_TAC
        THEN #'EQ_TAC
        THEN #'STRIP_TAC
        THEN (#`ASM_REWRITE_TAC nil)
        THEN
          (W
            (o
              (o (o (o EXISTS_TAC #'rand) (function-value #'snd 1)) dest_exists)
              (function-value #'snd 1)))
        THEN #'REFL_TAC))))

;; (* ------------------------------------------------------------------------- *)
;; (* Define an injective pairing function on ":num".                           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter NUMPAIR
  (#`new_definition (parse_term "NUMPAIR x y = (2 EXP x) * (2 * y + 1)")))

(defparameter NUMPAIR_INJ_LEMMA
  (prove
    (tuple
      (parse_term "!x1 y1 x2 y2. (NUMPAIR x1 y1 = NUMPAIR x2 y2) ==> (x1 = x2)")
      (holai.runtime:proof (REWRITE_TAC (cl:cons NUMPAIR nil))
        THEN (REPEAT (holai.runtime:proof INDUCT_TAC THEN #'GEN_TAC))
        THEN
          (#`ASM_REWRITE_TAC
            (cl:cons
              EXP
              (cl:cons
                (#`GSYM MULT_ASSOC)
                (cl:cons
                  ARITH
                  (cl:cons
                    EQ_MULT_LCANCEL
                    (cl:cons NOT_SUC (cl:cons (#`GSYM NOT_SUC) (cl:cons SUC_INJ nil))))))))
        THEN (DISCH_THEN (o #'MP_TAC (AP_TERM (parse_term "EVEN"))))
        THEN (REWRITE_TAC (cl:cons EVEN_MULT (cl:cons EVEN_ADD (cl:cons ARITH nil))))))))

(defparameter NUMPAIR_INJ
  (prove
    (tuple
      (parse_term
        "!x1 y1 x2 y2. (NUMPAIR x1 y1 = NUMPAIR x2 y2) <=> (x1 = x2) /\\ (y1 = y2)")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THEN DISCH_TAC
        THEN (#`ASM_REWRITE_TAC nil)
        THEN (FIRST_ASSUM (o #'SUBST_ALL_TAC (MATCH_MP NUMPAIR_INJ_LEMMA)))
        THEN (POP_ASSUM #'MP_TAC)
        THEN (REWRITE_TAC (cl:cons NUMPAIR nil))
        THEN
          (REWRITE_TAC
            (cl:cons
              EQ_MULT_LCANCEL
              (cl:cons EQ_ADD_RCANCEL (cl:cons EXP_EQ_0 (cl:cons ARITH nil)))))))))

(defparameter NUMPAIR_DEST
  (#`new_specification
    (cl:cons "NUMFST" (cl:cons "NUMSND" nil))
    (MATCH_MP INJ_INVERSE2 NUMPAIR_INJ)))

;; (* ------------------------------------------------------------------------- *)
;; (* Also, an injective map bool->num->num (even easier!)                      *)
;; (* ------------------------------------------------------------------------- *)


(defparameter NUMSUM
  (#`new_definition (parse_term "NUMSUM b x = if b then SUC(2 * x) else 2 * x")))

(defparameter NUMSUM_INJ
  (prove
    (tuple
      (parse_term
        "!b1 x1 b2 x2. (NUMSUM b1 x1 = NUMSUM b2 x2) <=> (b1 = b2) /\\ (x1 = x2)")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THEN DISCH_TAC
        THEN (#`ASM_REWRITE_TAC nil)
        THEN (POP_ASSUM (o #'MP_TAC (REWRITE_RULE (cl:cons NUMSUM nil))))
        THEN
          (DISCH_THEN
            (lambdac (th)
              (holai.runtime:proof (MP_TAC th)
                THEN (MP_TAC (AP_TERM (parse_term "EVEN") th)))))
        THEN (REPEAT COND_CASES_TAC)
        THEN (REWRITE_TAC (cl:cons EVEN (cl:cons EVEN_DOUBLE nil)))
        THEN (REWRITE_TAC (cl:cons SUC_INJ (cl:cons EQ_MULT_LCANCEL (cl:cons ARITH nil))))))))

(defparameter NUMSUM_DEST
  (#`new_specification
    (cl:cons "NUMLEFT" (cl:cons "NUMRIGHT" nil))
    (MATCH_MP INJ_INVERSE2 NUMSUM_INJ)))

;; (* ------------------------------------------------------------------------- *)
;; (* Injection num->Z, where Z == num->A->bool.                                *)
;; (* ------------------------------------------------------------------------- *)


(defparameter INJN
  (#`new_definition (parse_term "INJN (m:num) = \\(n:num) (a:A). n = m")))

(defparameter INJN_INJ
  (prove
    (tuple
      (parse_term "!n1 n2. (INJN n1 :num->A->bool = INJN n2) <=> (n1 = n2)")
      (holai.runtime:proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THEN DISCH_TAC
        THEN (#`ASM_REWRITE_TAC nil)
        THEN
          (POP_ASSUM
            (o
              (o #'MP_TAC (C #'AP_THM (parse_term "n1:num")))
              (REWRITE_RULE (cl:cons INJN nil))))
        THEN (DISCH_THEN (o #'MP_TAC (C #'AP_THM (parse_term "a:A"))))
