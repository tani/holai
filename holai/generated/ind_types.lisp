                                                  (map
                                                    sucivate
                                                    (-- 0 (- (#`length rargs) 1))))
                                                (rindexed
                                                  (map (curry #'mk_comb r%) indices))
                                                (rargs%
                                                  (map2
                                                    (lambdac (a% rx)
                                                      (mk_comb
                                                        (tuple (assoc a% mkindex) rx)))
                                                    artys
                                                    rindexed))
                                                (sargs% (map (curry #'mk_comb s) indices))
                                                (allargs
                                                  (append cargs% (append rargs% sargs%)))
                                                (funty
                                                  (itlist
                                                    (o #'mk_fun_ty #'type_of)
                                                    allargs
                                                    zty))
                                                (funname
                                                  (string-concat
                                                    (fst
                                                      (dest_const
                                                        (holai.lib:repeat
                                                          #'rator
                                                          (#`lhand (concl cth)))))
                                                    "'"))
                                                (funarg (mk_var (tuple funname funty))))
                                              (cl:declare
                                                (cl:ignorable
