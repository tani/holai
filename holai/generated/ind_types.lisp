;; (* The overall function, with rather crude string-based benignity.         *)
;; (* ----------------------------------------------------------------------- *)


(defparameter the_inductive_types
  (ref
    (cl:cons
      (tuple "list = NIL | CONS A list" (tuple list_INDUCT list_RECURSION))
      (cl:cons
        (tuple "option = NONE | SOME A" (tuple option_INDUCT option_RECURSION))
        (cl:cons (tuple "sum = INL A | INR B" (tuple sum_INDUCT sum_RECURSION)) nil)))))

(defunc define_type (s)
  (handler-case
    (let ((retval (assoc s (deref the_inductive_types))))
      (cl:declare (cl:ignorable retval))
      (progn (warn cl:t "Benign redefinition of inductive type") retval))
    (holai.runtime:ocaml-condition
      (exception~7323)
      (match exception~7323
        ((Failure _)
          (let*
            ((defspec (#`parse_inductive_type_specification s))
              (newtypes (map (function-value #'fst 1) defspec))
              (constructors
                (itlist
                  (o (function-value #'append 2) (map (function-value #'fst 1)))
                  (map (function-value #'snd 1) defspec)
                  nil)))
            (cl:declare (cl:ignorable defspec newtypes constructors))
            (if (not (= (#`length (setify newtypes)) (#`length newtypes)))
              (failwith "define_type: multiple definitions of a type")
              (if (not (= (#`length (setify constructors)) (#`length constructors)))
                (failwith "define_type: multiple instances of a constructor")
                (if (exists (o (can #'get_type_arity) #'dest_vartype) newtypes)
                  (let ((t% (find (can #'get_type_arity) (map #'dest_vartype newtypes))))
                    (cl:declare (cl:ignorable t%))
                    (failwith
                      (string-concat
                        "define_type: type :"
                        (string-concat t% " already defined"))))
                  (if (exists (can #'get_const_type) constructors)
                    (let ((t% (find (can #'get_const_type) constructors)))
                      (cl:declare (cl:ignorable t%))
                      (failwith
                        (string-concat
                          "define_type: constant "
                          (string-concat t% " already defined"))))
                    (let ((retval (#`define_type_raw defspec)))
                      (cl:declare (cl:ignorable retval))
                      (progn
                        (assign
                          the_inductive_types
                          (cl:cons (tuple s retval) (deref the_inductive_types)))
                        retval))))))))
        (_ (raise exception~7323))))))

