            (of_list mati)
            (filter_map
              (lambdac (arg~6766)
                (match arg~6766
                  ((guard
                    (tuple
                      (cl:and idx (tuple (tuple i% _) v))
                      (cl:and cla (cl:cons (Lit% lit%%) nil)))
                    (= lit%% hashek))
                    (>>=
                      (%>
                        (prove_clause
                          opt
                          (tuple sub0 0)
                          (tuple mati nil (cl:cons (tuple i% 0) nil) nil lim)
                          cla)
                        #'next_opt)
                      (lambdac (arg~6808)
                        (match arg~6808
                          ((tuple sub prfs)
                            (make-Some (tuple sub (make-Decomposition cla idx prfs))))))))
                  (_ (make-None))))))
          #'next_opt)
        (lambdac (arg~6831)
          (match arg~6831
            ((tuple sub prf)
              (make-Some
                (tuple (fst sub) (tuple (make-Mat% (tuple (tuple (- 1) 0) mati)) prf))))))))))

(defunc fol_of_thm (th)
  (let* ((lconsts (freesl (hyp th))) (tm (concl th)))
    (cl:declare (cl:ignorable lconsts tm))
    (progn
      (assert-true
        (list-for-all (lambdac (x) (list-mem x lconsts)) (frees tm))
        "thecops.ml"
        1424
        2)
      (fol_of_form nil lconsts tm))))

(defunc NANOCOP_DEEPEN (opt ths)
  (progn
    (if (deref copverb)
      (progn
        (format-printf "NANOCOP_DEEPEN with ths:
%!")
        (list-iter (o (format-printf "  th: %s
%!") string_of_thm) ths))
      unit)
    (#`reset_vars unit)
    (#`reset_consts unit)
    (let*
      ((gen_eq
        (o
          (o (map #'GEN_ALL) (create_eq_axs (record-field opt :add_eq_symmetry)))
          (map #'concl)))
        (ths%
          (if (list-exists (lambdac (th) (= (concl th) hashek_tm)) ths)
            ths
            (cl:cons hashek_thm ths)))
        (ths%% (setify (append ths% (#`gen_eq ths%))))
        (th (end_itlist CONJ ths%%))
        (fol (fol_of_thm th))
        (mat%% (index_matrix (matrix_of_form fol))))
      (cl:declare (cl:ignorable gen_eq ths% ths%% th fol mat%%))
      (progn
        (if (deref copverb)
          (progn (format-printf "Matrix:
%!") (#`print_matrix_i mat%%))
          unit)
        (matrix2db mat%%)
        (if (deref copverb) (format-printf "Matrix loaded.
%!") unit)
        (match (strategy opt (start mat%%))
          ((tuple sub prfs)
            (progn
              (if (deref copverb)
                (progn (format-printf "Theorem
%!") (print_proof_def sub prfs))
                unit)
              (let*
                ((data (mk_recon_data (tuple th mat%% sub)))
                  (bot (bot_of_proof data nil th prfs)))
                (cl:declare (cl:ignorable data bot))
                (progn
                  (if (deref copverb)
                    (progn (format-printf "Reconstruction:
%!") (#`print_thm bot))
                    unit)
                  (assert-true (set_eq (hyp bot) (hyp th)) "thecops.ml" 1456 2)
                  (assert-true (= (concl bot) (parse_term "F")) "thecops.ml" 1457 2)
                  bot)))))))))

;; (* Debugging tactic. *)


(defunc PRINT_TAC (g%) (progn (if (deref copverb) (#`print_goal g%) unit) (ALL_TAC g%)))

(defunc PRINT_ID_TAC (s g%)
  (progn (if (deref copverb) (print-endline s) unit) (PRINT_TAC g%)))

(defunc PREPARE_NANOCOP_TAC (ths)
  (holai.runtime:proof (PREPARE_COP_TAC ths)
    THEN
      (RULE_ASSUM_TAC (CONV_RULE (#`DEPTH_CONV (CHANGED_CONV (ASSOC_CONV DISJ_ASSOC)))))
    THEN
      (RULE_ASSUM_TAC (CONV_RULE (#`DEPTH_CONV (CHANGED_CONV (ASSOC_CONV CONJ_ASSOC)))))
    THEN (REPEAT (FIRST_X_ASSUM #'SUBST_VAR_TAC))))

(defunc PURE_NANOCOP (opt gl)
  (ORELSE
    (FIRST_ASSUM CONTR_TAC)
    (W
      (o
        (o (o ACCEPT_TAC (NANOCOP_DEEPEN opt)) (map (function-value #'snd 1)))
        (function-value #'fst 1)))
    gl))

(defunc GEN_NANOCOP_TAC (opt ths)
  (holai.runtime:proof (PREPARE_NANOCOP_TAC ths) THEN (PURE_NANOCOP opt)))

(defunc NANOCOP_TAC (ths) (GEN_NANOCOP_TAC search_opts ths))

(defunc NANOCOP (ths tm) (prove (tuple tm (NANOCOP_TAC ths))))

