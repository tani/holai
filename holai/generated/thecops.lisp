        (if (cl:and (is_neg xc) (not (is_neg yc)))
          (#`MP (#`NOT_ELIM x) y)
          (if (cl:and (is_neg yc) (not (is_neg xc)))
            (#`MP (#`NOT_ELIM y) x)
            (failwith "no contradiction found")))))))

