(defparameter INTERS_OVER_UNIONS
  (prove
    (tuple
      (parse_term
        "!f:A->(B->bool)->bool s.
        INTERS { UNIONS(f x) | x IN s} =
        UNIONS { INTERS {g x | x IN s} |g| !x. x IN s ==> g x IN f x}")
      (proof (REPEAT #'GEN_TAC)
        THEN (GEN_REWRITE_TAC #'I (cl:cons EXTENSION nil))
        THEN
          (REWRITE_TAC
            (cl:cons
              SIMPLE_IMAGE
              (cl:cons INTERS_IMAGE (cl:cons UNIONS_IMAGE (cl:cons UNIONS_GSPEC nil)))))
        THEN (REWRITE_TAC (cl:cons IN_UNIONS (cl:cons IN_ELIM_THM nil)))
        THEN (#`X_GEN_TAC (parse_term "b:B"))
        THEN (REWRITE_TAC (cl:cons RIGHT_IMP_EXISTS_THM (cl:cons SKOLEM_THM nil)))
        THEN (MESON_TAC nil)))))

(defparameter INTER_INTERS
  (prove
    (tuple
      (parse_term
        "(!f s:A->bool.
        s INTER INTERS f =
        if f = {} then s else INTERS {s INTER t | t IN f}) /\\
   (!f s:A->bool.
        INTERS f INTER s =
        if f = {} then s else INTERS {t INTER s | t IN f})")
      (proof (REPEAT #'STRIP_TAC)
        THEN COND_CASES_TAC
        THEN
          (#`ASM_REWRITE_TAC
            (cl:cons INTERS_0 (cl:cons INTER_UNIV (cl:cons INTERS_GSPEC nil))))
        THEN (ASM SET_TAC nil)))))

(defparameter UNIONS_OVER_INTERS
  (prove
    (tuple
      (parse_term
        "!f:A->(B->bool)->bool s.
        UNIONS { INTERS(f x) | x IN s} =
        INTERS { UNIONS {g x | x IN s} |g| !x. x IN s ==> g x IN f x}")
      (proof (REPEAT #'GEN_TAC)
        THEN (GEN_REWRITE_TAC #'I (cl:cons EXTENSION nil))
        THEN
          (REWRITE_TAC
            (cl:cons
              SIMPLE_IMAGE
              (cl:cons INTERS_IMAGE (cl:cons UNIONS_IMAGE (cl:cons INTERS_GSPEC nil)))))
        THEN (REWRITE_TAC (cl:cons IN_INTERS (cl:cons IN_ELIM_THM nil)))
        THEN #'GEN_TAC
        THEN
          (ONCE_REWRITE_TAC
            (cl:cons (#`TAUT (parse_term "(p <=> q) <=> (~p <=> ~q)")) nil))
        THEN
          (REWRITE_TAC
            (cl:cons NOT_FORALL_THM (cl:cons NOT_IMP (cl:cons NOT_EXISTS_THM nil))))
        THEN (REWRITE_TAC (cl:cons AND_FORALL_THM (cl:cons (#`GSYM SKOLEM_THM) nil)))
        THEN (MESON_TAC nil)))))

(defparameter UNIONS_EQ_INTERS
  (prove
    (tuple
      (parse_term "!f:(A->bool)->bool. UNIONS f = INTERS f <=> ?s. f = {s}")
      (proof (REWRITE_TAC
