        THEN (MESON_TAC nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Injectivity and surjectivity of image and preimage under a function.      *)
;; (* ------------------------------------------------------------------------- *)


(defparameter INJECTIVE_ON_IMAGE
  (prove
    (tuple
      (parse_term
        "!f:A->B u.
    (!s t. s SUBSET u /\\ t SUBSET u /\\ IMAGE f s = IMAGE f t ==> s = t) <=>
    (!x y. x IN u /\\ y IN u /\\ f x = f y ==> x = y)")
      (proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THENL (cl:cons DISCH_TAC (cl:cons (#`SET_TAC nil) nil))
        THEN
          (MAP_EVERY
            X_GEN_TAC
            (cl:cons (parse_term "x:A") (cl:cons (parse_term "y:A") nil)))
        THEN #'STRIP_TAC
        THEN
          (FIRST_X_ASSUM
            (o
              #'MP_TAC
              (SPECL (cl:cons (parse_term "{x:A}") (cl:cons (parse_term "{y:A}") nil)))))
        THEN (#`ASM_REWRITE_TAC (cl:cons SING_SUBSET (cl:cons IMAGE_CLAUSES nil)))
        THEN (#`SET_TAC nil)))))

(defparameter INJECTIVE_IMAGE
  (prove
    (tuple
      (parse_term
        "!f:A->B.
    (!s t. IMAGE f s = IMAGE f t ==> s = t) <=> (!x y. f x = f y ==> x = y)")
      (proof #'GEN_TAC
        THEN
          (MP_TAC
            (ISPECL
              (cl:cons (parse_term "f:A->B") (cl:cons (parse_term "(:A)") nil))
              INJECTIVE_ON_IMAGE))
        THEN (REWRITE_TAC (cl:cons IN_UNIV (cl:cons SUBSET_UNIV nil)))))))

(defparameter SURJECTIVE_ON_IMAGE
  (prove
    (tuple
      (parse_term
        "!f:A->B u v.
        (!t. t SUBSET v ==> ?s. s SUBSET u /\\ IMAGE f s = t) <=>
        (!y. y IN v ==> ?x. x IN u /\\ f x = y)")
      (proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THENL
          (cl:cons
            (proof DISCH_TAC
              THEN (#`X_GEN_TAC (parse_term "y:B"))
              THEN DISCH_TAC
              THEN (FIRST_X_ASSUM (o #'MP_TAC (#`SPEC (parse_term "{y:B}"))))
              THEN (ASM SET_TAC nil))
            (cl:cons
              (proof DISCH_TAC
                THEN (#`X_GEN_TAC (parse_term "t:B->bool"))
                THEN DISCH_TAC
                THEN (#`EXISTS_TAC (parse_term "{x | x IN u /\\ (f:A->B) x IN t}"))
                THEN (ASM SET_TAC nil))
              nil))))))

(defparameter SURJECTIVE_IMAGE
  (prove
    (tuple
      (parse_term "!f:A->B. (!t. ?s. IMAGE f s = t) <=> (!y. ?x. f x = y)")
      (proof #'GEN_TAC
        THEN
          (MP_TAC
            (ISPECL
              (cl:cons
                (parse_term "f:A->B")
                (cl:cons (parse_term "(:A)") (cl:cons (parse_term "(:B)") nil)))
              SURJECTIVE_ON_IMAGE))
        THEN (REWRITE_TAC (cl:cons IN_UNIV (cl:cons SUBSET_UNIV nil)))))))

(defparameter INJECTIVE_ON_PREIMAGE
  (prove
    (tuple
      (parse_term
        "!f:A->B s u.
        (!t t'. t SUBSET u /\\ t' SUBSET u /\\
                {x | x IN s /\\ f x IN t} = {x | x IN s /\\ f x IN t'}
                ==> t = t') <=>
        u SUBSET IMAGE f s")
      (proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THEN DISCH_TAC
        THENL (cl:cons #'ALL_TAC (cl:cons (ASM SET_TAC nil) nil))
        THEN (REWRITE_TAC (cl:cons SUBSET nil))
        THEN (#`X_GEN_TAC (parse_term "y:B"))
        THEN
          (FIRST_X_ASSUM
            (o
              #'MP_TAC
              (SPECL
                (cl:cons (parse_term "{y:B}") (cl:cons (parse_term "{}:B->bool") nil)))))
        THEN (ASM SET_TAC nil)))))

(defparameter SURJECTIVE_ON_PREIMAGE
  (prove
    (tuple
      (parse_term
        "!f:A->B s u.
        (!k. k SUBSET s
             ==> ?t. t SUBSET u /\\ {x | x IN s /\\ f x IN t} = k) <=>
        IMAGE f s SUBSET u /\\
        (!x y. x IN s /\\ y IN s /\\ f x = f y ==> x = y)")
      (proof (REPEAT #'STRIP_TAC)
        THEN #'EQ_TAC
        THEN DISCH_TAC
        THENL
          (cl:cons
            (proof #'CONJ_TAC
              THENL
                (cl:cons
                  (proof (REWRITE_TAC (cl:cons SUBSET (cl:cons FORALL_IN_IMAGE nil)))
                    THEN (#`X_GEN_TAC (parse_term "x:A"))
                    THEN DISCH_TAC
                    THEN (FIRST_X_ASSUM (o #'MP_TAC (#`SPEC (parse_term "{x:A}"))))
                    THEN (ASM SET_TAC nil))
                  (cl:cons
                    (proof (MAP_EVERY
                        X_GEN_TAC
                        (cl:cons (parse_term "x:A") (cl:cons (parse_term "y:A") nil)))
                      THEN #'STRIP_TAC
                      THEN (FIRST_X_ASSUM (o #'MP_TAC (#`SPEC (parse_term "{x:A}"))))
                      THEN (ASM SET_TAC nil))
                    nil)))
            (cl:cons
              (proof (#`X_GEN_TAC (parse_term "k:A->bool"))
                THEN #'STRIP_TAC
                THEN (#`EXISTS_TAC (parse_term "IMAGE (f:A->B) k"))
                THEN (ASM SET_TAC nil))
              nil))))))

(defparameter INJECTIVE_PREIMAGE
  (prove
    (tuple
      (parse_term
        "!f:A->B.
        (!t t'. {x | f x IN t} = {x | f x IN t'} ==> t = t') <=>
        IMAGE f UNIV = UNIV")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (MP_TAC
            (ISPECL
              (cl:cons
                (parse_term "f:A->B")
                (cl:cons (parse_term "(:A)") (cl:cons (parse_term "(:B)") nil)))
              INJECTIVE_ON_PREIMAGE))
        THEN (REWRITE_TAC (cl:cons IN_UNIV (cl:cons SUBSET_UNIV nil)))
        THEN (#`SET_TAC nil)))))

(defparameter SURJECTIVE_PREIMAGE
  (prove
    (tuple
      (parse_term "!f:A->B. (!k. ?t. {x | f x IN t} = k) <=> (!x y. f x = f y ==> x = y)")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (MP_TAC
            (ISPECL
              (cl:cons
                (parse_term "f:A->B")
                (cl:cons (parse_term "(:A)") (cl:cons (parse_term "(:B)") nil)))
              SURJECTIVE_ON_PREIMAGE))
        THEN (REWRITE_TAC (cl:cons IN_UNIV (cl:cons SUBSET_UNIV nil)))
        THEN (#`SET_TAC nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Existence of bijections between two finite sets of same size.             *)
;; (* ------------------------------------------------------------------------- *)


(defparameter CARD_EQ_BIJECTION
  (prove
    (tuple
      (parse_term
        "!s t. FINITE s /\\ FINITE t /\\ CARD s = CARD t
   ==> ?f:A->B. (!x. x IN s ==> f(x) IN t) /\\
                (!y. y IN t ==> ?x. x IN s /\\ f x = y) /\\
                !x y. x IN s /\\ y IN s /\\ (f x = f y) ==> (x = y)")
      (proof (MP_TAC CARD_LE_INJ)
        THEN (REPEAT (proof (MATCH_MP_TAC MONO_FORALL) THEN #'GEN_TAC))
        THEN (DISCH_THEN (lambdac (th) (proof #'STRIP_TAC THEN (MP_TAC th))))
        THEN (#`ASM_REWRITE_TAC (cl:cons LE_REFL nil))
        THEN (MATCH_MP_TAC MONO_EXISTS)
        THEN (#`ASM_SIMP_TAC (cl:cons SURJECTIVE_IFF_INJECTIVE_GEN nil))
        THEN (MESON_TAC (cl:cons SUBSET (cl:cons IN_IMAGE nil)))))))

(defparameter CARD_EQ_BIJECTIONS
  (prove
    (tuple
      (parse_term
        "!s t. FINITE s /\\ FINITE t /\\ CARD s = CARD t
   ==> ?f:A->B g. (!x. x IN s ==> f(x) IN t /\\ g(f x) = x) /\\
                  (!y. y IN t ==> g(y) IN s /\\ f(g y) = y)")
      (proof (REPEAT #'GEN_TAC)
        THEN (DISCH_THEN (o #'MP_TAC (MATCH_MP CARD_EQ_BIJECTION)))
        THEN (MATCH_MP_TAC MONO_EXISTS)
        THEN (REWRITE_TAC (cl:cons SURJECTIVE_ON_RIGHT_INVERSE nil))
        THEN #'GEN_TAC
        THEN
          (REWRITE_TAC (cl:cons LEFT_AND_EXISTS_THM (cl:cons RIGHT_AND_EXISTS_THM nil)))
        THEN (MATCH_MP_TAC MONO_EXISTS)
        THEN (MESON_TAC nil)))))

(defparameter CARD_EQ_BIJECTIONS_SPECIAL
  (prove
    (tuple
      (parse_term
        "!s t (a:A) (b:B).
         FINITE s /\\ FINITE t /\\ CARD s = CARD t /\\ a IN s /\\ b IN t
         ==> ?f g. f a = b /\\ g b = a /\\
                   (!x. x IN s ==> f x IN t /\\ g (f x) = x) /\\
                   (!y. y IN t ==> g y IN s /\\ f (g y) = y)")
      (proof (REPEAT #'STRIP_TAC)
        THEN
          (MP_TAC
            (ISPECL
              (cl:cons
                (parse_term "s DELETE (a:A)")
                (cl:cons (parse_term "t DELETE (b:B)") nil))
              CARD_EQ_BIJECTIONS))
        THEN
          (#`ASM_SIMP_TAC
            (cl:cons
              FINITE_DELETE
              (cl:cons CARD_DELETE (cl:cons IN_DELETE (cl:cons LEFT_IMP_EXISTS_THM nil)))))
        THEN
          (MAP_EVERY
            X_GEN_TAC
            (cl:cons (parse_term "f:A->B") (cl:cons (parse_term "g:B->A") nil)))
        THEN #'STRIP_TAC
        THEN (#`EXISTS_TAC (parse_term "\\x. if x = a then b else (f:A->B) x"))
        THEN (#`EXISTS_TAC (parse_term "\\y. if y = b then a else (g:B->A) y"))
        THEN (#`ASM_MESON_TAC nil)))))

(defparameter BIJECTIONS_HAS_SIZE
  (prove
    (tuple
      (parse_term
        "!s t f:A->B g.
        (!x. x IN s ==> f(x) IN t /\\ g(f x) = x) /\\
        (!y. y IN t ==> g(y) IN s /\\ f(g y) = y) /\\
        s HAS_SIZE n
        ==> t HAS_SIZE n")
      (proof (REPEAT #'STRIP_TAC)
        THEN (SUBGOAL_THEN (parse_term "t = IMAGE (f:A->B) s") #'SUBST_ALL_TAC)
        THENL
          (cl:cons
            (ASM SET_TAC nil)
            (cl:cons
              (proof (MATCH_MP_TAC HAS_SIZE_IMAGE_INJ) THEN (#`ASM_MESON_TAC nil))
              nil))))))

(defparameter BIJECTIONS_HAS_SIZE_EQ
  (prove
    (tuple
      (parse_term
        "!s t f:A->B g.
        (!x. x IN s ==> f(x) IN t /\\ g(f x) = x) /\\
        (!y. y IN t ==> g(y) IN s /\\ f(g y) = y)
        ==> !n. s HAS_SIZE n <=> t HAS_SIZE n")
      (proof (REPEAT #'STRIP_TAC)
        THEN #'EQ_TAC
        THEN
          (MATCH_MP_TAC
            (ONCE_REWRITE_RULE
              (cl:cons
                (#`TAUT (parse_term "a /\\ b /\\ c ==> d <=> a /\\ b ==> c ==> d"))
                nil)
              BIJECTIONS_HAS_SIZE))
        THENL
          (cl:cons
            (MAP_EVERY
              EXISTS_TAC
              (cl:cons (parse_term "f:A->B") (cl:cons (parse_term "g:B->A") nil)))
            (cl:cons
              (MAP_EVERY
                EXISTS_TAC
                (cl:cons (parse_term "g:B->A") (cl:cons (parse_term "f:A->B") nil)))
              nil))
        THEN (#`ASM_MESON_TAC nil)))))

(defparameter BIJECTIONS_CARD_EQ
  (prove
    (tuple
      (parse_term
        "!s t f:A->B g.
        (FINITE s \\/ FINITE t) /\\
        (!x. x IN s ==> f(x) IN t /\\ g(f x) = x) /\\
        (!y. y IN t ==> g(y) IN s /\\ f(g y) = y)
        ==> CARD s = CARD t")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (DISCH_THEN
            (CONJUNCTS_THEN2 #'MP_TAC (o #'MP_TAC (MATCH_MP BIJECTIONS_HAS_SIZE_EQ))))
        THEN (MESON_TAC (cl:cons HAS_SIZE nil))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Transitive relation with finitely many predecessors is wellfounded.       *)
;; (* ------------------------------------------------------------------------- *)


(defparameter WF_FINITE
  (prove
    (tuple
      (parse_term
        "!(<<). (!x. ~(x << x)) /\\ (!x y z. x << y /\\ y << z ==> x << z) /\\
          (!x:A. FINITE {y | y << x})
          ==> WF(<<)")
      (proof (REPEAT #'STRIP_TAC)
        THEN (REWRITE_TAC (cl:cons WF_DCHAIN nil))
        THEN (DISCH_THEN (X_CHOOSE_THEN (parse_term "s:num->A") STRIP_ASSUME_TAC))
        THEN (SUBGOAL_THEN (parse_term "!m n. m < n ==> (s:num->A) n << s m") ASSUME_TAC)
        THENL
          (cl:cons
            (proof (MATCH_MP_TAC TRANSITIVE_STEPWISE_LT) THEN (#`ASM_MESON_TAC nil))
            (cl:cons #'ALL_TAC nil))
        THEN (MP_TAC (ISPEC (parse_term "s:num->A") INFINITE_IMAGE_INJ))
        THEN ANTS_TAC
        THENL (cl:cons (#`ASM_MESON_TAC (cl:cons LT_CASES nil)) (cl:cons #'ALL_TAC nil))
        THEN (DISCH_THEN (o #'MP_TAC (#`SPEC (parse_term "(:num)"))))
        THEN (REWRITE_TAC (cl:cons num_INFINITE nil))
        THEN (REWRITE_TAC (cl:cons INFINITE nil))
        THEN (MATCH_MP_TAC FINITE_SUBSET)
        THEN (#`EXISTS_TAC (parse_term "s(0) INSERT {y:A | y << s(0)}"))
        THEN (#`ASM_REWRITE_TAC (cl:cons FINITE_INSERT nil))
        THEN
          (REWRITE_TAC
            (cl:cons
              SUBSET
              (cl:cons FORALL_IN_IMAGE (cl:cons IN_UNIV (cl:cons IN_INSERT nil)))))
        THEN INDUCT_TAC
        THEN (REWRITE_TAC (cl:cons IN_ELIM_THM nil))
        THEN (#`ASM_MESON_TAC (cl:cons LT_0 nil))))))

(defparameter WF_PSUBSET
  (prove
    (tuple
      (parse_term "!s:A->bool. FINITE s ==> WF (\\t1 t2. t1 PSUBSET t2 /\\ t2 SUBSET s)")
      (proof (REPEAT #'STRIP_TAC)
        THEN (MATCH_MP_TAC WF_FINITE)
        THEN (SIMP_TAC (cl:cons CONJ_ASSOC nil))
        THEN #'CONJ_TAC
        THENL
          (cl:cons (#`SET_TAC nil) (cl:cons (#`X_GEN_TAC (parse_term "t:A->bool")) nil))
        THEN (MATCH_MP_TAC FINITE_SUBSET)
        THEN (#`EXISTS_TAC (parse_term "{t:A->bool | t SUBSET s}"))
        THEN (#`ASM_SIMP_TAC (cl:cons FINITE_POWERSET nil))
        THEN (#`SET_TAC nil)))))

