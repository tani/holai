(defparameter sup
  (#`new_definition
    (parse_term
      "sup s = @a:real. (!x. x IN s ==> x <= a) /\\
                    !b. (!x. x IN s ==> x <= b) ==> a <= b")))

(defparameter SUP_EQ
  (prove
    (tuple
      (parse_term
        "!s t. (!b. (!x. x IN s ==> x <= b) <=> (!x. x IN t ==> x <= b))
         ==> sup s = sup t")
      (SIMP_TAC (cl:cons sup nil)))))

(defparameter SUP%
  (prove
    (tuple
      (parse_term
        "!s. ~(s = {}) /\\ (?b. !x. x IN s ==> x <= b)
       ==> (!x. x IN s ==> x <= sup s) /\\
           !b. (!x. x IN s ==> x <= b) ==> sup s <= b")
      (proof (REWRITE_TAC (cl:cons sup nil))
        THEN (#`CONV_TAC (#`ONCE_DEPTH_CONV SELECT_CONV))
        THEN (REPEAT #'STRIP_TAC)
        THEN (MATCH_MP_TAC REAL_COMPLETE)
        THEN (#`ASM_MESON_TAC (cl:cons MEMBER_NOT_EMPTY nil))))))

(defparameter SUP_FINITE_LEMMA
