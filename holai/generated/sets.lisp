        THEN #'CONJ_TAC
        THENL
          (cl:cons
            (proof #'GEN_TAC
              THEN
                (SUBGOAL_THEN
                  (parse_term "{(x:A,y:B) | x IN {} /\\ y IN (t x)} = {}")
                  (lambdac (th) (REWRITE_TAC (cl:cons th (cl:cons FINITE_RULES nil)))))
              THEN
                (REWRITE_TAC
                  (cl:cons EXTENSION (cl:cons IN_ELIM_THM (cl:cons NOT_IN_EMPTY nil)))))
            (cl:cons #'ALL_TAC nil))
        THEN
          (MAP_EVERY
            X_GEN_TAC
            (cl:cons (parse_term "a:A") (cl:cons (parse_term "s:A->bool") nil)))
        THEN #'STRIP_TAC
        THEN (#`X_GEN_TAC (parse_term "t:A->B->bool"))
        THEN
          (SUBGOAL_THEN
            (parse_term
              "{(x:A,y:B) | x IN (a INSERT s) /\\ y IN (t x)} =
    IMAGE (\\y. a,y) (t a) UNION {(x,y) | x IN s /\\ y IN (t x)}")
            (lambdac (th)
              (#`ASM_SIMP_TAC
                (cl:cons
                  IN_INSERT
                  (cl:cons FINITE_IMAGE (cl:cons FINITE_UNION (cl:cons th nil)))))))
        THEN
          (REWRITE_TAC
            (cl:cons
              EXTENSION
              (cl:cons
                IN_IMAGE
                (cl:cons IN_ELIM_THM (cl:cons IN_INSERT (cl:cons IN_UNION nil))))))
        THEN (MESON_TAC nil)))))

(defparameter FINITE_PRODUCT
  (prove
    (tuple
      (parse_term
        "!s t. FINITE s /\\ FINITE t ==> FINITE {(x:A,y:B) | x IN s /\\ y IN t}")
      (SIMP_TAC (cl:cons FINITE_PRODUCT_DEPENDENT nil)))))

(defparameter CARD_PRODUCT
  (prove
    (tuple
      (parse_term
        "!s t. FINITE s /\\ FINITE t
         ==> (CARD {(x:A,y:B) | x IN s /\\ y IN t} = CARD s * CARD t)")
      (proof (REPEAT #'STRIP_TAC)
        THEN
          (MP_TAC
            (SPECL
              (cl:cons
                (parse_term "s:A->bool")
                (cl:cons
                  (parse_term "CARD(s:A->bool)")
                  (cl:cons
                    (parse_term "\\x:A. t:B->bool")
                    (cl:cons (parse_term "CARD(t:B->bool)") nil))))
              HAS_SIZE_PRODUCT_DEPENDENT))
        THEN (#`ASM_SIMP_TAC (cl:cons HAS_SIZE nil))))))

(defparameter HAS_SIZE_PRODUCT
  (prove
    (tuple
      (parse_term
        "!s m t n. s HAS_SIZE m /\\ t HAS_SIZE n
             ==> {(x:A,y:B) | x IN s /\\ y IN t} HAS_SIZE (m * n)")
      (SIMP_TAC (cl:cons HAS_SIZE (cl:cons CARD_PRODUCT (cl:cons FINITE_PRODUCT nil)))))))

(#`parse_as_infix (tuple "CROSS" (tuple 22 "right")))

(defparameter CROSS
  (#`new_definition
    (parse_term "(s:A->bool) CROSS (t:B->bool) = {x,y | x IN s /\\ y IN t}")))

(defparameter IN_CROSS
  (prove
    (tuple
      (parse_term "!(x:A) (y:B) s t. (x,y) IN (s CROSS t) <=> x IN s /\\ y IN t")
      (REWRITE_TAC (cl:cons CROSS (cl:cons IN_ELIM_PAIR_THM nil))))))

(defparameter HAS_SIZE_CROSS
  (prove
    (tuple
      (parse_term
        "!(s:A->bool) (t:B->bool) m n.
        s HAS_SIZE m /\\ t HAS_SIZE n ==> (s CROSS t) HAS_SIZE (m * n)")
      (REWRITE_TAC (cl:cons CROSS (cl:cons HAS_SIZE_PRODUCT nil))))))

(defparameter FINITE_CROSS
  (prove
    (tuple
      (parse_term "!(s:A->bool) (t:B->bool). FINITE s /\\ FINITE t ==> FINITE(s CROSS t)")
      (SIMP_TAC (cl:cons CROSS (cl:cons FINITE_PRODUCT nil))))))

(defparameter CARD_CROSS
  (prove
    (tuple
      (parse_term
        "!(s:A->bool) (t:B->bool). FINITE s /\\ FINITE t ==> CARD(s CROSS t) = CARD s * CARD t")
      (SIMP_TAC (cl:cons CROSS (cl:cons CARD_PRODUCT nil))))))

(defparameter CROSS_EQ_EMPTY
  (prove
    (tuple
      (parse_term "!(s:A->bool) (t:B->bool). s CROSS t = {} <=> s = {} \\/ t = {}")
      (proof (REWRITE_TAC
          (cl:cons
            EXTENSION
            (cl:cons FORALL_PAIR_THM (cl:cons IN_CROSS (cl:cons NOT_IN_EMPTY nil)))))
        THEN (MESON_TAC nil)))))

(defparameter CROSS_EMPTY
  (prove
    (tuple
      (parse_term "(!s:A->bool. s CROSS {} = {}) /\\ (!t:B->bool. {} CROSS t = {})")
      (REWRITE_TAC (cl:cons CROSS_EQ_EMPTY nil)))))

(defparameter CROSS_SING
  (prove
    (tuple
      (parse_term "!x:A y:B. {x} CROSS {y} = {(x,y)}")
      (REWRITE_TAC
        (cl:cons
          EXTENSION
          (cl:cons
            FORALL_PAIR_THM
            (cl:cons IN_SING (cl:cons IN_CROSS (cl:cons PAIR_EQ nil)))))))))

(defparameter CROSS_UNIV
  (prove
    (tuple
      (parse_term "(:A) CROSS (:B) = (:A#B)")
      (REWRITE_TAC
        (cl:cons
          CROSS
          (cl:cons
            EXTENSION
            (cl:cons IN_ELIM_PAIR_THM (cl:cons FORALL_PAIR_THM (cl:cons IN_UNIV nil)))))))))

(defparameter FINITE_CROSS_EQ
  (prove
    (tuple
      (parse_term
        "!s:A->bool t:B->bool.
        FINITE(s CROSS t) <=> s = {} \\/ t = {} \\/ FINITE s /\\ FINITE t")
      (proof (REPEAT #'GEN_TAC)
        THEN (ASM_CASES_TAC (parse_term "s:A->bool = {}"))
        THEN (#`ASM_REWRITE_TAC (cl:cons CROSS_EMPTY (cl:cons FINITE_EMPTY nil)))
        THEN (ASM_CASES_TAC (parse_term "t:B->bool = {}"))
        THEN (#`ASM_REWRITE_TAC (cl:cons CROSS_EMPTY (cl:cons FINITE_EMPTY nil)))
        THEN #'EQ_TAC
        THEN (REWRITE_TAC (cl:cons FINITE_CROSS nil))
        THEN (REPEAT #'STRIP_TAC)
        THENL
          (cl:cons
            (FIRST_ASSUM
              (o #'MP_TAC (MATCH_MP (ISPEC (parse_term "FST:A#B->A") FINITE_IMAGE))))
            (cl:cons
              (FIRST_ASSUM
                (o #'MP_TAC (MATCH_MP (ISPEC (parse_term "SND:A#B->B") FINITE_IMAGE))))
              nil))
        THEN (MATCH_MP_TAC (REWRITE_RULE (cl:cons IMP_CONJ_ALT nil) FINITE_SUBSET))
        THEN
          (REWRITE_TAC
            (cl:cons
              SUBSET
              (cl:cons IN_IMAGE (cl:cons EXISTS_PAIR_THM (cl:cons IN_CROSS nil)))))
        THEN (ASM SET_TAC nil)))))

(defparameter INFINITE_CROSS_EQ
  (prove
    (tuple
      (parse_term
        "!(s:A->bool) (t:B->bool).
        INFINITE(s CROSS t) <=>
        ~(s = {}) /\\ INFINITE t \\/ INFINITE s /\\ ~(t = {})")
      (proof (REWRITE_TAC (cl:cons INFINITE (cl:cons FINITE_CROSS_EQ nil)))
        THEN (MESON_TAC (cl:cons FINITE_EMPTY nil))))))

(defparameter FINITE_CROSS_UNIV
  (prove
    (tuple
      (parse_term "FINITE(:A#B) <=> FINITE(:A) /\\ FINITE(:B)")
      (REWRITE_TAC
        (cl:cons
          (#`GSYM CROSS_UNIV)
          (cl:cons FINITE_CROSS_EQ (cl:cons UNIV_NOT_EMPTY nil)))))))

(defparameter INFINITE_CROSS_UNIV
  (prove
    (tuple
      (parse_term "INFINITE(:A#B) <=> INFINITE(:A) \\/ INFINITE(:B)")
      (proof (REWRITE_TAC
          (cl:cons
            (#`GSYM CROSS_UNIV)
            (cl:cons INFINITE_CROSS_EQ (cl:cons UNIV_NOT_EMPTY nil))))
        THEN (MESON_TAC nil)))))

(defparameter FINITE_UNIV_PAIR
  (prove
    (tuple
      (parse_term "FINITE(:A#A) <=> FINITE(:A)")
      (REWRITE_TAC (cl:cons FINITE_CROSS_UNIV nil)))))

(defparameter INFINITE_UNIV_PAIR
  (prove
    (tuple
      (parse_term "INFINITE(:A#A) <=> INFINITE(:A)")
      (REWRITE_TAC (cl:cons INFINITE_CROSS_UNIV nil)))))

(defparameter FORALL_IN_CROSS
  (prove
    (tuple
      (parse_term
        "!P s t. (!z:A#B. z IN s CROSS t ==> P z) <=>
           (!x y. x IN s /\\ y IN t ==> P(x,y))")
      (REWRITE_TAC (cl:cons FORALL_PAIR_THM (cl:cons IN_CROSS nil))))))

(defparameter EXISTS_IN_CROSS
  (prove
    (tuple
      (parse_term
        "!P s t. (?z:A#B. z IN s CROSS t /\\ P z) <=>
           (?x y. x IN s /\\ y IN t /\\ P(x,y))")
      (REWRITE_TAC
        (cl:cons EXISTS_PAIR_THM (cl:cons (#`GSYM CONJ_ASSOC) (cl:cons IN_CROSS nil)))))))

(defparameter SUBSET_CROSS
  (prove
    (tuple
      (parse_term
        "!(s:A->bool) (t:B->bool) s' t'.
        s CROSS t SUBSET s' CROSS t' <=>
        s = {} \\/ t = {} \\/ s SUBSET s' /\\ t SUBSET t'")
      (proof (SIMP_TAC
          (cl:cons
            CROSS
            (cl:cons
              EXTENSION
              (cl:cons
                IN_ELIM_PAIR_THM
                (cl:cons
                  SUBSET
                  (cl:cons FORALL_PAIR_THM (cl:cons IN_CROSS (cl:cons NOT_IN_EMPTY nil))))))))
        THEN (MESON_TAC nil)))))

(defparameter CROSS_MONO
  (prove
    (tuple
      (parse_term
        "!(s:A->bool) (t:B->bool) s' t'. s SUBSET s' /\\ t SUBSET t' ==> s CROSS t SUBSET s' CROSS t'")
      (SIMP_TAC (cl:cons SUBSET_CROSS nil)))))

(defparameter CROSS_EQ
  (prove
    (tuple
      (parse_term
        "!s s':A->bool t t':B->bool.
        s CROSS t = s' CROSS t' <=>
        (s = {} \\/ t = {}) /\\ (s' = {} \\/ t' = {}) \\/ s = s' /\\ t = t'")
      (proof (REWRITE_TAC (cl:cons (#`GSYM SUBSET_ANTISYM_EQ) (cl:cons SUBSET_CROSS nil)))
        THEN (#`SET_TAC nil)))))

(defparameter IMAGE_FST_CROSS
  (prove
    (tuple
      (parse_term
        "!s:A->bool t:B->bool.
        IMAGE FST (s CROSS t) = if t = {} then {} else s")
      (proof (REPEAT #'GEN_TAC)
        THEN COND_CASES_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons CROSS_EMPTY (cl:cons IMAGE_CLAUSES nil)))
        THEN (REWRITE_TAC (cl:cons EXTENSION (cl:cons IN_IMAGE nil)))
        THEN (ONCE_REWRITE_TAC (cl:cons CONJ_SYM nil))
        THEN (REWRITE_TAC (cl:cons EXISTS_IN_CROSS (cl:cons FST nil)))
        THEN (ASM SET_TAC nil)))))

(defparameter IMAGE_SND_CROSS
  (prove
    (tuple
      (parse_term
        "!s:A->bool t:B->bool.
        IMAGE SND (s CROSS t) = if s = {} then {} else t")
      (proof (REPEAT #'GEN_TAC)
        THEN COND_CASES_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons CROSS_EMPTY (cl:cons IMAGE_CLAUSES nil)))
        THEN (REWRITE_TAC (cl:cons EXTENSION (cl:cons IN_IMAGE nil)))
        THEN (ONCE_REWRITE_TAC (cl:cons CONJ_SYM nil))
        THEN (REWRITE_TAC (cl:cons EXISTS_IN_CROSS (cl:cons SND nil)))
        THEN (ASM SET_TAC nil)))))

(defparameter IMAGE_PAIRED_CROSS
  (prove
    (tuple
      (parse_term
        "!(f:A->B) (g:C->D) s t.
         IMAGE (\\(x,y). f x,g y) (s CROSS t) = (IMAGE f s) CROSS (IMAGE g t)")
      (proof (REWRITE_TAC
          (cl:cons
            EXTENSION
            (cl:cons
              IN_IMAGE
              (cl:cons
                EXISTS_PAIR_THM
                (cl:cons IN_CROSS (cl:cons FORALL_PAIR_THM (cl:cons PAIR_EQ nil)))))))
        THEN (MESON_TAC nil)))))

(defparameter CROSS_INTER
  (prove
    (tuple
      (parse_term
        "(!(s:A->bool) (t:B->bool) u.
        s CROSS (t INTER u) = (s CROSS t) INTER (s CROSS u)) /\\
   (!(s:A->bool) t (u:B->bool).
        (s INTER t) CROSS u = (s CROSS u) INTER (t CROSS u))")
      (proof (REWRITE_TAC
          (cl:cons
            EXTENSION
            (cl:cons FORALL_PAIR_THM (cl:cons IN_INTER (cl:cons IN_CROSS nil)))))
        THEN (REPEAT #'STRIP_TAC)
        THEN (#`CONV_TAC TAUT)))))

(defparameter CROSS_UNION
  (prove
    (tuple
      (parse_term
        "(!(s:A->bool) (t:B->bool) u.
        s CROSS (t UNION u) = (s CROSS t) UNION (s CROSS u)) /\\
   (!(s:A->bool) t (u:B->bool).
        (s UNION t) CROSS u = (s CROSS u) UNION (t CROSS u))")
      (proof (REWRITE_TAC
          (cl:cons
            EXTENSION
            (cl:cons FORALL_PAIR_THM (cl:cons IN_UNION (cl:cons IN_CROSS nil)))))
        THEN (REPEAT #'STRIP_TAC)
        THEN (#`CONV_TAC TAUT)))))

(defparameter CROSS_DIFF
  (prove
    (tuple
      (parse_term
        "(!(s:A->bool) (t:B->bool) u.
        s CROSS (t DIFF u) = (s CROSS t) DIFF (s CROSS u)) /\\
   (!(s:A->bool) t (u:B->bool).
        (s DIFF t) CROSS u = (s CROSS u) DIFF (t CROSS u))")
      (proof (REWRITE_TAC
          (cl:cons
            EXTENSION
            (cl:cons FORALL_PAIR_THM (cl:cons IN_DIFF (cl:cons IN_CROSS nil)))))
        THEN (REPEAT #'STRIP_TAC)
        THEN (#`CONV_TAC TAUT)))))

(defparameter INTER_CROSS
  (prove
    (tuple
      (parse_term
        "!(s:A->bool) s' (t:B->bool) t'.
      (s CROSS t) INTER (s' CROSS t') = (s INTER s') CROSS (t INTER t')")
      (proof (REWRITE_TAC
          (cl:cons
            EXTENSION
            (cl:cons IN_INTER (cl:cons FORALL_PAIR_THM (cl:cons IN_CROSS nil)))))
        THEN (#`CONV_TAC TAUT)))))

(defparameter CROSS_UNIONS nil)

(defparameter CROSS_UNIONS_UNIONS nil)

(match
  (o
    #'CONJ_PAIR
    #'prove
    (tuple
      (parse_term
        "(!(f:(A->bool)->bool) (g:(B->bool)->bool).
        (UNIONS f) CROSS (UNIONS g) =
        UNIONS {s CROSS t | s IN f /\\ t IN g}) /\\
   (!(s:A->bool) (f:(A->bool)->bool).
        s CROSS (UNIONS f) = UNIONS {s CROSS t | t IN f}) /\\
   (!(f:(A->bool)->bool) (t:B->bool).
        (UNIONS f) CROSS t = UNIONS {s CROSS t | s IN f})")
      (proof (REWRITE_TAC
          (cl:cons
            UNIONS_GSPEC
            (cl:cons
              EXTENSION
              (cl:cons FORALL_PAIR_THM (cl:cons IN_ELIM_THM (cl:cons IN_CROSS nil))))))
        THEN (#`SET_TAC nil))))
  ((tuple CROSS_UNIONS_UNIONS% CROSS_UNIONS%)
    (setf CROSS_UNIONS CROSS_UNIONS% CROSS_UNIONS_UNIONS CROSS_UNIONS_UNIONS%)))

(defparameter CROSS_INTERS nil)

(defparameter CROSS_INTERS_INTERS nil)

(match
  (o
    #'CONJ_PAIR
    #'prove
    (tuple
      (parse_term
        "(!(f:(A->bool)->bool) (g:(B->bool)->bool).
        (INTERS f) CROSS (INTERS g) =
        if f = {} then INTERS {UNIV CROSS t | t IN g}
        else if g = {} then INTERS {s CROSS UNIV | s IN f}
        else INTERS {s CROSS t | s IN f /\\ t IN g}) /\\
   (!(s:A->bool) (f:(A->bool)->bool).
        s CROSS (INTERS f) =
        if f = {} then s CROSS UNIV else INTERS {s CROSS t | t IN f}) /\\
   (!(f:(A->bool)->bool) (t:B->bool).
        (INTERS f) CROSS t =
        if f = {} then UNIV CROSS t else INTERS {s CROSS t | s IN f})")
      (proof (REPEAT #'STRIP_TAC)
        THEN (REPEAT (proof COND_CASES_TAC THEN (REWRITE_TAC nil)))
        THEN
          (#`ASM_REWRITE_TAC
            (cl:cons
              INTERS_GSPEC
              (cl:cons
                EXTENSION
                (cl:cons
                  FORALL_PAIR_THM
                  (cl:cons IN_ELIM_THM (cl:cons IN_CROSS (cl:cons NOT_IN_EMPTY nil)))))))
        THEN (ASM SET_TAC nil))))
  ((tuple CROSS_INTERS_INTERS% CROSS_INTERS%)
    (setf CROSS_INTERS CROSS_INTERS% CROSS_INTERS_INTERS CROSS_INTERS_INTERS%)))

(defparameter DISJOINT_CROSS
  (prove
    (tuple
      (parse_term
        "!s:A->bool t:B->bool s' t'.
        DISJOINT (s CROSS t) (s' CROSS t') <=>
        DISJOINT s s' \\/ DISJOINT t t'")
      (REWRITE_TAC (cl:cons DISJOINT (cl:cons INTER_CROSS (cl:cons CROSS_EQ_EMPTY nil)))))))

;; (* ------------------------------------------------------------------------- *)
;; (* "Extensional" functions, mapping to a fixed value ARB outside the domain. *)
;; (* Even though these are still total, they're a conveniently better model    *)
;; (* of the partial function space (e.g. the space has the right cardinality). *)
;; (* ------------------------------------------------------------------------- *)


(defparameter ARB (#`new_definition (parse_term "ARB = (@x:A. F)")))

(defparameter EXTENSIONAL
  (#`new_definition (parse_term "EXTENSIONAL s = {f:A->B | !x. ~(x IN s) ==> f x = ARB}")))

(defparameter IN_EXTENSIONAL
  (prove
    (tuple
      (parse_term "!s f:A->B. f IN EXTENSIONAL s <=> (!x. ~(x IN s) ==> f x = ARB)")
      (REWRITE_TAC (cl:cons EXTENSIONAL (cl:cons IN_ELIM_THM nil))))))

(defparameter IN_EXTENSIONAL_UNDEFINED
  (prove
    (tuple
      (parse_term "!s f:A->B x. f IN EXTENSIONAL s /\\ ~(x IN s) ==> f x = ARB")
      (SIMP_TAC (cl:cons IN_EXTENSIONAL nil)))))

(defparameter EXTENSIONAL_EMPTY
  (prove
    (tuple
      (parse_term "EXTENSIONAL {} = {\\x:A. ARB:B}")
      (proof (REWRITE_TAC
          (cl:cons
            EXTENSION
            (cl:cons IN_EXTENSIONAL (cl:cons IN_SING (cl:cons NOT_IN_EMPTY nil)))))
        THEN (REWRITE_TAC (cl:cons FUN_EQ_THM nil))))))

(defparameter EXTENSIONAL_UNIV
  (prove
    (tuple
      (parse_term "!f:A->B. EXTENSIONAL (:A) f")
      (REWRITE_TAC (cl:cons EXTENSIONAL (cl:cons IN_UNIV (cl:cons IN_ELIM_THM nil)))))))

(defparameter EXTENSIONAL_EQ
  (prove
    (tuple
      (parse_term
        "!s f g:A->B.
     f IN EXTENSIONAL s /\\ g IN EXTENSIONAL s /\\ (!x. x IN s ==> f x = g x)
     ==> f = g")
      (proof (REPEAT #'STRIP_TAC)
        THEN (REWRITE_TAC (cl:cons FUN_EQ_THM nil))
        THEN #'GEN_TAC
        THEN (ASM_CASES_TAC (parse_term "x:A IN s"))
        THENL
          (cl:cons
            (#`ASM_SIMP_TAC nil)
            (cl:cons (#`ASM_MESON_TAC (cl:cons IN_EXTENSIONAL_UNDEFINED nil)) nil))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Restriction of a function to an EXTENSIONAL one on a subset.              *)
;; (* ------------------------------------------------------------------------- *)


(defparameter RESTRICTION
  (#`new_definition (parse_term "RESTRICTION s (f:A->B) x = if x IN s then f x else ARB")))

(defparameter RESTRICTION_THM
  (prove
    (tuple
      (parse_term "!s (f:A->B). RESTRICTION s f = \\x. if x IN s then f x else ARB")
      (REWRITE_TAC (cl:cons FUN_EQ_THM (cl:cons RESTRICTION nil))))))

(defparameter RESTRICTION_DEFINED
  (prove
    (tuple
      (parse_term "!s f:A->B x. x IN s ==> RESTRICTION s f x = f x")
      (SIMP_TAC (cl:cons RESTRICTION nil)))))

(defparameter RESTRICTION_UNDEFINED
  (prove
    (tuple
      (parse_term "!s f:A->B x. ~(x IN s) ==> RESTRICTION s f x = ARB")
      (SIMP_TAC (cl:cons RESTRICTION nil)))))

(defparameter RESTRICTION_EQ
  (prove
    (tuple
      (parse_term "!s f:A->B x y. x IN s /\\ f x = y ==> RESTRICTION s f x = y")
      (SIMP_TAC (cl:cons RESTRICTION_DEFINED nil)))))

(defparameter RESTRICTION_IN_EXTENSIONAL
  (prove
    (tuple
      (parse_term "!s f:A->B. RESTRICTION s f IN EXTENSIONAL s")
      (SIMP_TAC (cl:cons IN_EXTENSIONAL (cl:cons RESTRICTION nil))))))

(defparameter RESTRICTION_EXTENSION
  (prove
    (tuple
      (parse_term
        "!s f g:A->B. RESTRICTION s f = RESTRICTION s g <=>
                (!x. x IN s ==> f x = g x)")
      (proof (REPEAT #'GEN_TAC)
        THEN (REWRITE_TAC (cl:cons RESTRICTION (cl:cons FUN_EQ_THM nil)))
        THEN (MESON_TAC nil)))))

(defparameter RESTRICTION_FIXPOINT
  (prove
    (tuple
      (parse_term "!s f:A->B. RESTRICTION s f = f <=> f IN EXTENSIONAL s")
      (proof (REWRITE_TAC
          (cl:cons IN_EXTENSIONAL (cl:cons FUN_EQ_THM (cl:cons RESTRICTION nil))))
        THEN (MESON_TAC nil)))))

(defparameter RESTRICTION_UNIV
  (prove
    (tuple
      (parse_term "!f:A->B. RESTRICTION UNIV f = f")
      (REWRITE_TAC (cl:cons FUN_EQ_THM (cl:cons RESTRICTION (cl:cons IN_UNIV nil)))))))

(defparameter RESTRICTION_RESTRICTION
  (prove
    (tuple
      (parse_term
        "!s t f:A->B.
        s SUBSET t ==> RESTRICTION s (RESTRICTION t f) = RESTRICTION s f")
      (proof (REWRITE_TAC (cl:cons FUN_EQ_THM (cl:cons RESTRICTION nil)))
        THEN (#`SET_TAC nil)))))

(defparameter RESTRICTION_IDEMP
  (prove
    (tuple
      (parse_term "!s f:A->B. RESTRICTION s (RESTRICTION s f) = RESTRICTION s f")
      (REWRITE_TAC
        (cl:cons RESTRICTION_FIXPOINT (cl:cons RESTRICTION_IN_EXTENSIONAL nil))))))

(defparameter IMAGE_RESTRICTION
  (prove
    (tuple
      (parse_term "!f:A->B s t. s SUBSET t ==> IMAGE (RESTRICTION t f) s = IMAGE f s")
      (proof (REWRITE_TAC
          (cl:cons EXTENSION (cl:cons IN_IMAGE (cl:cons RESTRICTION nil))))
        THEN (#`SET_TAC nil)))))

(defparameter RESTRICTION_COMPOSE_RIGHT
  (prove
    (tuple
      (parse_term
        "!f:A->B g:B->C s.
        RESTRICTION s (g o RESTRICTION s f) =
        RESTRICTION s (g o f)")
      (proof (REWRITE_TAC (cl:cons FUN_EQ_THM (cl:cons o_DEF (cl:cons RESTRICTION nil))))
        THEN (SIMP_TAC (cl:cons SUBSET (cl:cons FORALL_IN_IMAGE nil)))
        THEN (#`SET_TAC nil)))))

(defparameter RESTRICTION_COMPOSE_LEFT
  (prove
    (tuple
      (parse_term
        "!f:A->B g:B->C s t.
