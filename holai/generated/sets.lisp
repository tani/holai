                "(!x. P x ==> f(x) = g(k x)) <=> (!y x. P x /\\ y = k x ==> f x = g y)"))
            nil))
        THEN (REWRITE_TAC (cl:cons (#`GSYM SKOLEM_THM) nil))
        THEN (MESON_TAC nil)))))

(defparameter FUNCTION_FACTORS_LEFT
  (prove
    (tuple
      (parse_term "!(f:A->B) (g:A->C). (!x y. g x = g y ==> f x = f y) <=> ?h. f = h o g")
      (REWRITE_TAC
        (cl:cons
          FUN_EQ_THM
          (cl:cons
            o_THM
            (cl:cons
              (#`GSYM
                (REWRITE_RULE nil (ISPEC (parse_term "\\x. T") FUNCTION_FACTORS_LEFT_GEN)))
              nil)))))))

(defparameter FUNCTION_FACTORS_RIGHT_GEN
  (prove
    (tuple
      (parse_term
        "!P (f:A->C) (g:B->C).
        (!x. P x ==> ?y. g(y) = f(x)) <=>
        (?h. !x. P x ==> f(x) = g(h x))")
      (proof (REWRITE_TAC (cl:cons (#`GSYM SKOLEM_THM) nil)) THEN (MESON_TAC nil)))))

(defparameter FUNCTION_FACTORS_RIGHT
  (prove
    (tuple
      (parse_term "!(f:A->C) (g:B->C). (!x. ?y. g(y) = f(x)) <=> ?h. f = g o h")
      (proof (REWRITE_TAC
          (cl:cons FUN_EQ_THM (cl:cons o_THM (cl:cons (#`GSYM SKOLEM_THM) nil))))
        THEN (MESON_TAC nil)))))

(defparameter SURJECTIVE_FORALL_THM
  (prove
    (tuple
      (parse_term "!f:A->B. (!y. ?x. f x = y) <=> (!P. (!x. P(f x)) <=> (!y. P y))")
      (proof #'GEN_TAC
        THEN #'EQ_TAC
        THENL (cl:cons (MESON_TAC nil) (cl:cons #'ALL_TAC nil))
        THEN (DISCH_THEN (lambdac (th) (ONCE_REWRITE_TAC (cl:cons (#`GSYM th) nil))))
        THEN (MESON_TAC nil)))))

(defparameter SURJECTIVE_EXISTS_THM
  (prove
    (tuple
      (parse_term "!f:A->B. (!y. ?x. f x = y) <=> (!P. (?x. P(f x)) <=> (?y. P y))")
      (proof #'GEN_TAC
        THEN #'EQ_TAC
        THENL (cl:cons (MESON_TAC nil) (cl:cons #'ALL_TAC nil))
        THEN (DISCH_THEN (o #'MP_TAC (#`SPEC (parse_term "\\y:B. !x:A. ~(f x = y)"))))
        THEN (MESON_TAC nil)))))

(defparameter SURJECTIVE_IMAGE_THM
  (prove
    (tuple
      (parse_term "!f:A->B. (!y. ?x. f x = y) <=> (!P. IMAGE f {x | P(f x)} = {x | P x})")
      (proof #'GEN_TAC
        THEN
          (REWRITE_TAC (cl:cons EXTENSION (cl:cons IN_IMAGE (cl:cons IN_ELIM_THM nil))))
        THEN #'EQ_TAC
        THENL
          (cl:cons
            #'ALL_TAC
            (cl:cons (DISCH_THEN (o #'MP_TAC (#`SPEC (parse_term "\\y:B. T")))) nil))
        THEN (MESON_TAC nil)))))

(defparameter IMAGE_INJECTIVE_IMAGE_OF_SUBSET
  (prove
    (tuple
      (parse_term
        "!f:A->B s.
     ?t. t SUBSET s /\\
         IMAGE f s = IMAGE f t /\\
         (!x y. x IN t /\\ y IN t /\\ f x = f y ==> x = y)")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (SUBGOAL_THEN
            (parse_term "?g. !y. y IN IMAGE (f:A->B) s ==> g(y) IN s /\\ f(g(y)) = y")
            STRIP_ASSUME_TAC)
        THENL
          (cl:cons
            (proof (REWRITE_TAC (cl:cons (#`GSYM SURJECTIVE_ON_RIGHT_INVERSE) nil))
              THEN (#`SET_TAC nil))
            (cl:cons
              (proof (#`EXISTS_TAC (parse_term "IMAGE (g:B->A) (IMAGE (f:A->B) s)"))
                THEN (ASM SET_TAC nil))
              nil))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Basic combining theorems for finite sets.                                 *)
;; (* ------------------------------------------------------------------------- *)


(defparameter FINITE_EMPTY
  (prove
    (tuple (parse_term "FINITE ({}:A->bool)") (REWRITE_TAC (cl:cons FINITE_RULES nil)))))

(defparameter FINITE_SUBSET
  (prove
    (tuple
      (parse_term "!(s:A->bool) t. FINITE t /\\ s SUBSET t ==> FINITE s")
      (proof (ONCE_REWRITE_TAC (cl:cons SWAP_FORALL_THM nil))
        THEN (REWRITE_TAC (cl:cons IMP_CONJ nil))
        THEN (REWRITE_TAC (cl:cons RIGHT_FORALL_IMP_THM nil))
        THEN (MATCH_MP_TAC FINITE_INDUCT)
        THEN #'CONJ_TAC
        THENL
          (cl:cons
            (MESON_TAC (cl:cons SUBSET_EMPTY (cl:cons FINITE_RULES nil)))
            (cl:cons #'ALL_TAC nil))
        THEN (#`X_GEN_TAC (parse_term "x:A"))
        THEN (#`X_GEN_TAC (parse_term "u:A->bool"))
        THEN DISCH_TAC
        THEN (#`X_GEN_TAC (parse_term "t:A->bool"))
        THEN DISCH_TAC
        THEN (SUBGOAL_THEN (parse_term "FINITE((x:A) INSERT (t DELETE x))") ASSUME_TAC)
        THENL
          (cl:cons
            (proof (MATCH_MP_TAC (#`CONJUNCT2 FINITE_RULES))
              THEN (FIRST_ASSUM #'MATCH_MP_TAC)
              THEN (UNDISCH_TAC (parse_term "t SUBSET (x:A INSERT u)"))
              THEN (#`SET_TAC nil))
            (cl:cons
              (proof (ASM_CASES_TAC (parse_term "x:A IN t"))
                THENL
                  (cl:cons
                    (proof (SUBGOAL_THEN
                        (parse_term "x:A INSERT (t DELETE x) = t")
                        #'SUBST_ALL_TAC)
                      THENL
                        (cl:cons
                          (proof (UNDISCH_TAC (parse_term "x:A IN t"))
                            THEN (#`SET_TAC nil))
                          (cl:cons (#`ASM_REWRITE_TAC nil) nil)))
                    (cl:cons
                      (proof (FIRST_ASSUM #'MATCH_MP_TAC)
                        THEN (UNDISCH_TAC (parse_term "t SUBSET x:A INSERT u"))
                        THEN (UNDISCH_TAC (parse_term "~(x:A IN t)"))
                        THEN (#`SET_TAC nil))
                      nil)))
              nil))))))

(defparameter FINITE_RESTRICT
  (prove
    (tuple
      (parse_term "!s:A->bool P. FINITE s ==> FINITE {x | x IN s /\\ P x}")
      (MESON_TAC (cl:cons SUBSET_RESTRICT (cl:cons FINITE_SUBSET nil))))))

(defparameter FINITE_UNION_IMP
  (prove
    (tuple
      (parse_term "!(s:A->bool) t. FINITE s /\\ FINITE t ==> FINITE (s UNION t)")
      (proof (REWRITE_TAC (cl:cons IMP_CONJ nil))
        THEN (REWRITE_TAC (cl:cons RIGHT_FORALL_IMP_THM nil))
        THEN (MATCH_MP_TAC FINITE_INDUCT)
        THEN (REWRITE_TAC (cl:cons UNION_EMPTY nil))
        THEN
          (SUBGOAL_THEN
            (parse_term "!x s t. (x:A INSERT s) UNION t = x INSERT (s UNION t)")
            (lambdac (th) (REWRITE_TAC (cl:cons th nil))))
        THENL
          (cl:cons (#`SET_TAC nil) (cl:cons (MESON_TAC (cl:cons FINITE_RULES nil)) nil))))))

(defparameter FINITE_UNION
  (prove
    (tuple
      (parse_term "!(s:A->bool) t. FINITE(s UNION t) <=> FINITE(s) /\\ FINITE(t)")
      (proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THENL
          (cl:cons
            (proof (REPEAT #'STRIP_TAC)
              THEN (MATCH_MP_TAC FINITE_SUBSET)
              THEN (#`EXISTS_TAC (parse_term "(s:A->bool) UNION t"))
              THEN (#`ASM_REWRITE_TAC nil)
              THEN (#`SET_TAC nil))
            (cl:cons (#`MATCH_ACCEPT_TAC FINITE_UNION_IMP) nil))))))

(defparameter FINITE_INTER
  (prove
    (tuple
      (parse_term "!(s:A->bool) t. FINITE s \\/ FINITE t ==> FINITE (s INTER t)")
      (MESON_TAC (cl:cons INTER_SUBSET (cl:cons FINITE_SUBSET nil))))))

(defparameter FINITE_INSERT
  (prove
    (tuple
      (parse_term "!(s:A->bool) x. FINITE (x INSERT s) <=> FINITE s")
      (proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THEN DISCH_TAC
        THENL
          (cl:cons
            (proof (MATCH_MP_TAC FINITE_SUBSET)
              THEN (#`EXISTS_TAC (parse_term "x:A INSERT s"))
              THEN (#`ASM_REWRITE_TAC nil)
              THEN (#`SET_TAC nil))
            (cl:cons
              (proof (MATCH_MP_TAC (#`CONJUNCT2 FINITE_RULES))
                THEN (#`ASM_REWRITE_TAC nil))
              nil))))))

(defparameter FINITE_SING
  (prove
    (tuple
      (parse_term "!a:A. FINITE {a}")
      (REWRITE_TAC (cl:cons FINITE_INSERT (cl:cons FINITE_RULES nil))))))

(defparameter FINITE_DELETE_IMP
  (prove
    (tuple
      (parse_term "!(s:A->bool) x. FINITE s ==> FINITE (s DELETE x)")
      (proof (REPEAT #'STRIP_TAC)
        THEN (MATCH_MP_TAC FINITE_SUBSET)
        THEN (#`ASM_REWRITE_TAC nil)
        THEN (ASM SET_TAC nil)))))

(defparameter FINITE_DELETE
  (prove
    (tuple
      (parse_term "!(s:A->bool) x. FINITE (s DELETE x) <=> FINITE s")
      (proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THEN (REWRITE_TAC (cl:cons FINITE_DELETE_IMP nil))
        THEN (ASM_CASES_TAC (parse_term "x:A IN s"))
        THENL
          (cl:cons
            (proof (SUBGOAL_THEN
                (parse_term "s = x INSERT (s DELETE x:A)")
                (lambdac (th)
                  (GEN_REWRITE_TAC (o #'RAND_CONV #'RAND_CONV) (cl:cons th nil))))
              THEN (REWRITE_TAC (cl:cons FINITE_INSERT nil))
              THEN (POP_ASSUM #'MP_TAC)
              THEN (#`SET_TAC nil))
            (cl:cons
              (proof (SUBGOAL_THEN
                  (parse_term "s DELETE x:A = s")
                  (lambdac (th) (REWRITE_TAC (cl:cons th nil))))
                THEN (POP_ASSUM #'MP_TAC)
                THEN (#`SET_TAC nil))
              nil))))))

(defparameter FINITE_FINITE_UNIONS
  (prove
    (tuple
      (parse_term
        "!s:(A->bool)->bool.
        FINITE(s) ==> (FINITE(UNIONS s) <=> (!t. t IN s ==> FINITE(t)))")
      (proof (MATCH_MP_TAC FINITE_INDUCT)
        THEN
          (REWRITE_TAC
            (cl:cons
              IN_INSERT
              (cl:cons NOT_IN_EMPTY (cl:cons UNIONS_0 (cl:cons UNIONS_INSERT nil)))))
        THEN (REWRITE_TAC (cl:cons FINITE_UNION (cl:cons FINITE_RULES nil)))
        THEN (MESON_TAC nil)))))

(defparameter FINITE_IMAGE_EXPAND
  (prove
    (tuple
      (parse_term "!(f:A->B) s. FINITE s ==> FINITE {y | ?x. x IN s /\\ (y = f x)}")
      (proof #'GEN_TAC
        THEN (MATCH_MP_TAC FINITE_INDUCT)
        THEN
          (REWRITE_TAC
            (cl:cons
              NOT_IN_EMPTY
              (cl:cons (REWRITE_RULE nil EMPTY_GSPEC) (cl:cons FINITE_RULES nil))))
        THEN (REPEAT #'GEN_TAC)
        THEN
          (SUBGOAL_THEN
            (parse_term
              "{y | ?z. z IN (x INSERT s) /\\ (y = (f:A->B) z)} =
                {y | ?z. z IN s /\\ (y = f z)} UNION {(f x)}")
            (lambdac (th) (REWRITE_TAC (cl:cons th nil))))
        THENL
          (cl:cons
            (proof (REWRITE_TAC
                (cl:cons
                  EXTENSION
                  (cl:cons
                    IN_ELIM_THM
                    (cl:cons IN_INSERT (cl:cons IN_UNION (cl:cons NOT_IN_EMPTY nil))))))
              THEN (MESON_TAC nil))
            (cl:cons
              (REWRITE_TAC
                (cl:cons FINITE_UNION (cl:cons FINITE_INSERT (cl:cons FINITE_RULES nil))))
              nil))))))

(defparameter FINITE_IMAGE
  (prove
    (tuple
      (parse_term "!(f:A->B) s. FINITE s ==> FINITE (IMAGE f s)")
      (REWRITE_TAC (cl:cons IMAGE (cl:cons FINITE_IMAGE_EXPAND nil))))))

(defparameter FINITE_IMAGE_INJ_GENERAL
  (prove
    (tuple
      (parse_term
        "!(f:A->B) A s.
        (!x y. x IN s /\\ y IN s /\\ f(x) = f(y) ==> x = y) /\\
        FINITE A
        ==> FINITE {x | x IN s /\\ f(x) IN A}")
      (proof (REPEAT #'STRIP_TAC)
        THEN
          (FIRST_X_ASSUM
            (o #'MP_TAC (GEN_REWRITE_RULE #'I (cl:cons INJECTIVE_ON_LEFT_INVERSE nil))))
        THEN (DISCH_THEN (#`X_CHOOSE_TAC (parse_term "g:B->A")))
        THEN (MATCH_MP_TAC FINITE_SUBSET)
        THEN (#`EXISTS_TAC (parse_term "IMAGE (g:B->A) A"))
        THEN (#`ASM_SIMP_TAC (cl:cons FINITE_IMAGE nil))
        THEN (ASM SET_TAC nil)))))

(defparameter FINITE_FINITE_PREIMAGE_GENERAL
  (prove
    (tuple
      (parse_term
        "!f:A->B s t.
        FINITE t /\\
        (!y. y IN t ==> FINITE {x | x IN s /\\ f(x) = y})
        ==> FINITE {x | x IN s /\\ f(x) IN t}")
      (proof (REPEAT #'STRIP_TAC)
        THEN
          (SUBGOAL_THEN
            (parse_term
              "{x | x IN s /\\ (f:A->B)(x) IN t} =
    UNIONS (IMAGE (\\a. {x | x IN s /\\ f x = a}) t)")
            #'SUBST1_TAC)
        THENL
          (cl:cons
            (proof (GEN_REWRITE_TAC #'I (cl:cons EXTENSION nil))
              THEN (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons IN_UNIONS nil)))
              THEN (REWRITE_TAC (cl:cons EXISTS_IN_IMAGE nil))
              THEN (#`SET_TAC nil))
            (cl:cons
              (#`ASM_SIMP_TAC
                (cl:cons
                  FINITE_FINITE_UNIONS
                  (cl:cons FINITE_IMAGE (cl:cons FORALL_IN_IMAGE nil))))
              nil))))))

(defparameter FINITE_FINITE_PREIMAGE
  (prove
    (tuple
      (parse_term
        "!f:A->B t.
        FINITE t /\\
        (!y. y IN t ==> FINITE {x | f(x) = y})
        ==> FINITE {x | f(x) IN t}")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (MP_TAC
            (ISPECL
              (cl:cons
                (parse_term "f:A->B")
                (cl:cons (parse_term "(:A)") (cl:cons (parse_term "t:B->bool") nil)))
              FINITE_FINITE_PREIMAGE_GENERAL))
        THEN (REWRITE_TAC (cl:cons IN_UNIV nil))))))

(defparameter FINITE_IMAGE_INJ_EQ
  (prove
    (tuple
      (parse_term
        "!(f:A->B) s.
        (!x y. x IN s /\\ y IN s /\\ f(x) = f(y) ==> x = y)
        ==> (FINITE(IMAGE f s) <=> FINITE s)")
      (proof (REPEAT #'STRIP_TAC)
        THEN #'EQ_TAC
        THEN (#`ASM_SIMP_TAC (cl:cons FINITE_IMAGE nil))
        THEN (POP_ASSUM #'MP_TAC)
        THEN (REWRITE_TAC (cl:cons IMP_IMP nil))
        THEN (DISCH_THEN (o #'MP_TAC (MATCH_MP FINITE_IMAGE_INJ_GENERAL)))
        THEN (MATCH_MP_TAC EQ_IMP)
        THEN AP_TERM_TAC
        THEN (#`SET_TAC nil)))))

(defparameter FINITE_IMAGE_INJ
  (prove
    (tuple
      (parse_term
        "!(f:A->B) A.
        (!x y. f(x) = f(y) ==> x = y) /\\ FINITE A
        ==> FINITE {x | f(x) IN A}")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (MP_TAC
            (SPECL
              (cl:cons
                (parse_term "f:A->B")
                (cl:cons
                  (parse_term "A:B->bool")
                  (cl:cons (parse_term "UNIV:A->bool") nil)))
              FINITE_IMAGE_INJ_GENERAL))
        THEN (REWRITE_TAC (cl:cons IN_UNIV nil))))))

(defparameter FINITE_IMAGE_GEN
  (prove
    (tuple
      (parse_term
        "!(f:A->B) (g:A->C) s t.
        IMAGE f s SUBSET t /\\ FINITE t /\\
        (!x y. x IN s /\\ y IN s /\\ f x = f y ==> g x = g y)
        ==> FINITE(IMAGE g s)")
      (proof (REPEAT #'STRIP_TAC)
        THEN
          (FIRST_X_ASSUM
            (o #'MP_TAC (GEN_REWRITE_RULE #'I (cl:cons FUNCTION_FACTORS_LEFT_GEN nil))))
        THEN (DISCH_THEN (#`X_CHOOSE_TAC (parse_term "h:B->C")))
        THEN
          (SUBGOAL_THEN
            (parse_term "IMAGE g s = IMAGE (h:B->C) (IMAGE (f:A->B) s)")
            #'SUBST1_TAC)
        THENL
          (cl:cons
            (ASM SET_TAC nil)
            (cl:cons
              (#`ASM_MESON_TAC (cl:cons FINITE_IMAGE (cl:cons FINITE_SUBSET nil)))
              nil))))))

(defparameter INFINITE_IMAGE
  (prove
    (tuple
      (parse_term
        "!f:A->B s.
        INFINITE s /\\ (!x y. x IN s /\\ y IN s /\\ f x = f y ==> x = y)
        ==> INFINITE (IMAGE f s)")
      (proof (REPEAT #'GEN_TAC)
        THEN (REWRITE_TAC (cl:cons IMP_CONJ_ALT (cl:cons INJECTIVE_ON_LEFT_INVERSE nil)))
        THEN (DISCH_THEN (#`X_CHOOSE_TAC (parse_term "g:B->A")))
        THEN (REWRITE_TAC (cl:cons INFINITE (cl:cons CONTRAPOS_THM nil)))
        THEN DISCH_TAC
        THEN (SUBGOAL_THEN (parse_term "s = IMAGE (g:B->A) (IMAGE f s)") #'SUBST1_TAC)
        THENL
          (cl:cons
            (ASM SET_TAC nil)
            (cl:cons (proof (MATCH_MP_TAC FINITE_IMAGE) THEN (#`ASM_REWRITE_TAC nil)) nil))))))

(defparameter INFINITE_IMAGE_INJ
  (prove
    (tuple
      (parse_term
        "!f:A->B. (!x y. (f x = f y) ==> (x = y))
            ==> !s. INFINITE s ==> INFINITE(IMAGE f s)")
      (MESON_TAC (cl:cons INFINITE_IMAGE nil)))))

(defparameter INFINITE_NONEMPTY
  (prove
    (tuple
      (parse_term "!s:A->bool. INFINITE(s) ==> ~(s = EMPTY)")
      (MESON_TAC (cl:cons INFINITE (cl:cons FINITE_RULES nil))))))

(defparameter INFINITE_DIFF_FINITE
  (prove
    (tuple
      (parse_term "!s:A->bool t. INFINITE(s) /\\ FINITE(t) ==> INFINITE(s DIFF t)")
      (proof (REPEAT #'GEN_TAC)
        THEN (MATCH_MP_TAC (#`TAUT (parse_term "(b /\\ ~c ==> ~a) ==> a /\\ b ==> c")))
        THEN (REWRITE_TAC (cl:cons INFINITE nil))
        THEN #'STRIP_TAC
        THEN (MATCH_MP_TAC FINITE_SUBSET)
        THEN (#`EXISTS_TAC (parse_term "(t:A->bool) UNION (s DIFF t)"))
        THEN (#`ASM_REWRITE_TAC (cl:cons FINITE_UNION nil))
        THEN (#`SET_TAC nil)))))

(defparameter SUBSET_IMAGE_INJ
  (prove
    (tuple
      (parse_term
        "!f:A->B s t.
        s SUBSET (IMAGE f t) <=>
        ?u. u SUBSET t /\\
            (!x y. x IN u /\\ y IN u ==> (f x = f y <=> x = y)) /\\
            s = IMAGE f u")
      (proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THENL (cl:cons #'ALL_TAC (cl:cons (MESON_TAC (cl:cons IMAGE_SUBSET nil)) nil))
        THEN DISCH_TAC
        THEN
          (FIRST_ASSUM
            (o
              #'MP_TAC
              (MATCH_MP
                (SET_RULE
                  (parse_term
                    "s SUBSET IMAGE f t ==> !x. x IN s ==> ?y. y IN t /\\ f y = x")))))
        THEN (REWRITE_TAC (cl:cons SURJECTIVE_ON_RIGHT_INVERSE nil))
        THEN (DISCH_THEN (#`X_CHOOSE_TAC (parse_term "g:B->A")))
        THEN (#`EXISTS_TAC (parse_term "IMAGE (g:B->A) s"))
        THEN (ASM SET_TAC nil)))))

(defparameter SUBSET_IMAGE
  (prove
    (tuple
      (parse_term
        "!f:A->B s t. s SUBSET (IMAGE f t) <=> ?u. u SUBSET t /\\ (s = IMAGE f u)")
      (proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THENL (cl:cons #'ALL_TAC (cl:cons (MESON_TAC (cl:cons IMAGE_SUBSET nil)) nil))
        THEN (REWRITE_TAC (cl:cons SUBSET_IMAGE_INJ nil))
        THEN (MATCH_MP_TAC MONO_EXISTS)
        THEN (#`SET_TAC nil)))))

(defparameter EXISTS_SUBSET_IMAGE
  (prove
    (tuple
      (parse_term
        "!P (f:A->B) s.
    (?t. t SUBSET IMAGE f s /\\ P t) <=> (?t. t SUBSET s /\\ P (IMAGE f t))")
      (proof (REWRITE_TAC (cl:cons SUBSET_IMAGE nil)) THEN (MESON_TAC nil)))))

(defparameter FORALL_SUBSET_IMAGE
  (prove
    (tuple
      (parse_term
        "!P (f:A->B) s.
        (!t. t SUBSET IMAGE f s ==> P t) <=>
        (!t. t SUBSET s ==> P(IMAGE f t))")
      (proof (REWRITE_TAC (cl:cons SUBSET_IMAGE nil)) THEN (MESON_TAC nil)))))

(defparameter EXISTS_SUBSET_IMAGE_INJ
  (prove
    (tuple
      (parse_term
        "!P (f:A->B) s.
    (?t. t SUBSET IMAGE f s /\\ P t) <=>
    (?t. t SUBSET s /\\
         (!x y. x IN t /\\ y IN t ==> (f x = f y <=> x = y)) /\\
         P (IMAGE f t))")
      (proof (REWRITE_TAC (cl:cons SUBSET_IMAGE_INJ nil)) THEN (MESON_TAC nil)))))

(defparameter FORALL_SUBSET_IMAGE_INJ
  (prove
    (tuple
      (parse_term
        "!P (f:A->B) s.
        (!t. t SUBSET IMAGE f s ==> P t) <=>
        (!t. t SUBSET s /\\
             (!x y. x IN t /\\ y IN t ==> (f x = f y <=> x = y))
             ==> P(IMAGE f t))")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (ONCE_REWRITE_TAC
            (cl:cons (MESON nil (parse_term "(!t. p t) <=> ~(?t. ~p t)")) nil))
        THEN
          (REWRITE_TAC
            (cl:cons
              NOT_IMP
              (cl:cons EXISTS_SUBSET_IMAGE_INJ (cl:cons (#`GSYM CONJ_ASSOC) nil))))))))

(defparameter EXISTS_FINITE_SUBSET_IMAGE_INJ
  (prove
    (tuple
      (parse_term
        "!P (f:A->B) s.
    (?t. FINITE t /\\ t SUBSET IMAGE f s /\\ P t) <=>
    (?t. FINITE t /\\ t SUBSET s /\\
         (!x y. x IN t /\\ y IN t ==> (f x = f y <=> x = y)) /\\
         P (IMAGE f t))")
      (proof (ONCE_REWRITE_TAC
          (cl:cons (#`TAUT (parse_term "p /\\ q /\\ r <=> q /\\ p /\\ r")) nil))
        THEN (REPEAT #'GEN_TAC)
        THEN (REWRITE_TAC (cl:cons EXISTS_SUBSET_IMAGE_INJ nil))
        THEN AP_TERM_TAC
        THEN #'ABS_TAC
        THEN (MESON_TAC (cl:cons FINITE_IMAGE_INJ_EQ nil))))))

(defparameter FORALL_FINITE_SUBSET_IMAGE_INJ
  (prove
    (tuple
      (parse_term
        "!P (f:A->B) s.
        (!t. FINITE t /\\ t SUBSET IMAGE f s ==> P t) <=>
        (!t. FINITE t /\\ t SUBSET s /\\
             (!x y. x IN t /\\ y IN t ==> (f x = f y <=> x = y))
             ==> P(IMAGE f t))")
      (proof (REPEAT #'GEN_TAC)
        THEN
