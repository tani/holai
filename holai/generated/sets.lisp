      (proof #'GEN_TAC
        THEN DISCH_TAC
        THEN (FIRST_ASSUM (o #'MP_TAC (MATCH_MP SUP_FINITE_LEMMA)))
        THEN
          (#`ASM_MESON_TAC
            (cl:cons REAL_LE_ANTISYM (cl:cons REAL_LE_TOTAL (cl:cons SUP% nil))))))))

(defparameter REAL_LE_SUP_FINITE
  (prove
    (tuple
      (parse_term
        "!s a. FINITE s /\\ ~(s = {}) ==> (a <= sup s <=> ?x. x IN s /\\ a <= x)")
      (MESON_TAC (cl:cons SUP_FINITE (cl:cons REAL_LE_TRANS nil))))))

(defparameter REAL_SUP_LE_FINITE
  (prove
    (tuple
      (parse_term
        "!s a. FINITE s /\\ ~(s = {}) ==> (sup s <= a <=> !x. x IN s ==> x <= a)")
      (MESON_TAC (cl:cons SUP_FINITE (cl:cons REAL_LE_TRANS nil))))))

(defparameter REAL_LT_SUP_FINITE
  (prove
