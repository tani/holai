(defparameter IN_ELIM_PAIR_THM
  (prove
    (tuple
      (parse_term "!(P:A->B->bool) a b. (a,b) IN {(x,y) | P x y} <=> P a b")
      (proof (REWRITE_TAC (cl:cons IN_ELIM_THM nil))
