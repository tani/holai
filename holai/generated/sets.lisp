(defparameter EMPTY_GSPEC (prove (tuple (parse_term "{x:A | F} = {}") (#`SET_TAC nil))))

(defparameter UNIV_GSPEC (prove (tuple (parse_term "{x | T} = (:A)") (#`SET_TAC nil))))

(defparameter SING_GSPEC
