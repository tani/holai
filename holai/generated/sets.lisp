      (proof (REPEAT #'GEN_TAC)
        THEN (GEN_REWRITE_TAC #'I (cl:cons EXTENSION nil))
        THEN
          (REWRITE_TAC
            (cl:cons cartesian_product (cl:cons IN_ELIM_THM (cl:cons EXTENSIONAL nil))))
        THEN (MESON_TAC (cl:cons IN_SING nil))))))

(defparameter RESTRICTION_IN_CARTESIAN_PRODUCT
  (prove
