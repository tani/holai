;; (* ------------------------------------------------------------------------- *)
;; (* General Cartesian product / dependent function space.                     *)
;; (* ------------------------------------------------------------------------- *)


(defparameter cartesian_product
  (#`new_definition
    (parse_term
      "cartesian_product k s =
        {f:K->A | EXTENSIONAL k f /\\ !i. i IN k ==> f i IN s i}")))

(defparameter IN_CARTESIAN_PRODUCT
  (prove
    (tuple
      (parse_term
        "!k s (x:K->A).
        x IN cartesian_product k s <=>
        EXTENSIONAL k x /\\ (!i. i IN k ==> x i IN s i)")
      (REWRITE_TAC (cl:cons cartesian_product (cl:cons IN_ELIM_THM nil))))))

(defparameter CARTESIAN_PRODUCT%
  (prove
    (tuple
      (parse_term
