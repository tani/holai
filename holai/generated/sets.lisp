(defparameter REAL_SUP_UNIQUE
  (prove
    (tuple
      (parse_term
        "!s b. (!x. x IN s ==> x <= b) /\\
         (!b'. b' < b ==> ?x. x IN s /\\ b' < x)
         ==> sup s = b")
