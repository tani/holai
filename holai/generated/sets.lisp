                      THEN DISCH_TAC
                      THEN (UNDISCH_TAC (parse_term "x:A IN s"))
                      THEN (#`ASM_REWRITE_TAC (cl:cons NOT_IN_EMPTY nil)))
                    (cl:cons
                      (proof (IMP_RES_THEN ASSUME_TAC FINREC_SUC_LEMMA)
                        THEN
                          (DISCH_THEN
                            (ANTE_RES_THEN (o #'MP_TAC (#`SPEC (parse_term "x:A")))))
                        THEN (#`ASM_REWRITE_TAC nil)
                        THEN
                          (DISCH_THEN
                            (X_CHOOSE_THEN
                              (parse_term "w:B")
                              (#`CONJUNCTS_THEN ASSUME_TAC)))
                        THEN
                          (SUBGOAL_THEN
                            (parse_term "(g (s DELETE x:A) = w:B)")
                            #'SUBST1_TAC)
                        THENL
                          (cl:cons
                            (proof (SUBGOAL_THEN
                                (parse_term "FINITE(s DELETE x:A)")
                                #'MP_TAC)
                              THENL
                                (cl:cons
                                  (proof (MATCH_MP_TAC FINITE_SUBSET)
                                    THEN (#`EXISTS_TAC (parse_term "s:A->bool"))
                                    THEN (#`ASM_REWRITE_TAC nil)
                                    THEN (#`SET_TAC nil))
                                  (cl:cons
                                    (proof (DISCH_THEN (ANTE_RES_THEN (o #'MP_TAC GSYM)))
                                      THEN
                                        (DISCH_THEN
                                          (lambdac (th) (REWRITE_TAC (cl:cons th nil))))
                                      THEN (#`EXISTS_TAC (parse_term "n:num"))
                                      THEN (#`ASM_REWRITE_TAC nil))
                                    nil)))
                            (cl:cons (#`ASM_REWRITE_TAC nil) nil)))
                      nil)))
              nil))))))

(defparameter SET_RECURSION_LEMMA
  (prove
    (tuple
      (parse_term
        "!(f:A->B->B) b.
        (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s)))
        ==> ?g. (g {} = b) /\\
                !x s. FINITE s
                      ==> (g (x INSERT s) =
                                if x IN s then g s else f x (g s))")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (DISCH_THEN (o (o #'MP_TAC (#`SPEC (parse_term "b:B"))) (MATCH_MP FINREC_FUN)))
        THEN (DISCH_THEN (X_CHOOSE_THEN (parse_term "g:(A->bool)->B") STRIP_ASSUME_TAC))
        THEN (#`EXISTS_TAC (parse_term "g:(A->bool)->B"))
        THEN (#`ASM_REWRITE_TAC nil)
        THEN (REPEAT #'GEN_TAC)
        THEN COND_CASES_TAC
        THEN (#`ASM_REWRITE_TAC nil)
        THEN DISCH_TAC
        THENL
          (cl:cons
            (proof AP_TERM_TAC
              THEN (REWRITE_TAC (cl:cons (#`GSYM ABSORPTION) nil))
              THEN (#`ASM_REWRITE_TAC nil))
            (cl:cons
              (proof (SUBGOAL_THEN
                  (parse_term "FINITE(x:A INSERT s) /\\ x IN (x INSERT s)")
                  #'MP_TAC)
                THENL
                  (cl:cons
                    (proof (REWRITE_TAC (cl:cons IN_INSERT nil))
                      THEN (#`ASM_MESON_TAC (cl:cons FINITE_RULES nil)))
                    (cl:cons
                      (proof (DISCH_THEN (ANTE_RES_THEN #'SUBST1_TAC))
                        THEN (REPEAT AP_TERM_TAC)
                        THEN (UNDISCH_TAC (parse_term "~(x:A IN s)"))
                        THEN (#`SET_TAC nil))
                      nil)))
              nil))))))

(defparameter ITSET
  (#`new_definition
    (parse_term
      "ITSET (f:A->B->B) s b =
        (@g. (g {} = b) /\\
             !x s. FINITE s
                   ==> (g (x INSERT s) = if x IN s then g s else f x (g s)))
        s")))

(defparameter FINITE_RECURSION
  (prove
    (tuple
      (parse_term
        "!(f:A->B->B) b.
        (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s)))
        ==> (ITSET f {} b = b) /\\
            !x s. FINITE s
                  ==> (ITSET f (x INSERT s) b =
                       if x IN s then ITSET f s b
                                 else f x (ITSET f s b))")
      (proof (REPEAT #'GEN_TAC)
        THEN DISCH_TAC
        THEN (REWRITE_TAC (cl:cons ITSET nil))
        THEN (#`CONV_TAC SELECT_CONV)
        THEN (MATCH_MP_TAC SET_RECURSION_LEMMA)
        THEN (#`ASM_REWRITE_TAC nil)))))

(defparameter FINITE_RECURSION_DELETE
  (prove
    (tuple
      (parse_term
        "!(f:A->B->B) b.
        (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s)))
        ==> (ITSET f {} b = b) /\\
            !x s. FINITE s
                  ==> (ITSET f s b =
                       if x IN s then f x (ITSET f (s DELETE x) b)
                                 else ITSET f (s DELETE x) b)")
      (proof (REPEAT #'GEN_TAC)
        THEN (DISCH_THEN (o #'MP_TAC (MATCH_MP FINITE_RECURSION)))
        THEN (DISCH_THEN (o STRIP_ASSUME_TAC (#`SPEC (parse_term "b:B"))))
        THEN (#`ASM_REWRITE_TAC nil)
        THEN (REPEAT #'GEN_TAC)
        THEN (ASM_CASES_TAC (parse_term "x:A IN s"))
        THEN (#`ASM_REWRITE_TAC nil)
        THENL
          (cl:cons
            (proof (DISCH_THEN (o #'MP_TAC (MATCH_MP FINITE_DELETE_IMP)))
              THEN (DISCH_THEN (o (ANTE_RES_THEN #'MP_TAC) (#`SPEC (parse_term "x:A"))))
              THEN (DISCH_THEN (o #'MP_TAC (#`SPEC (parse_term "x:A"))))
              THEN (REWRITE_TAC (cl:cons IN_DELETE nil))
              THEN (DISCH_THEN (o #'SUBST1_TAC #'SYM))
              THEN AP_THM_TAC
              THEN AP_TERM_TAC
              THEN (UNDISCH_TAC (parse_term "x:A IN s"))
              THEN (#`SET_TAC nil))
            (cl:cons
              (proof DISCH_TAC
                THEN AP_THM_TAC
                THEN AP_TERM_TAC
                THEN (UNDISCH_TAC (parse_term "~(x:A IN s)"))
                THEN (#`SET_TAC nil))
              nil))))))

(defparameter ITSET_EQ
  (prove
    (tuple
      (parse_term
        "!s (f:A->B->B) g b.
        FINITE(s) /\\ (!x. x IN s ==> (f x = g x)) /\\
        (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s))) /\\
        (!x y s. ~(x = y) ==> (g x (g y s) = g y (g x s)))
        ==> (ITSET f s b = ITSET g s b)")
      (proof (ONCE_REWRITE_TAC (cl:cons IMP_CONJ nil))
        THEN (REWRITE_TAC (cl:cons RIGHT_FORALL_IMP_THM nil))
        THEN (MATCH_MP_TAC FINITE_INDUCT_STRONG)
        THEN
          (SIMP_TAC
            (cl:cons FINITE_RECURSION (cl:cons NOT_IN_EMPTY (cl:cons IN_INSERT nil))))
        THEN (REPEAT #'STRIP_TAC)
        THEN AP_TERM_TAC
        THEN
          (FIRST_ASSUM
            (o #'MATCH_MP_TAC (REWRITE_RULE (cl:cons RIGHT_IMP_FORALL_THM nil))))
        THEN (#`ASM_MESON_TAC nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Cardinality.                                                              *)
;; (* ------------------------------------------------------------------------- *)


(defparameter CARD
  (#`new_definition (parse_term "CARD (s:A->bool) = ITSET (\\x n. SUC n) s 0")))

(defparameter CARD_CLAUSES
  (prove
    (tuple
      (parse_term
        "(CARD ({}:A->bool) = 0) /\\
   (!(x:A) s. FINITE s ==>
                 (CARD (x INSERT s) =
                      if x IN s then CARD s else SUC(CARD s)))")
      (proof (MP_TAC
          (ISPECL
            (cl:cons (parse_term "\\(x:A) n. SUC n") (cl:cons (parse_term "0") nil))
            FINITE_RECURSION))
        THEN (REWRITE_TAC (cl:cons CARD nil))))))

(defparameter CARD_UNION
  (prove
    (tuple
      (parse_term
        "!(s:A->bool) t. FINITE(s) /\\ FINITE(t) /\\ (s INTER t = EMPTY)
         ==> (CARD (s UNION t) = CARD s + CARD t)")
      (proof (REWRITE_TAC
          (cl:cons
            (#`TAUT (parse_term "a /\\ b /\\ c ==> d <=> a ==> b /\\ c ==> d"))
            nil))
        THEN (REWRITE_TAC (cl:cons RIGHT_FORALL_IMP_THM nil))
        THEN (MATCH_MP_TAC FINITE_INDUCT_STRONG)
        THEN
          (REWRITE_TAC
            (cl:cons
              UNION_EMPTY
              (cl:cons CARD_CLAUSES (cl:cons INTER_EMPTY (cl:cons ADD_CLAUSES nil)))))
        THEN (#`X_GEN_TAC (parse_term "x:A"))
        THEN (#`X_GEN_TAC (parse_term "s:A->bool"))
        THEN (REPEAT #'STRIP_TAC)
        THEN
          (SUBGOAL_THEN
            (parse_term "(x:A INSERT s) UNION t = x INSERT (s UNION t)")
            #'SUBST1_TAC)
        THENL (cl:cons (#`SET_TAC nil) (cl:cons #'ALL_TAC nil))
        THEN
          (SUBGOAL_THEN
            (parse_term "FINITE ((s:A->bool) UNION t) /\\ FINITE s")
            STRIP_ASSUME_TAC)
        THENL
          (cl:cons
            (proof (#`ASM_REWRITE_TAC nil)
              THEN (MATCH_MP_TAC FINITE_UNION_IMP)
              THEN (#`ASM_REWRITE_TAC nil))
            (cl:cons #'ALL_TAC nil))
        THEN
          (MP_TAC
            (ISPECL
              (cl:cons (parse_term "x:A") (cl:cons (parse_term "s:A->bool") nil))
              (#`CONJUNCT2 CARD_CLAUSES)))
        THEN
          (MP_TAC
            (ISPECL
              (cl:cons (parse_term "x:A") (cl:cons (parse_term "s:A->bool UNION t") nil))
              (#`CONJUNCT2 CARD_CLAUSES)))
        THEN (#`ASM_REWRITE_TAC nil)
        THEN DISCH_TAC
        THEN DISCH_TAC
        THEN (#`ASM_REWRITE_TAC nil)
        THEN (SUBGOAL_THEN (parse_term "~(x:A IN (s UNION t))") ASSUME_TAC)
        THENL
          (cl:cons
            (proof (#`ASM_REWRITE_TAC (cl:cons IN_UNION nil))
              THEN (UNDISCH_TAC (parse_term "(x:A INSERT s) INTER t = EMPTY"))
              THEN
                (REWRITE_TAC
                  (cl:cons
                    EXTENSION
                    (cl:cons IN_INSERT (cl:cons IN_INTER (cl:cons NOT_IN_EMPTY nil)))))
              THEN (MESON_TAC nil))
            (cl:cons
              (proof (#`ASM_REWRITE_TAC (cl:cons SUC_INJ (cl:cons ADD_CLAUSES nil)))
                THEN (FIRST_ASSUM #'MATCH_MP_TAC)
                THEN (#`ASM_REWRITE_TAC nil)
                THEN (UNDISCH_TAC (parse_term "x:A INSERT s INTER t = EMPTY"))
                THEN (#`SET_TAC nil))
              nil))))))

(defparameter CARD_DELETE
  (prove
    (tuple
      (parse_term
        "!x:A s. FINITE(s)
           ==> (CARD(s DELETE x) = if x IN s then CARD(s) - 1 else CARD(s))")
      (proof (REPEAT #'STRIP_TAC)
        THEN COND_CASES_TAC
        THENL
          (cl:cons
            (proof (SUBGOAL_THEN
                (parse_term "s = x:A INSERT (s DELETE x)")
                (lambdac (th)
                  (GEN_REWRITE_TAC (o #'RAND_CONV ONCE_DEPTH_CONV) (cl:cons th nil))))
              THENL
                (cl:cons
                  (proof (UNDISCH_TAC (parse_term "x:A IN s")) THEN (#`SET_TAC nil))
                  (cl:cons #'ALL_TAC nil))
              THEN
                (#`ASM_SIMP_TAC
                  (cl:cons
                    CARD_CLAUSES
                    (cl:cons FINITE_DELETE (cl:cons IN_DELETE (cl:cons SUC_SUB1 nil))))))
            (cl:cons
              (proof AP_TERM_TAC
                THEN (UNDISCH_TAC (parse_term "~(x:A IN s)"))
                THEN (#`SET_TAC nil))
              nil))))))

(defparameter CARD_UNION_EQ
  (prove
    (tuple
      (parse_term
        "!s t u:A->bool.
        FINITE u /\\ s INTER t = {} /\\ s UNION t = u
        ==> (CARD s + CARD t = CARD u)")
      (MESON_TAC (cl:cons CARD_UNION (cl:cons FINITE_SUBSET (cl:cons SUBSET_UNION nil)))))))

(defparameter CARD_DIFF
  (prove
    (tuple
      (parse_term
        "!s t:A->bool. FINITE s /\\ t SUBSET s ==> CARD(s DIFF t) = CARD s - CARD t")
      (proof (REPEAT #'STRIP_TAC)
        THEN (MATCH_MP_TAC (#`ARITH_RULE (parse_term "a + b:num = c ==> a = c - b")))
        THEN (MATCH_MP_TAC CARD_UNION_EQ)
        THEN (#`ASM_SIMP_TAC nil)
        THEN (ASM SET_TAC nil)))))

(defparameter CARD_EQ_0
  (prove
    (tuple
      (parse_term "!s:A->bool. FINITE s ==> ((CARD s = 0) <=> (s = {}))")
      (proof (MATCH_MP_TAC FINITE_INDUCT_STRONG)
        THEN
          (SIMP_TAC
            (cl:cons CARD_CLAUSES (cl:cons NOT_INSERT_EMPTY (cl:cons NOT_SUC nil))))))))

(defparameter CARD_SING
  (prove
    (tuple
      (parse_term "!a:A. CARD {a} = 1")
      (SIMP_TAC
        (cl:cons
          CARD_CLAUSES
          (cl:cons
            FINITE_INSERT
            (cl:cons FINITE_EMPTY (cl:cons NOT_IN_EMPTY (cl:cons ARITH nil)))))))))

(defparameter CARD_LE_2
  (prove
    (tuple
      (parse_term "!a (b:A). CARD{a,b} <= 2")
      (proof (SIMP_TAC
          (cl:cons
            CARD_CLAUSES
            (cl:cons
              FINITE_INSERT
              (cl:cons FINITE_EMPTY (cl:cons IN_INSERT (cl:cons NOT_IN_EMPTY nil))))))
        THEN (REPEAT (proof #'GEN_TAC #'ORELSE COND_CASES_TAC))
        THEN ARITH_TAC))))

(defparameter CARD_LE_3
  (prove
    (tuple
      (parse_term "!a b (c:A). CARD{a,b,c} <= 3")
      (proof (SIMP_TAC
          (cl:cons
            CARD_CLAUSES
            (cl:cons
              FINITE_INSERT
              (cl:cons FINITE_EMPTY (cl:cons IN_INSERT (cl:cons NOT_IN_EMPTY nil))))))
        THEN (REPEAT (proof #'GEN_TAC #'ORELSE COND_CASES_TAC))
        THEN ARITH_TAC))))

(defparameter CARD_LE_4
  (prove
    (tuple
      (parse_term "!a b c (d:A). CARD{a,b,c,d} <= 4")
      (proof (SIMP_TAC
          (cl:cons
            CARD_CLAUSES
            (cl:cons
              FINITE_INSERT
              (cl:cons FINITE_EMPTY (cl:cons IN_INSERT (cl:cons NOT_IN_EMPTY nil))))))
        THEN (REPEAT (proof #'GEN_TAC #'ORELSE COND_CASES_TAC))
        THEN ARITH_TAC))))

;; (* ------------------------------------------------------------------------- *)
;; (* A stronger still form of induction where we get to choose the element.    *)
;; (* ------------------------------------------------------------------------- *)


(defparameter FINITE_INDUCT_DELETE
  (prove
    (tuple
      (parse_term
        "!P. P {} /\\
       (!s. FINITE s /\\ ~(s = {}) ==> ?x. x IN s /\\ (P(s DELETE x) ==> P s))
       ==> !s:A->bool. FINITE s ==> P s")
      (proof #'GEN_TAC
        THEN #'STRIP_TAC
        THEN #'GEN_TAC
        THEN (#`WF_INDUCT_TAC (parse_term "CARD(s:A->bool)"))
        THEN (ASM_CASES_TAC (parse_term "s:A->bool = {}"))
        THEN (#`ASM_REWRITE_TAC nil)
        THEN DISCH_TAC
        THEN
          (UNDISCH_TAC
            (parse_term
              "!s. FINITE s /\\ ~(s = {}) ==> ?x:A. x IN s /\\ (P(s DELETE x) ==> P s)"))
        THEN (DISCH_THEN (o #'MP_TAC (#`SPEC (parse_term "s:A->bool"))))
        THEN (#`ASM_REWRITE_TAC nil)
        THEN
          (DISCH_THEN
            (X_CHOOSE_THEN (parse_term "x:A") (CONJUNCTS_THEN2 ASSUME_TAC #'MATCH_MP_TAC)))
        THEN (FIRST_X_ASSUM (o #'MP_TAC (#`SPEC (parse_term "s DELETE (x:A)"))))
        THEN
          (#`ASM_SIMP_TAC
            (cl:cons
              FINITE_DELETE
              (cl:cons
                CARD_DELETE
                (cl:cons
                  CARD_EQ_0
                  (cl:cons (#`ARITH_RULE (parse_term "n - 1 < n <=> ~(n = 0)")) nil)))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Relational form is often more useful.                                     *)
;; (* ------------------------------------------------------------------------- *)


(defparameter HAS_SIZE
  (#`new_definition (parse_term "(s:A->bool) HAS_SIZE n <=> FINITE s /\\ CARD s = n")))

(defparameter HAS_SIZE_CARD
  (prove
    (tuple
      (parse_term "!(s:A->bool) n. s HAS_SIZE n ==> CARD s = n")
      (SIMP_TAC (cl:cons HAS_SIZE nil)))))

(defparameter HAS_SIZE_0
  (prove
    (tuple
      (parse_term "!(s:A->bool). s HAS_SIZE 0 <=> (s = {})")
      (proof (REPEAT #'GEN_TAC)
        THEN (REWRITE_TAC (cl:cons HAS_SIZE nil))
        THEN #'EQ_TAC
        THEN DISCH_TAC
        THEN (#`ASM_REWRITE_TAC (cl:cons FINITE_RULES (cl:cons CARD_CLAUSES nil)))
        THEN (FIRST_ASSUM (o #'MP_TAC CONJUNCT2))
        THEN (FIRST_ASSUM (o #'MP_TAC CONJUNCT1))
        THEN (SPEC_TAC (tuple (parse_term "s:A->bool") (parse_term "s:A->bool")))
        THEN (MATCH_MP_TAC FINITE_INDUCT_STRONG)
        THEN (REWRITE_TAC (cl:cons NOT_INSERT_EMPTY nil))
        THEN (REPEAT #'GEN_TAC)
        THEN #'STRIP_TAC
        THEN
          (FIRST_ASSUM
            (lambdac (th)
              (REWRITE_TAC (cl:cons (MATCH_MP (#`CONJUNCT2 CARD_CLAUSES) th) nil))))
        THEN (#`ASM_REWRITE_TAC (cl:cons NOT_SUC nil))))))

(defparameter HAS_SIZE_SUC
  (prove
    (tuple
      (parse_term
        "!(s:A->bool) n. s HAS_SIZE (SUC n) <=>
                   ~(s = {}) /\\ !a. a IN s ==> (s DELETE a) HAS_SIZE n")
      (proof (REPEAT #'GEN_TAC)
        THEN (REWRITE_TAC (cl:cons HAS_SIZE nil))
        THEN (ASM_CASES_TAC (parse_term "s:A->bool = {}"))
        THEN
          (#`ASM_REWRITE_TAC
            (cl:cons
              CARD_CLAUSES
              (cl:cons FINITE_RULES (cl:cons NOT_IN_EMPTY (cl:cons NOT_SUC nil)))))
        THEN (REWRITE_TAC (cl:cons FINITE_DELETE nil))
        THEN (ASM_CASES_TAC (parse_term "FINITE(s:A->bool)"))
        THEN (#`ASM_REWRITE_TAC (cl:cons NOT_FORALL_THM (cl:cons MEMBER_NOT_EMPTY nil)))
        THEN #'EQ_TAC
        THEN (REPEAT #'STRIP_TAC)
        THENL
          (cl:cons
            (proof (MP_TAC
                (ISPECL
                  (cl:cons (parse_term "a:A") (cl:cons (parse_term "s DELETE a:A") nil))
                  (#`CONJUNCT2 CARD_CLAUSES)))
              THEN (#`ASM_REWRITE_TAC (cl:cons FINITE_DELETE (cl:cons IN_DELETE nil)))
              THEN (SUBGOAL_THEN (parse_term "a INSERT (s DELETE a:A) = s") #'SUBST1_TAC)
              THENL
                (cl:cons
                  (proof (UNDISCH_TAC (parse_term "a:A IN s")) THEN (#`SET_TAC nil))
                  (cl:cons
                    (proof (#`ASM_REWRITE_TAC (cl:cons SUC_INJ nil)) THEN (MESON_TAC nil))
                    nil)))
            (cl:cons
              (proof (FIRST_ASSUM
                  (o
                    #'MP_TAC
                    (GEN_REWRITE_RULE #'I (cl:cons (#`GSYM MEMBER_NOT_EMPTY) nil))))
                THEN (DISCH_THEN (#`X_CHOOSE_TAC (parse_term "a:A")))
                THEN
                  (MP_TAC
                    (ISPECL
                      (cl:cons
                        (parse_term "a:A")
                        (cl:cons (parse_term "s DELETE a:A") nil))
                      (#`CONJUNCT2 CARD_CLAUSES)))
                THEN (#`ASM_REWRITE_TAC (cl:cons FINITE_DELETE (cl:cons IN_DELETE nil)))
                THEN
                  (SUBGOAL_THEN (parse_term "a INSERT (s DELETE a:A) = s") #'SUBST1_TAC)
                THENL
                  (cl:cons
                    (proof (UNDISCH_TAC (parse_term "a:A IN s")) THEN (#`SET_TAC nil))
                    (cl:cons (#`ASM_MESON_TAC nil) nil)))
              nil))))))

(defparameter HAS_SIZE_UNION
  (prove
    (tuple
      (parse_term
        "!(s:A->bool) t m n.
        s HAS_SIZE m /\\ t HAS_SIZE n /\\ DISJOINT s t
        ==> (s UNION t) HAS_SIZE (m + n)")
      (SIMP_TAC
        (cl:cons
          HAS_SIZE
          (cl:cons FINITE_UNION (cl:cons DISJOINT (cl:cons CARD_UNION nil))))))))

(defparameter HAS_SIZE_DIFF
  (prove
    (tuple
      (parse_term
        "!(s:A->bool) t m n.
        s HAS_SIZE m /\\ t HAS_SIZE n /\\ t SUBSET s
        ==> (s DIFF t) HAS_SIZE (m - n)")
      (SIMP_TAC (cl:cons HAS_SIZE (cl:cons FINITE_DIFF (cl:cons CARD_DIFF nil)))))))

(defparameter HAS_SIZE_UNIONS
  (prove
    (tuple
      (parse_term
        "!s t:A->B->bool m n.
        s HAS_SIZE m /\\
        (!x. x IN s ==> t(x) HAS_SIZE n) /\\
        (!x y. x IN s /\\ y IN s /\\ ~(x = y) ==> DISJOINT (t x) (t y))
        ==> UNIONS {t(x) | x IN s} HAS_SIZE (m * n)")
      (proof (GEN_REWRITE_TAC
          (o (funpow 4 #'BINDER_CONV) (funpow 2 LAND_CONV))
          (cl:cons HAS_SIZE nil))
        THEN (REWRITE_TAC (cl:cons (#`GSYM CONJ_ASSOC) nil))
        THEN (ONCE_REWRITE_TAC (cl:cons IMP_CONJ nil))
        THEN (REWRITE_TAC (cl:cons RIGHT_FORALL_IMP_THM nil))
        THEN (MATCH_MP_TAC FINITE_INDUCT_STRONG)
        THEN #'CONJ_TAC
        THENL
          (cl:cons
            (proof (REPEAT #'GEN_TAC)
              THEN (REWRITE_TAC (cl:cons CARD_CLAUSES nil))
              THEN (DISCH_THEN (CONJUNCTS_THEN2 (o #'SUBST1_TAC #'SYM) (K #'ALL_TAC)))
              THEN
                (REWRITE_TAC
                  (cl:cons MULT_CLAUSES (cl:cons HAS_SIZE_0 (cl:cons EMPTY_UNIONS nil))))
              THEN (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons NOT_IN_EMPTY nil))))
            (cl:cons #'ALL_TAC nil))
        THEN
          (MAP_EVERY
            X_GEN_TAC
            (cl:cons (parse_term "x:A") (cl:cons (parse_term "s:A->bool") nil)))
        THEN #'STRIP_TAC
        THEN
          (MAP_EVERY
            X_GEN_TAC
            (cl:cons
              (parse_term "t:A->B->bool")
              (cl:cons (parse_term "m:num") (cl:cons (parse_term "n:num") nil))))
        THEN (#`ASM_SIMP_TAC (cl:cons CARD_CLAUSES nil))
        THEN (DISCH_THEN (CONJUNCTS_THEN2 (o #'SUBST1_TAC #'SYM) STRIP_ASSUME_TAC))
        THEN
          (REWRITE_TAC
            (cl:cons
              (SET_RULE
                (parse_term
                  "UNIONS {t y | y IN x INSERT s} = t x UNION UNIONS {t y | y IN s}"))
              nil))
        THEN
          (REWRITE_TAC (cl:cons (#`ARITH_RULE (parse_term "SUC a * b = b + a * b")) nil))
        THEN (MATCH_MP_TAC HAS_SIZE_UNION)
        THEN (#`ASM_SIMP_TAC (cl:cons IN_INSERT nil))
        THEN
          (REWRITE_TAC
            (cl:cons
              (SET_RULE
                (parse_term "DISJOINT a (UNIONS s) <=> !x. x IN s ==> DISJOINT a x"))
              nil))
        THEN (#`ASM_SIMP_TAC (cl:cons IN_ELIM_THM (cl:cons LEFT_IMP_EXISTS_THM nil)))
        THEN (#`ASM_MESON_TAC (cl:cons IN_INSERT nil))))))

(defparameter FINITE_HAS_SIZE
  (prove
    (tuple
      (parse_term "!s:A->bool. FINITE s <=> s HAS_SIZE CARD s")
      (REWRITE_TAC (cl:cons HAS_SIZE nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* This is often more useful as a rewrite.                                   *)
;; (* ------------------------------------------------------------------------- *)


(defparameter HAS_SIZE_CLAUSES
  (prove
    (tuple
      (parse_term
        "(s HAS_SIZE 0 <=> s = {}) /\\
   (s HAS_SIZE (SUC n) <=>
        ?(a:A) t. t HAS_SIZE n /\\ ~(a IN t) /\\ (s = a INSERT t))")
      (let ((lemma (SET_RULE (parse_term "a IN s ==> (s = a INSERT (s DELETE a))"))))
        (cl:declare (cl:ignorable lemma))
        (proof (REWRITE_TAC (cl:cons HAS_SIZE_0 nil))
          THEN (REPEAT #'STRIP_TAC)
          THEN #'EQ_TAC
          THENL
            (cl:cons
              (proof (REWRITE_TAC
                  (cl:cons HAS_SIZE_SUC (cl:cons (#`GSYM MEMBER_NOT_EMPTY) nil)))
                THEN (MESON_TAC (cl:cons lemma (cl:cons IN_DELETE nil))))
              (cl:cons
                (SIMP_TAC
                  (cl:cons
                    LEFT_IMP_EXISTS_THM
                    (cl:cons HAS_SIZE (cl:cons CARD_CLAUSES (cl:cons FINITE_INSERT nil)))))
                nil)))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Produce an explicit expansion for "s HAS_SIZE n" for numeral n.           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter HAS_SIZE_CONV
  (let
    ((pth
      (prove
        (tuple
          (parse_term
            "(~((a:A) IN {}) /\\ P <=> P) /\\
     (~(a IN {b}) /\\ P <=> ~(a = b) /\\ P) /\\
     (~(a IN (b INSERT cs)) /\\ P <=> ~(a = b) /\\ ~(a IN cs) /\\ P)")
          (#`SET_TAC nil))))
      (qth
        (prove
          (tuple
            (parse_term
              "((?s. s HAS_SIZE 0 /\\ P s) <=> P {}) /\\
     ((?s. s HAS_SIZE (SUC n) /\\ P s) <=>
      (?(a:A) s. s HAS_SIZE n /\\ ~(a IN s) /\\ P(a INSERT s)))")
            (proof (REWRITE_TAC (cl:cons HAS_SIZE_CLAUSES nil)) THEN (MESON_TAC nil))))))
    (cl:declare (cl:ignorable pth qth))
    (let
      ((qconv_0 (GEN_REWRITE_CONV #'I (cl:cons (#`CONJUNCT1 qth) nil)))
        (qconv_1 (GEN_REWRITE_CONV #'I (cl:cons (#`CONJUNCT2 qth) nil)))
        (rconv_0 (GEN_REWRITE_CONV #'I (cl:cons (#`CONJUNCT1 pth) nil)))
        (rconv_1 (GEN_REWRITE_CONV #'I (cl:cons (#`CONJUNCT2 pth) nil))))
      (cl:declare (cl:ignorable qconv_0 qconv_1 rconv_0 rconv_1))
      (labelsc
        ((EXISTS_HAS_SIZE_AND_CONV (tm)
          (ORELSEC
            qconv_0
            (THENC
              (THENC (BINDER_CONV (#`LAND_CONV (RAND_CONV num_CONV))) qconv_1)
              (BINDER_CONV #'EXISTS_HAS_SIZE_AND_CONV))
            tm))
          (NOT_IN_INSERT_CONV (tm)
            (ORELSEC
              (ORELSEC
                (THENC rconv_0 #'NOT_IN_INSERT_CONV)
                (THENC rconv_1 (RAND_CONV #'NOT_IN_INSERT_CONV)))
              ALL_CONV
              tm)))
        (let
          ((HAS_SIZE_CONV%
            (ORELSEC
              (GEN_REWRITE_CONV #'I (cl:cons (#`CONJUNCT1 HAS_SIZE_CLAUSES) nil))
              (THENC
                (THENC
                  (RAND_CONV num_CONV)
                  (GEN_REWRITE_CONV #'I (cl:cons (#`CONJUNCT2 HAS_SIZE_CLAUSES) nil)))
                (BINDER_CONV #'EXISTS_HAS_SIZE_AND_CONV)))))
          (cl:declare (cl:ignorable HAS_SIZE_CONV%))
          (lambdac (tm)
            (let* ((th (#`HAS_SIZE_CONV% tm)) (tm% (rand (concl th))))
              (cl:declare (cl:ignorable th tm%))
              (match (#`strip_exists tm%)
                ((tuple evs bod)
                  (if (= evs nil)
                    th
                    (let
                      ((th%
                        (funpow (#`length evs) #'BINDER_CONV #'NOT_IN_INSERT_CONV tm%)))
                      (cl:declare (cl:ignorable th%))
                      (TRANS th th%))))))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Various useful lemmas about cardinalities of unions etc.                  *)
;; (* ------------------------------------------------------------------------- *)


(defparameter CARD_SUBSET_EQ
  (prove
    (tuple
      (parse_term
        "!(a:A->bool) b. FINITE b /\\ a SUBSET b /\\ (CARD a = CARD b) ==> (a = b)")
      (proof (REPEAT #'STRIP_TAC)
        THEN
          (MP_TAC
            (SPECL
              (cl:cons
                (parse_term "a:A->bool")
                (cl:cons (parse_term "b DIFF (a:A->bool)") nil))
              CARD_UNION))
        THEN (SUBGOAL_THEN (parse_term "FINITE(a:A->bool)") ASSUME_TAC)
        THENL
          (cl:cons (#`ASM_MESON_TAC (cl:cons FINITE_SUBSET nil)) (cl:cons #'ALL_TAC nil))
        THEN (SUBGOAL_THEN (parse_term "FINITE(b:A->bool DIFF a)") ASSUME_TAC)
        THENL
          (cl:cons
            (proof (MATCH_MP_TAC FINITE_SUBSET)
              THEN (#`EXISTS_TAC (parse_term "b:A->bool"))
              THEN (#`ASM_REWRITE_TAC nil)
              THEN (#`SET_TAC nil))
            (cl:cons #'ALL_TAC nil))
        THEN (SUBGOAL_THEN (parse_term "a:A->bool INTER (b DIFF a) = EMPTY") ASSUME_TAC)
        THENL (cl:cons (#`SET_TAC nil) (cl:cons #'ALL_TAC nil))
        THEN (#`ASM_REWRITE_TAC nil)
        THEN (SUBGOAL_THEN (parse_term "a UNION (b:A->bool DIFF a) = b") ASSUME_TAC)
        THENL
          (cl:cons
            (proof (UNDISCH_TAC (parse_term "a:A->bool SUBSET b")) THEN (#`SET_TAC nil))
            (cl:cons #'ALL_TAC nil))
        THEN (#`ASM_REWRITE_TAC nil)
        THEN
          (REWRITE_TAC
            (cl:cons (#`ARITH_RULE (parse_term "(a = a + b) <=> (b = 0)")) nil))
        THEN DISCH_TAC
        THEN (SUBGOAL_THEN (parse_term "b:A->bool DIFF a = EMPTY") #'MP_TAC)
        THENL
          (cl:cons
            (proof (REWRITE_TAC (cl:cons (#`GSYM HAS_SIZE_0) nil))
              THEN (#`ASM_REWRITE_TAC (cl:cons HAS_SIZE nil)))
            (cl:cons
              (proof (UNDISCH_TAC (parse_term "a:A->bool SUBSET b")) THEN (#`SET_TAC nil))
              nil))))))

(defparameter CARD_SUBSET
  (prove
    (tuple
      (parse_term "!(a:A->bool) b. a SUBSET b /\\ FINITE(b) ==> CARD(a) <= CARD(b)")
      (proof (REPEAT #'STRIP_TAC)
        THEN (SUBGOAL_THEN (parse_term "b:A->bool = a UNION (b DIFF a)") #'SUBST1_TAC)
        THENL
          (cl:cons
            (proof (UNDISCH_TAC (parse_term "a:A->bool SUBSET b")) THEN (#`SET_TAC nil))
            (cl:cons #'ALL_TAC nil))
        THEN
          (SUBGOAL_THEN
            (parse_term "CARD (a UNION b DIFF a) = CARD(a:A->bool) + CARD(b DIFF a)")
            #'SUBST1_TAC)
        THENL
          (cl:cons
            (proof (MATCH_MP_TAC CARD_UNION)
              THEN (REPEAT #'CONJ_TAC)
              THENL
                (cl:cons
                  (proof (MATCH_MP_TAC FINITE_SUBSET)
                    THEN (#`EXISTS_TAC (parse_term "b:A->bool"))
                    THEN (#`ASM_REWRITE_TAC nil))
                  (cl:cons
                    (proof (MATCH_MP_TAC FINITE_SUBSET)
                      THEN (#`EXISTS_TAC (parse_term "b:A->bool"))
                      THEN (#`ASM_REWRITE_TAC nil)
                      THEN (#`SET_TAC nil))
                    (cl:cons (#`SET_TAC nil) nil))))
            (cl:cons ARITH_TAC nil))))))

(defparameter CARD_SUBSET_LE
  (prove
    (tuple
      (parse_term
        "!(a:A->bool) b. FINITE b /\\ a SUBSET b /\\ CARD b <= CARD a ==> a = b")
      (MESON_TAC (cl:cons CARD_SUBSET (cl:cons CARD_SUBSET_EQ (cl:cons LE_ANTISYM nil)))))))

(defparameter SUBSET_CARD_EQ
  (prove
    (tuple
      (parse_term "!s t:A->bool. FINITE t /\\ s SUBSET t ==> (CARD s = CARD t <=> s = t)")
      (MESON_TAC (cl:cons CARD_SUBSET_EQ (cl:cons LE_ANTISYM (cl:cons CARD_SUBSET nil)))))))

(defparameter FINITE_CARD_LE_SUBSET
  (prove
    (tuple
      (parse_term
        "!s (t:A->bool) n.
        s SUBSET t /\\ FINITE t /\\ CARD t <= n
        ==> FINITE s /\\ CARD s <= n")
      (MESON_TAC (cl:cons FINITE_SUBSET (cl:cons CARD_SUBSET (cl:cons LE_TRANS nil)))))))

(defparameter CARD_PSUBSET
  (prove
    (tuple
      (parse_term "!(a:A->bool) b. a PSUBSET b /\\ FINITE(b) ==> CARD(a) < CARD(b)")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (REWRITE_TAC
            (cl:cons
              (SET_RULE
                (parse_term
                  "a PSUBSET b <=> ?x. x IN b /\\ ~(x IN a) /\\ a SUBSET (b DELETE x)"))
              nil))
        THEN (DISCH_THEN (CONJUNCTS_THEN2 #'MP_TAC ASSUME_TAC))
        THEN (DISCH_THEN (X_CHOOSE_THEN (parse_term "x:A") STRIP_ASSUME_TAC))
        THEN (MATCH_MP_TAC LET_TRANS)
        THEN (#`EXISTS_TAC (parse_term "CARD(b DELETE (x:A))"))
        THEN (#`ASM_SIMP_TAC (cl:cons CARD_SUBSET (cl:cons FINITE_DELETE nil)))
        THEN
          (#`ASM_SIMP_TAC
            (cl:cons
              CARD_DELETE
              (cl:cons (#`ARITH_RULE (parse_term "n - 1 < n <=> ~(n = 0)")) nil)))
        THEN (#`ASM_MESON_TAC (cl:cons CARD_EQ_0 (cl:cons MEMBER_NOT_EMPTY nil)))))))

(defparameter CARD_PSUBSET_IMP
  (prove
    (tuple
      (parse_term "!a b:A->bool. a SUBSET b /\\ ~(CARD a = CARD b) ==> a PSUBSET b")
      (proof (REWRITE_TAC (cl:cons PSUBSET nil)) THEN (MESON_TAC nil)))))

(defparameter CARD_PSUBSET_EQ
  (prove
    (tuple
      (parse_term
        "!a b:A->bool. FINITE b /\\ a SUBSET b ==> (a PSUBSET b <=> CARD a < CARD b)")
      (MESON_TAC (cl:cons CARD_PSUBSET_IMP (cl:cons CARD_PSUBSET (cl:cons LT_REFL nil)))))))

(defparameter CARD_UNION_LE
  (prove
    (tuple
      (parse_term
        "!s t:A->bool.
        FINITE s /\\ FINITE t ==> CARD(s UNION t) <= CARD(s) + CARD(t)")
      (proof (REPEAT #'STRIP_TAC)
        THEN (MATCH_MP_TAC LE_TRANS)
        THEN (#`EXISTS_TAC (parse_term "CARD(s:A->bool) + CARD(t DIFF s)"))
        THEN
          (#`ASM_SIMP_TAC
            (cl:cons
              LE_ADD_LCANCEL
              (cl:cons CARD_SUBSET (cl:cons SUBSET_DIFF (cl:cons FINITE_DIFF nil)))))
        THEN (MATCH_MP_TAC EQ_IMP_LE)
        THEN
          (ONCE_REWRITE_TAC
            (cl:cons (SET_RULE (parse_term "s UNION t = s UNION (t DIFF s)")) nil))
        THEN (MATCH_MP_TAC CARD_UNION)
        THEN (#`ASM_SIMP_TAC (cl:cons FINITE_DIFF nil))
        THEN (#`SET_TAC nil)))))

(defparameter FINITE_CARD_LE_UNION
  (prove
    (tuple
      (parse_term
        "!s (t:A->bool) m n.
        (FINITE s /\\ CARD s <= m) /\\
        (FINITE t /\\ CARD t <= n)
        ==> FINITE(s UNION t) /\\ CARD(s UNION t) <= m + n")
      (MESON_TAC
        (cl:cons
          FINITE_UNION
          (cl:cons CARD_UNION_LE (cl:cons LE_ADD2 (cl:cons LE_TRANS nil))))))))

(defparameter CARD_UNIONS_LE
  (prove
    (tuple
      (parse_term
        "!s t:A->B->bool m n.
        s HAS_SIZE m /\\ (!x. x IN s ==> FINITE(t x) /\\ CARD(t x) <= n)
        ==> CARD(UNIONS {t(x) | x IN s}) <= m * n")
      (proof (GEN_REWRITE_TAC
          (o (funpow 4 #'BINDER_CONV) (funpow 2 LAND_CONV))
          (cl:cons HAS_SIZE nil))
        THEN (REWRITE_TAC (cl:cons (#`GSYM CONJ_ASSOC) nil))
        THEN (ONCE_REWRITE_TAC (cl:cons IMP_CONJ nil))
        THEN (REWRITE_TAC (cl:cons RIGHT_FORALL_IMP_THM nil))
        THEN (MATCH_MP_TAC FINITE_INDUCT_STRONG)
        THEN #'CONJ_TAC
        THEN
          (REWRITE_TAC
            (cl:cons
              (SET_RULE (parse_term "UNIONS {t x | x IN {}} = {}"))
              (cl:cons CARD_CLAUSES (cl:cons LE_0 nil))))
        THEN (REPEAT #'GEN_TAC)
        THEN #'STRIP_TAC
        THEN (REPEAT #'GEN_TAC)
        THEN (#`ASM_SIMP_TAC (cl:cons CARD_CLAUSES (cl:cons FINITE_RULES nil)))
        THEN (DISCH_THEN (CONJUNCTS_THEN2 (o #'SUBST_ALL_TAC #'SYM) ASSUME_TAC))
        THEN
          (REWRITE_TAC
            (cl:cons
              (SET_RULE
                (parse_term
                  "UNIONS {t x | x IN a INSERT s} = t(a) UNION UNIONS {t x | x IN s}"))
              nil))
        THEN (MATCH_MP_TAC LE_TRANS)
        THEN
          (#`EXISTS_TAC
            (parse_term
              "CARD((t:A->B->bool) x) + CARD(UNIONS {(t:A->B->bool) y | y IN s})"))
        THEN #'CONJ_TAC
        THENL
          (cl:cons
            (proof (MATCH_MP_TAC CARD_UNION_LE)
              THEN (#`ASM_SIMP_TAC (cl:cons IN_INSERT nil))
              THEN
                (REWRITE_TAC
                  (cl:cons (SET_RULE (parse_term "{t x | x IN s} = IMAGE t s")) nil))
              THEN
                (#`ASM_SIMP_TAC
                  (cl:cons
                    FINITE_FINITE_UNIONS
                    (cl:cons
                      FINITE_IMAGE
                      (cl:cons FORALL_IN_IMAGE (cl:cons IN_INSERT nil))))))
            (cl:cons
              (proof (MATCH_MP_TAC
                  (#`ARITH_RULE
                    (parse_term "a <= n /\\ b <= x * n ==> a + b <= SUC x * n")))
                THEN (#`ASM_SIMP_TAC (cl:cons IN_INSERT nil)))
              nil))))))

(defparameter CARD_UNION_GEN
  (prove
    (tuple
      (parse_term
        "!s t:A->bool.
        FINITE s /\\ FINITE t
        ==> CARD(s UNION t) = (CARD(s) + CARD(t)) - CARD(s INTER t)")
      (proof (REPEAT #'STRIP_TAC)
        THEN
          (ONCE_REWRITE_TAC
            (cl:cons (SET_RULE (parse_term "s UNION t = s UNION (t DIFF s)")) nil))
        THEN
          (#`ASM_SIMP_TAC
            (cl:cons
              (#`ARITH_RULE (parse_term "x:num <= y ==> (a + y) - x = a + (y - x)"))
              (cl:cons
                CARD_SUBSET
                (cl:cons INTER_SUBSET (cl:cons (#`GSYM CARD_DIFF) nil)))))
        THEN
          (REWRITE_TAC
            (cl:cons (SET_RULE (parse_term "t DIFF (s INTER t) = t DIFF s")) nil))
        THEN (MATCH_MP_TAC CARD_UNION)
        THEN (#`ASM_SIMP_TAC (cl:cons FINITE_DIFF nil))
        THEN (#`SET_TAC nil)))))

(defparameter CARD_UNION_OVERLAP_EQ
  (prove
    (tuple
      (parse_term
        "!s t:A->bool.
        FINITE s /\\ FINITE t
        ==> (CARD(s UNION t) = CARD s + CARD t <=> s INTER t = {})")
      (proof (REPEAT #'GEN_TAC)
        THEN #'STRIP_TAC
        THEN (#`ASM_SIMP_TAC (cl:cons CARD_UNION_GEN nil))
        THEN
          (REWRITE_TAC
            (cl:cons (#`ARITH_RULE (parse_term "a - b = a <=> b = 0 \\/ a = 0")) nil))
        THEN
          (#`ASM_SIMP_TAC
            (cl:cons ADD_EQ_0 (cl:cons CARD_EQ_0 (cl:cons FINITE_INTER nil))))
        THEN (#`SET_TAC nil)))))

(defparameter CARD_UNION_OVERLAP
  (prove
    (tuple
      (parse_term
        "!s t:A->bool.
        FINITE s /\\ FINITE t /\\ CARD(s UNION t) < CARD(s) + CARD(t)
        ==> ~(s INTER t = {})")
      (proof (SIMP_TAC (cl:cons (#`GSYM CARD_UNION_OVERLAP_EQ) nil)) THEN ARITH_TAC))))

;; (* ------------------------------------------------------------------------- *)
;; (* Cardinality of image under maps, injective or general.                    *)
;; (* ------------------------------------------------------------------------- *)


(defparameter CARD_IMAGE_INJ
  (prove
    (tuple
      (parse_term
        "!(f:A->B) s. (!x y. x IN s /\\ y IN s /\\ (f(x) = f(y)) ==> (x = y)) /\\
                FINITE s ==> (CARD (IMAGE f s) = CARD s)")
      (proof #'GEN_TAC
        THEN
          (REWRITE_TAC
            (cl:cons (#`TAUT (parse_term "a /\\ b ==> c <=> b ==> a ==> c")) nil))
        THEN (MATCH_MP_TAC FINITE_INDUCT_STRONG)
        THEN (REWRITE_TAC (cl:cons NOT_IN_EMPTY (cl:cons IMAGE_CLAUSES nil)))
        THEN (REPEAT #'STRIP_TAC)
        THEN
          (#`ASM_SIMP_TAC
            (cl:cons CARD_CLAUSES (cl:cons FINITE_IMAGE (cl:cons IN_IMAGE nil))))
        THEN COND_CASES_TAC
        THEN (#`ASM_MESON_TAC (cl:cons IN_INSERT nil))))))

(defparameter HAS_SIZE_IMAGE_INJ
  (prove
    (tuple
      (parse_term
        "!(f:A->B) s n.
        (!x y. x IN s /\\ y IN s /\\ (f(x) = f(y)) ==> (x = y)) /\\ s HAS_SIZE n
        ==> (IMAGE f s) HAS_SIZE n")
      (proof (SIMP_TAC (cl:cons HAS_SIZE (cl:cons FINITE_IMAGE nil)))
        THEN (MESON_TAC (cl:cons CARD_IMAGE_INJ nil))))))

(defparameter CARD_IMAGE_LE
  (prove
    (tuple
      (parse_term "!(f:A->B) s. FINITE s ==> CARD(IMAGE f s) <= CARD s")
      (proof #'GEN_TAC
        THEN (MATCH_MP_TAC FINITE_INDUCT_STRONG)
        THEN
          (SIMP_TAC
            (cl:cons
              IMAGE_CLAUSES
              (cl:cons CARD_CLAUSES (cl:cons FINITE_IMAGE (cl:cons LE_REFL nil)))))
        THEN (REPEAT #'GEN_TAC)
        THEN COND_CASES_TAC
        THEN (DISCH_THEN (o #'MP_TAC CONJUNCT1))
        THEN ARITH_TAC))))

(defparameter FINITE_CARD_LE_IMAGE
  (prove
    (tuple
      (parse_term
        "!(f:A->B) s n.
        FINITE s /\\ CARD s <= n ==> FINITE(IMAGE f s) /\\ CARD(IMAGE f s) <= n")
      (MESON_TAC (cl:cons CARD_IMAGE_LE (cl:cons LE_TRANS (cl:cons FINITE_IMAGE nil)))))))

(defparameter CARD_IMAGE_INJ_EQ
  (prove
    (tuple
      (parse_term
        "!f:A->B s t.
        FINITE s /\\
        (!x. x IN s ==> f(x) IN t) /\\
        (!y. y IN t ==> ?!x. x IN s /\\ f(x) = y)
        ==> CARD t = CARD s")
      (proof (REPEAT #'STRIP_TAC)
        THEN (SUBGOAL_THEN (parse_term "t = IMAGE (f:A->B) s") #'SUBST1_TAC)
        THENL
          (cl:cons
            (proof (REWRITE_TAC (cl:cons EXTENSION (cl:cons IN_IMAGE nil)))
              THEN (#`ASM_MESON_TAC nil))
            (cl:cons (proof (MATCH_MP_TAC CARD_IMAGE_INJ) THEN (#`ASM_MESON_TAC nil)) nil))))))

(defparameter CARD_SUBSET_IMAGE
  (prove
    (tuple
      (parse_term "!(f:A->B) s t. FINITE t /\\ s SUBSET IMAGE f t ==> CARD s <= CARD t")
      (MESON_TAC
        (cl:cons
          LE_TRANS
          (cl:cons FINITE_IMAGE (cl:cons CARD_IMAGE_LE (cl:cons CARD_SUBSET nil))))))))

(defparameter HAS_SIZE_IMAGE_INJ_EQ
  (prove
    (tuple
      (parse_term
        "!(f:A->B) s n.
        (!x y. x IN s /\\ y IN s /\\ f x = f y ==> x = y)
        ==> ((IMAGE f s) HAS_SIZE n <=> s HAS_SIZE n)")
      (proof (REPEAT #'STRIP_TAC)
        THEN (REWRITE_TAC (cl:cons HAS_SIZE nil))
        THEN
          (MATCH_MP_TAC
            (#`TAUT
              (parse_term "(a' <=> a) /\\ (a ==> (b' <=> b)) ==> (a' /\\ b' <=> a /\\ b)")))
        THEN #'CONJ_TAC
        THENL
          (cl:cons
            (MATCH_MP_TAC FINITE_IMAGE_INJ_EQ)
            (cl:cons
              (proof DISCH_TAC
                THEN AP_THM_TAC
                THEN AP_TERM_TAC
                THEN (MATCH_MP_TAC CARD_IMAGE_INJ))
              nil))
        THEN (#`ASM_REWRITE_TAC nil)))))

(defparameter CARD_IMAGE_EQ_INJ
  (prove
    (tuple
      (parse_term
        "!f:A->B s.
        FINITE s
        ==> (CARD(IMAGE f s) = CARD s <=>
             !x y. x IN s /\\ y IN s /\\ f x = f y ==> x = y)")
      (proof (REPEAT #'STRIP_TAC)
        THEN #'EQ_TAC
        THENL
          (cl:cons DISCH_TAC (cl:cons (#`ASM_MESON_TAC (cl:cons CARD_IMAGE_INJ nil)) nil))
        THEN
          (MAP_EVERY
            X_GEN_TAC
            (cl:cons (parse_term "x:A") (cl:cons (parse_term "y:A") nil)))
        THEN #'STRIP_TAC
        THEN (ASM_CASES_TAC (parse_term "x:A = y"))
        THEN (#`ASM_REWRITE_TAC nil)
        THEN (UNDISCH_TAC (parse_term "CARD(IMAGE (f:A->B) s) = CARD s"))
        THEN
          (SUBGOAL_THEN
