(#`parse_as_infix (tuple "IN" (tuple 11 "right")))

(#`parse_as_infix (tuple "SUBSET" (tuple 12 "right")))

(#`parse_as_infix (tuple "PSUBSET" (tuple 12 "right")))

(#`parse_as_infix (tuple "INTER" (tuple 20 "right")))

(#`parse_as_infix (tuple "UNION" (tuple 16 "right")))

(#`parse_as_infix (tuple "DIFF" (tuple 18 "left")))

(#`parse_as_infix (tuple "INSERT" (tuple 21 "right")))

(#`parse_as_infix (tuple "DELETE" (tuple 21 "left")))

(#`parse_as_infix (tuple "HAS_SIZE" (tuple 12 "right")))

(#`parse_as_infix (tuple "<=_c" (tuple 12 "right")))

(#`parse_as_infix (tuple "<_c" (tuple 12 "right")))

(#`parse_as_infix (tuple ">=_c" (tuple 12 "right")))

(#`parse_as_infix (tuple ">_c" (tuple 12 "right")))

(#`parse_as_infix (tuple "=_c" (tuple 12 "right")))

;; (* ------------------------------------------------------------------------- *)
;; (* Set membership.                                                           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter IN (#`new_definition (parse_term "!P:A->bool. !x. x IN P <=> P x")))

;; (* ------------------------------------------------------------------------- *)
;; (* Axiom of extensionality in this framework.                                *)
;; (* ------------------------------------------------------------------------- *)


(defparameter EXTENSION
  (prove
    (tuple
      (parse_term "!s t. (s = t) <=> !x:A. x IN s <=> x IN t")
      (REWRITE_TAC (cl:cons IN (cl:cons FUN_EQ_THM nil))))))

;; (* ------------------------------------------------------------------------- *)
;; (* General specification.                                                    *)
;; (* ------------------------------------------------------------------------- *)


(defparameter GSPEC (#`new_definition (parse_term "GSPEC (p:A->bool) = p")))

(defparameter SETSPEC
  (#`new_definition (parse_term "SETSPEC (v:A) P t <=> P /\\ (v = t)")))

;; (* ------------------------------------------------------------------------- *)
;; (* Rewrite rule for eliminating set-comprehension membership assertions.     *)
;; (* ------------------------------------------------------------------------- *)


(defparameter IN_ELIM_THM
  (prove
    (tuple
      (parse_term
        "(!P x:A. x IN GSPEC (\\v. P (SETSPEC v)) <=> P (\\p t. p /\\ (x = t))) /\\
   (!p x:A. x IN GSPEC (\\v. ?y. SETSPEC v (p y) y) <=> p x) /\\
   (!P x:A. GSPEC (\\v. P (SETSPEC v)) x <=> P (\\p t. p /\\ (x = t))) /\\
   (!p x:A. GSPEC (\\v. ?y. SETSPEC v (p y) y) x <=> p x) /\\
   (!p x:A. x IN (\\y. p y) <=> p x)")
      (proof (REPEAT #'STRIP_TAC)
        THEN (REWRITE_TAC (cl:cons IN (cl:cons GSPEC nil)))
        THEN (TRY (proof AP_TERM_TAC THEN (REWRITE_TAC (cl:cons FUN_EQ_THM nil))))
        THEN (REWRITE_TAC (cl:cons SETSPEC nil))
        THEN (MESON_TAC nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* These two definitions are needed first, for the parsing of enumerations.  *)
;; (* ------------------------------------------------------------------------- *)


(defparameter EMPTY (#`new_definition (parse_term "EMPTY = (\\x:A. F)")))

(defparameter INSERT_DEF
  (#`new_definition (parse_term "x INSERT s = \\y:A. y IN s \\/ (y = x)")))

;; (* ------------------------------------------------------------------------- *)
;; (* The other basic operations.                                               *)
;; (* ------------------------------------------------------------------------- *)


(defparameter UNIV (#`new_definition (parse_term "UNIV = (\\x:A. T)")))

(defparameter UNION
  (#`new_definition (parse_term "s UNION t = {x:A | x IN s \\/ x IN t}")))

(defparameter UNIONS
  (#`new_definition (parse_term "UNIONS s = {x:A | ?u. u IN s /\\ x IN u}")))

(defparameter INTER
  (#`new_definition (parse_term "s INTER t = {x:A | x IN s /\\ x IN t}")))

(defparameter INTERS
  (#`new_definition (parse_term "INTERS s = {x:A | !u. u IN s ==> x IN u}")))

(defparameter DIFF
  (#`new_definition (parse_term "s DIFF t =  {x:A | x IN s /\\ ~(x IN t)}")))

(defparameter INSERT
  (prove
    (tuple
      (parse_term "x INSERT s = {y:A | y IN s \\/ (y = x)}")
      (REWRITE_TAC (cl:cons EXTENSION (cl:cons INSERT_DEF (cl:cons IN_ELIM_THM nil)))))))

(defparameter DELETE
  (#`new_definition (parse_term "s DELETE x = {y:A | y IN s /\\ ~(y = x)}")))

;; (* ------------------------------------------------------------------------- *)
;; (* Other basic predicates.                                                   *)
;; (* ------------------------------------------------------------------------- *)


(defparameter SUBSET
  (#`new_definition (parse_term "s SUBSET t <=> !x:A. x IN s ==> x IN t")))

(defparameter PSUBSET
  (#`new_definition (parse_term "(s:A->bool) PSUBSET t <=> s SUBSET t /\\ ~(s = t)")))

(defparameter DISJOINT
  (#`new_definition (parse_term "DISJOINT (s:A->bool) t <=> (s INTER t = EMPTY)")))

(defparameter SING (#`new_definition (parse_term "SING s = ?x:A. s = {x}")))

;; (* ------------------------------------------------------------------------- *)
;; (* Finiteness.                                                               *)
;; (* ------------------------------------------------------------------------- *)


(defparameter FINITE_CASES nil)

(defparameter FINITE_INDUCT nil)

(defparameter FINITE_RULES nil)

(match
  (#`new_inductive_definition
    (parse_term
      "FINITE (EMPTY:A->bool) /\\
     !(x:A) s. FINITE s ==> FINITE (x INSERT s)"))
  ((tuple FINITE_RULES% FINITE_INDUCT% FINITE_CASES%)
    (setf
      FINITE_CASES
      FINITE_CASES%
      FINITE_INDUCT
      FINITE_INDUCT%
      FINITE_RULES
      FINITE_RULES%)))

(defparameter INFINITE
  (#`new_definition (parse_term "INFINITE (s:A->bool) <=> ~(FINITE s)")))

;; (* ------------------------------------------------------------------------- *)
;; (* Stuff concerned with functions.                                           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter IMAGE
  (#`new_definition (parse_term "IMAGE (f:A->B) s = { y | ?x. x IN s /\\ (y = f x)}")))

(defparameter INJ
  (#`new_definition
    (parse_term
      "INJ (f:A->B) s t <=>
     (!x. x IN s ==> (f x) IN t) /\\
     (!x y. x IN s /\\ y IN s /\\ (f x = f y) ==> (x = y))")))

(defparameter SURJ
  (#`new_definition
    (parse_term
      "SURJ (f:A->B) s t <=>
     (!x. x IN s ==> (f x) IN t) /\\
     (!x. (x IN t) ==> ?y. y IN s /\\ (f y = x))")))

(defparameter BIJ
  (#`new_definition (parse_term "BIJ (f:A->B) s t <=> INJ f s t /\\ SURJ f s t")))

;; (* ------------------------------------------------------------------------- *)
;; (* Another funny thing.                                                      *)
;; (* ------------------------------------------------------------------------- *)


(defparameter CHOICE (#`new_definition (parse_term "CHOICE s = @x:A. x IN s")))

(defparameter REST
  (#`new_definition (parse_term "REST (s:A->bool) = s DELETE (CHOICE s)")))

;; (* ------------------------------------------------------------------------- *)
;; (* Basic membership properties.                                              *)
;; (* ------------------------------------------------------------------------- *)


(defparameter NOT_IN_EMPTY
  (prove
    (tuple
      (parse_term "!x:A. ~(x IN EMPTY)")
      (REWRITE_TAC (cl:cons IN (cl:cons EMPTY nil))))))

(defparameter IN_UNIV
  (prove
    (tuple (parse_term "!x:A. x IN UNIV") (REWRITE_TAC (cl:cons UNIV (cl:cons IN nil))))))

(defparameter IN_UNION
  (prove
    (tuple
      (parse_term "!s t (x:A). x IN (s UNION t) <=> x IN s \\/ x IN t")
      (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons UNION nil))))))

(defparameter IN_UNIONS
  (prove
    (tuple
      (parse_term "!s (x:A). x IN (UNIONS s) <=> ?t. t IN s /\\ x IN t")
      (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons UNIONS nil))))))

(defparameter IN_INTER
  (prove
    (tuple
      (parse_term "!s t (x:A). x IN (s INTER t) <=> x IN s /\\ x IN t")
      (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons INTER nil))))))

(defparameter IN_INTERS
  (prove
    (tuple
      (parse_term "!s (x:A). x IN (INTERS s) <=> !t. t IN s ==> x IN t")
      (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons INTERS nil))))))

(defparameter IN_DIFF
  (prove
    (tuple
      (parse_term "!(s:A->bool) t x. x IN (s DIFF t) <=> x IN s /\\ ~(x IN t)")
      (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons DIFF nil))))))

(defparameter IN_INSERT
  (prove
    (tuple
      (parse_term "!x:A. !y s. x IN (y INSERT s) <=> (x = y) \\/ x IN s")
      (proof (ONCE_REWRITE_TAC (cl:cons DISJ_SYM nil))
        THEN (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons INSERT nil)))))))

(defparameter IN_DELETE
  (prove
    (tuple
      (parse_term "!s. !x:A. !y. x IN (s DELETE y) <=> x IN s /\\ ~(x = y)")
      (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons DELETE nil))))))

(defparameter IN_SING
  (prove
    (tuple
      (parse_term "!x y. x IN {y:A} <=> (x = y)")
      (REWRITE_TAC (cl:cons IN_INSERT (cl:cons NOT_IN_EMPTY nil))))))

(defparameter IN_IMAGE
  (prove
    (tuple
      (parse_term "!y:B. !s f. (y IN (IMAGE f s)) <=> ?x:A. (y = f x) /\\ x IN s")
      (proof (ONCE_REWRITE_TAC (cl:cons CONJ_SYM nil))
        THEN (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons IMAGE nil)))))))

(defparameter IN_REST
  (prove
    (tuple
      (parse_term "!x:A. !s. x IN (REST s) <=> x IN s /\\ ~(x = CHOICE s)")
      (REWRITE_TAC (cl:cons REST (cl:cons IN_DELETE nil))))))

(defparameter FORALL_IN_INSERT
  (prove
    (tuple
      (parse_term
        "!P a s. (!x:A. x IN (a INSERT s) ==> P x) <=> P a /\\ (!x. x IN s ==> P x)")
      (proof (REWRITE_TAC (cl:cons IN_INSERT nil)) THEN (MESON_TAC nil)))))

(defparameter EXISTS_IN_INSERT
  (prove
    (tuple
      (parse_term
        "!P a s. (?x:A. x IN (a INSERT s) /\\ P x) <=> P a \\/ ?x. x IN s /\\ P x")
      (proof (REWRITE_TAC (cl:cons IN_INSERT nil)) THEN (MESON_TAC nil)))))

(defparameter FORALL_IN_UNION
  (prove
    (tuple
      (parse_term
        "!P s t:A->bool.
        (!x. x IN s UNION t ==> P x) <=>
        (!x. x IN s ==> P x) /\\ (!x. x IN t ==> P x)")
      (proof (REWRITE_TAC (cl:cons IN_UNION nil)) THEN (MESON_TAC nil)))))

(defparameter EXISTS_IN_UNION
  (prove
    (tuple
      (parse_term
        "!P s t:A->bool.
        (?x. x IN s UNION t /\\ P x) <=>
        (?x. x IN s /\\ P x) \\/ (?x. x IN t /\\ P x)")
      (proof (REWRITE_TAC (cl:cons IN_UNION nil)) THEN (MESON_TAC nil)))))

(defparameter FORALL_IN_IMAGE
  (prove
    (tuple
      (parse_term "!(f:A->B) s. (!y. y IN IMAGE f s ==> P y) <=> (!x. x IN s ==> P(f x))")
      (proof (REWRITE_TAC (cl:cons IN_IMAGE nil)) THEN (MESON_TAC nil)))))

(defparameter EXISTS_IN_IMAGE
  (prove
    (tuple
      (parse_term "!(f:A->B) s. (?y. y IN IMAGE f s /\\ P y) <=> ?x. x IN s /\\ P(f x)")
      (proof (REWRITE_TAC (cl:cons IN_IMAGE nil)) THEN (MESON_TAC nil)))))

(defparameter FORALL_IN_GSPEC
  (prove
    (tuple
      (parse_term
        "(!P Q (f:A->B). (!z. z IN {f x | P x} ==> Q z) <=> (!x. P x ==> Q(f x))) /\\
   (!P Q (f:A->B->C).
        (!z. z IN {f x y | P x y} ==> Q z) <=>
        (!x y. P x y ==> Q(f x y))) /\\
   (!P Q (f:A->B->C->D).
        (!z. z IN {f w x y | P w x y} ==> Q z) <=>
        (!w x y. P w x y ==> Q(f w x y))) /\\
   (!P Q (f:A->B->C->D->E).
        (!z. z IN {f v w x y | P v w x y} ==> Q z) <=>
        (!v w x y. P v w x y ==> Q(f v w x y)))")
      (proof (REWRITE_TAC (cl:cons GSPEC (cl:cons IN_ELIM_THM nil))) THEN (MESON_TAC nil)))))

(defparameter EXISTS_IN_GSPEC
  (prove
    (tuple
      (parse_term
        "(!P Q (f:A->B). (?z. z IN {f x | P x} /\\ Q z) <=> (?x. P x /\\ Q(f x))) /\\
   (!P Q (f:A->B->C).
        (?z. z IN {f x y | P x y} /\\ Q z) <=>
        (?x y. P x y /\\ Q(f x y))) /\\
   (!P Q (f:A->B->C->D).
        (?z. z IN {f w x y | P w x y} /\\ Q z) <=>
        (?w x y. P w x y /\\ Q(f w x y))) /\\
   (!P Q (f:A->B->C->D->E).
        (?z. z IN {f v w x y | P v w x y} /\\ Q z) <=>
        (?v w x y. P v w x y /\\ Q(f v w x y)))")
      (proof (REWRITE_TAC (cl:cons GSPEC (cl:cons IN_ELIM_THM nil))) THEN (MESON_TAC nil)))))

(defparameter UNIONS_IMAGE
  (prove
    (tuple
      (parse_term "!(f:A->B->bool) s. UNIONS (IMAGE f s) = {y | ?x. x IN s /\\ y IN f x}")
      (proof (REPEAT #'GEN_TAC)
        THEN (GEN_REWRITE_TAC #'I (cl:cons EXTENSION nil))
        THEN
          (REWRITE_TAC (cl:cons IN_UNIONS (cl:cons IN_IMAGE (cl:cons IN_ELIM_THM nil))))
        THEN (MESON_TAC nil)))))

(defparameter INTERS_IMAGE
  (prove
    (tuple
      (parse_term "!(f:A->B->bool) s. INTERS (IMAGE f s) = {y | !x. x IN s ==> y IN f x}")
      (proof (REPEAT #'GEN_TAC)
        THEN (GEN_REWRITE_TAC #'I (cl:cons EXTENSION nil))
        THEN
          (REWRITE_TAC (cl:cons IN_INTERS (cl:cons IN_IMAGE (cl:cons IN_ELIM_THM nil))))
        THEN (MESON_TAC nil)))))

(defparameter UNIONS_GSPEC
  (prove
    (tuple
      (parse_term
        "(!P (f:A->B->bool).
        UNIONS {f x | P x} = {a | ?x. P x /\\ a IN (f x)}) /\\
   (!P (f:A->B->C->bool).
        UNIONS {f x y | P x y} = {a | ?x y. P x y /\\ a IN (f x y)}) /\\
   (!P (f:A->B->C->D->bool).
        UNIONS {f x y z | P x y z} =
        {a | ?x y z. P x y z /\\ a IN (f x y z)})")
      (proof (REPEAT #'STRIP_TAC)
        THEN (GEN_REWRITE_TAC #'I (cl:cons EXTENSION nil))
        THEN (REWRITE_TAC (cl:cons IN_UNIONS (cl:cons IN_ELIM_THM nil)))
        THEN (MESON_TAC nil)))))

(defparameter INTERS_GSPEC
  (prove
    (tuple
      (parse_term
        "(!P (f:A->B->bool).
        INTERS {f x | P x} = {a | !x. P x ==> a IN (f x)}) /\\
   (!P (f:A->B->C->bool).
        INTERS {f x y | P x y} = {a | !x y. P x y ==> a IN (f x y)}) /\\
   (!P (f:A->B->C->D->bool).
        INTERS {f x y z | P x y z} =
        {a | !x y z. P x y z ==> a IN (f x y z)})")
      (proof (REPEAT #'STRIP_TAC)
        THEN (GEN_REWRITE_TAC #'I (cl:cons EXTENSION nil))
        THEN (REWRITE_TAC (cl:cons IN_INTERS (cl:cons IN_ELIM_THM nil)))
        THEN (MESON_TAC nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Basic property of the choice function.                                    *)
;; (* ------------------------------------------------------------------------- *)


(defparameter CHOICE_DEF
  (prove
    (tuple
      (parse_term "!s:A->bool. ~(s = EMPTY) ==> (CHOICE s) IN s")
      (REWRITE_TAC
        (cl:cons
          CHOICE
          (cl:cons
            EXTENSION
            (cl:cons NOT_IN_EMPTY (cl:cons NOT_FORALL_THM (cl:cons EXISTS_THM nil)))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Tactic to automate some routine set theory by reduction to FOL.           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter SET_TAC
  (let
    ((PRESET_CONV
      (THENC
        (THENC
          (REWRITE_CONV
            (cl:cons
              INTERS_IMAGE
              (cl:cons INTERS_GSPEC (cl:cons UNIONS_IMAGE (cl:cons UNIONS_GSPEC nil)))))
          (REWRITE_CONV
            (cl:cons
              EXTENSION
              (cl:cons
                SUBSET
                (cl:cons
                  PSUBSET
                  (cl:cons
                    DISJOINT
                    (cl:cons SING (cl:cons BIJ (cl:cons INJ (cl:cons SURJ nil))))))))))
        (REWRITE_CONV
          (cl:cons
            NOT_IN_EMPTY
            (cl:cons
              IN_UNIV
              (cl:cons
                IN_UNION
                (cl:cons
                  IN_INTER
                  (cl:cons
                    IN_DIFF
                    (cl:cons
                      IN_INSERT
                      (cl:cons
                        IN_DELETE
                        (cl:cons
                          IN_REST
                          (cl:cons
                            IN_INTERS
                            (cl:cons
                              IN_UNIONS
                              (cl:cons IN_IMAGE (cl:cons IN_ELIM_THM (cl:cons IN nil)))))))))))))))))
    (cl:declare (cl:ignorable PRESET_CONV))
    (lambdac (ths)
      (proof (MAP_EVERY #'MP_TAC ths)
        THEN (POP_ASSUM_LIST (K #'ALL_TAC))
        THEN (REPEAT (proof COND_CASES_TAC THEN (POP_ASSUM #'MP_TAC)))
        THEN (#`CONV_TAC PRESET_CONV)
        THEN
          (MAP_EVERY
            #'MP_TAC
            (filter (lambdac (th) (= (CONV_RULE PRESET_CONV th) TRUTH)) ths))
        THEN (REWRITE_TAC (cl:cons IN nil))
        THEN (MESON_TAC nil)))))

(defunc SET_RULE (tm) (prove (tuple tm (#`SET_TAC nil))))

;; (* ------------------------------------------------------------------------- *)
;; (* Misc. theorems.                                                           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter NOT_EQUAL_SETS
  (prove
    (tuple
      (parse_term "!s:A->bool. !t. ~(s = t) <=> ?x. x IN t <=> ~(x IN s)")
      (#`SET_TAC nil))))

(defparameter INSERT_RESTRICT
  (prove
    (tuple
      (parse_term
        "!P s a:A.
        {x | x IN a INSERT s /\\ P x} =
        if P a then a INSERT {x | x IN s /\\ P x} else {x | x IN s /\\ P x}")
      (proof (REPEAT #'GEN_TAC) THEN COND_CASES_TAC THEN (ASM SET_TAC nil)))))

(defparameter UNIV_1
  (prove (tuple (parse_term "(:1) = {one}") (#`SET_TAC (cl:cons one nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* The empty set.                                                            *)
;; (* ------------------------------------------------------------------------- *)


(defparameter MEMBER_NOT_EMPTY
  (prove (tuple (parse_term "!s:A->bool. (?x. x IN s) <=> ~(s = EMPTY)") (#`SET_TAC nil))))

;; (* ------------------------------------------------------------------------- *)
;; (* The universal set.                                                        *)
;; (* ------------------------------------------------------------------------- *)


(defparameter UNIV_NOT_EMPTY
  (prove (tuple (parse_term "~(UNIV:A->bool = EMPTY)") (#`SET_TAC nil))))

(defparameter EMPTY_NOT_UNIV
  (prove (tuple (parse_term "~(EMPTY:A->bool = UNIV)") (#`SET_TAC nil))))

(defparameter EQ_UNIV
  (prove (tuple (parse_term "(!x:A. x IN s) <=> (s = UNIV)") (#`SET_TAC nil))))

;; (* ------------------------------------------------------------------------- *)
;; (* Set inclusion.                                                            *)
;; (* ------------------------------------------------------------------------- *)


(defparameter SUBSET_TRANS
  (prove
    (tuple
      (parse_term "!(s:A->bool) t u. s SUBSET t /\\ t SUBSET u ==> s SUBSET u")
      (#`SET_TAC nil))))

(defparameter SUBSET_REFL
  (prove (tuple (parse_term "!s:A->bool. s SUBSET s") (#`SET_TAC nil))))

(defparameter SUBSET_ANTISYM
  (prove
    (tuple
      (parse_term "!(s:A->bool) t. s SUBSET t /\\ t SUBSET s ==> s = t")
      (#`SET_TAC nil))))

(defparameter SUBSET_ANTISYM_EQ
  (prove
    (tuple
      (parse_term "!(s:A->bool) t. s SUBSET t /\\ t SUBSET s <=> s = t")
      (#`SET_TAC nil))))

(defparameter EMPTY_SUBSET
  (prove (tuple (parse_term "!s:A->bool. EMPTY SUBSET s") (#`SET_TAC nil))))

(defparameter SUBSET_EMPTY
  (prove
    (tuple (parse_term "!s:A->bool. s SUBSET EMPTY <=> (s = EMPTY)") (#`SET_TAC nil))))

(defparameter SUBSET_UNIV
  (prove (tuple (parse_term "!s:A->bool. s SUBSET UNIV") (#`SET_TAC nil))))

(defparameter UNIV_SUBSET
  (prove (tuple (parse_term "!s:A->bool. UNIV SUBSET s <=> (s = UNIV)") (#`SET_TAC nil))))

(defparameter SING_SUBSET
  (prove (tuple (parse_term "!s x:A. {x} SUBSET s <=> x IN s") (#`SET_TAC nil))))

(defparameter SUBSET_RESTRICT
  (prove
    (tuple
      (parse_term "!s P. {x:A | x IN s /\\ P x} SUBSET s")
      (SIMP_TAC (cl:cons SUBSET (cl:cons IN_ELIM_THM nil))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Proper subset.                                                            *)
;; (* ------------------------------------------------------------------------- *)


(defparameter PSUBSET_TRANS
  (prove
    (tuple
      (parse_term "!(s:A->bool) t u. s PSUBSET t /\\ t PSUBSET u ==> s PSUBSET u")
      (#`SET_TAC nil))))

(defparameter PSUBSET_SUBSET_TRANS
  (prove
    (tuple
      (parse_term "!(s:A->bool) t u. s PSUBSET t /\\ t SUBSET u ==> s PSUBSET u")
      (#`SET_TAC nil))))

(defparameter SUBSET_PSUBSET_TRANS
  (prove
    (tuple
      (parse_term "!(s:A->bool) t u. s SUBSET t /\\ t PSUBSET u ==> s PSUBSET u")
      (#`SET_TAC nil))))

(defparameter PSUBSET_IRREFL
  (prove (tuple (parse_term "!s:A->bool. ~(s PSUBSET s)") (#`SET_TAC nil))))

(defparameter NOT_PSUBSET_EMPTY
  (prove (tuple (parse_term "!s:A->bool. ~(s PSUBSET EMPTY)") (#`SET_TAC nil))))

(defparameter NOT_UNIV_PSUBSET
  (prove (tuple (parse_term "!s:A->bool. ~(UNIV PSUBSET s)") (#`SET_TAC nil))))

(defparameter PSUBSET_UNIV
  (prove
    (tuple (parse_term "!s:A->bool. s PSUBSET UNIV <=> ?x. ~(x IN s)") (#`SET_TAC nil))))

(defparameter PSUBSET_ALT
  (prove
    (tuple
      (parse_term
        "!s t:A->bool. s PSUBSET t <=> s SUBSET t /\\ (?a. a IN t /\\ ~(a IN s))")
      (proof (REWRITE_TAC (cl:cons PSUBSET nil)) THEN (#`SET_TAC nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Union.                                                                    *)
;; (* ------------------------------------------------------------------------- *)


(defparameter UNION_ASSOC
  (prove
    (tuple
      (parse_term "!(s:A->bool) t u. (s UNION t) UNION u = s UNION (t UNION u)")
      (#`SET_TAC nil))))

(defparameter UNION_IDEMPOT
  (prove (tuple (parse_term "!s:A->bool. s UNION s = s") (#`SET_TAC nil))))

(defparameter UNION_COMM
  (prove (tuple (parse_term "!(s:A->bool) t. s UNION t = t UNION s") (#`SET_TAC nil))))

(defparameter SUBSET_UNION
  (prove
    (tuple
      (parse_term
        "(!s:A->bool. !t. s SUBSET (s UNION t)) /\\
   (!s:A->bool. !t. s SUBSET (t UNION s))")
      (#`SET_TAC nil))))

(defparameter SUBSET_UNION_ABSORPTION
  (prove
    (tuple (parse_term "!s:A->bool. !t. s SUBSET t <=> (s UNION t = t)") (#`SET_TAC nil))))

(defparameter UNION_EMPTY
  (prove
    (tuple
      (parse_term
        "(!s:A->bool. EMPTY UNION s = s) /\\
   (!s:A->bool. s UNION EMPTY = s)")
      (#`SET_TAC nil))))

(defparameter UNION_UNIV
  (prove
    (tuple
      (parse_term
        "(!s:A->bool. UNIV UNION s = UNIV) /\\
   (!s:A->bool. s UNION UNIV = UNIV)")
      (#`SET_TAC nil))))

(defparameter EMPTY_UNION
  (prove
    (tuple
      (parse_term "!s:A->bool. !t. (s UNION t = EMPTY) <=> (s = EMPTY) /\\ (t = EMPTY)")
      (#`SET_TAC nil))))

(defparameter UNION_SUBSET
  (prove
    (tuple
      (parse_term "!s t u:A->bool. (s UNION t) SUBSET u <=> s SUBSET u /\\ t SUBSET u")
      (#`SET_TAC nil))))

(defparameter UNION_RESTRICT
  (prove
    (tuple
      (parse_term
        "!P s t:A->bool.
        {x | x IN (s UNION t) /\\ P x} =
        {x | x IN s /\\ P x} UNION {x | x IN t /\\ P x}")
      (#`SET_TAC nil))))

(defparameter FORALL_SUBSET_UNION
  (prove
    (tuple
      (parse_term
        "!t u:A->bool.
        (!s. s SUBSET t UNION u ==> P s) <=>
        (!t' u'. t' SUBSET t /\\ u' SUBSET u ==> P(t' UNION u'))")
      (proof (REPEAT #'GEN_TAC)
        THEN #'EQ_TAC
        THENL
          (cl:cons
            (proof (REPEAT #'STRIP_TAC)
              THEN (FIRST_X_ASSUM #'MATCH_MP_TAC)
              THEN (ASM SET_TAC nil))
            (cl:cons
              (proof DISCH_TAC
                THEN (#`X_GEN_TAC (parse_term "s:A->bool"))
                THEN DISCH_TAC
                THEN
                  (FIRST_ASSUM
                    (o
                      #'MP_TAC
                      (SPECL
                        (cl:cons
                          (parse_term "s INTER t:A->bool")
                          (cl:cons (parse_term "s INTER u:A->bool") nil)))))
                THEN ANTS_TAC
                THENL
                  (cl:cons
                    #'ALL_TAC
                    (cl:cons (proof (MATCH_MP_TAC EQ_IMP) THEN AP_TERM_TAC) nil))
                THEN (ASM SET_TAC nil))
              nil))))))

(defparameter EXISTS_SUBSET_UNION
  (prove
    (tuple
      (parse_term
        "!t u:A->bool.
        (?s. s SUBSET t UNION u /\\ P s) <=>
        (?t' u'. t' SUBSET t /\\ u' SUBSET u /\\ P(t' UNION u'))")
      (proof (REWRITE_TAC
          (cl:cons
            (MESON nil (parse_term "(?x. P x /\\ Q x) <=> ~(!x. P x ==> ~Q x)"))
            nil))
        THEN (REWRITE_TAC (cl:cons FORALL_SUBSET_UNION nil))
        THEN (MESON_TAC nil)))))

(defparameter FORALL_SUBSET_INSERT
  (prove
    (tuple
      (parse_term
        "!a:A t. (!s. s SUBSET a INSERT t ==> P s) <=>
           (!s. s SUBSET t ==> P s /\\ P (a INSERT s))")
      (proof (REPEAT #'GEN_TAC)
        THEN
          (ONCE_REWRITE_TAC
            (cl:cons (SET_RULE (parse_term "a INSERT s = {a} UNION s")) nil))
        THEN
          (REWRITE_TAC
            (cl:cons
              FORALL_SUBSET_UNION
              (cl:cons (SET_RULE (parse_term "s SUBSET {a} <=> s = {} \\/ s = {a}")) nil)))
        THEN (MESON_TAC (cl:cons UNION_EMPTY nil))))))

(defparameter EXISTS_SUBSET_INSERT
  (prove
