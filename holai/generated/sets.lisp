        !i. i IN k ==> (f i) IN (s i)")
      (proof (REWRITE_TAC
          (cl:cons
            RESTRICTION
            (cl:cons cartesian_product (cl:cons EXTENSIONAL (cl:cons IN_ELIM_THM nil)))))
        THEN (#`SET_TAC nil)))))

(defparameter CARTESIAN_PRODUCT_AS_RESTRICTIONS
  (prove
    (tuple
      (parse_term
        "!k (s:K->A->bool).
