   (!b. ~FINITE {x:real | x <= b}) /\\
   (!a b. FINITE {x:real | a < x /\\ x < b} <=> b <= a) /\\
   (!a b. FINITE {x:real | a <= x /\\ x < b} <=> b <= a) /\\
   (!a b. FINITE {x:real | a < x /\\ x <= b} <=> b <= a) /\\
   (!a b. FINITE {x:real | a <= x /\\ x <= b} <=> b <= a)")
      (proof (SUBGOAL_THEN
          (parse_term "!a b. FINITE {x:real | a < x /\\ x < b} <=> b <= a")
          ASSUME_TAC)
        THENL
          (cl:cons
            (proof (REPEAT #'GEN_TAC)
              THEN (REWRITE_TAC (cl:cons (#`GSYM REAL_NOT_LT) nil))
              THEN (ASM_CASES_TAC (parse_term "a:real < b"))
