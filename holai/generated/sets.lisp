(defparameter INJECTIVE_ON_ALT
  (prove
    (tuple
      (parse_term
        "!P f:A->B.
        (!x y. P x /\\ P y /\\ f x = f y ==> x = y) <=>
        (!x y. P x /\\ P y ==> (f x = f y <=> x = y))")
      (MESON_TAC nil))))

(defparameter INJECTIVE_ALT
  (prove
    (tuple
      (parse_term "!f:A->B. (!x y. f x = f y ==> x = y) <=> (!x y. f x = f y <=> x = y)")
      (MESON_TAC nil))))

(defparameter SURJECTIVE_ON_RIGHT_INVERSE
  (prove
    (tuple
      (parse_term
        "!(f:A->B) t.
        (!y. y IN t ==> ?x. x IN s /\\ (f(x) = y)) <=>
        (?g. !y. y IN t ==> g(y) IN s /\\ (f(g(y)) = y))")
      (REWRITE_TAC (cl:cons RIGHT_IMP_EXISTS_THM (cl:cons SKOLEM_THM nil))))))

(defparameter INJECTIVE_ON_LEFT_INVERSE
  (prove
    (tuple
      (parse_term
        "!(f:A->B) s. (!x y. x IN s /\\ y IN s /\\ (f x = f y) ==> (x = y)) <=>
         (?g. !x. x IN s ==> (g(f(x)) = x))")
      (let
        ((lemma
          (MESON
            nil
            (parse_term
              "(!x. x IN s ==> (g(f(x)) = x)) <=>
    (!y x. x IN s /\\ (y = (f:A->B) x) ==> (g y = x))"))))
        (cl:declare (cl:ignorable lemma))
        (proof (REWRITE_TAC (cl:cons lemma (cl:cons (#`GSYM SKOLEM_THM) nil)))
          THEN (MESON_TAC nil))))))

(defparameter BIJECTIVE_ON_LEFT_RIGHT_INVERSE
  (prove
    (tuple
      (parse_term
        "!(f:A->B) s t.
        (!x. x IN s ==> f(x) IN t)
        ==> ((!x y. x IN s /\\ y IN s /\\ f(x) = f(y) ==> x = y) /\\
             (!y. y IN t ==> ?x. x IN s /\\ f x = y) <=>
            ?g. (!y. y IN t ==> g(y) IN s) /\\
                (!y. y IN t ==> (f(g(y)) = y)) /\\
                (!x. x IN s ==> (g(f(x)) = x)))")
      (proof (REPEAT #'GEN_TAC)
        THEN DISCH_TAC
        THEN
          (REWRITE_TAC
            (cl:cons INJECTIVE_ON_LEFT_INVERSE (cl:cons SURJECTIVE_ON_RIGHT_INVERSE nil)))
        THEN (REWRITE_TAC (cl:cons RIGHT_AND_EXISTS_THM nil))
        THEN AP_TERM_TAC
        THEN #'ABS_TAC
        THEN #'EQ_TAC
        THEN (#`ASM_MESON_TAC nil)))))

(defparameter SURJECTIVE_RIGHT_INVERSE
  (prove
    (tuple
      (parse_term "!f:A->B. (!y. ?x. f(x) = y) <=> (?g. !y. f(g(y)) = y)")
      (MESON_TAC (cl:cons SURJECTIVE_ON_RIGHT_INVERSE (cl:cons IN_UNIV nil))))))

(defparameter INJECTIVE_LEFT_INVERSE
  (prove
    (tuple
      (parse_term "!f:A->B. (!x y. f x = f y ==> x = y) <=> (?g. !x. g(f(x)) = x)")
      (let
        ((th
          (REWRITE_RULE
            (cl:cons IN_UNIV nil)
            (ISPECL
              (cl:cons (parse_term "f:A->B") (cl:cons (parse_term "UNIV:A->bool") nil))
              INJECTIVE_ON_LEFT_INVERSE))))
        (cl:declare (cl:ignorable th))
        (REWRITE_TAC (cl:cons th nil))))))

(defparameter BIJECTIVE_LEFT_RIGHT_INVERSE
  (prove
    (tuple
      (parse_term
        "!f:A->B.
       (!x y. f(x) = f(y) ==> x = y) /\\ (!y. ?x. f x = y) <=>
       ?g. (!y. f(g(y)) = y) /\\ (!x. g(f(x)) = x)")
      (proof #'GEN_TAC
        THEN
          (MP_TAC
            (ISPECL
              (cl:cons
                (parse_term "f:A->B")
                (cl:cons (parse_term "(:A)") (cl:cons (parse_term "(:B)") nil)))
              BIJECTIVE_ON_LEFT_RIGHT_INVERSE))
        THEN (REWRITE_TAC (cl:cons IN_UNIV nil))))))

(defparameter FUNCTION_FACTORS_LEFT_GEN
  (prove
    (tuple
      (parse_term
        "!P (f:A->B) (g:A->C).
        (!x y. P x /\\ P y /\\ g x = g y ==> f x = f y) <=>
        (?h. !x. P x ==> f(x) = h(g x))")
      (proof (ONCE_REWRITE_TAC
          (cl:cons
            (MESON
