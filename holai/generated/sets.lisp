(defparameter le_c
  (#`new_definition
    (parse_term
      "s <=_c t <=>
   ?f:A->B. (!x. x IN s ==> f(x) IN t) /\\
            (!x y. x IN s /\\ y IN s /\\ f(x) = f(y) ==> x = y)")))

(defparameter lt_c
  (#`new_definition
    (parse_term "(s:A->bool) <_c (t:B->bool) <=> s <=_c t /\\ ~(t <=_c s)")))

(defparameter eq_c
  (#`new_definition
    (parse_term
      "(s:A->bool) =_c (t:B->bool) <=>
   ?f. (!x. x IN s ==> f(x) IN t) /\\
       !y. y IN t ==> ?!x. x IN s /\\ (f x = y)")))

(defparameter ge_c
  (#`new_definition (parse_term "(s:A->bool) >=_c (t:B->bool) <=> t <=_c s")))

(defparameter gt_c
