          ((canonicalize_clause (cls args)
            (match (#`strip_forall cls)
              ((tuple avs bimp)
                (match
                  (handler-case
                    (#`dest_imp bimp)
                    (holai.runtime:ocaml-condition
                      (exception~734)
                      (match exception~734
