(defparameter NUM_NORMALIZE_CONV
  (let
    ((sth
      (prove
        (tuple
          (parse_term
            "(!x y z. x + (y + z) = (x + y) + z) /\\
     (!x y. x + y = y + x) /\\
     (!x. 0 + x = x) /\\
     (!x y z. x * (y * z) = (x * y) * z) /\\
     (!x y. x * y = y * x) /\\
     (!x. 1 * x = x) /\\
     (!x. 0 * x = 0) /\\
     (!x y z. x * (y + z) = x * y + x * z) /\\
     (!x. x EXP 0 = 1) /\\
     (!x n. x EXP (SUC n) = x * x EXP n)")
          (proof (REWRITE_TAC
              (cl:cons
                EXP
                (cl:cons
                  MULT_CLAUSES
                  (cl:cons ADD_CLAUSES (cl:cons LEFT_ADD_DISTRIB nil)))))
            THEN (REWRITE_TAC (cl:cons ADD_AC (cl:cons MULT_AC nil)))))))
      (rth TRUTH)
      (is_semiring_constant is_numeral)
      (SEMIRING_ADD_CONV NUM_ADD_CONV)
      (SEMIRING_MUL_CONV NUM_MULT_CONV)
      (SEMIRING_POW_CONV NUM_EXP_CONV))
    (cl:declare
      (cl:ignorable
        sth
        rth
        is_semiring_constant
        SEMIRING_ADD_CONV
        SEMIRING_MUL_CONV
        SEMIRING_POW_CONV))
    (match
      (#`SEMIRING_NORMALIZERS_CONV
        sth
        rth
        (tuple is_semiring_constant SEMIRING_ADD_CONV SEMIRING_MUL_CONV SEMIRING_POW_CONV)
        (function-value #'< 2))
      ((tuple _ _ _ _ _ NUM_NORMALIZE_CONV%) NUM_NORMALIZE_CONV%))))

