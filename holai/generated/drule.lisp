;; (* Useful instance of more general higher order matching.                    *)
;; (* ------------------------------------------------------------------------- *)


(defparameter HIGHER_REWRITE_CONV
  (let
    ((BETA_VAR
      (labelsc
        ((BETA_CONVS (n)
          (if (= n 1)
            (TRY_CONV #'BETA_CONV)
            (THENC (RATOR_CONV (BETA_CONVS (- n 1))) (TRY_CONV #'BETA_CONV))))
          (free_beta (v tm)
            (if (is_abs tm)
              (match (dest_abs tm)
                ((tuple bv bod)
                  (if (= v bv) (failwith "unchanged") (ABS_CONV (free_beta v bod)))))
              (match (#`strip_comb tm)
                ((tuple op args)
                  (if (= args nil)
                    (failwith "unchanged")
                    (if (= op v)
                      (BETA_CONVS (#`length args))
                      (match (dest_comb tm)
                        ((tuple l r)
                          (handler-case
                            (let ((lconv (free_beta v l)))
                              (cl:declare (cl:ignorable lconv))
                              (handler-case
                                (let ((rconv (free_beta v r)))
                                  (cl:declare (cl:ignorable rconv))
                                  (COMB2_CONV lconv rconv))
                                (holai.runtime:ocaml-condition
                                  (exception~2612)
                                  (match exception~2612
                                    ((Failure _) (RATOR_CONV lconv))
                                    (_ (raise exception~2612))))))
                            (holai.runtime:ocaml-condition
                              (exception~2601)
                              (match exception~2601
                                ((Failure _) (RAND_CONV (free_beta v r)))
                                (_ (raise exception~2601))))))))))))))
        #'free_beta)))
    (cl:declare (cl:ignorable BETA_VAR))
    (labelsc
      ((GINST (th)
        (let*
          ((fvs (subtract (frees (concl th)) (freesl (hyp th))))
            (gvs (map (o genvar #'type_of) fvs)))
          (cl:declare (cl:ignorable fvs gvs))
          (INST% (zip gvs fvs) th))))
      (lambdac (ths)
        (let*
          ((thl (map (o #'GINST #'SPEC_ALL) ths))
            (concs (map #'concl thl))
            (lefts (map lhs concs)))
          (cl:declare (cl:ignorable thl concs lefts))
          (match (unzip (map #'dest_comb lefts))
            ((tuple preds pats)
              (let*
                ((beta_fns (map2 BETA_VAR preds concs))
                  (ass_list (zip pats (zip preds (zip thl beta_fns))))
                  (mnet
                    (itlist (lambdac (p n) (#`enter nil (tuple p p) n)) pats empty_net)))
                (cl:declare (cl:ignorable beta_fns ass_list mnet))
                (labelsc
                  ((look_fn (t%)
                    (mapfilter
                      (lambdac (p) (if (can (#`term_match nil p) t%) p (fail unit)))
                      (#`lookup t% mnet))))
                  (lambdac (top tm)
                    (labelsc
                      ((pred (t%) (cl:and (not (= (look_fn t%) nil)) (free_in t% tm))))
                      (let*
                        ((stm
                          (if top
                            (find_term #'pred tm)
                            (hd (sort #'free_in (#`find_terms #'pred tm)))))
                          (pat (hd (look_fn stm))))
                        (cl:declare (cl:ignorable stm pat))
                        (match (#`term_match nil pat stm)
                          ((tuple _ tmin tyin)
                            (match (assoc pat ass_list)
                              ((tuple pred% (tuple th beta_fn))
                                (let*
                                  ((gv (#`genvar (type_of stm)))
                                    (abs%%
                                      (mk_abs
                                        (tuple
                                          gv
                                          (#`subst (cl:cons (tuple gv stm) nil) tm)))))
                                  (cl:declare (cl:ignorable gv abs%%))
                                  (match (#`term_match nil pred% abs%%)
                                    ((tuple _ tmin0 tyin0)
                                      (CONV_RULE
                                        beta_fn
                                        (INST% tmin (INST% tmin0 (INST_TYPE tyin0 th)))))))))))))))))))))))

