;; (* Combinators for theorem continuations / "theorem tacticals".              *)
;; (* ------------------------------------------------------------------------- *)


(defunc THEN_TCL (ttcl1 ttcl2 ttac) (#`ttcl1 (#`ttcl2 ttac)))

(defunc ORELSE_TCL (ttcl1 ttcl2 ttac th)
  (handler-case
    (#`ttcl1 ttac th)
    (holai.runtime:ocaml-condition
      (exception~744)
      (match exception~744 ((Failure _) (#`ttcl2 ttac th)) (_ (raise exception~744))))))

(defunc REPEAT_TCL (ttcl ttac th)
  (ORELSE_TCL (THEN_TCL ttcl (REPEAT_TCL ttcl)) #'I ttac th))

(defparameter REPEAT_GTCL
  (labelsc
    ((REPEAT_GTCL% (ttcl ttac th g%)
      (handler-case
        (#`ttcl (REPEAT_GTCL% ttcl ttac) th g%)
        (holai.runtime:ocaml-condition
          (exception~774)
          (match exception~774 ((Failure _) (#`ttac th g%)) (_ (raise exception~774)))))))
    #'REPEAT_GTCL%))

(defparameter ALL_THEN #'I)

(defunc NO_THEN (ttac th) (failwith "NO_THEN"))

(defunc EVERY_TCL (ttcll) (itlist (lambdac (t1 t2) (THEN_TCL t1 t2)) ttcll ALL_THEN))

(defunc FIRST_TCL (ttcll) (end_itlist (lambdac (t1 t2) (ORELSE_TCL t1 t2)) ttcll))

;; (* ------------------------------------------------------------------------- *)
;; (* Tactics to augment assumption list. Note that to allow "ASSUME p" for     *)
;; (* any assumption "p", these add a PROVE_HYP in the justification function,  *)
;; (* just in case.                                                             *)
;; (* ------------------------------------------------------------------------- *)


(defunc LABEL_TAC (s thm arg~825)
  (match arg~825
    ((tuple asl w%)
      (tuple
        null_meta
        (cl:cons (tuple (cl:cons (tuple s thm) asl) w%) nil)
        (lambdac (i% arg~840)
          (match arg~840 ((cl:cons th nil) (PROVE_HYP (INSTANTIATE_ALL i% thm) th))))))))

(defparameter ASSUME_TAC (LABEL_TAC ""))

;; (* ------------------------------------------------------------------------- *)
;; (* Manipulation of assumption list.                                          *)
;; (* ------------------------------------------------------------------------- *)


(defunc FIND_ASSUM (ttac t% arg~864)
  (match arg~864
    ((cl:and g% (tuple asl w%))
      (#`ttac
        (snd
          (find (lambdac (arg~869) (match arg~869 ((tuple _ th) (= (concl th) t%)))) asl))
        g%))))

(defunc POP_ASSUM (ttac arg~893)
  (match arg~893
    ((tuple (cl:cons (tuple _ th) asl) w%) (#`ttac th (tuple asl w%)))
    (_ (failwith "POP_ASSUM: No assumption to pop"))))

(defunc ASSUM_LIST (aslfun arg~916)
  (match arg~916
    ((tuple asl w%) (#`aslfun (map (function-value #'snd 1) asl) (tuple asl w%)))))

(defunc POP_ASSUM_LIST (asltac arg~933)
  (match arg~933
    ((tuple asl w%) (#`asltac (map (function-value #'snd 1) asl) (tuple nil w%)))))

(defunc EVERY_ASSUM (ttac) (ASSUM_LIST (MAP_EVERY ttac)))

(defunc FIRST_ASSUM (ttac arg~956)
  (match arg~956
    ((cl:and g% (tuple asl w%))
      (tryfind (lambdac (arg~961) (match arg~961 ((tuple _ th) (#`ttac th g%)))) asl))))

(defunc RULE_ASSUM_TAC (rule arg~981)
  (match arg~981
    ((tuple asl w%)
      (#`THEN
        (POP_ASSUM_LIST (K #'ALL_TAC))
        (MAP_EVERY
          (lambdac (arg~988) (match arg~988 ((tuple s th) (LABEL_TAC s (#`rule th)))))
          (#`rev asl))
        (tuple asl w%)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Operate on assumption identified by a label.                              *)
;; (* ------------------------------------------------------------------------- *)


(defunc USE_THEN (s ttac arg~1014)
  (match arg~1014
    ((cl:and gl (tuple asl w%))
      (let
        ((th
          (handler-case
            (assoc s asl)
            (holai.runtime:ocaml-condition
              (exception~1020)
              (match exception~1020
                ((Failure _)
                  (failwith (string-concat "USE_TAC: didn't find assumption " s)))
                (_ (raise exception~1020)))))))
        (cl:declare (cl:ignorable th))
        (#`ttac th gl)))))

(defunc REMOVE_THEN (s ttac arg~1044)
  (match arg~1044
    ((tuple asl w%)
      (let
        ((th
          (handler-case
            (assoc s asl)
            (holai.runtime:ocaml-condition
              (exception~1049)
              (match exception~1049
                ((Failure _)
                  (failwith (string-concat "USE_TAC: didn't find assumption " s)))
                (_ (raise exception~1049)))))))
