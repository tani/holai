;; (* ------------------------------------------------------------------------- *)
;; (* The common case of trivial instantiations.                                *)
;; (* ------------------------------------------------------------------------- *)


(defparameter null_inst (tuple nil nil nil))

(defparameter null_meta (tuple nil null_inst))

(defunc equals_goal (arg~15 arg~19)
  (match arg~15
    ((tuple a% w%)
      (match arg~19
        ((tuple a%% w%%)
          (cl:and
            (forall2
              (lambdac (arg~26 arg~30)
                (match arg~26
                  ((tuple s th)
                    (match arg~30 ((tuple s% th%) (cl:and (= s s%) (equals_thm th th%)))))))
              a%
              a%%)
            (= w% w%%)))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Apply instantiation to a goal.                                            *)
;; (* ------------------------------------------------------------------------- *)


(defunc inst_goal (p% arg~61)
  (match arg~61
    ((tuple thms w%)
      (tuple (map (F_F #'I (INSTANTIATE_ALL p%)) thms) (#`instantiate p% w%)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Perform a sequential composition (left first) of instantiations.          *)
;; (* ------------------------------------------------------------------------- *)


(defunc compose_insts (arg~80 arg~85)
  (match arg~80
    ((tuple pats1 tmin1 tyin1)
      (match arg~85
        ((cl:and i2 (tuple pats2 tmin2 tyin2))
          (let
            ((tmin (map (F_F (#`instantiate i2) (#`inst tyin2)) tmin1))
              (tyin (map (F_F (type_subst tyin2) #'I) tyin1)))
            (cl:declare (cl:ignorable tmin tyin))
            (let
              ((tmin%
                (filter
                  (lambdac (arg~108)
                    (match arg~108 ((tuple _ x) (not (can (rev_assoc x) tmin)))))
                  tmin2))
                (tyin%
                  (filter
                    (lambdac (arg~122)
                      (match arg~122 ((tuple _ a%) (not (can (rev_assoc a%) tyin)))))
                    tyin2)))
              (cl:declare (cl:ignorable tmin% tyin%))
              (tuple (append pats1 pats2) (append tmin tmin%) (append tyin tyin%)))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Construct A,_FALSITY_ |- p; contortion so falsity is the last element.    *)
;; (* ------------------------------------------------------------------------- *)


(defparameter _FALSITY_ (new_definition (parse_term "_FALSITY_ = F")))

(defparameter mk_fthm
  (let
    ((pth (UNDISCH (fst (#`EQ_IMP_RULE _FALSITY_))))
      (qth (ASSUME (parse_term "_FALSITY_"))))
    (cl:declare (cl:ignorable pth qth))
    (lambdac (arg~174)
      (match arg~174
        ((tuple asl c%) (PROVE_HYP qth (itlist #'ADD_ASSUM (#`rev asl) (#`CONTR c% pth))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Validity checking of tactics. This cannot be 100% accurate without making *)
;; (* arbitrary theorems, but "mk_fthm" brings us quite close.                  *)
;; (* ------------------------------------------------------------------------- *)


(defparameter VALID
  (let
    ((fake_thm
      (lambdac (arg~196)
        (match arg~196
          ((tuple asl w%)
            (let
              ((asms
                (itlist
                  (o (o #'union #'holai.fusion.hol:hyp) (function-value #'snd 1))
                  asl
                  nil)))
              (cl:declare (cl:ignorable asms))
              (#`mk_fthm (tuple asms w%)))))))
      (false_tm (parse_term "_FALSITY_")))
    (cl:declare (cl:ignorable fake_thm false_tm))
    (lambdac (tac arg~221)
      (match arg~221
        ((tuple asl w%)
          (match (#`tac (tuple asl w%))
            ((cl:and res (tuple (tuple mvs i%) gls just))
              (let ((ths (map fake_thm gls)))
                (cl:declare (cl:ignorable ths))
                (match (dest_thm (#`just null_inst ths))
                  ((tuple asl% w%%)
                    (match (inst_goal i% (tuple asl w%))
                      ((tuple asl%% w%%%)
                        (let
                          ((maxasms
                            (itlist
                              (lambdac (arg~239)
                                (match arg~239
                                  ((tuple _ th)
                                    (union (insert (concl th) (holai.fusion.hol:hyp th))))))
                              asl%%
                              nil)))
                          (cl:declare (cl:ignorable maxasms))
                          (if
                            (cl:and
                              (aconv w%% w%%%)
                              (forall
                                (lambdac (t%) (exists (aconv t%) maxasms))
                                (subtract asl% (cl:cons false_tm nil))))
                            res
                            (failwith "VALID: Invalid tactic")))))))))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Various simple combinators for tactics, identity tactic etc.              *)
;; (* ------------------------------------------------------------------------- *)


(defparameter then1_ nil)

(defparameter THEN nil)

(defparameter THENL nil)

(match
  (labelsc
    ((propagate_empty (i% arg~329) (match arg~329 (nil nil)))
      (propagate_thm (th i% arg~335) (match arg~335 (nil (INSTANTIATE_ALL i% th))))
      (compose_justs (n just1 just2 insts2 i% ths)
        (match (chop_list n ths)
          ((tuple ths1 ths2)
            (cl:cons (#`just1 (compose_insts insts2 i%) ths1) (#`just2 i% ths2)))))
      (seqapply (l1 l2)
        (match (tuple l1 l2)
          ((tuple nil nil) (tuple null_meta nil #'propagate_empty))
          ((tuple (cl:cons tac tacs) (cl:cons goal goals))
            (match (#`tac goal)
              ((tuple (tuple mvs1 insts1) gls1 just1)
                (let ((goals% (map (inst_goal insts1) goals)))
                  (cl:declare (cl:ignorable goals%))
                  (match (seqapply tacs goals%)
                    ((tuple (tuple mvs2 insts2) gls2 just2)
                      (tuple
                        (tuple (union mvs1 mvs2) (compose_insts insts1 insts2))
                        (append (map (inst_goal insts2) gls1) gls2)
                        (compose_justs (#`length gls1) just1 just2 insts2))))))))
          ((tuple _ _) (failwith "seqapply: Length mismatch"))))
      (justsequence (just1 just2 insts2 i% ths)
        (#`just1 (compose_insts insts2 i%) (#`just2 i% ths)))
      (tacsequence (arg~465 tacl)
        (match arg~465
          ((tuple (tuple mvs1 insts1) gls1 just1)
            (match (seqapply tacl gls1)
              ((tuple (tuple mvs2 insts2) gls2 just2)
                (let*
                  ((jst (justsequence just1 just2 insts2))
                    (just (if (= gls2 nil) (propagate_thm (#`jst null_inst nil)) jst)))
                  (cl:declare (cl:ignorable jst just))
                  (tuple
                    (tuple (union mvs1 mvs2) (compose_insts insts1 insts2))
                    gls2
                    just)))))))
      (THEN% (tac1 tac2 g%)
        (match (#`tac1 g%)
          ((cl:and gstate (tuple _ gls _))
            (tacsequence gstate (replicate tac2 (#`length gls))))))
      (THENL% (tac1 tac2l g%)
        (match (#`tac1 g%)
          ((cl:and gstate (tuple _ gls _))
            (if (= gls nil) (tacsequence gstate nil) (tacsequence gstate tac2l))))))
    (tuple #'THEN% #'THENL% (lambdac (tac1 tac2) (THENL% tac1 (cl:cons tac2 nil)))))
  ((tuple THEN% THENL% then1_%) (setf then1_ then1_% THEN THEN% THENL THENL%)))

(defunc ORELSE (tac1 tac2 g%)
  (handler-case
    (#`tac1 g%)
    (holai.runtime:ocaml-condition
      (exception~587)
      (match exception~587 ((Failure _) (#`tac2 g%)) (_ (raise exception~587))))))

(defunc FAIL_TAC (tok g%) (failwith tok))

(defparameter NO_TAC (FAIL_TAC "NO_TAC"))

(defunc ALL_TAC (g%)
  (tuple
    null_meta
    (cl:cons g% nil)
    (lambdac (arg~612 arg~614) (match arg~614 ((cl:cons th nil) th)))))

(defunc TRY (tac) (holai.runtime:proof tac #'ORELSE #'ALL_TAC))

(defunc REPEAT (tac g%) (ORELSE (holai.runtime:proof tac THEN (REPEAT tac)) #'ALL_TAC g%))

(defunc EVERY (tacl)
  (itlist (lambdac (t1 t2) (holai.runtime:proof t1 THEN t2)) tacl #'ALL_TAC))

(defunc FIRST (tacl g%)
  (end_itlist (lambdac (t1 t2) (holai.runtime:proof t1 #'ORELSE t2)) tacl g%))

(defunc MAP_EVERY (tacf lst) (EVERY (map tacf lst)))

(defunc MAP_FIRST (tacf lst) (FIRST (map tacf lst)))

(defunc CHANGED_TAC (tac g%)
  (match (#`tac g%)
    ((cl:and gstate (tuple meta gl _))
      (if
        (cl:and (= meta null_meta) (cl:and (= (#`length gl) 1) (equals_goal (hd gl) g%)))
        (failwith "CHANGED_TAC")
        gstate))))

(defunc REPLICATE_TAC (n tac)
  (if (<= n 0) #'ALL_TAC (holai.runtime:proof tac THEN (REPLICATE_TAC (- n 1) tac))))

