(in-package :holai.user)

(cl:defun ensure-result-names (name suffixes)
  (dolist (suffix suffixes)
    (when (gethash (result-name name suffix) *theorems*)
      (reject-kind 'definition-conflict name "Generated theorem name already exists: ~a" suffix))))
(cl:defun copy-table (table)
  (let ((copy (make-hash-table :test (hash-table-test table))))
    (maphash (lambda (key value) (setf (gethash key copy) value)) table) copy))
(cl:defun type-parameter-bindings (parameters)
  (require-variables parameters)
  (unless (every #'type-variable-p parameters) (reject parameters "Expected ?a type variables"))
  (loop for parameter in parameters for index from 0
        collect (cons parameter (format nil "A~6,'0D" index))))
(cl:defun collect-type-variables (syntax)
  (remove-duplicates
    (cond ((type-variable-p syntax) (list syntax))
          ((consp syntax) (mapcan #'collect-type-variables syntax)))))
(cl:defun define-type-alias (name parameters body)
  (require-arity name (if (stringp (first body)) (rest body) body) 1)
  (type-parameter-bindings parameters)
  (let ((type (car (last body))))
    (unless (subsetp (collect-type-variables type) parameters)
      (reject-kind 'dsl-type-error type "Undeclared type abbreviation parameter"))
    (cache-definition name (list 'deftype parameters type)
      (lambda ()
        (let* ((alias (list :parameters parameters :type type))
               (*type-aliases* (copy-table *type-aliases*)))
          (setf (gethash name *type-aliases*) alias)
          (hol-type (cons name parameters)))
        (setf (gethash name *type-aliases*) (list :parameters parameters :type type))
        type))))
(defmacro deftype (name parameters &body body)
  (declaration-expansion `(define-type-alias ',name ',parameters ',body)))

(cl:defun datatype-field-type (syntax group parameters)
  (cond
    ((and (consp syntax) (member (car syntax) group))
     (unless (equal (cdr syntax) parameters)
       (reject syntax "Recursive types must preserve the declared type parameters"))
     (holai.fusion:mk_vartype (encoded-name (car syntax))))
    ((and (symbolp syntax) (member syntax group))
     (when parameters (reject syntax "A recursive type needs its parameters"))
     (holai.fusion:mk_vartype (encoded-name syntax)))
    ((and (consp syntax) (eq (car syntax) '->))
     (unless (>= (length syntax) 3) (reject syntax "An arrow needs two types"))
     (reduce #'holai.fusion:mk_fun_ty
       (mapcar (lambda (x) (datatype-field-type x group parameters)) (cdr syntax)) :from-end t))
    ((consp syntax)
     (let ((info (gethash (car syntax) *types*)))
       (unless info (reject-kind 'dsl-type-error syntax "Unknown field type"))
       (require-arity syntax (cdr syntax) (second info))
       (holai.fusion:mk_type
         (tuple (first info)
                (mapcar (lambda (x) (datatype-field-type x group parameters)) (cdr syntax))))))
    (t (hol-type syntax))))
(cl:defun contains-symbol-p (symbols syntax)
  (cond ((consp syntax) (or (contains-symbol-p symbols (car syntax))
                            (contains-symbol-p symbols (cdr syntax))))
        (t (not (null (member syntax symbols))))))
(cl:defun validate-positive-field (syntax group &optional (positive t))
  (when (and (not positive) (contains-symbol-p group syntax))
    (reject syntax "Negative recursive occurrence"))
  (when (consp syntax)
    (if (eq (car syntax) '->)
        (progn (validate-positive-field (second syntax) group (not positive))
               (validate-positive-field (if (= (length syntax) 3) (third syntax)
                                           (cons '-> (cddr syntax))) group positive))
        (dolist (argument (cdr syntax)) (validate-positive-field argument group positive)))))
(cl:defun inhabited-field-p (syntax pending)
  (cond ((and (consp syntax) (eq (car syntax) 'list)) t)
        ((and (consp syntax) (eq (car syntax) '->))
         (inhabited-field-p (car (last syntax)) pending))
        ((and (consp syntax) (member (car syntax) pending)) nil)
        ((consp syntax) (every (lambda (x) (inhabited-field-p x pending)) (cdr syntax)))
        (t (not (member syntax pending)))))

(cl:defun define-datatypes (group-name parameters clauses)
  (let ((clauses (if (stringp (first clauses)) (rest clauses) clauses)))
    (unless (and (proper-list-p clauses)
                 (every (lambda (clause)
                          (and (proper-list-p clause) clause (symbolp (car clause))
                               (every (lambda (constructor)
                                        (and (proper-list-p constructor) constructor
                                             (symbolp (car constructor)))) (cdr clause)))) clauses))
      (reject clauses "Malformed datatype or constructor clauses"))
    (unless clauses (reject group-name "A datatype needs constructors"))
    (cache-definition group-name (list 'defdatatypes parameters clauses)
      (lambda ()
        (let* ((*type-parameters* (type-parameter-bindings parameters))
               (names (mapcar #'first clauses)) (constructor-names nil)
               (used nil) (metadata nil) (specification nil))
          (require-variables names)
          (unless (member group-name names)
            (ensure-result-names group-name '(".induction" ".recursion")))
          (dolist (name names)
            (require-owner name)
            (when (or (gethash name *types*) (gethash name *type-aliases*))
              (reject-kind 'definition-conflict name "Type name already exists"))
            (ensure-result-names name '(".induction" ".recursion" ".cases" ".injective" ".distinct")))
          (dolist (clause clauses)
            (unless (and (proper-list-p clause) (cdr clause))
              (reject clause "A type needs at least one constructor"))
            (let ((family (mapcar #'first (cdr clause))) (native-constructors nil))
              (dolist (constructor (cdr clause))
                (unless (and (proper-list-p constructor) constructor)
                  (reject constructor "Expected (constructor (field type) ...)"))
                (let ((name (first constructor)) (fields (cdr constructor)))
                  (require-owner name)
                  (when (or (member name constructor-names) (gethash name *constants*))
                    (reject-kind 'definition-conflict name "Constructor name is occupied"))
                  (push name constructor-names)
                  (dolist (field fields)
                    (require-arity field field 2)
                    (validate-positive-field (second field) names)
                    (setf used (union used (collect-type-variables (second field)))))
                  (require-variables (mapcar #'first fields))
                  (push (cons name (list :type (car clause) :family family :fields fields)) metadata)
                  (push (tuple (encoded-name name)
                          (mapcar (lambda (field)
                                    (datatype-field-type (second field) names parameters)) fields))
                        native-constructors)))
              (push (tuple (holai.fusion:mk_vartype (encoded-name (car clause)))
                           (nreverse native-constructors)) specification)))
          (unless (and (subsetp used parameters) (subsetp parameters used))
            (reject parameters "Datatype parameters must be declared and used"))
          ;; Reject groups without a finite constructor witness before kernel mutation.
          (let ((inhabited nil))
            (loop for before = (length inhabited)
                  do (dolist (clause clauses)
                       (when (some (lambda (constructor)
                                     (every (lambda (field)
                                              (inhabited-field-p (second field) (set-difference names inhabited)))
                                            (cdr constructor))) (cdr clause))
                         (pushnew (car clause) inhabited)))
                  until (= before (length inhabited)))
            (unless (= (length inhabited) (length names))
              (reject group-name "No finite constructor witness for the recursive group")))
          (let* ((result (kernel-definition-call group-name
                           (lambda () (funcall holai.ind_types:define_type_raw
                                         (nreverse specification)))))
                 (induction (fst result)) (recursion (snd result)))
            (dolist (clause clauses)
              (let* ((name (car clause)) (native (encoded-name name))
                     (constructors (cdr clause))
                     (entries (list (cons ".induction" induction) (cons ".recursion" recursion)
                                    (cons ".cases" (holai.ind_types:cases native)))))
                (setf (gethash name *types*) (list native (length parameters))
                      (gethash native *type-inductions*) induction)
                (when (> (length constructors) 1)
                  (push (cons ".distinct" (holai.ind_types:distinctness native)) entries))
                (when (some #'cdr constructors)
                  (push (cons ".injective" (holai.ind_types:injectivity native)) entries))
                (register-definition-results name entries)))
            (dolist (entry metadata)
              (setf (gethash (car entry) *constructors*) (cdr entry)
                    (gethash (car entry) *constants*) (encoded-name (car entry))))
            (unless (member group-name names)
              (register-definition-results group-name
                (list (cons ".induction" induction) (cons ".recursion" recursion))))
            result))))))
(defmacro defdatatype (name parameters &body constructors)
  (declaration-expansion `(define-datatypes ',name ',parameters
     ',(list (cons name (if (stringp (first constructors)) (rest constructors) constructors))))))
(defmacro defdatatypes (name parameters &body clauses)
  (declaration-expansion `(define-datatypes ',name ',parameters ',clauses)))

(cl:defun require-definition-frees (equations name)
  (let ((free (holai.fusion:frees equations)))
    (unless (and (= (length free) 1)
                 (string= (fst (holai.fusion:dest_var (car free))) (encoded-name name)))
      (reject-kind 'dsl-scope-error name "Unbound variable or unused function in definition"))
    (car free)))
(cl:defun close-parameters (parameters term)
  (reduce (lambda (parameter body) (list 'forall (list parameter) body))
          parameters :from-end t :initial-value term))
(cl:defun define-function (name parameters body)
  (require-variables parameters)
  (multiple-value-bind (rest specs)
      (declaration-body body parameters '(type values type-variables ignorable recursion termination) t)
    (require-arity name rest 1)
    (when (and (assoc 'termination specs) (not (equal (assoc 'termination specs) '(termination :auto))))
      (reject specs "Only TERMINATION :AUTO is currently implemented"))
    (let ((expression (first rest)))
      (cache-definition name (list 'defun parameters specs expression)
        (lambda ()
          (ensure-result-names name '(".definition" ".equations"))
          (let* ((*constants* (copy-table *constants*)) (*bindings* parameters)
                 (*strict-names* t) (*variable-names* nil) (*elaboration-active* t)
                 (*annotations* (annotation-bindings specs))
                 (recursive (contains-symbol-p (list name) expression))
                 (matchp (and (consp expression) (eq (car expression) 'match)
                              (member (second expression) parameters)))
                 (clauses nil) (principle nil))
            (setf (gethash name *constants*) (encoded-name name))
            (when matchp
              ;; Expand only disjoint constructor branches into recursion equations.
              (let ((patterns (mapcar #'first (cddr expression))))
                (dolist (pattern patterns) (pattern-variables pattern))
                (unless (exhaustive-patterns-p (mapcar #'list patterns))
                  (reject expression "MATCH is not exhaustive"))
                (when (and (every #'consp patterns)
                           (= (length patterns) (length (remove-duplicates patterns :key #'car))))
                  (let* ((scrutinee (second expression))
                         (type (cdr (assoc scrutinee *annotations*))))
                    (dolist (branch (cddr expression))
                      (require-arity expression branch 2)
                      (let* ((pattern (freshen-wildcards (first branch)))
                             (variables (pattern-variables pattern))
                             (other-parameters (remove scrutinee parameters))
                             (*bindings* (append variables other-parameters))
                             (lhs-arguments (subst (if type `(the ,type ,pattern) pattern)
                                                   scrutinee parameters))
                             (result-type (second (assoc 'values specs)))
                             (equation `(= (,name ,@lhs-arguments)
                                            ,(if result-type `(the ,result-type ,(second branch))
                                                 (second branch)))))
                        (require-variables variables)
                        (push (close-parameters (append variables other-parameters) equation) clauses)))
                    (setf principle
                      (theorem (result-name (getf (gethash (caar patterns) *constructors*) :type)
                                            ".recursion")))))))
            (unless clauses
              (let ((result-type (second (assoc 'values specs))))
                (push (close-parameters parameters
                        `(= (,name ,@parameters)
                            ,(if result-type `(the ,result-type ,expression) expression))) clauses)))
            ;; Parameter type constraints apply even when quantified by generated clauses.
            (let* ((equations (read-term (cons 'and (nreverse clauses)) :expected-type 'bool))
                   (function (progn (require-type-parameters specs equations name)
                                    (require-definition-frees equations name)))
                   (explicit (second (assoc 'recursion specs)))
                   (recursion (if explicit (theorem explicit) principle))
                   (result
                     (if (or recursive principle explicit)
                         (progn
                           (require-closed-theorem
                             (if recursion
                                 (funcall holai.recursion:prove_recursive_functions_exist recursion equations)
                                 (funcall holai.define:prove_general_recursive_function_exists
                                   (funcall holai.bool:mk_exists (tuple function equations)))) name)
                           (kernel-definition-call name
                             (lambda () (if recursion
                                            (funcall holai.recursion:new_recursive_definition recursion equations)
                                            (funcall holai.define:define equations)))))
                         (kernel-definition-call name
                           (lambda () (funcall holai.pair:new_definition equations))))))
              (require-closed-theorem result name)
              ;; Publish into the outer table only after complete checked success.
              (register-definition-results name
                (list (cons ".definition" result) (cons ".equations" result)))
              (values result (gethash name *constants*)))))))))

;; The dynamic provisional constant table must never escape a failed definition.
(cl:defun introduce-function (name parameters body)
  (let ((result (define-function name parameters body)))
    (setf (gethash name *constants*) (encoded-name name)) result))
(defmacro defun (name parameters &body body &environment environment)
  (declaration-expansion `(introduce-function ',name ',parameters ',(expand-dsl body environment))))
(defmacro defconstant (name expression &optional docstring &environment environment)
  (declaration-expansion `(introduce-function ',name nil
     ',(append (when docstring (list docstring)) (list (expand-dsl expression environment))))))

(cl:defun relation-clauses (name parameters body)
  (require-variables parameters)
  (multiple-value-bind (rules specs)
      (declaration-body body parameters '(type type-variables strong-induction) t)
    (unless rules (reject name "An inductive relation needs rules"))
    (when (second (assoc 'strong-induction specs))
      (reject name "Explicit strong-induction generation is not implemented yet"))
    (let ((types (annotation-bindings specs)) (labels nil) (propositions nil))
      (dolist (rule rules)
        (unless (and (proper-list-p rule) (>= (length rule) 3)) (reject rule "Malformed rule"))
        (when (member (first rule) labels) (reject rule "Duplicate rule label"))
        (push (first rule) labels)
        (let ((variables (second rule)))
          (require-variables variables)
          (multiple-value-bind (rest declarations)
              (declaration-body (cddr rule) variables '(type ignorable))
            (require-arity rule rest 1)
            (let ((conclusion (first rest)))
              (loop while (and (consp conclusion) (eq (car conclusion) 'implies))
                    do (setf conclusion (third conclusion)))
              (unless (and (consp conclusion) (eq (car conclusion) name))
                (reject rule "Rule conclusion must be headed by its relation")))
            (push (if variables `(forall ,variables ,@(when declarations `((declare ,@declarations)))
                                         ,(first rest)) (first rest)) propositions))))
      (values (nreverse propositions) (nreverse labels)
              (when (every (lambda (p) (assoc p types)) parameters)
                (cons '-> (append (mapcar (lambda (p) (cdr (assoc p types))) parameters) (list 'bool))))))))
(cl:defun match-labelled-result (proposition rules)
  (let ((expected (read-term proposition :expected-type 'bool)))
    (or (loop for rule in rules
              for result = (handler-case
                             (holai.tactics:prove
                               (tuple expected (funcall holai.tactics:MATCH_ACCEPT_TAC rule)))
                             (holai.runtime.core:failure () nil))
              when result return result)
        (progn
          (setf *kernel-uncertain* t)
          (reject-kind 'kernel-state-uncertain proposition "Backend did not return the declared labelled clause")))))

(cl:defun define-relations (group parameters body)
  (unless (null parameters) (reject parameters "Parameterized relation groups are not implemented yet"))
  (let ((clauses (if (stringp (first body)) (rest body) body)))
    (cache-definition group (list 'defrelations parameters clauses)
      (lambda ()
        (let* ((*constants* (copy-table *constants*)) (*strict-names* t)
               (*variable-names* nil) (*elaboration-active* t) (*annotations* nil) (props nil) (labels nil))
          (dolist (clause clauses)
            (require-owner (first clause))
            (when (gethash (first clause) *constants*)
              (reject-kind 'definition-conflict clause "Relation already defined"))
            (setf (gethash (first clause) *constants*) (encoded-name (first clause))))
          (dolist (clause clauses)
            (multiple-value-bind (propositions names signature)
                (relation-clauses (first clause) (second clause) (cddr clause))
              (when signature (push (cons (first clause) signature) *annotations*))
              (setf props (append props propositions) labels (append labels names))))
          (ensure-result-names group (append '(".rules" ".induction" ".cases")
                                      (mapcar (lambda (label) (concatenate 'string ".rules." (symbol-name label))) labels)))
          (let ((proposition (read-term (cons 'and props) :expected-type 'bool)))
            (require-closed-theorem
              (funcall holai.ind_defs:prove_inductive_relations_exist proposition) group)
            (let* ((result (kernel-definition-call group
                             (lambda () (funcall holai.ind_defs:new_inductive_definition proposition))))
                   (parts (holai.runtime.data:tuple-items result))
                   (rules (funcall holai.bool:CONJUNCTS (first parts)))
                   (entries (list (cons ".rules" (first parts)) (cons ".induction" (second parts))
                                  (cons ".cases" (third parts)))))
              (loop for label in labels for proposition in props
                    do (push (cons (concatenate 'string ".rules." (symbol-name label))
                                   (match-labelled-result proposition rules)) entries))
              (register-definition-results group entries)
              result)))))))
(cl:defun introduce-relations (group parameters body)
  (let ((result (define-relations group parameters body)))
    (dolist (clause (if (stringp (first body)) (rest body) body))
      (setf (gethash (car clause) *constants*) (encoded-name (car clause)))) result))
(cl:defun expand-relation-body (body environment)
  (mapcar (lambda (form)
            (if (or (stringp form) (and (consp form) (eq (car form) 'declare))) form
                (progn
                  (unless (and (proper-list-p form) (>= (length form) 3))
                    (reject form "Malformed relation rule"))
                  (list* (first form) (second form)
                         (mapcar (lambda (x) (expand-dsl x environment)) (cddr form)))))) body))
(defmacro definductive (name parameters &body body &environment environment)
  (declaration-expansion `(introduce-relations ',name nil
     ',(list (list* name parameters (expand-relation-body body environment))))))
(defmacro defrelations (group parameters &body clauses &environment environment)
  (declaration-expansion `(introduce-relations ',group ',parameters
     ',(mapcar (lambda (clause)
                 (if (stringp clause) clause
                     (list* (first clause) (second clause)
                            (expand-relation-body (cddr clause) environment)))) clauses))))

(cl:defun introduce-record (name parameters body)
  (let* ((fields (if (stringp (first body)) (rest body) body))
         (constructor (intern (concatenate 'string "MAKE-" (symbol-name name)) (symbol-package name)))
         (record-variable (intern "%RECORD-VALUE" (symbol-package name))))
    (unless fields (reject name "A record needs fields"))
    (dolist (field fields) (require-arity field field 2))
    (require-variables (mapcar #'first fields))
    (let ((result (define-datatypes name parameters (list (list name (cons constructor fields))))))
      (dolist (field fields)
        (let ((projection (intern (concatenate 'string (symbol-name name) "-" (symbol-name (first field)))
                                  (symbol-package name))))
          (introduce-function projection (list record-variable)
            `((declare (type (,name ,@parameters) ,record-variable) (values ,(second field)))
              (match ,record-variable
                ((,constructor ,@(mapcar #'first fields)) ,(first field)))))))
      result)))
(defmacro defstruct (name parameters &body fields)
  (declaration-expansion `(introduce-record ',name ',parameters ',fields)))

(cl:defun introduce-equations (name parameters body)
  (require-variables parameters)
  (multiple-value-bind (clauses specs)
      (declaration-body body parameters '(type values type-variables recursion) t)
    (unless clauses (reject name "Expected defining equations"))
    (cache-definition name (list 'defequations parameters specs clauses)
      (lambda ()
        (ensure-result-names name
          (append '(".definition" ".equations")
                  (mapcar (lambda (clause)
                            (concatenate 'string ".equations." (symbol-name (first clause)))) clauses)))
        (let* ((*constants* (copy-table *constants*)) (*strict-names* t)
               (*variable-names* nil) (*elaboration-active* t) (*bindings* nil) (*annotations* nil)
               (equations nil) (rows nil) (labels nil))
          (setf (gethash name *constants*) (encoded-name name))
          (dolist (clause clauses)
            (unless (and (proper-list-p clause) (>= (length clause) 3))
              (reject clause "Expected labelled equation"))
            (let ((label (first clause)) (variables (second clause)))
              (when (member label labels) (reject label "Duplicate equation label"))
              (push label labels)
              (require-variables variables)
              (multiple-value-bind (rest declarations)
                  (declaration-body (cddr clause) variables '(type ignorable))
                (require-arity clause rest 1)
                (let* ((equation (first rest)) (lhs (second equation)))
                  (unless (and (eq (first equation) '=) (= (length equation) 3)
                               (consp lhs) (eq (first lhs) name)
                               (= (length (cdr lhs)) (length parameters)))
                    (reject clause "Equation must define this function at the declared arity"))
                  (push (cdr lhs) rows)
                  (let ((pattern-vars (mapcan #'pattern-variables (cdr lhs))))
                    (require-variables pattern-vars)
                    (unless (and (subsetp pattern-vars variables) (subsetp variables pattern-vars))
                      (reject clause "Equation variables must be exactly the pattern variables")))
                  (let ((annotations (annotation-bindings specs)))
                    (loop for parameter in parameters for argument in (cdr lhs)
                          for type = (cdr (assoc parameter annotations))
                          when type do (setf equation
                            (list '= (subst `(the ,type ,argument) argument (second equation))
                                     (third equation)))))
                  (let ((result-type (second (assoc 'values specs))))
                    (when result-type
                      (setf equation `(= ,(second equation) (the ,result-type ,(third equation))))))
                  (push (if variables
                            `(forall ,variables ,@(when declarations `((declare ,@declarations))) ,equation)
                            equation) equations)))))
          (unless (exhaustive-patterns-p rows) (reject name "Equations do not cover all constructors"))
          (let* ((proposition (read-term (cons 'and (setf equations (nreverse equations))) :expected-type 'bool))
                 (function (progn (require-type-parameters specs proposition name)
                                  (require-definition-frees proposition name)))
                 (recursion-name (second (assoc 'recursion specs)))
                 (recursion (and recursion-name (theorem recursion-name))))
            (require-closed-theorem
              (if recursion (funcall holai.recursion:prove_recursive_functions_exist recursion proposition)
                  (funcall holai.define:prove_general_recursive_function_exists
                    (funcall holai.bool:mk_exists (tuple function proposition)))) name)
            (let* ((result (kernel-definition-call name
                             (lambda () (if recursion
                                            (funcall holai.recursion:new_recursive_definition recursion proposition)
                                            (funcall holai.define:define proposition)))))
                   (entries (list (cons ".definition" result) (cons ".equations" result)))
                   (rules (funcall holai.bool:CONJUNCTS result)))
              (when (= (length rules) (length labels))
                (loop for label in (nreverse labels) for proposition in equations
                      do (push (cons (concatenate 'string ".equations." (symbol-name label))
                                     (match-labelled-result proposition rules)) entries)))
              (register-definition-results name entries)
              result)))))
    (setf (gethash name *constants*) (encoded-name name))
    (theorem (result-name name ".equations"))))
(defmacro defequations (name parameters &body clauses &environment environment)
  (declaration-expansion `(introduce-equations ',name ',parameters ',(expand-relation-body clauses environment))))
