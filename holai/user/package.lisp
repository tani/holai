(cl:defun publish-theorem (name result source &optional references (expanded-source source))
  (let ((old (gethash name *provenance*)))
    (setf (gethash name *theorems*) result
          (gethash name *provenance*)
          (list :source source :expanded-source expanded-source :references references
                :context-parameters (copy-list *context-parameters*)
                :context-assumptions (copy-tree *context-assumptions*)
                :version (1+ (getf old :version 0))
                :basis "HOL Light 233b83c3202370e03c54de2bd090e4d34f677e91"
                :lisp (list (lisp-implementation-type) (lisp-implementation-version))
                :dependencies :conservative-kernel-axiom-upper-bound
                :axioms (copy-list (holai.fusion:axioms holai.runtime.data:unit))
                :automation (copy-list *automation-options*)
                :extensions (loop for key being the hash-keys of *extension-versions*
                                  using (hash-value value) collect (cons key value))
                :simpset *default-simpset* :compset *default-compset*))) result)
