(in-package :holai.user)

(cl:defun context-expansion (parameters body)
  (require-variables parameters)
  (multiple-value-bind (forms specs)
      (declaration-body body parameters '(type type-variables assumption simpset compset automation))
    (let ((assumptions (loop for s in specs when (eq (car s) 'assumption) collect (cdr s))))
      (when (assoc 'automation specs)
        (multiple-value-bind (facts opts) (options body (cdr (assoc 'automation specs)) '(:timeout))
          (when facts (reject body "AUTOMATION uses keyword settings"))
          (when (getf opts :timeout)
            (unless (and (realp (getf opts :timeout)) (plusp (getf opts :timeout))) (reject opts "Expected a positive timeout")))))
      (dolist (a assumptions) (require-arity a a 2))
      `(let* ((*context-active* t)
              (*context-parameters* (append *context-parameters* ',parameters))
              (*bindings* (append ',parameters *bindings*))
              (*annotations* (append ',(annotation-bindings specs) *annotations*))
              (*context-assumptions* (append *context-assumptions* ',assumptions))
              (*local-theorems* (copy-list *local-theorems*))
              (*context-function-bindings* (copy-list *context-function-bindings*))
              (*local-simp-theorems* (copy-list *local-simp-theorems*))
              (*default-simpset* ,(if (assoc 'simpset specs) `',(second (assoc 'simpset specs)) '*default-simpset*))
              (*default-compset* ,(if (assoc 'compset specs) `',(second (assoc 'compset specs)) '*default-compset*))
              (*automation-options* (append ',(cdr (assoc 'automation specs)) *automation-options*)))
         (require-variables *context-parameters*)
         ,@forms))))
(defmacro with-proof-context (parameters &body body)
  (context-expansion parameters body))
(defmacro lemma (name parameters &body body &environment environment)
  `(progn
     (unless *context-active* (reject ',name "LEMMA requires WITH-PROOF-CONTEXT"))
     (let ((th (prove-declaration ',parameters ',(expand-dsl body environment))))
       (let ((local th))
         (dolist (parameter *context-parameters*)
           (setf local (holai.bool:ISPEC (read-term parameter) local)))
         (setf local (native "HOLAI.BOOL" "SPEC_ALL" local))
         (dolist (assumption *context-assumptions*)
           (declare (ignore assumption)) (setf local (native "HOLAI.BOOL" "UNDISCH" local)))
         (push (cons ',name local) *local-theorems*)) th)))

(cl:defun raw-proof-for (statement proof &optional definitions)
  (let* ((tactic
           (if (and (consp proof) (member (name-text (car proof)) '("by" "proof") :test #'equal))
               (sequence-tactics (cdr proof))
               (lambda (g)
                 (let ((candidate (goal-theorem proof g)))
                   (when definitions
                     (setf candidate (native "HOLAI.EQUAL" "CONV_RULE"
                                       (native "HOLAI.EQUAL" "DEPTH_CONV" (native-function "HOLAI.EQUAL" "BETA_CONV")) candidate)))
                   (funcall (native "HOLAI.TACTICS" "MATCH_ACCEPT_TAC" candidate) g)))))
         (tactic (if definitions (native "HOLAI.TACTICS" "THEN" (native "HOLAI.SIMP" "REWRITE_TAC" definitions) tactic) tactic))
         (th (funcall *proof-executor*
               (lambda () (native "HOLAI.TACTICS" "prove" (tuple statement tactic))))))
    (require-closed-theorem th proof)
    (unless (holai.fusion:aconv statement (holai.fusion:concl th))
      (reject-kind 'dsl-contract-error proof "Proof conclusion differs from the required proposition")) th))
(cl:defun proof-for (statement proof &optional definitions)
  (restart-case
    (handler-case (raw-proof-for statement proof definitions)
      (holai.runtime.core:failure (cause)
        (error 'dsl-proof-failure :form proof :cause cause :expected statement)))
    (retry-proof () :report "Retry this proof with the current proof environment."
      (proof-for statement proof definitions))))
(cl:defun introduce-specification (names parameters body)
  (require-variables names)
  (when (or (null names) parameters) (reject names "DEFSPEC requires names and ()"))
  (dolist (name names) (require-owner name))
  (multiple-value-bind (rest specs) (declaration-body body nil '(type-variables) t)
    (unless (>= (length rest) 2) (reject body "Expected proposition and proof steps"))
    (let ((context (copy-list *context-parameters*)))
      (cache-definition (first names)
        (list 'defspec names specs rest context *context-assumptions* *annotations*)
        (lambda ()
          (dolist (name names)
            (when (gethash name *constants*) (reject name "Constant is occupied"))
            (ensure-result-names name '(".specification")))
          (let* ((*bindings* context) (*strict-names* t)
                 (statement (read-term (first rest) :expected-type 'bool))
                 (binders (fst (native "HOLAI.BASICS" "strip_exists" statement))))
            (unless (= (length binders) (length names)) (reject names "Consume every leading existential binder"))
            (require-type-parameters specs statement names)
            (let* ((existence (if (or context *context-assumptions*) (prove-declaration nil body)
                                 (proof-for statement `(by ,@(cdr rest)))))
                   (existence (if context
                                  (native "HOLAI.EQUAL" "CONV_RULE"
                                    (native "HOLAI.SIMP" "GEN_REWRITE_CONV"
                                      (native-function "HOLAI.EQUAL" "REDEPTH_CONV")
                                      (list holai.class:RIGHT_IMP_EXISTS_THM holai.class:SKOLEM_THM)) existence)
                                  existence))
                   (consumed (fst (native "HOLAI.BASICS" "strip_exists" (holai.fusion:concl existence)))))
              (unless (= (length consumed) (length names)) (reject names "Skolemization did not preserve the specified witnesses"))
              (require-visible-type-variables (holai.fusion:concl existence) (mapcar #'holai.fusion:type_of consumed) names)
              (when (holai.fusion:frees (holai.fusion:concl existence)) (reject body "Existence evidence has free terms"))
              (require-closed-theorem existence names)
              (let ((result (kernel-definition-call names
                              (lambda () (native "HOLAI.NUMS" "new_specification" (mapcar #'encoded-name names) existence)))))
                (dolist (name names)
                  (setf (gethash name *constants*) (encoded-name name))
                  (register-definition-results name (list (cons ".specification" result)))) result)))))
      (when context (dolist (name names) (push (cons name context) *context-function-bindings*)))
      (theorem (result-name (first names) ".specification")))))
(defmacro defspec (names parameters &body body &environment environment)
  (declaration-expansion `(introduce-specification ',names ',parameters ',(expand-dsl body environment))))

(cl:defun introduce-subset (name parameters body)
  (require-variables parameters)
  (unless (every #'type-variable-p parameters) (reject parameters "Expected ?a type parameters"))
  (multiple-value-bind (rest specs) (declaration-body body nil '(representation-type) t)
    (require-arity body rest 2)
    (let ((representation (second (assoc 'representation-type specs))))
      (unless representation (reject body "REPRESENTATION-TYPE is required"))
      (let ((used (collect-type-variables representation)))
        (unless (and (subsetp used parameters) (subsetp parameters used))
          (reject representation "Representation parameters must be declared and used")))
      (cache-definition name (list 'defsubset parameters specs rest)
        (lambda ()
          (when (or (gethash name *types*) (gethash name *type-aliases*)) (reject name "Type name is occupied"))
          (let* ((*type-parameters* (type-parameter-bindings parameters))
                 (*strict-names* t) (*bindings* nil)
                 (base (hol-type representation))
                 (predicate (read-term (first rest) :expected-hol-type
                              (native "HOLAI.FUSION" "mk_fun_ty" base (hol-type 'bool))))
                 (x (holai.fusion:mk_var (tuple "subset_witness" base)))
                 (statement (native "HOLAI.BOOL" "mk_exists"
                              (tuple x (holai.fusion:mk_comb (tuple predicate x)))))
                 (proof (proof-for statement (second rest)))
                 (abs (result-name name ".abs")) (rep (result-name name ".rep")))
            (require-type-parameters (list (cons 'type-variables parameters)) predicate name)
            (dolist (n (list abs rep)) (require-owner n)
              (when (gethash n *constants*) (reject n "Generated constant name occupied")))
            (ensure-result-names name '(".abs-rep" ".rep-abs" ".membership"))
            (let* ((result (kernel-definition-call name
                             (lambda () (native "HOLAI.CLASS" "new_type_definition" (encoded-name name)
                                          (tuple (encoded-name abs) (encoded-name rep)) proof))))
                   (parts (native "HOLAI.BOOL" "CONJUNCTS" result)))
              (setf (gethash name *types*) (list (encoded-name name) (length parameters))
                    (gethash abs *constants*) (encoded-name abs) (gethash rep *constants*) (encoded-name rep))
              (register-definition-results name
                (list (cons ".abs-rep" (first parts)) (cons ".rep-abs" (second parts))))
              (let* ((a (gensym "SUBSET"))
                     (claim `(forall (,a) (declare (type (,name ,@parameters) ,a))
                               (,(first rest) (,rep ,a))))
                     (membership (native "HOLAI.TACTICS" "prove"
                                   (tuple (read-term claim :expected-type 'bool)
                                     (native "HOLAI.SIMP" "SIMP_TAC" parts)))))
                (register-definition-results name (list (cons ".membership" membership))))
              result)))))))
(defmacro defsubset (name parameters &body body &environment environment)
  (declaration-expansion `(introduce-subset ',name ',parameters ',(expand-dsl body environment))))

(cl:defun introduce-quotient (name parameters body)
  (require-variables parameters)
  (unless (every #'type-variable-p parameters) (reject parameters "Expected ?a type parameters"))
  (multiple-value-bind (rest specs) (declaration-body body nil '(representation-type) t)
    (require-arity body rest 2)
    (let ((representation (second (assoc 'representation-type specs))))
      (unless representation (reject body "REPRESENTATION-TYPE is required"))
      (let ((used (collect-type-variables representation)))
        (unless (and (subsetp used parameters) (subsetp parameters used))
          (reject representation "Representation parameters must be declared and used")))
      (cache-definition name (list 'defquotient parameters specs rest)
        (lambda ()
          (when (or (gethash name *types*) (gethash name *type-aliases*)) (reject name "Type name is occupied"))
          (let* ((*type-parameters* (type-parameter-bindings parameters))
                 (*context-parameters* nil) (*strict-names* t) (*bindings* nil)
                 (base (hol-type representation))
                 (source-relation (read-term (first rest) :expected-type `(-> ,representation ,representation bool)))
                 (x (gensym "X")) (y (gensym "Y")) (z (gensym "Z"))
                 (claims (list
                   `(forall (,x) (declare (type ,representation ,x)) (,(first rest) ,x ,x))
                   `(forall (,x ,y) (declare (type ,representation ,x ,y))
                      (iff (,(first rest) ,x ,y) (,(first rest) ,y ,x)))
                   `(forall (,x ,y ,z) (declare (type ,representation ,x ,y ,z))
                      (implies (and (,(first rest) ,x ,y) (,(first rest) ,y ,z)) (,(first rest) ,x ,z)))))
                 (statement (read-term (cons 'and claims) :expected-type 'bool))
                 (proof (proof-for statement (second rest)))
                 (abs (result-name name ".abs")) (rep (result-name name ".rep"))
                 (class (result-name name ".class")) (relation-name (result-name name ".relation")))
            (require-type-parameters (list (cons 'type-variables parameters)) source-relation name)
            (dolist (n (list abs rep class relation-name))
              (require-owner n) (when (gethash n *constants*) (reject n "Generated name occupied")))
            (ensure-result-names name '(".abs-rep" ".rep-abs" ".equivalence" ".class-equality" ".class-relation"))
            (ensure-result-names class '(".definition" ".equations"))
            (ensure-result-names relation-name '(".definition" ".equations"))
            ;; A named relation preserves the syntactic correspondence required by
            ;; HOL Light's first-order lifting, even for a lambda-valued input.
            (let* ((relation-definition (kernel-definition-call name
                       (lambda () (native "HOLAI.PAIR" "new_definition"
                         (native "HOLAI.FUSION" "mk_eq"
                           (tuple (holai.fusion:mk_var (tuple (encoded-name relation-name) (holai.fusion:type_of source-relation))) source-relation))))))
                   (relation-normalization (native "HOLAI.EQUAL" "CONV_RULE"
                     (native "HOLAI.EQUAL" "RAND_CONV"
                       (native "HOLAI.EQUAL" "DEPTH_CONV" (native-function "HOLAI.CLASS" "ETA_CONV"))) relation-definition))
                   (proof (native "HOLAI.SIMP" "GEN_REWRITE_RULE"
                            (native-function "HOLAI.EQUAL" "DEPTH_CONV")
                            (list (native "HOLAI.EQUAL" "GSYM" relation-definition)) proof))
                   (properties (native "HOLAI.BOOL" "CONJUNCTS" proof)))
              (setf (gethash relation-name *constants*) (encoded-name relation-name))
              (register-definition-results relation-name
                (list (cons ".definition" relation-definition) (cons ".equations" relation-definition)))
              (let* ((relation (read-term relation-name :expected-hol-type (holai.fusion:type_of source-relation)))
                     (bijections (kernel-definition-call name
                       (lambda () (native "HOLAI.QUOT" "define_quotient_type" (encoded-name name)
                                    (tuple (encoded-name abs) (encoded-name rep)) relation)))))
                (setf (gethash name *types*) (list (encoded-name name) (length parameters))
                      (gethash abs *constants*) (encoded-name abs) (gethash rep *constants*) (encoded-name rep))
                (register-definition-results name
                  (list (cons ".abs-rep" (fst bijections)) (cons ".rep-abs" (snd bijections)) (cons ".equivalence" proof)))
                (introduce-function class (list x)
                  `((declare (type ,representation ,x)) (,abs (,relation-name ,x))))
                (let* ((claim `(forall (,x ,y) (declare (type ,representation ,x ,y))
                                 (iff (= (,class ,x) (,class ,y)) (,relation-name ,x ,y))))
                       (goal (read-term claim :expected-type 'bool))
                       (class-definition (theorem (result-name class ".definition")))
                       (thms (mapcar (lambda (th) (native "HOLAI.SIMP" "REWRITE_RULE" (list relation-definition) th))
                                    (append (list class-definition (fst bijections) (snd bijections) holai.class:FUN_EQ_THM) properties)))
                       (equality (native "HOLAI.TACTICS" "prove"
                                   (tuple goal (native "HOLAI.TACTICS" "THEN"
                                     (native "HOLAI.SIMP" "REWRITE_TAC" (list class-definition relation-definition))
                                     (native "HOLAI.MESON" "MESON_TAC" thms)))))
                       (source-equality (native "HOLAI.SIMP" "REWRITE_RULE" (list relation-definition) equality)))
                  (register-definition-results name
                    (list (cons ".class-relation" equality) (cons ".class-equality" source-equality))))
                (setf (gethash name *quotients*)
                  (list :name name :quotient-type (hol-type (if parameters (cons name parameters) name))
                        :relation relation :relation-definition relation-definition :relation-normalization relation-normalization
                        :base-type base :representation representation :parameters parameters
                        :bijections bijections :properties properties :lifts nil)) bijections))))))))
(defmacro defquotient (name parameters &body body &environment environment)
  (declaration-expansion `(introduce-quotient ',name ',parameters ',(expand-dsl body environment))))

(cl:defun instantiate-quotient-entry (entry substitutions)
  (let ((copy (copy-list entry)))
    (unless substitutions (return-from instantiate-quotient-entry copy))
    (dolist (key '(:relation-definition :relation-normalization))
      (setf (getf copy key) (native "HOLAI.FUSION" "INST_TYPE" substitutions (getf entry key))))
    (dolist (key '(:base-type :quotient-type))
      (setf (getf copy key) (native "HOLAI.FUSION" "type_subst" substitutions (getf entry key))))
    (setf (getf copy :relation) (native "HOLAI.FUSION" "INST" substitutions (getf entry :relation))
          (getf copy :bijections) (tuple (native "HOLAI.FUSION" "INST_TYPE" substitutions (fst (getf entry :bijections)))
                                         (native "HOLAI.FUSION" "INST_TYPE" substitutions (snd (getf entry :bijections)))))
    (dolist (key '(:properties :lifts))
      (setf (getf copy key) (mapcar (lambda (th) (native "HOLAI.FUSION" "INST_TYPE" substitutions th)) (getf entry key)))) copy))
(cl:defun quotient-instance (designator &optional base-type)
  (let* ((name (if (consp designator) (car designator) designator))
         (entry (or (gethash name *quotients*) (reject designator "Unknown quotient")))
         (substitutions
           (cond ((consp designator) (native "HOLAI.BASICS" "type_match" (getf entry :quotient-type) (hol-type designator) nil))
                 (base-type (native "HOLAI.BASICS" "type_match" (getf entry :base-type) base-type nil)))))
    (instantiate-quotient-entry entry substitutions)))
(cl:defun function-argument-types (type count)
  (let ((types nil))
    (dotimes (i count)
      (let ((parts (holai.fusion:dest_type type)))
        (unless (equal (fst parts) "fun") (reject type "Source has too few arguments"))
        (push (first (snd parts)) types) (setf type (second (snd parts)))))
    (values (nreverse types) type)))
(cl:defun prepare-lift-signature (source designator parameters positions specs)
  (let* ((name (if (consp designator) (car designator) designator))
         (prototype (gethash name *quotients*)) (annotations (annotation-bindings specs))
         (result-syntax (second (assoc 'values specs))) (q nil))
    (multiple-value-bind (argument-types result-type) (function-argument-types (holai.fusion:type_of source) (length parameters))
      (let* ((first-position (first positions))
             (annotation (cdr (assoc (nth (1- first-position) parameters) annotations)))
             (explicit-type (and annotation (hol-type annotation)))
             (result-quotient (and result-syntax
                                   (let ((ty (hol-type result-syntax)))
                                     (and (not (funcall holai.fusion:is_vartype ty))
                                          (equal (fst (holai.fusion:dest_type ty)) (encoded-name name)) ty)))))
        (setf q
          (cond ((consp designator) (quotient-instance designator))
                (explicit-type (instantiate-quotient-entry prototype
                                  (native "HOLAI.BASICS" "type_match" (getf prototype :quotient-type) explicit-type nil)))
                (result-quotient (instantiate-quotient-entry prototype
                                  (native "HOLAI.BASICS" "type_match" (getf prototype :quotient-type) result-quotient nil)))
                (t (handler-case (quotient-instance name (nth (1- first-position) argument-types))
                     (holai.runtime.core:failure () (copy-list prototype))))))
        (let ((substitutions nil))
          (loop for type in argument-types for parameter in parameters for index from 1
                for expected = (if (member index positions) (getf q :base-type)
                                   (let ((annotation (cdr (assoc parameter annotations)))) (if annotation (hol-type annotation) type))) do
            (setf substitutions (native "HOLAI.BASICS" "type_match" type expected substitutions)))
          (when result-syntax
            (setf substitutions (native "HOLAI.BASICS" "type_match" result-type
                                  (if result-quotient (getf q :base-type) (hol-type result-syntax)) substitutions)))
          (setf source (native "HOLAI.FUSION" "INST" substitutions source)
                q (instantiate-quotient-entry q substitutions))
          (multiple-value-bind (actual-arguments actual-result) (function-argument-types (holai.fusion:type_of source) (length parameters))
            (let* ((public-arguments (loop for type in actual-arguments for index from 1
                                          collect (if (member index positions) (getf q :quotient-type) type)))
                   (public-result (if result-quotient (getf q :quotient-type) actual-result)))
              (when (and (null result-syntax) (holai.runtime.core:= actual-result (getf q :base-type)))
                (reject specs "VALUES is required to distinguish a base result from a quotient result"))
              (loop for parameter in parameters for type in public-arguments
                    for annotation = (cdr (assoc parameter annotations))
                    when (and annotation (not (holai.runtime.core:= type (hol-type annotation)))) do
                      (reject annotation "A lifting stage uses one relation instance"))
              (require-type-parameters specs source specs)
              (values source q (not (null result-quotient))
                      (reduce (lambda (a b) (native "HOLAI.FUSION" "mk_fun_ty" a b))
                              (append public-arguments (list public-result)) :from-end t)))))))))
(cl:defun introduce-lift (name parameters body)
  (require-variables parameters)
  (multiple-value-bind (rest specs)
      (declaration-body body parameters '(type values type-variables quotients lift-positions) t)
    (require-arity body rest 2)
    (let* ((qs (cdr (assoc 'quotients specs))) (positions (cdr (assoc 'lift-positions specs)))
           (designator (first qs)) (qname (if (consp designator) (car designator) designator)))
      (unless (and (= (length qs) 1) (gethash qname *quotients*))
        (reject qs "A lifting stage uses one quotient relation instance"))
      (unless (and positions (= (length positions) (length (remove-duplicates positions)))
                   (every (lambda (p) (and (integerp p) (<= 1 p (length parameters)))) positions))
        (reject positions "LIFT-POSITIONS are distinct, 1-based argument positions"))
      (cache-definition name (list 'deflift parameters specs rest)
        (lambda ()
          (ensure-result-names name '(".definition" ".equations" ".lifting"))
          (when (gethash name *constants*) (reject name "Lifted constant name occupied"))
          (let ((*strict-names* t) (*bindings* nil))
            (multiple-value-bind (source q quotient-result public-type)
                (prepare-lift-signature (read-term (first rest)) designator parameters positions specs)
              (let ((args nil) (primes nil) (hyps nil) (type (holai.fusion:type_of source)))
                (dotimes (i (length parameters))
                  (let* ((parts (holai.fusion:dest_type type)) (argtype (first (snd parts)))
                         (x (holai.fusion:mk_var (tuple (format nil "lift_x~d" i) argtype)))
                         (y (holai.fusion:mk_var (tuple (format nil "lift_y~d" i) argtype))))
                    (push x args) (push y primes)
                    (push (if (member (1+ i) positions)
                              (holai.basics:list_mk_comb (tuple (getf q :relation) (list x y)))
                              (native "HOLAI.FUSION" "mk_eq" (tuple x y))) hyps)
                    (setf type (second (snd parts)))))
                (setf args (nreverse args) primes (nreverse primes) hyps (nreverse hyps))
                (let* ((left (holai.basics:list_mk_comb (tuple source args)))
                       (right (holai.basics:list_mk_comb (tuple source primes)))
                       (conclusion (if quotient-result
                                       (holai.basics:list_mk_comb (tuple (getf q :relation) (list left right)))
                                       (native "HOLAI.FUSION" "mk_eq" (tuple left right))))
                       (statement (native "HOLAI.BOOL" "list_mk_forall"
                                    (tuple (mapcan #'list args primes)
                                      (native "HOLAI.BOOL" "mk_imp"
                                        (tuple (native "HOLAI.BOOL" "list_mk_conj" hyps) conclusion)))))
                       (proof (proof-for statement (second rest) (list (getf q :relation-definition))))
                       (props (getf q :properties))
                       (result (kernel-definition-call name
                         (lambda () (native "HOLAI.QUOT" "lift_function" (snd (getf q :bijections))
                                      (tuple (first props) (third props)) (encoded-name name) proof)))))
                  (unless (holai.runtime.core:= public-type (native "HOLAI.FUSION" "get_const_type" (encoded-name name)))
                    (reject-kind 'kernel-state-uncertain name "Lifted signature differs from the checked signature"))
                  (setf (gethash name *constants*) (encoded-name name))
                  (push (snd result) (getf (gethash qname *quotients*) :lifts))
                  (register-definition-results name
                    (list (cons ".definition" (fst result)) (cons ".equations" (fst result)) (cons ".lifting" (snd result)))) result)))))))))
(defmacro deflift (name parameters &body body &environment environment)
  (declaration-expansion `(introduce-lift ',name ',parameters ',(expand-dsl body environment))))
(cl:defun lift-theorem (quotient source &optional lifting-theorems)
  (let* ((q (quotient-instance quotient))
         (p (getf q :properties))
         (source (if (symbolp source) (theorem source) (require-theorem source quotient))))
    (require-closed-theorem source quotient)
    (require-closed-theorem
      (native "HOLAI.QUOT" "lift_theorem" (getf q :bijections)
        (tuple (first p) (second p) (third p))
        (append (mapcar (lambda (th) (if (symbolp th) (theorem th) (require-theorem th quotient))) lifting-theorems)
                (getf q :lifts))
        (let* ((normal (getf q :relation-normalization))
               (rhs (snd (holai.fusion:dest_eq (holai.fusion:concl normal))))
               (equality (and (holai.fusion:is_const rhs) (equal (fst (holai.fusion:dest_const rhs)) "=")))
               (ambiguous (and equality (or (funcall holai.fusion:is_vartype (getf q :base-type))
                                           (holai.runtime.core:= (getf q :base-type) (hol-type 'bool))))))
          (if ambiguous source
              (native "HOLAI.SIMP" "REWRITE_RULE" (list (native "HOLAI.EQUAL" "GSYM" normal)) source)))) quotient)))
(setf (gethash "lift-theorem" *theorem-expressions*)
  (lambda (form g)
    (unless (>= (length form) 3) (reject form "LIFT-THEOREM requires a quotient and source theorem"))
    (lift-theorem (second form) (goal-theorem (third form) g)
                  (mapcar (lambda (th) (goal-theorem th g)) (cdddr form)))))

;; Sessions own immutable HOL goalstates, never the generated global goalstack.
(cl:defun goal (syntax &key (parameters nil))
  (require-variables parameters)
  (setf *goal-labels* (make-hash-table :test #'eq))
  (let* ((*bindings* parameters) (*strict-names* nil)
         (statement (read-term syntax :expected-type 'bool)))
    (setf *proof-session* (list :statement statement :parameters parameters
                               :states (list (native "HOLAI.TACTICS" "mk_goalstate" (tuple nil statement)))
                               :steps nil))
    (goals)))
(cl:defun goals ()
  (unless *proof-session* (reject nil "No active proof"))
  (copy-list (second (holai.runtime.data:tuple-items (first (getf *proof-session* :states))))))
(cl:defun proof-step (command)
  (unless *proof-session* (reject command "No active proof"))
  (let ((state (first (getf *proof-session* :states))))
    (multiple-value-bind (next result)
        (call-with-dsl-context command
          (lambda () (funcall *proof-executor*
          (lambda ()
            (let* ((next (if (and (consp command) (equal (name-text (car command)) "focus"))
                             (funcall (funcall *focus-refiner* command) state)
                             (native "HOLAI.TACTICS" "by"
                               (native "HOLAI.TACTICS" "VALID" (command-tactic command)) state)))
                   (subgoals (second (holai.runtime.data:tuple-items next))))
              (values next
                (if subgoals (copy-list subgoals)
                    ;; Validate the retained justification without executing
                    ;; procedural tactics again; publish state only on success.
                    (native "HOLAI.TACTICS" "prove"
                      (tuple (getf *proof-session* :statement)
                             (lambda (goal) (declare (ignore goal)) next)))))))))
          :failure-kind 'dsl-proof-failure :expected (getf *proof-session* :statement))
      (push next (getf *proof-session* :states))
      (push command (getf *proof-session* :steps))
      result)))
(cl:defun undo ()
  (unless (and *proof-session* (cdr (getf *proof-session* :states))) (reject nil "Nothing to undo"))
  (pop (getf *proof-session* :states)) (pop (getf *proof-session* :steps)) (goals))
(cl:defun abort-proof () (clrhash *goal-labels*) (setf *proof-session* nil))
(cl:defun find-theorems (&rest arguments)
  (let* ((positional (and arguments (not (keywordp (car arguments)))))
         (query (when positional (pop arguments))))
    (multiple-value-bind (facts opts) (options arguments arguments '(:pattern :limit))
      (when (or facts (and positional (member :pattern arguments)))
        (reject-kind 'dsl-option-error arguments "Supply one name query or :PATTERN"))
      (unless (or positional (member :pattern arguments))
        (reject-kind 'dsl-option-error arguments "Supply a name query or :PATTERN"))
      (let* ((query (if positional query (getf opts :pattern)))
             (patternp (or (not positional) (not (stringp query))))
             (pattern (when patternp (let ((*strict-names* nil)) (read-term query :expected-type 'bool))))
             (limit (getf opts :limit 100)) (matches nil))
        (unless (and (integerp limit) (plusp limit)) (reject limit "Expected a positive limit"))
        (maphash
          (lambda (name th)
            (when (if patternp
                      (handler-case
                        (progn (native "HOLAI.DRULE" "term_match" nil pattern
                                 (if (fst (native "HOLAI.BASICS" "strip_forall" pattern))
                                     (holai.fusion:concl th)
                                     (snd (native "HOLAI.BASICS" "strip_forall" (holai.fusion:concl th))))) t)
                        (holai.runtime.core:failure () nil))
                      (search (string-upcase query) (symbol-name name)))
              (push (cons name th) matches))) *theorems*)
        (subseq (sort matches #'string<
                       :key (lambda (entry) (let ((name (car entry)))
                                             (format nil "~a/~a" (package-name (symbol-package name)) (symbol-name name)))))
                0 (min limit (length matches)))))))
(cl:defun describe-theorem (name &optional (stream *standard-output*))
  (let ((th (theorem name)))
    (format stream "~s~%~a~%~s~%" name (funcall holai.printer:string_of_thm th) (gethash name *provenance*)) th))
(cl:defun obligations (name)
  (copy-tree (getf (gethash name *pending-definitions*) :obligations)))
(cl:defun complete-definition (name proofs)
  (let ((entry (gethash name *pending-definitions*)))
    (unless entry (reject name "No pending definition"))
    (unless (and (proper-list-p proofs)
                 (= (length proofs) (length (getf entry :obligations)))
                 (= (length proofs) (length (remove-duplicates proofs :key #'car))))
      (reject proofs "Supply each pending obligation exactly once"))
    (dolist (proof proofs)
      (require-arity proof proof 2)
      (unless (assoc (car proof) (getf entry :obligations)) (reject proof "Unknown pending obligation label")))
    (ensure-result-names name
      (if (eq (car (getf entry :source)) 'defrelations) '(".rules" ".induction" ".cases") '(".definition" ".equations")))
    (let* ((*package* (or (getf entry :package) *package*))
           (*context-parameters* nil) (*context-assumptions* nil)
           (result (funcall (getf entry :complete) proofs))
           (source (getf entry :source)))
      (when source
        (setf (gethash name *definitions*) (list :source source :canonical-source (canonical-source source) :result result))
        (when (eq (car source) 'defequations)
          (let ((rules (native "HOLAI.BOOL" "CONJUNCTS" result)))
            (dolist (clause (fourth source))
              (let* ((syntax (if (second clause) `(forall ,(second clause) ,@(cddr clause)) (third clause)))
                     (th (match-labelled-result syntax rules)))
                (register-definition-results name
                  (list (cons (concatenate 'string ".equations." (symbol-name (first clause))) th))))))))
      (remhash name *pending-definitions*) result)))

(defmacro with-axiomatic-extensions (() &body body)
  `(let ((*axiomatic-extensions* t)) ,@body))
(cl:defun require-axiomatic-context (form)
  (unless *axiomatic-extensions* (reject-kind 'dsl-scope-error form "Requires WITH-AXIOMATIC-EXTENSIONS")))
(cl:defun declare-type (name arity)
  (require-axiomatic-context name) (require-owner name)
  (when (gethash name *types*) (reject name "Type already declared"))
  (unless (and (integerp arity) (not (minusp arity))) (reject arity "Expected a nonnegative arity"))
  (kernel-definition-call name (lambda () (native "HOLAI.FUSION" "new_type" (tuple (encoded-name name) arity))))
  (setf (gethash name *types*) (list (encoded-name name) arity))
  (push (list :type name arity) *axiom-log*) name)
(cl:defun declare-constant (name type)
  (require-axiomatic-context name) (require-owner name)
  (when (gethash name *constants*) (reject name "Constant already declared"))
  (let ((ty (hol-type type)))
    (kernel-definition-call name (lambda () (native "HOLAI.FUSION" "new_constant" (tuple (encoded-name name) ty))))
    (setf (gethash name *constants*) (encoded-name name))
    (push (list :constant name type) *axiom-log*) name))
(defmacro defaxiom (name proposition)
  (declaration-expansion
    `(progn (require-axiomatic-context ',name)
       (cache-definition ',name '(defaxiom ,proposition)
         (lambda ()
           (when (gethash ',name *theorems*) (reject ',name "Theorem name already occupied"))
           (let* ((*strict-names* t) (tm (read-term ',proposition :expected-type 'bool)))
             (when (holai.fusion:frees tm) (reject ',name "Axiom must be closed"))
             (let ((th (kernel-definition-call ',name (lambda () (native "HOLAI.FUSION" "new_axiom" tm)))))
               (publish-theorem ',name th '(defaxiom ,name ,proposition))
               (push (list :axiom ',name ',proposition) *axiom-log*) th)))))))

(cl:defun save-development (pathname forms &key (manifest-path (concatenate 'string (namestring pathname) ".manifest.lisp")))
  "Save replayable source and inert provenance. LOAD of source reruns the proofs."
  (unless (proper-list-p forms) (reject forms "Expected replay forms"))
  (write-replay-files pathname forms manifest-path))
