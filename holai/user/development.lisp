(in-package :holai.user)

(setf (gethash 'finite *type-expanders*)
  (lambda (form)
    (require-arity form (cdr form) 1)
    (unless (and (integerp (second form)) (plusp (second form))) (reject form "FINITE requires a positive fixed dimension"))
    (labels ((bits (n) (if (= n 1) (make-Ptycon "1" nil)
                          (make-Ptycon (if (evenp n) "tybit0" "tybit1") (list (bits (floor n 2)))))))
      (bits (second form)))))
(cl:defun syntax-symbols (syntax)
  (cond ((symbolp syntax) (list syntax))
        ((consp syntax) (mapcan #'syntax-symbols syntax))))
(cl:defun implicit-numeric-operators (syntax)
  (cond ((and (integerp syntax) (minusp syntax)) (list "--"))
        ((and (rationalp syntax) (not (integerp syntax)))
         (append (list "/") (when (minusp syntax) (list "--"))))
        ((consp syntax) (mapcan #'implicit-numeric-operators syntax))))
(setf *ambiguity-checker*
 (lambda (syntax constrained environment baseline)
  (let* ((cell holai.printer:the_interface) (original (holai.runtime.data:deref cell))
         (operators (remove-duplicates
                      (append (loop for symbol in (syntax-symbols syntax)
                                    for name = (gethash symbol *constants*)
                                    when (and name (> (count name original :key #'fst :test #'equal) 1)) collect name)
                              (remove-if-not (lambda (name) (> (count name original :key #'fst :test #'equal) 1))
                                             (implicit-numeric-operators syntax))) :test #'equal)))
    (dolist (operator operators)
      (let ((candidates nil))
        (unwind-protect
          (dolist (candidate (remove-if-not (lambda (e) (equal (fst e) operator)) original))
            (holai.runtime.data:assign cell
              (cons candidate (remove-if (lambda (e) (equal (fst e) operator)) original)))
            (let ((alternative (handler-case
                                 (funcall term_of_preterm (funcall retypecheck environment constrained))
                                 (holai.runtime.core:failure () nil))))
              (when alternative
                (pushnew (fst (snd candidate)) candidates :test #'equal)
                (unless (holai.fusion:aconv alternative baseline)
                  (reject-kind 'dsl-overload-error syntax "Ambiguous overload ~a; add a TYPE or THE annotation (~{~a~^, ~})"
                               operator (mapcar (lambda (e) (fst (snd e)))
                                          (remove-if-not (lambda (e) (equal (fst e) operator)) original)))))))
          (holai.runtime.data:assign cell original)))))))

(dolist (entry '((pair prod (pair) ((left ?a) (right ?b)))
                 (cons list (cons nil-list) ((head ?a) (tail (list ?a))))
                 (nil-list list (cons nil-list) ())
                 (true bool (true false) ()) (false bool (true false) ())))
  (setf (gethash (first entry) *constructors*)
        (list :type (second entry) :family (third entry) :fields (fourth entry))))
(setf (gethash 'nil-list *constants*) "NIL")
(export 'nil-list)

(cl:defun label-branches (tactic labels &optional ignored-variables)
  (lambda (g)
    (let* ((state (funcall tactic g)) (subgoals (second (holai.runtime.data:tuple-items state))))
      (if labels
          (unless (= (length subgoals) (length labels)) (reject labels "Principle branch count differs from its descriptor"))
          (setf labels (loop for i from 1 to (length subgoals) collect (intern (format nil "CASE-~d" i) :keyword))))
      (loop for subgoal in subgoals for label in labels do
        (setf (gethash subgoal *goal-labels*)
              (list :label label :variables (set-difference (goal-variables subgoal) (set-difference (goal-variables g) ignored-variables :test #'equalp) :test #'equalp)))) state)))
(cl:defun assumption-cases-tactic (label principle goal)
  (let* ((entry (find (variable-name label) (fst goal) :key #'fst :test #'equal))
         (th (and entry (snd entry))))
    (unless th (reject label "Unknown case assumption"))
    (let* ((head (fst (native "HOLAI.BASICS" "strip_comb" (holai.fusion:concl th))))
           (relation (and (holai.fusion:is_const head)
                          (loop for name being the hash-keys of *constants* using (hash-value value)
                                when (equal value (fst (holai.fusion:dest_const head))) return name)))
           (cases (if principle (goal-theorem principle goal)
                       (and relation (theorem (result-name relation ".cases")))))
           (inversion (native "HOLAI.EQUAL" "CONV_RULE"
                        (native "HOLAI.SIMP" "ONCE_REWRITE_CONV" (list (or cases (reject label "Specify a case principle")))) th)))
      (native "HOLAI.TACTICS" "STRUCT_CASES_TAC" inversion))))
(setf (gethash "cases" *proof-commands*)
  (lambda (form)
    (multiple-value-bind (facts opts) (options form (cdr form) '(:using))
      (require-arity form facts 1)
      (lambda (g)
       (block nil
        (let ((assumption (and (symbolp (first facts))
                               (find (variable-name (first facts)) (fst g) :key #'fst :test #'equal))))
          (when assumption
            (return-from nil (funcall (label-branches (assumption-cases-tactic (first facts) (getf opts :using) g) nil) g))))
        (let* ((value (goal-term (first facts) g)) (type (holai.fusion:type_of value))
               (native-type (fst (holai.fusion:dest_type type)))
               (type-symbol (loop for s being the hash-keys of *types* using (hash-value info)
                                  when (equal (first info) native-type) return s))
               (constructors (loop for c being the hash-keys of *constructors* using (hash-value info)
                                   when (eq (getf info :type) type-symbol) return (getf info :family))))
          (if (and (equal native-type "bool") (null (getf opts :using)))
              (funcall (label-branches (holai.class:BOOL_CASES_TAC value) '(true false)) g)
              (let* ((standard (gethash native-type *type-cases*))
                     (principle (if (getf opts :using) (goal-theorem (getf opts :using) g)
                                     (or standard (theorem (result-name type-symbol ".cases")))))
                     (th (holai.bool:ISPEC value principle)))
                (funcall (label-branches (native "HOLAI.TACTICS" "STRUCT_CASES_TAC" th)
                           (and standard (holai.runtime.core:= standard principle) constructors)) g)))))))))
(cl:defun split-case-tactic (count)
  (if (= count 1) #'holai.tactics:ALL_TAC
      (native "HOLAI.TACTICS" "THENL" #'holai.tactics:CONJ_TAC
        (list #'holai.tactics:ALL_TAC (split-case-tactic (1- count))))))
(setf (gethash "induct" *proof-commands*)
  (lambda (form)
    (multiple-value-bind (facts opts) (options form (cdr form) '(:using :generalizing))
      (require-arity form facts 0 1)
      (lambda (g)
        (let* ((variable (and facts (goal-term (first facts) g)))
               (type (and variable (holai.fusion:type_of variable)))
               (native-type (and type (fst (holai.fusion:dest_type type))))
               (standard (or (and type (gethash native-type *type-inductions*)) holai.nums:num_INDUCTION))
               (principle (if (getf opts :using) (goal-theorem (getf opts :using) g) standard))
               (labels (when (holai.runtime.core:= principle standard)
                         (if (or (null type) (equal native-type "num")) '(base step)
                             (loop for c being the hash-keys of *constructors* using (hash-value info)
                                   for owner = (getf info :type)
                                   when (equal (first (gethash owner *types*)) native-type) return (getf info :family)))))
               (tactic (native "HOLAI.TACTICS" "THEN" (holai.tactics:MATCH_MP_TAC principle)
                         (if labels (split-case-tactic (length labels)) (holai.tactics:REPEAT #'holai.tactics:CONJ_TAC))))
               (baseline (set-difference (goal-variables g) (when variable (list variable)) :test #'holai.runtime.core:=)))
          (when variable (setf tactic (native "HOLAI.TACTICS" "THEN" (holai.tactics:SPEC_TAC (tuple variable variable)) tactic)))
          (dolist (symbol (reverse (getf opts :generalizing)))
            (let ((v (goal-term symbol g)))
              (when (find-if (lambda (entry) (member v (holai.fusion:frees (holai.fusion:concl (snd entry))) :test #'holai.runtime.core:=)) (fst g))
                (reject-kind 'dsl-scope-error symbol "Generalization depends on a current assumption"))
              (setf tactic (native "HOLAI.TACTICS" "THEN" (holai.tactics:SPEC_TAC (tuple v v)) tactic))))
          (funcall (native "HOLAI.TACTICS" "THEN"
                     (label-branches tactic labels (when variable (list variable)))
                     (lambda (branch)
                       (let* ((metadata (goal-metadata branch))
                              (state (funcall (holai.tactics:REPEAT
                                               (holai.tactics:ORELSE #'holai.tactics:GEN_TAC holai.tactics:DISCH_TAC)) branch)))
                         (dolist (subgoal (second (holai.runtime.data:tuple-items state)))
                           (setf (gethash subgoal *goal-labels*)
                             (list :label (getf metadata :label)
                                   :variables (set-difference (goal-variables subgoal) baseline :test #'holai.runtime.core:=)))) state))) g))))))
(cl:defun rename-goal-variables (g variables names)
  (unless (= (length variables) (length names)) (reject names "Branch variable count differs"))
  (let* ((newvars (mapcar (lambda (v name) (holai.fusion:mk_var (tuple (variable-name name) (holai.fusion:type_of v)))) variables names))
         (forward (mapcar #'tuple newvars variables)) (backward (mapcar #'tuple variables newvars))
         (newgoal (tuple (mapcar (lambda (entry) (tuple (fst entry) (native "HOLAI.FUSION" "INST%" forward (snd entry)))) (fst g))
                         (funcall holai.fusion:vsubst forward (snd g))))
         (meta (first (holai.runtime.data:tuple-items (holai.tactics:ALL_TAC g)))))
    (when (intersection newvars (set-difference (goal-variables g) variables :test #'equalp) :test #'equalp)
      (reject-kind 'dsl-scope-error names "Branch name captures an existing variable"))
    (tuple meta (list newgoal)
      (lambda (inst thms)
        (native "HOLAI.DRULE" "INSTANTIATE_ALL" inst (native "HOLAI.FUSION" "INST%" backward (first thms)))))))
(setf (gethash "branch" *proof-commands*)
  (lambda (form)
    (unless (>= (length form) 4) (reject form "BRANCH requires label, variables and proof"))
    (require-variables (third form))
    (let ((proof (sequence-tactics (cdddr form))))
      (lambda (g)
        (let ((metadata (goal-metadata g)))
          (unless (and metadata (eq (getf metadata :label) (second form)))
            (reject form "Wrong or unavailable branch label"))
          (funcall (native "HOLAI.TACTICS" "THEN"
                     (lambda (goal) (rename-goal-variables goal (getf metadata :variables) (third form))) proof) g))))))
(setf *focus-refiner*
  (lambda (form)
    (unless (>= (length form) 3) (reject form "FOCUS needs a target and proof commands"))
    (let ((proof (sequence-tactics (cddr form))) (target (second form)))
      (lambda (state)
        (let* ((subgoals (second (holai.runtime.data:tuple-items state)))
               (matches (if (integerp target)
                            (when (<= 1 target (length subgoals)) (list (1- target)))
                            (loop for g in subgoals for index from 0 for metadata = (goal-metadata g)
                                  when (and metadata (eq target (getf metadata :label))) collect index))))
          (unless (= (length matches) 1) (reject form "FOCUS target is missing or ambiguous"))
          (let* ((index (car matches))
                 (rotated (native "HOLAI.TACTICS" "rotate" index state))
                 (refined (native "HOLAI.TACTICS" "by" (native "HOLAI.TACTICS" "VALID" proof) rotated)))
            (native "HOLAI.TACTICS" "rotate" (- index) refined)))))))
(setf (gethash "focus" *proof-commands*)
  (lambda (form)
    (let ((refine (funcall *focus-refiner* form)))
      (lambda (g) (funcall refine (native "HOLAI.TACTICS" "mk_goalstate" g))))))
(setf (gethash "obtain" *proof-commands*)
  (lambda (form)
    (require-arity form (cdr form) 3)
    (require-variables (second form))
    (lambda (g)
      (let ((th (goal-theorem (third form) g)) (variables (second form)) (labels (fourth form)))
        (labels ((choose (th vars)
                   (if vars
                       (let* ((binder (fst (native "HOLAI.BASICS" "dest_exists" (holai.fusion:concl th))))
                              (v (holai.fusion:mk_var (tuple (variable-name (car vars)) (holai.fusion:type_of binder)))))
                         (native "HOLAI.TACTICS" "X_CHOOSE_THEN" v (holai.runtime.core:lambdac (th goal) (funcall (choose th (cdr vars)) goal)) th))
                       (let ((parts (native "HOLAI.BOOL" "CONJUNCTS" th)))
                         (unless (= (length parts) (length labels)) (reject form "OBTAIN labels differ from conjuncts"))
                         (lambda (goal)
                           (let ((tactic #'holai.tactics:ALL_TAC))
                             (loop for entry in labels for part in parts do
                               (require-arity entry entry 2)
                               (unless (holai.fusion:aconv (goal-term (second entry) (tuple (append (mapcar (lambda (p) (tuple "" p)) parts) (fst goal)) (snd goal)) 'bool)
                                                          (holai.fusion:concl part)) (reject entry "OBTAIN proposition differs"))
                               (setf tactic (native "HOLAI.TACTICS" "THEN" tactic
                                              (holai.tactics:LABEL_TAC (variable-name (first entry)) part))))
                             (funcall tactic goal)))))))
          (funcall (choose th variables) g))))))
(setf (gethash "calc" *proof-commands*)
  (lambda (form)
    (unless (>= (length form) 3) (reject form "CALC needs a start term and steps"))
    (lambda (g)
      (let ((previous (goal-term (second form) g)) (result nil))
        (dolist (step (cddr form))
          (unless (and (eq (car step) '=) (>= (length step) 3)) (reject step "CALC requires equality and proof steps"))
          (let* ((next (goal-term (second step) g nil (holai.fusion:type_of previous)))
                 (proposition (native "HOLAI.FUSION" "mk_eq" (tuple previous next)))
                 (th (native "HOLAI.TACTICS" "TAC_PROOF" (tuple (tuple (fst g) proposition) (sequence-tactics (cddr step))))))
            (setf result (if result (native "HOLAI.FUSION" "TRANS" result th) th) previous next)))
        (funcall (native "HOLAI.TACTICS" "ACCEPT_TAC" result) g)))))

(setf *datatype-completion*
  (lambda (metadata)
    (dolist (entry metadata)
      (when (getf (cdr entry) :fields)
        (let* ((constructor (car entry)) (type (getf (cdr entry) :type))
               (bundle (theorem (result-name type ".injective")))
               (name (encoded-name constructor))
               (th (find-if (lambda (th)
                              (labels ((contains (tm)
                                         (cond ((holai.fusion:is_const tm) (equal (fst (holai.fusion:dest_const tm)) name))
                                               ((holai.fusion:is_comb tm) (let ((p (holai.fusion:dest_comb tm))) (or (contains (fst p)) (contains (snd p)))))
                                               ((holai.fusion:is_abs tm) (contains (snd (holai.fusion:dest_abs tm)))))))
                                (contains (holai.fusion:concl th))))
                            (native "HOLAI.BOOL" "CONJUNCTS" bundle))))
          (unless th (reject-kind 'kernel-state-uncertain constructor "Missing constructor injectivity theorem"))
          (register-definition-results constructor (list (cons ".injective" th))))))))
(setf (gethash 'record-update *term-expanders*)
 (lambda (form)
  (unless (>= (length form) 3) (reject form "RECORD-UPDATE requires a type, value and field clauses"))
  (let* ((name (second form)) (record (or (gethash name *records*) (reject name "Unknown record type")))
         (updates (cdddr form)) (fields (getf record :fields)) (temporary (gensym "RECORD")))
    (dolist (entry updates)
      (require-arity entry entry 2)
      (unless (assoc (first entry) fields) (reject entry "Unknown record field")))
    (require-variables (mapcar #'first updates))
    `(let ((,temporary ,(third form)))
       (,(getf record :constructor)
         ,@(mapcar (lambda (field)
                     (let ((update (assoc (first field) updates)))
                       (if update (second update)
                           `(,(intern (concatenate 'string (symbol-name name) "-" (symbol-name (first field)))
                                      (symbol-package name)) ,temporary)))) fields))))))

(setf *logical-snapshot-function* #'logical-snapshot)
(setf *pending-definition-recorder*
  (lambda (name source)
    (let ((entry (gethash name *pending-definitions*)))
      (when entry (setf (getf entry :source) source
                        (getf entry :canonical-source) (canonical-source source)
                        (getf entry :package) *package*
                        (gethash name *pending-definitions*) entry)))))
(setf *definition-preflight*
  (lambda (name source)
    (let ((pending (gethash name *pending-definitions*)))
      (when (and pending (getf pending :canonical-source)
                 (not (equal (getf pending :canonical-source) (canonical-source source))))
        (reject-kind 'definition-conflict name "A different declaration owns the pending obligations")))))

(defvar *standard-modules*
 '("system" "lib" "fusion" "basics" "nets" "printer" "preterm" "parser" "equal" "bool"
   "drule" "tactics" "itab" "simp" "theorems" "ind_defs" "class" "trivia" "canon"
   "meson" "firstorder" "metis" "thecops" "quot" "impconv" "pair" "compute" "nums"
   "recursion" "arith" "wf" "calc_num" "normalizer" "grobner" "ind_types" "lists"
   "realax" "calc_int" "realarith" "real" "calc_rat" "int" "sets" "iterate" "cart" "define"))
(cl:defun standard-descriptors (&optional module)
  "Inventory public generated owners. Callable bindings need an explicit kind signature."
  (let ((result nil) (constants (native "HOLAI.FUSION" "constants" holai.runtime.data:unit)))
    (dolist (package (list-all-packages))
      (when (some (lambda (stem)
                    (let ((prefix (concatenate 'string "HOLAI." (string-upcase stem))))
                      (or (equal prefix (package-name package))
                          (uiop:string-prefix-p (concatenate 'string prefix ".") (package-name package)))))
                  (if module (list (string-downcase (string module))) *standard-modules*))
        (do-external-symbols (symbol package)
          (let* ((matches (remove-if-not (lambda (c) (string-equal (fst c) (symbol-name symbol))) constants))
                 (callable (or (fboundp symbol) (and (boundp symbol) (functionp (symbol-value symbol)))))
                 (theorem (and (boundp symbol)
                               (handler-case (progn (holai.fusion:concl (symbol-value symbol)) t)
                                 (error () nil)))))
            (push (list :symbol symbol :owner (package-name package)
                        :kind (cond (callable :procedure)
                                    (theorem :theorem)
                                    (t :implementation))
                        :term-constant (and (= (length matches) 1) (fst (car matches)))
                        :application (cond (callable :explicit-argument-signature-required)
                                           ((or theorem (= (length matches) 1)) :direct-theorem-or-term)
                                           (t :implementation-detail))) result)))))
    (sort result #'string< :key (lambda (e) (format nil "~a/~a" (getf e :owner) (getf e :symbol))))))
(cl:defun install-standard-names ()
  (dolist (descriptor (standard-descriptors))
    (when (getf descriptor :term-constant)
      (setf (gethash (getf descriptor :symbol) *constants*) (getf descriptor :term-constant)))))
(install-standard-names)
(export '(standard-descriptors install-standard-names core bool-computation
          beta eta alpha rator rand body depth redepth once try-conv repeat-conv
          then-conv orelse-conv rewrite-conv num-reduce int-reduce real-rat-reduce
          argument-kinds))
(setf (gethash 'core *simpsets*) (list (list "native-basis" (native "HOLAI.SIMP" "basic_ss" nil)))
      (gethash 'bool-computation *compsets*) '(("equations")))

(setf (gethash "tactic" *proof-commands*)
  (lambda (form)
    (unless (>= (length form) 2) (reject form "TACTIC needs a registered name"))
    (or (funcall *tactic-command-resolver* (cdr form)) (reject form "Unknown tactic extension"))))
(export '(tactic retry-proof))

;; A context-dependent mutual group abstracts its fixed parameters before the
;; simultaneous-existence procedure. The lexical context holds the partial applications.
(cl:defun abstract-context-calls (syntax names context &optional bound)
  (cond ((and (symbolp syntax) (member syntax names) (not (member syntax bound))) `(,syntax ,@context))
        ((and (consp syntax) (member (car syntax) '(lambda forall exists exists1 choose)))
         (list* (car syntax) (second syntax)
           (mapcar (lambda (x) (abstract-context-calls x names context (append (second syntax) bound))) (cddr syntax))))
        ((and (consp syntax) (eq (car syntax) 'declare)) syntax)
        ((consp syntax) (mapcar (lambda (x) (abstract-context-calls x names context bound)) syntax)) (t syntax)))
(cl:defun introduce-contextual-functions (group body)
  (if (null *context-parameters*) (introduce-functions group body)
      (multiple-value-bind (clauses specs doc)
          (declaration-body body nil '(recursion termination measure obligation-proofs) t)
        (let* ((context *context-parameters*) (names (mapcar #'first clauses))
               (annotations (mapcar (lambda (p) `(type ,(or (cdr (assoc p *annotations*))
                                                            (reject p "A context function parameter needs a TYPE declaration")) ,p)) context))
               (new-clauses
                 (mapcar (lambda (clause)
                           (require-variables (append context (second clause)))
                           (let ((body (abstract-context-calls (cddr clause) names context (second clause))))
                             (let ((doc (when (stringp (car body)) (pop body))))
                               (list* (first clause) (append context (second clause))
                                      (append (when doc (list doc)) (list `(declare ,@annotations)) body))))) clauses))
               (result (let ((*context-parameters* nil)
                             (*context-function-bindings* (remove-if (lambda (e) (member (car e) names)) *context-function-bindings*)))
                         (introduce-functions group
                           (append (when doc (list doc)) (when specs (list `(declare ,@specs))) new-clauses)))))
          (dolist (name names) (push (cons name context) *context-function-bindings*)) result))))
(defmacro deffunctions (group &body clauses &environment environment)
  (declaration-expansion `(introduce-contextual-functions ',group
    ',(mapcar (lambda (c) (if (or (stringp c) (eq (car c) 'declare)) c
                              (list* (first c) (second c) (expand-dsl (cddr c) environment)))) clauses))))

(cl:defun theorem-data (th)
  "Inert alpha-normalized judgment data, never a theorem constructor."
  (let ((type-variables nil))
    (labels ((type-data (ty)
               (if (funcall holai.fusion:is_vartype ty)
                   (let ((name (holai.fusion:dest_vartype ty)))
                     (unless (member name type-variables :test #'equal)
                       (setf type-variables (append type-variables (list name))))
                     (list :type-variable (position name type-variables :test #'equal)))
                   (let ((parts (holai.fusion:dest_type ty)))
                     (list* :type (fst parts) (mapcar #'type-data (snd parts))))))
             (term-data (tm bound)
               (cond ((holai.fusion:is_var tm)
                      (let ((index (position tm bound :test #'holai.runtime.core:=)))
                        (if index (list :bound index (type-data (holai.fusion:type_of tm)))
                            (list :free (fst (holai.fusion:dest_var tm)) (type-data (holai.fusion:type_of tm))))))
                     ((holai.fusion:is_const tm)
                      (list :constant (fst (holai.fusion:dest_const tm)) (type-data (holai.fusion:type_of tm))))
                     ((holai.fusion:is_comb tm)
                      (let ((p (holai.fusion:dest_comb tm))) (list :application (term-data (fst p) bound) (term-data (snd p) bound))))
                     (t (let ((p (holai.fusion:dest_abs tm)))
                          (list :lambda (type-data (holai.fusion:type_of (fst p))) (term-data (snd p) (cons (fst p) bound))))))))
      (list :conclusion (term-data (holai.fusion:concl th) nil)
            :hypotheses (mapcar (lambda (tm) (term-data tm nil)) (holai.fusion:hyp th))))))
(cl:defun stable-source-id (object)
  "FNV-1a/64 over fixed-width Unicode code points; a reference ID, not a signature."
  (let ((hash #xcbf29ce484222325)
        (text (let ((*package* (find-package :cl-user)) (*print-readably* t) (*print-circle* t))
                (write-to-string object))))
    (loop for c across text for code = (char-code c) do
      (dolist (shift '(24 16 8 0))
        (setf hash (ldb (byte 64 0) (* (logxor hash (ldb (byte 8 shift) code)) #x100000001b3)))))
    (format nil "fnv1a64:~16,'0X" hash)))
(cl:defun development-manifest (forms)
  (list :format "holai.user/v0.3" :source-id (stable-source-id (canonical-source forms))
        :basis "HOL Light 233b83c3202370e03c54de2bd090e4d34f677e91"
        :host (list (lisp-implementation-type) (lisp-implementation-version) (asdf:asdf-version))
        :trust :replay-common-lisp-source :dependency-precision :conservative-kernel-axiom-upper-bound
        :resources (loop for value being the hash-values of *resource-history* collect value)
        :extensions (loop for value being the hash-values of *extension-history* collect value)
        :axioms (mapcar #'theorem-data (native "HOLAI.FUSION" "axioms" holai.runtime.data:unit))
        :definitions
          (loop for name being the hash-keys of *definitions* using (hash-value entry)
                collect (list :name name :expanded-source (getf entry :source)
                              :canonical-source (getf entry :canonical-source)
                              :source-id (stable-source-id (getf entry :canonical-source))))
        :theorems
          (loop for name being the hash-keys of *theorems* using (hash-value th)
                for entry = (gethash name *provenance*) collect
                (list :name name :version (getf entry :version)
                      :source (getf entry :source) :expanded-source (getf entry :expanded-source)
                      :context-parameters (getf entry :context-parameters)
                      :context-assumptions (getf entry :context-assumptions)
                      :automation (getf entry :automation) :simpset (getf entry :simpset) :compset (getf entry :compset)
                      :extensions (getf entry :extensions) :judgment (theorem-data th)
                      :reference-id (stable-source-id (theorem-data th))
                      :references (mapcar (lambda (ref)
                                            (list :name (first ref) :version (second ref)
                                                  :reference-id (stable-source-id (theorem-data (third ref)))))
                                          (getf entry :references))))))
(cl:defun write-replay-files (pathname forms manifest-path)
  ;; Render before replacing either target, so non-readable host values fail early.
  (let* ((*package* (find-package :cl-user)) (*print-readably* t) (*print-circle* t)
         (source (with-output-to-string (stream)
                   (write-line ";; Holai v0.3: trusted CL source; LOAD reexecutes kernel proofs." stream)
                   (dolist (form forms) (write form :stream stream) (terpri stream))))
         (manifest (write-to-string (development-manifest forms))))
    (uiop:with-temporary-file (:pathname tmp :stream stream :direction :output)
      (write-string source stream) (finish-output stream)
      (uiop:copy-file tmp pathname))
    (uiop:with-temporary-file (:pathname tmp :stream stream :direction :output)
      (write-string manifest stream) (finish-output stream)
      (uiop:copy-file tmp manifest-path)))
  (values pathname manifest-path))
(export '(theorem-data stable-source-id development-manifest))

(setf (gethash "list" *type-inductions*) holai.ind_types:list_INDUCT)
(setf (gethash 'list.recursion *theorems*) holai.ind_types:list_RECURSION)
(setf (gethash 'list.cases *theorems*) (holai.ind_types:cases "list"))
(setf (gethash 'prod.cases *theorems*) (holai.ind_types:cases "prod"))

(setf (gethash "list" *type-recursions*) holai.ind_types:list_RECURSION
      (gethash "list" *type-cases*) (holai.ind_types:cases "list")
      (gethash "prod" *type-cases*) (holai.ind_types:cases "prod"))

(export '(intro intros assumption refl split taut arith asm-arith skip fail assume exact apply
          rewrite asm-rewrite simp asm-simp meson then proof by all-goals thenl orelse try repeat
          cases induct fix witness have show left right contradiction unfold fold conv compute
          normalize first focus obtain calc branch metis leancop nanocop ring field inst gen rule convert
          conversion-ref))

(let ((base *relation-introducer*))
 (setf *relation-introducer*
  (lambda (group parameters body)
    (if (null *context-parameters*) (funcall base group parameters body)
        (multiple-value-bind (clauses specs doc)
            (declaration-body body parameters '(type type-variables monotonicity-proof strong-induction) t)
          (let* ((context (copy-list *context-parameters*))
                 (names (mapcar #'first clauses))
                 (annotations (mapcar (lambda (p) `(type ,(or (cdr (assoc p *annotations*))
                                                               (reject p "A fixed relation parameter needs a TYPE declaration")) ,p)) context))
                 (result (let ((*context-parameters* nil))
                           (require-variables (append context parameters))
                           (funcall base group (append context parameters)
                             (append (when doc (list doc)) (list `(declare ,@annotations ,@specs)) clauses)))))
            (dolist (name names) (push (cons name context) *context-function-bindings*)) result))))))

(export '(base step))

(cl:defun record-extension-source (name kind parameters body)
  (let* ((version (gethash name *extension-versions*))
         (source (list* kind name parameters body)))
    (setf (gethash (list kind name version) *extension-history*)
          (list :name name :kind kind :version version :source source
                :source-id (stable-source-id (canonical-source source)))) name))
