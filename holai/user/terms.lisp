(in-package :holai.user)
(declaim (ftype function syntax-preterm annotation-bindings term-overload-choices))

(defparameter *builtin-terms*
  '((true . "T") (false . "F") (and . "/\\") (or . "\\/")
    (not . "~") (implies . "==>") (iff . "<=>") (if . "COND")
    (= . "=") (+ . "+") (- . "-") (* . "*") (/ . "/")
    (< . "<") (<= . "<=") (> . ">") (>= . ">=")
    (succ . "SUC") (cons . "CONS") (append . "APPEND") (map . "MAP")
    (pair . ",")))
(dolist (entry *builtin-terms*) (setf (gethash (car entry) *constants*) (cdr entry)))
(dolist (entry '((bool "bool" 0) (num "num" 0) (int "int" 0)
                 (real "real" 0) (list "list" 1) (prod "prod" 2)))
  (setf (gethash (first entry) *types*) (rest entry)))

(cl:defun type-variable-p (syntax)
  (and (symbolp syntax) (> (length (symbol-name syntax)) 1)
       (char= (char (symbol-name syntax) 0) #\?)))
(cl:defun type-variable-name (symbol)
  (or (cdr (assoc symbol *type-parameters*))
      (concatenate 'string "?" (variable-name symbol))))
(cl:defun type-preterm (syntax &optional expanding)
  (when (and (consp syntax) (gethash (car syntax) *type-expanders*))
    (return-from type-preterm
      (funcall (gethash (car syntax) *type-expanders*) syntax)))
  (cond
    ((type-variable-p syntax)
     (holai.preterm:make-Utv (type-variable-name syntax)))
    ((and (consp syntax) (eq (car syntax) '->))
     (unless (and (proper-list-p syntax) (>= (length syntax) 3))
       (reject syntax "An arrow needs at least two types"))
     (reduce (lambda (a b) (make-Ptycon "fun" (list a b)))
             (mapcar (lambda (x) (type-preterm x expanding)) (cdr syntax)) :from-end t))
    ((and (consp syntax) (eq (car syntax) 'set))
     (require-arity syntax (cdr syntax) 1)
     (make-Ptycon "fun" (list (type-preterm (second syntax) expanding)
                              (make-Ptycon "bool" nil))))
    (t
     (let* ((head (if (consp syntax) (car syntax) syntax))
            (arguments (if (consp syntax) (cdr syntax) nil))
            (alias (and (symbolp head) (gethash head *type-aliases*)))
            (info (and (symbolp head) (gethash head *types*))))
       (unless (and (symbolp head) (proper-list-p arguments))
         (reject syntax "Expected a HOL type"))
       (cond
         (alias
          (when (member head expanding) (reject syntax "Cyclic type abbreviation"))
          (require-arity syntax arguments (length (getf alias :parameters)))
          (labels ((substitute-types (x)
                     (let ((position (position x (getf alias :parameters))))
                       (cond (position (nth position arguments))
                             ((consp x) (mapcar #'substitute-types x)) (t x)))))
            (type-preterm (substitute-types (getf alias :type)) (cons head expanding))))
         (info
          (require-arity syntax arguments (second info))
          (make-Ptycon (first info)
            (mapcar (lambda (x) (type-preterm x expanding)) arguments)))
         (t (reject-kind 'dsl-type-error syntax "Unknown type constructor; type variables start with ?")))))))
(cl:defun hol-type (syntax)
  (call-with-dsl-context syntax
    (lambda () (funcall holai.preterm:type_of_pretype (type-preterm syntax)))
    :failure-kind 'dsl-type-error))

(cl:defun declaration-body (body variables allowed &optional docp)
  (unless (proper-list-p body) (reject body "Expected a proper body"))
  (let ((doc (when (and docp (stringp (car body))) (pop body))) (specs nil))
    (loop while (and (consp (car body)) (eq (caar body) 'declare))
          do (dolist (spec (cdar body))
               (unless (and (consp spec) (proper-list-p spec)
                            (member (car spec) allowed :test #'eq))
                 (reject-kind 'dsl-option-error spec "Unsupported declaration"))
               (when (and (not (member (car spec) '(type ignorable assumption)))
                          (assoc (car spec) specs))
                 (reject-kind 'dsl-option-error spec "Duplicate declaration"))
               (when (member (car spec) '(values recursion termination well-founded-relation monotonicity-proof
                                          strong-induction simp representation-type simpset compset))
                 (require-arity spec (cdr spec) 1))
               (when (member (car spec) '(strong-induction simp))
                 (unless (member (second spec) '(t nil)) (reject spec "Expected a CL Boolean flag")))
               (when (eq (car spec) 'obligation-proofs)
                 (dolist (entry (cdr spec)) (require-arity entry entry 2))
                 (unless (= (length (cdr spec)) (length (remove-duplicates (cdr spec) :key #'first)))
                   (reject spec "Duplicate obligation label")))
               (case (car spec)
                 (type
                  (unless (and (>= (length spec) 3)
                               (every (lambda (x) (member x variables)) (cddr spec)))
                    (reject spec "TYPE names must be in this lambda list"))
                  (dolist (variable (cddr spec))
                    (let ((old (cdr (assoc variable (annotation-bindings specs)))))
                      (when (and old (not (holai.runtime.core:= (hol-type old) (hol-type (second spec)))))
                        (reject-kind 'dsl-type-error spec "Conflicting TYPE declarations for ~s" variable)))))
                 (ignorable
                  (unless (every (lambda (x) (member x variables)) (cdr spec))
                    (reject spec "IGNORABLE names must be bound"))))
               (push spec specs))
             (pop body))
    (values body (nreverse specs) doc)))
(cl:defun annotation-bindings (specs)
  (loop for spec in specs when (eq (car spec) 'type)
        append (loop for variable in (cddr spec) collect (cons variable (second spec)))))
(cl:defun apply-preterms (head arguments)
  (reduce #'make-Combp arguments :initial-value head))
(cl:defun binder-preterm (symbol)
  (require-variables (list symbol))
  (let ((variable (make-Varp (variable-name symbol) dpty))
        (type (cdr (assoc symbol *annotations*))))
    (if type (make-Typing variable (type-preterm type)) variable)))
(cl:defun bind-preterms (operator variables body)
  (require-variables variables)
  (unless variables (reject variables "A binder must bind at least one variable"))
  (multiple-value-bind (rest specs)
      (declaration-body body variables '(type ignorable))
    (require-arity body rest 1)
    (let ((*bindings* (append variables *bindings*))
          (*annotations* (append (annotation-bindings specs) *annotations*)))
      (reduce (lambda (variable result)
                (let ((abstraction (make-Absp (binder-preterm variable) result)))
                  (if operator (make-Combp (make-Varp operator dpty) abstraction) abstraction)))
              variables :from-end t :initial-value (syntax-preterm (first rest))))))

(cl:defun expand-dsl (syntax &optional environment)
  (let ((*macro-expansions* 0))
    (labels ((walk (x)
               (unless (< (incf *macro-expansions*) 10000)
                 (reject x "Macro expansion limit reached"))
               (if (not (consp x)) x
                   (progn
                     (unless (proper-list-p x) (reject x "Dotted or cyclic syntax"))
                     (when (eq (car x) 'declare) (return-from walk x))
                     (when (member (car x) '(lambda forall exists exists1 choose))
                       (return-from walk (list* (car x) (second x) (mapcar #'walk (cddr x)))))
                     (when (eq (car x) 'the)
                       (return-from walk (list 'the (second x) (walk (third x)))))
                     (when (member (car x) '(let let*))
                       (return-from walk
                         (list* (car x)
                           (mapcar (lambda (binding)
                                     (require-arity x binding 2)
                                     (list (first binding) (walk (second binding)))) (second x))
                           (mapcar #'walk (cddr x)))))
                     (when (eq (car x) 'match)
                       (return-from walk
                         (list* 'match (walk (second x))
                           (mapcar (lambda (branch)
                                     (require-arity x branch 2)
                                     (list (first branch) (walk (second branch)))) (cddr x)))))
                     (let* ((head (car x))
                            (protected (or (not (symbolp head))
                                           (special-operator-p head)
                                           (member head '(lambda and or cond match forall exists exists1
                                                          choose the let let* declare))
                                           (gethash head *constants*))))
                       (if (and (not protected) (macro-function head environment))
                           (walk (macroexpand-1 x environment))
                           (mapcar #'walk x)))))))
      (walk syntax))))

(cl:defun pattern-variables (pattern)
  (cond
    ((eq pattern '_) nil)
    ((and (consp pattern) (eq (car pattern) 'the))
     (require-arity pattern (cdr pattern) 2) (pattern-variables (third pattern)))
    ((symbolp pattern) (list pattern))
    ((and (consp pattern) (gethash (car pattern) *constructors*))
     (let ((info (gethash (car pattern) *constructors*)))
       (require-arity pattern (cdr pattern) (length (getf info :fields)))
       (mapcan #'pattern-variables (cdr pattern))))
    (t (reject-kind 'dsl-pattern-error pattern "Expected a variable, wildcard or datatype constructor pattern"))))
(cl:defun require-pattern-variables (variables)
  (handler-case (require-variables variables)
    (dsl-syntax-error (condition)
      (error 'dsl-pattern-error :form variables :cause condition))))
(cl:defun coverage-pattern (pattern)
  (if (and (consp pattern) (eq (car pattern) 'the)) (coverage-pattern (third pattern)) pattern))
(cl:defun wildcard-pattern-p (pattern)
  (and (symbolp pattern) (not (gethash pattern *constructors*))))
(cl:defun exhaustive-patterns-p (rows)
  (setf rows (mapcar (lambda (row) (mapcar #'coverage-pattern row)) rows))
  ;; Constructor matrix specialization; no evaluation or axioms are involved.
  (cond ((null rows) nil)
        ((null (car rows)) t)
        ((every (lambda (row) (wildcard-pattern-p (car row))) rows)
         (exhaustive-patterns-p (mapcar #'cdr rows)))
        (t
         (let* ((example (find-if (lambda (row) (consp (car row))) rows))
                (info (and example (gethash (caar example) *constructors*)))
                (family (and info (getf info :family))))
           (and family
                (every
                  (lambda (constructor)
                    (let ((arity (length (getf (gethash constructor *constructors*) :fields))))
                      (exhaustive-patterns-p
                        (loop for row in rows for pattern = (car row)
                              when (wildcard-pattern-p pattern)
                                collect (append (make-list arity :initial-element '_) (cdr row))
                              when (and (consp pattern) (eq (car pattern) constructor))
                                collect (append (cdr pattern) (cdr row)))))) family))))))
(cl:defun freshen-wildcards (pattern)
  (cond ((eq pattern '_) (gensym "WILDCARD"))
        ((consp pattern) (mapcar #'freshen-wildcards pattern))
        (t pattern)))
(cl:defun normalize-pattern (pattern)
  (cond ((and (consp pattern) (eq (car pattern) 'as))
         (require-arity pattern (cdr pattern) 2)
         (multiple-value-bind (p aliases) (normalize-pattern (third pattern))
           (values p (cons (list (second pattern) p) aliases))))
        ((and (consp pattern) (eq (car pattern) 'list))
         (normalize-pattern (reduce (lambda (x tail) `(cons ,x ,tail)) (cdr pattern)
                                    :from-end t :initial-value '(nil-list))))
        ((and (consp pattern) (eq (car pattern) 'the))
         (multiple-value-bind (p aliases) (normalize-pattern (third pattern))
           (values `(the ,(second pattern) ,p) aliases)))
        ((consp pattern)
         (let ((parts nil) (aliases nil))
           (dolist (part (cdr pattern))
             (multiple-value-bind (p a) (normalize-pattern part) (push p parts) (setf aliases (append aliases a))))
           (values (cons (car pattern) (nreverse parts)) aliases)))
        (t (values pattern nil))))
(cl:defun normalize-match-syntax (syntax)
  (if (and (consp syntax) (eq (car syntax) 'match))
      (list* 'match (second syntax)
        (mapcar (lambda (branch)
                  (require-arity syntax branch 2)
                  (multiple-value-bind (pattern aliases) (normalize-pattern (freshen-wildcards (first branch)))
                    (require-pattern-variables (append (mapcar #'first aliases) (pattern-variables pattern)))
                    (list pattern (if aliases `(let ,aliases ,(second branch)) (second branch))))) (cddr syntax)))
      syntax))
(cl:defun match-preterm (syntax)
  (let ((branches (mapcar
          (lambda (branch)
            (require-arity syntax branch 2)
            (multiple-value-bind (pattern aliases) (normalize-pattern (freshen-wildcards (first branch)))
              (require-pattern-variables (append (mapcar #'first aliases) (pattern-variables pattern)))
              (list pattern (if aliases `(let ,aliases ,(second branch)) (second branch))))) (cddr syntax))))
    (unless branches (reject syntax "MATCH needs branches"))
    (dolist (branch branches)
      (require-arity syntax branch 2)
      (let ((variables (pattern-variables (first branch))))
        (require-pattern-variables variables)))
    (unless (exhaustive-patterns-p (mapcar (lambda (x) (list (first x))) branches))
      (reject-kind 'dsl-coverage-error syntax "MATCH is not exhaustive"))
    (let ((clauses
            (mapcar (lambda (branch)
                      (let* ((pattern (freshen-wildcards (first branch)))
                             (*bindings* (append (pattern-variables pattern) *bindings*)))
                        (let* ((x (make-Varp (variable-name (gensym "MATCH-X")) dpty))
                               (y (make-Varp (variable-name (gensym "MATCH-Y")) dpty))
                               (body (apply-preterms (make-Varp "_UNGUARDED_PATTERN" dpty)
                                       (list (apply-preterms (make-Varp "GEQ" dpty)
                                               (list (syntax-preterm pattern) x))
                                             (apply-preterms (make-Varp "GEQ" dpty)
                                               (list (syntax-preterm (second branch)) y))))))
                          (make-Absp x (make-Absp y
                            (reduce (lambda (variable result)
                                      (make-Combp (make-Varp "?" dpty)
                                        (make-Absp (binder-preterm variable) result)))
                                    (pattern-variables pattern) :from-end t :initial-value body)))))) branches)))
      (apply-preterms (make-Varp "_MATCH" dpty)
        (list (syntax-preterm (second syntax))
              (reduce (lambda (left right)
                        (apply-preterms (make-Varp "_SEQPATTERN" dpty) (list left right)))
                      clauses :from-end t))))))

(cl:defun syntax-preterm (syntax)
  (when (and (consp syntax) (gethash (car syntax) *term-expanders*))
    (return-from syntax-preterm (syntax-preterm (funcall (gethash (car syntax) *term-expanders*) syntax))))
  (cond
    ((eq syntax t) (make-Varp "T" dpty))
    ((null syntax)
     (let ((marker (variable-name (gensym "NIL"))))
       (push marker *nil-markers*) (make-Varp marker dpty)))
    ((symbolp syntax)
     (let ((context (assoc syntax *context-function-bindings*)))
       (when (and context (not (member syntax *bindings*)))
         (return-from syntax-preterm
           (apply-preterms (make-Varp (gethash syntax *constants*) dpty)
                           (mapcar #'syntax-preterm (cdr context))))))
     (let* ((bound (member syntax *bindings*))
            (constant (and (not bound) (gethash syntax *constants*)))
            (annotation (cdr (assoc syntax *annotations*)))
            (preterm (make-Varp (or constant (variable-name syntax)) dpty)))
       (when (and *strict-names* (not bound) (not constant))
         (reject-kind 'dsl-name-error syntax "Unbound logical name"))
       (if annotation (make-Typing preterm (type-preterm annotation)) preterm)))
    ((and (integerp syntax) (not (minusp syntax)))
     (let ((marker (variable-name (gensym "NUMERAL"))))
       (push (cons marker syntax) *numeral-markers*) (make-Varp marker dpty)))
    ((and (rationalp syntax) (not (integerp syntax)))
     (syntax-preterm (list '/ (numerator syntax) (denominator syntax))))
    ((and (integerp syntax) (minusp syntax))
     (apply-preterms (make-Varp "--" dpty) (list (syntax-preterm (- syntax)))))
    ((and (consp syntax) (proper-list-p syntax))
     (let ((head (car syntax)) (arguments (cdr syntax)))
       (cond
         ((member head '(lambda forall exists exists1 choose))
          (unless (>= (length arguments) 2) (reject syntax "Missing binder body"))
          (when (member head '(exists1 choose))
            (require-arity syntax (first arguments) 1))
          (bind-preterms (cdr (assoc head '((forall . "!") (exists . "?")
                                          (exists1 . "?!") (choose . "@") (lambda . nil))))
                        (first arguments) (rest arguments)))
         ((eq head 'the)
          (require-arity syntax arguments 2)
          (make-Typing (if (and (null (second arguments))
                                (consp (first arguments)) (eq (caar arguments) 'list))
                          (make-Varp "NIL" dpty) (syntax-preterm (second arguments)))
                       (type-preterm (first arguments))))
         ((member head '(and or))
          (if (null arguments) (make-Varp (if (eq head 'and) "T" "F") dpty)
              (if (null (cdr arguments))
                  (make-Typing (syntax-preterm (first arguments)) (type-preterm 'bool))
                  (apply-preterms (make-Varp (gethash head *constants*) dpty)
                    (list (syntax-preterm (first arguments))
                          (syntax-preterm (cons head (cdr arguments))))))))
         ((eq head 'list)
          (reduce (lambda (item tail)
                    (apply-preterms (make-Varp "CONS" dpty) (list (syntax-preterm item) tail)))
                  arguments :from-end t :initial-value (make-Varp "NIL" dpty)))
         ((eq head 'set)
          (reduce (lambda (item tail)
                    (apply-preterms (make-Varp "INSERT" dpty) (list (syntax-preterm item) tail)))
                  arguments :from-end t :initial-value (make-Varp "EMPTY" dpty)))
         ((eq head 'setof)
          (unless (>= (length arguments) 2) (reject syntax "Missing set comprehension"))
          (bind-preterms nil (first arguments) (rest arguments)))
         ((eq head 'arbitrary)
          (require-arity syntax arguments 1)
          (let ((type (type-preterm (first arguments))))
            (make-Combp (make-Varp "@" dpty)
              (make-Absp (make-Typing (make-Varp "arbitrary_value" dpty) type)
                         (make-Varp "T" dpty)))))
         ((member head '(let let*))
          (unless (and (>= (length arguments) 2) (proper-list-p (first arguments)))
            (reject syntax "Malformed LET"))
          (let* ((bindings (first arguments)) (variables (mapcar #'first bindings)))
            (dolist (binding bindings) (require-arity syntax binding 2))
            (require-variables variables)
            (if (and (eq head 'let*) (cdr bindings))
                (syntax-preterm `(let (,(first bindings)) (let* ,(rest bindings) ,@(rest arguments))))
                (if (null bindings) (progn (require-arity syntax (rest arguments) 1)
                                          (syntax-preterm (second arguments)))
                    (apply-preterms (bind-preterms nil variables (rest arguments))
                                    (mapcar (lambda (b) (syntax-preterm (second b))) bindings))))))
         ((eq head 'cond)
          (unless (and arguments (eq (caar (last arguments)) t))
            (reject syntax "COND requires a final T branch"))
          (dolist (clause arguments) (require-arity syntax clause 2))
          (syntax-preterm (reduce (lambda (clause rest) `(if ,(first clause) ,(second clause) ,rest))
                                  (butlast arguments) :from-end t
                                  :initial-value (second (car (last arguments))))))
         ((eq head 'match) (match-preterm syntax))
         ((eq head 'hol-syntax)
          (require-arity syntax arguments 1)
          (unless (stringp (first arguments)) (reject syntax "Expected HOL text"))
          (when *strict-names* (reject syntax "HOL text is only available through the inspection API"))
          (let ((parsed (funcall holai.parser:parse_preterm
                          (funcall holai.parser:lex (holai.lib:explode (first arguments))))))
            (unless (null (snd parsed)) (reject syntax "Trailing HOL text"))
            (fst parsed)))
         (t
          (when (member head '(= iff implies if not))
            (require-arity syntax arguments (cond ((eq head 'if) 3) ((eq head 'not) 1) (t 2))))
          (apply-preterms (syntax-preterm head) (mapcar #'syntax-preterm arguments))))))
    (t (reject syntax "Expected HOL term syntax; host values are not lifted"))))

(cl:defun read-term (syntax &key expected-type variables expected-hol-type)
  (unless *elaboration-active*
    (return-from read-term
      (let ((*elaboration-active* t) (*variable-names* nil))
        (read-term syntax :expected-type expected-type :variables variables
                          :expected-hol-type expected-hol-type))))
  (call-with-dsl-context syntax
    (lambda ()
      (let* ((*nil-markers* nil) (*numeral-markers* nil)
             (preterm (syntax-preterm (expand-dsl syntax *macro-environment*)))
             (constraint (cond (expected-type (type-preterm expected-type))
                               (expected-hol-type (pretype_of_type expected-hol-type))))
             (constrained (if constraint (make-Typing preterm constraint) preterm))
             (environment (mapcar (lambda (v) (tuple (fst (holai.fusion:dest_var v))
                                              (pretype_of_type (holai.fusion:type_of v)))) variables))
             (term (funcall term_of_preterm (funcall retypecheck environment constrained)))
             (substitutions nil))
        (when *ambiguity-checker*
          (funcall *ambiguity-checker* syntax constrained environment term))
        ;; Default unconstrained numeral metavariables before replacing placeholders.
        (let ((defaults nil))
          (dolist (variable (holai.fusion:frees term))
            (when (and (assoc (fst (holai.fusion:dest_var variable)) *numeral-markers* :test #'string=)
                       (funcall holai.fusion:is_vartype (holai.fusion:type_of variable)))
              (let ((name (holai.fusion:dest_vartype (holai.fusion:type_of variable))))
                (when (and (> (length name) 1) (char= (char name 0) #\?)
                           (not (digit-char-p (char name 1))))
                  (reject-kind 'dsl-type-error syntax "A numeral cannot have a rigid arbitrary type")))
              (push (tuple (fst (holai.fusion:dest_var variable)) (type-preterm 'num)) defaults)))
          (when defaults
            (setf term (funcall term_of_preterm
                         (funcall retypecheck (append defaults environment) constrained)))))
        (dolist (variable (holai.fusion:frees term))
          (let ((marker (assoc (fst (holai.fusion:dest_var variable)) *numeral-markers* :test #'string=)))
            (when marker
              (let* ((type (holai.fusion:type_of variable))
                     (parts (holai.fusion:dest_type type))
                     (name (fst parts))
                     (text (cond ((string= name "num") (format nil "~d" (cdr marker)))
                                 ((member name '("int" "real") :test #'string=)
                                  (format nil "(&~d:~a)" (cdr marker) name))
                                 (t (reject-kind 'dsl-type-error syntax "Numeral type must be NUM, INT or REAL")))))
                (push (tuple (holai.parser:parse_term text) variable) substitutions)))))
        (dolist (variable (holai.fusion:frees term))
          (when (member (fst (holai.fusion:dest_var variable)) *nil-markers* :test #'string=)
            (let* ((type (holai.fusion:type_of variable))
                   (parts (unless (funcall holai.fusion:is_vartype type) (holai.fusion:dest_type type)))
                   (constant (cond ((and parts (string= (fst parts) "bool")) "F")
                                   ((and parts (string= (fst parts) "list")) "NIL")
                                   (t (reject-kind 'dsl-type-error syntax
                                        "NIL needs an unambiguous BOOL or LIST expected type")))))
              (push (tuple (holai.basics:mk_mconst (tuple constant type)) variable) substitutions))))
        (if substitutions (funcall holai.fusion:vsubst substitutions term) term)))
    :failure-kind 'dsl-type-error :expected (or expected-type expected-hol-type)))
(defmacro term (syntax &environment environment)
  `(read-term ',(expand-dsl syntax environment)))
(cl:defun check (syntax)
  (let ((term (read-term syntax)))
    (values term (holai.fusion:type_of term) (holai.fusion:frees term)
            (holai.fusion:type_vars_in_term term) (term-overload-choices term))))

(cl:defun term-overload-choices (term)
  (let ((interface (holai.runtime.data:deref holai.printer:the_interface)) (choices nil))
    (labels ((walk (term)
               (cond ((holai.fusion:is_const term)
                      (let ((constant (fst (holai.fusion:dest_const term))))
                        (dolist (entry interface)
                          (when (and (equal constant (fst (snd entry)))
                                     (> (count (fst entry) interface :key #'fst :test #'equal) 1))
                            (pushnew (list :operator (fst entry) :constant constant :type (holai.fusion:type_of term))
                                     choices :test #'equalp)))))
                     ((holai.fusion:is_comb term)
                      (let ((parts (holai.fusion:dest_comb term))) (walk (fst parts)) (walk (snd parts))))
                     ((holai.fusion:is_abs term) (walk (snd (holai.fusion:dest_abs term)))))))
      (walk term))
    (nreverse choices)))
