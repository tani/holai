          definductive-set defsimpset defcompset with-proof-context lemma
          defrule deftactic defconversion register-rule register-tactic register-conversion
          conversion apply-conversion find-theorems goal proof-step goals undo abort-proof
          obligations complete-definition describe-theorem save-development
          with-axiomatic-extensions declare-type declare-constant defaxiom
          representation-type quotients lift-positions assumption simpset compset automation
          extends rewrites congruences condition-provers equations conversions strategy stops
          record-update cart finite-image decimal
          dsl-proof-failure dsl-resource-exhausted dsl-interrupted dsl-contract-error
          dsl-error-source dsl-error-context dsl-error-expected dsl-error-actual))

(defvar *simpsets* (make-hash-table :test #'eq))
(defvar *compsets* (make-hash-table :test #'eq))
(defvar *resource-metadata* (make-hash-table :test #'equal))
(defvar *resource-history* (make-hash-table :test #'equal))
(defvar *rules* (make-hash-table :test #'eq))
(defvar *conversions* (make-hash-table :test #'eq))
(defvar *tactic-extensions* (make-hash-table :test #'eq))
(defvar *extension-history* (make-hash-table :test #'equal))
(defvar *provenance* (make-hash-table :test #'eq))
(defvar *axiomatic-extensions* nil)
(defvar *axiom-log* nil)
(defvar *pending-definitions* (make-hash-table :test #'eq))
(defvar *quotients* (make-hash-table :test #'eq))
(defvar *records* (make-hash-table :test #'eq))
(defvar *proof-session* nil)
(defvar *definition-completion-proofs* nil)

(declaim (ftype function conversion invoke-extension compset-conversion goals call-extension write-replay-files native-binder-name-p record-extension-source))

(cl:defun native-function (package name)
  ;; Generated modules contain both function bindings and closure-valued bindings.
  (let ((symbol (find-symbol (string-upcase name) package)))
    (cond ((and symbol (fboundp symbol)) (symbol-function symbol))
          ((and symbol (boundp symbol) (functionp (symbol-value symbol))) (symbol-value symbol))
          (t (reject-kind 'dsl-name-error (list package name) "No callable generated binding")))))
(cl:defun native (package name &rest arguments)
  (let ((function (native-function package name)))
    (if (and (equal package "HOLAI.TACTICS") (member (string-upcase name) '("PROVE" "TAC_PROOF") :test #'equal))
        (call-extension function arguments (list package name))
        (apply function arguments))))
(cl:defun options (form arguments allowed)
  (let ((position (position-if #'keywordp arguments)))
    (let ((facts (if position (subseq arguments 0 position) arguments))
          (tail (when position (nthcdr position arguments))) (seen nil))
      (unless (evenp (length tail)) (reject-kind 'dsl-option-error form "Options need values"))
      (loop for key in tail by #'cddr do
        (unless (member key allowed) (reject-kind 'dsl-option-error form "Unknown option ~s" key))
        (when (member key seen) (reject-kind 'dsl-option-error form "Duplicate option ~s" key))
        (push key seen))
      (values facts tail))))
(cl:defun require-theorem (value form)
  (handler-case (progn (holai.fusion:concl value) value)
    (error () (reject-kind 'dsl-contract-error form "Expected a kernel theorem"))))
(cl:defun logical-snapshot ()
  (list (native "HOLAI.FUSION" "constants" holai.runtime.data:unit) (native "HOLAI.FUSION" "types" holai.runtime.data:unit)
        (native "HOLAI.FUSION" "axioms" holai.runtime.data:unit)))
(cl:defun call-extension (function arguments form)
  (let ((before (logical-snapshot)) (failure nil) (results nil))
    ;; Catch before re-signalling so a native failure cannot enter the debugger
    ;; before the mutation guard has checked a delayed justification's effects.
    (unwind-protect
      (handler-case (setf results (multiple-value-list (apply function arguments)))
        (error (condition) (setf failure condition)))
      (unless (equalp before (logical-snapshot))
        (setf *kernel-uncertain* t)
        (reject-kind 'kernel-state-uncertain form "A procedural extension changed kernel declarations")))
    (if failure (error failure) (values-list results))))
(setf *proof-executor* (lambda (thunk) (call-extension thunk nil 'proof)))
(cl:defun register-rule (name function argument-kinds)
  (require-owner name)
  (incf (gethash name *extension-versions* 0))
  (setf (gethash name *rules*) (list function argument-kinds)) name)
(cl:defun register-tactic (name function argument-kinds)
  (require-owner name)
  (incf (gethash name *extension-versions* 0))
  (setf (gethash name *tactic-extensions*) (list function argument-kinds)) name)
(setf *tactic-command-resolver*
  (lambda (form)
    (when (gethash (car form) *tactic-extensions*)
      (lambda (g)
        (let ((tactic (invoke-extension (car form) (cdr form) g *tactic-extensions*)))
          (unless (functionp tactic) (reject-kind 'dsl-contract-error form "Expected a tactic"))
          (funcall (native "HOLAI.TACTICS" "VALID"
                     (lambda (goal) (call-extension tactic (list goal) form))) g))))))
(cl:defun register-conversion (name function argument-kinds)
  (require-owner name)
  (incf (gethash name *extension-versions* 0))
  (setf (gethash name *conversions*) (list function argument-kinds)) name)
(declaim (ftype function conversion invoke-extension))
(cl:defun extension-argument (kind syntax goal)
  (case kind
    (:term (goal-term syntax goal)) (:type (hol-type syntax))
    (:theorem (goal-theorem syntax goal)) (:tactic (command-tactic syntax))
    (:conversion (conversion syntax goal)) (:syntax syntax)
    (otherwise (reject kind "Unknown extension argument kind"))))
(cl:defun elaborate-extension-arguments (name arguments goal signature)
  (if (not (eq (car signature) :lambda-signature))
      (progn
        (unless (= (length arguments) (length signature)) (reject name "Extension arity differs from its signature"))
        (mapcar (lambda (kind syntax) (extension-argument kind syntax goal)) signature arguments))
      (let* ((slots (second signature)) (result nil) (tail arguments)
             (keys (remove-if-not (lambda (slot) (eq (first slot) :key)) slots))
             (rest-slot (find :rest slots :key #'first)))
        (dolist (slot slots)
          (when (member (first slot) '(:required :optional))
            (when (and (eq (first slot) :required) (null tail)) (reject name "Missing required extension argument"))
            (when tail (push (extension-argument (fourth slot) (pop tail) goal) result))))
        (cond (keys
               (unless (evenp (length tail)) (reject name "Keyword arguments need values"))
               (loop for (key value) on tail by #'cddr do
                 (let ((slot (find key keys :key #'third)))
                   (unless (or slot (eq key :allow-other-keys) (getf (cddr signature) :allow-other-keys)
                               (getf tail :allow-other-keys)) (reject key "Unknown extension keyword"))
                   (push key result) (push (if slot (extension-argument (fourth slot) value goal) value) result))))
              (rest-slot (dolist (argument tail) (push (extension-argument (fourth rest-slot) argument goal) result)))
              (tail (reject name "Too many extension arguments")))
        (nreverse result))))
(cl:defun invoke-extension (name arguments goal registry)
  (let ((entry (gethash name registry)))
    (unless entry (reject-kind 'dsl-name-error name "Unregistered extension"))
    (call-extension (first entry) (elaborate-extension-arguments name arguments goal (second entry)) name)))

;; The first host declaration (ARGUMENT-KINDS :term :theorem ...) is consumed by
;; the DSL. Remaining declarations and the body have ordinary CL semantics.
(cl:defun extension-lambda-signature (parameters kinds)
  (unless (proper-list-p parameters) (reject parameters "Expected a CL lambda list"))
  (let ((mode :required) (slots nil) (rest nil) (allow nil) (keys nil))
    (dolist (parameter parameters)
      (cond ((eq parameter '&optional) (setf mode :optional))
            ((eq parameter '&rest) (setf mode :rest))
            ((eq parameter '&key) (setf mode :key keys t))
            ((eq parameter '&allow-other-keys) (setf allow t))
            ((eq parameter '&aux) (setf mode :aux))
            ((eq mode :aux) nil)
            ((eq mode :after-rest) (reject parameters "Unexpected parameter after &REST"))
            (t
             (let* ((binding (if (consp parameter) (first parameter) parameter))
                    (name (if (and (eq mode :key) (consp binding)) (second binding) binding))
                    (key (and (eq mode :key) (if (consp binding) (first binding) (intern (symbol-name name) :keyword)))))
               (require-variables (list name))
               (push (list mode name key) slots)
               (when (eq mode :rest) (setf rest t mode :after-rest))))))
    (setf slots (nreverse slots))
    (unless kinds (setf kinds (make-list (length slots) :initial-element :syntax)))
    (unless (= (length slots) (length kinds)) (reject parameters "Argument kinds and callable parameters differ"))
    (loop for slot in slots for kind in kinds do
      (unless (member kind '(:term :type :theorem :tactic :conversion :syntax)) (reject kind "Unknown argument kind"))
      (setf (cdr (last slot)) (list kind)))
    (when (and rest keys (not (eq (fourth (find :rest slots :key #'first)) :syntax)))
      (reject parameters "&REST with &KEY uses :SYNTAX for the rest list"))
    (list :lambda-signature slots :allow-other-keys allow)))
(cl:defun extension-expansion (kind name parameters body)
  (let* ((original-body body) (doc (when (stringp (car body)) (pop body))) (kinds nil) (declarations nil))
    (loop while (and (consp (car body)) (eq (caar body) 'declare)) do
      (dolist (decl (cdar body))
        (if (string= (name-text (car decl)) "argument-kinds")
            (setf kinds (cdr decl)) (push decl declarations))) (pop body))
    (let ((signature (extension-lambda-signature parameters kinds)))
      (declaration-expansion
        `(progn
           (,kind ',name (lambda ,parameters ,@(when doc (list doc))
                                 ,@(when declarations `((declare ,@(nreverse declarations)))) ,@body) ',signature)
           (record-extension-source ',name ',kind ',parameters ',original-body))))))
(defmacro defrule (name parameters &body body)
  (extension-expansion 'register-rule name parameters body))
(defmacro deftactic (name parameters &body body)
  (extension-expansion 'register-tactic name parameters body))
(defmacro defconversion (name parameters &body body)
  (extension-expansion 'register-conversion name parameters body))

(cl:defun checked-conversion (function form)
  (lambda (input)
    (let* ((th (require-theorem
                 #+sbcl (handler-case (sb-ext:with-timeout (getf *automation-options* :timeout 30)
                                        (funcall function input))
                          (sb-ext:timeout () (reject-kind 'dsl-resource-exhausted form "Conversion timeout")))
                 #-sbcl (funcall function input) form))
           (sides (handler-case (holai.fusion:dest_eq (holai.fusion:concl th))
                    (error () (reject-kind 'dsl-contract-error form "Conversion must prove an equality")))))
      (unless (and (null (holai.fusion:hyp th))
                   (holai.fusion:aconv input (fst sides))
                   (equalp (holai.fusion:type_of input) (holai.fusion:type_of (snd sides))))
        (reject-kind 'dsl-contract-error form "Conversion has assumptions, wrong input or wrong type")) th)))
(cl:defun position-conversion (conv position)
  (cond ((or (null position) (eq position :goal) (eq position :conclusion)) conv)
        ((proper-list-p position)
         (reduce (lambda (part inner)
                   (let ((key (and (symbolp part) (intern (string-upcase (symbol-name part)) :keyword))))
                     (unless (member key '(:rator :rand :body)) (reject position "Unknown conversion path component"))
                     (native "HOLAI.EQUAL" (ecase key (:rator "RATOR_CONV") (:rand "RAND_CONV") (:body "ABS_CONV")) inner)))
                 position :from-end t :initial-value conv))
        (t (reject position "Expected :GOAL or a path of :RATOR, :RAND, :BODY"))))
(cl:defun conversion (syntax &optional (goal (tuple nil (read-term 'true))))
  (let* ((form (if (symbolp syntax) (list syntax) syntax))
         (head (name-text (car form))) (args (cdr form)))
    (unless (or (gethash (car form) *conversions*)
                (eq (car form) (find-symbol (string-upcase (symbol-name (car form))) :holai.user)))
      (reject syntax "Unknown conversion operator; import or qualify HOLAI.USER names"))
    (checked-conversion
      (cond
        ((member head '("beta" "eta" "num" "num-reduce" "int-reduce" "real-rat-reduce") :test #'equal)
         (require-arity form args 0)
         (cond ((equal head "beta") (native-function "HOLAI.EQUAL" "BETA_CONV"))
               ((equal head "eta") (native-function "HOLAI.CLASS" "ETA_CONV"))
               ((member head '("num" "num-reduce") :test #'equal) (native-function "HOLAI.CALC_NUM" "NUM_REDUCE_CONV"))
               ((equal head "int-reduce") (native-function "HOLAI.INT" "INT_REDUCE_CONV"))
               (t (native-function "HOLAI.CALC_RAT" "REAL_RAT_REDUCE_CONV"))))
        ((equal head "alpha")
         (require-arity form args 1)
         (lambda (tm)
           (let ((variable (fst (holai.fusion:dest_abs tm))))
             (native "HOLAI.EQUAL" "ALPHA_CONV"
               (holai.fusion:mk_var (tuple (variable-name (first args)) (holai.fusion:type_of variable))) tm))))
        ((member head '("rator" "rand" "body" "depth" "redepth" "once" "try-conv" "repeat-conv") :test #'equal)
         (require-arity form args 1)
         (native "HOLAI.EQUAL"
           (cdr (assoc head '(("rator" . "RATOR_CONV") ("rand" . "RAND_CONV") ("body" . "ABS_CONV")
                             ("depth" . "DEPTH_CONV") ("redepth" . "REDEPTH_CONV")
                             ("once" . "ONCE_DEPTH_CONV") ("try-conv" . "TRY_CONV")
                             ("repeat-conv" . "REDEPTH_CONV")) :test #'equal))
           (let ((conv (conversion (first args) goal)))
             (if (member head '("depth" "redepth" "repeat-conv") :test #'equal)
                 (native "HOLAI.EQUAL" "CHANGED_CONV" conv) conv))))
        ((member head '("then-conv" "orelse-conv") :test #'equal)
         (require-arity form args 2)
         (let ((a (conversion (first args) goal)) (b (conversion (second args) goal)))
           (if (equal head "orelse-conv")
               (lambda (tm) (handler-case (funcall a tm)
                              (holai.runtime.core:failure () (funcall b tm))))
               (lambda (tm)
                 (let ((th (funcall a tm)))
                   (native "HOLAI.FUSION" "TRANS" th
                     (funcall b (snd (holai.fusion:dest_eq (holai.fusion:concl th))))))))))
        ((equal head "rewrite-conv")
         (native "HOLAI.SIMP" "REWRITE_CONV" (mapcar (lambda (x) (rewrite-theorem x goal)) args)))
        ((member head '("eval" "compute" "restricted-eval") :test #'equal)
         (multiple-value-bind (facts opts) (options form args '(:set :strategy :stops))
           (when facts (reject form "Evaluation uses keyword options"))
           (compset-conversion (getf opts :set *default-compset*) opts goal)))
        ((equal head "conversion-ref")
         (unless (>= (length form) 2) (reject form "CONVERSION-REF needs a name"))
         (conversion (cdr form) goal))
        ((gethash (car form) *conversions*)
         (let ((function (invoke-extension (car form) args goal *conversions*)))
           (unless (functionp function) (reject-kind 'dsl-contract-error form "Expected a conversion"))
           (lambda (tm) (call-extension function (list tm) form))))
        (t (reject syntax "Unknown conversion"))) syntax)))
(cl:defun apply-conversion (syntax term &optional goal)
  (funcall (if goal (conversion syntax goal) (conversion syntax)) term))

(cl:defun resource-clauses (body allowed)
  (when (stringp (car body)) (pop body))
  (let ((seen nil))
    (dolist (clause body)
      (unless (and (consp clause) (member (name-text (car clause)) allowed :test #'equal))
        (reject clause "Unknown resource clause"))
      (when (member (name-text (car clause)) seen :test #'equal) (reject clause "Duplicate resource clause"))
      (push (name-text (car clause)) seen))) body)
(cl:defun resource-values (key clauses)
  (cdr (find key clauses :key (lambda (c) (name-text (car c))) :test #'equal)))
(cl:defun make-condition-prover (syntax)
  (let ((rules (copy-table *rules*)) (tactics (copy-table *tactic-extensions*))
        (conversions (copy-table *conversions*)) (theorems (copy-table *theorems*))
        (provenance (copy-table *provenance*)) (commands (copy-table *proof-commands*)))
    (funcall (native "HOLAI.SIMP" "mk_prover"
      (holai.runtime.core:lambdac (facts tm)
        (let ((*rules* rules) (*tactic-extensions* tactics) (*conversions* conversions)
              (*theorems* theorems) (*provenance* provenance) (*proof-commands* commands))
          (native "HOLAI.TACTICS" "TAC_PROOF"
            (tuple (tuple (mapcar (lambda (th) (tuple "" th)) facts) tm) (command-tactic syntax)))))
      (lambda (facts new) (append new facts))) nil)))
(cl:defun freeze-proof-function (function)
  (let ((rules (copy-table *rules*)) (tactics (copy-table *tactic-extensions*))
        (conversions (copy-table *conversions*)) (theorems (copy-table *theorems*))
        (provenance (copy-table *provenance*)) (commands (copy-table *proof-commands*)))
    (lambda (&rest arguments)
      (let ((*rules* rules) (*tactic-extensions* tactics) (*conversions* conversions)
            (*theorems* theorems) (*provenance* provenance) (*proof-commands* commands))
        (apply function arguments)))))
(cl:defun prepare-computation-conversion (entry)
  (if (and (symbolp entry) (eq entry 'num-reduce)) entry
      (progn
        (require-arity entry entry 3)
        (unless (and (integerp (second entry)) (not (minusp (second entry)))) (reject entry "Expected a nonnegative conversion arity"))
        (let ((constant (read-term (first entry))))
          (unless (holai.fusion:is_const constant) (reject entry "A computation conversion needs a constant head"))
          (list constant (second entry) (freeze-proof-function (conversion (third entry))))))))
(cl:defun define-resource (name body registry allowed)
  (require-owner name)
  (let* ((clauses (resource-clauses body allowed))
         (parents (resource-values "extends" clauses)))
    (when (member name parents) (reject name "Cyclic resource inheritance"))
    ;; Snapshot inheritance and theorem references now, never consult a parent's later version.
    (let ((snapshot (loop for parent in parents append
                       (copy-tree (or (gethash parent registry)
                                      (reject-kind 'dsl-name-error parent "Unknown resource"))))))
      (dolist (clause clauses)
        (unless (equal (name-text (car clause)) "extends")
          (let* ((key (name-text (car clause)))
                 (values (cond ((member key '("rewrites" "equations" "congruences") :test #'equal)
                                (mapcar (lambda (x) (rewrite-theorem x (tuple nil (read-term 'true)))) (cdr clause)))
                               ((equal key "condition-provers") (mapcar #'make-condition-prover (cdr clause)))
                               ((equal key "conversions") (mapcar #'prepare-computation-conversion (cdr clause)))
                               (t (copy-tree (cdr clause))))))
            (setf snapshot (append snapshot (list (cons key values)))))))
      (when (and (eq registry *simpsets*) (null (assoc "native-basis" snapshot :test #'equal)))
        (push (list "native-basis" (native "HOLAI.SIMP" "basic_ss" nil)) snapshot))
      (let* ((key (list (if (eq registry *simpsets*) :simpset :compset) name))
             (old (gethash key *resource-metadata*)))
        (setf (gethash key *resource-metadata*)
              (list :name name :kind (first key) :source body :version (1+ (getf old :version 0))
                    :parents (mapcar (lambda (p) (list p (getf (gethash (list (first key) p) *resource-metadata*) :version))) parents)
                    :extensions (loop for s being the hash-keys of *extension-versions* using (hash-value v) collect (cons s v))))
        (setf (gethash (append key (list (getf (gethash key *resource-metadata*) :version))) *resource-history*)
              (gethash key *resource-metadata*)))
      (setf (gethash name registry) snapshot) name)))
(defmacro defsimpset (name &body body)
  (declaration-expansion `(define-resource ',name ',body *simpsets*
                           '("extends" "rewrites" "congruences" "condition-provers"))))
(defmacro defcompset (name &body body)
  (declaration-expansion `(define-resource ',name ',body *compsets*
                           '("extends" "equations" "conversions" "strategy" "stops"))))
(cl:defun all-resource-values (key clauses)
  (loop for c in clauses when (equal key (car c)) append (cdr c)))
(cl:defun simpset-conversion (name thms once &optional strict)
  (let* ((clauses (when name (or (gethash name *simpsets*) (reject name "Unknown simpset"))))
         (ss (or (second (assoc "native-basis" clauses :test #'equal)) (native "HOLAI.SIMP" "basic_ss" nil)))
         (rewrites (append (all-resource-values "rewrites" clauses) *local-simp-theorems* thms)))
    (setf ss (native "HOLAI.SIMP" "ss_of_thms" rewrites ss)
          ss (native "HOLAI.SIMP" "ss_of_congs" (all-resource-values "congruences" clauses) ss))
    (setf ss (native "HOLAI.SIMP" "ss_of_provers" (all-resource-values "condition-provers" clauses) ss))
    (let ((failed nil) (original ss))
      (when strict
        (setf ss (native "HOLAI.SIMP" "ss_of_provers"
                   (list (funcall (native "HOLAI.SIMP" "mk_prover"
                     (holai.runtime.core:lambdac (facts tm)
                       (handler-case
                         (native "HOLAI.BOOL" "EQT_ELIM"
                           (native "HOLAI.SIMP" "SIMPLIFY_CONV" original facts tm))
                         (holai.runtime.core:failure ()
                           (pushnew tm failed :test #'holai.runtime.core:=)
                           (holai.runtime.core:failwith "Unproved rewrite condition"))))
                     (lambda (facts new) (append new facts))) nil)) ss)))
      (let ((conv (native "HOLAI.SIMP" (if once "ONCE_SIMPLIFY_CONV" "SIMPLIFY_CONV") ss nil)))
        (lambda (tm)
          (setf failed nil)
          (let ((th (funcall conv tm)))
            (when failed
              (error 'dsl-obligation-error :form 'strict-rewrite :cause "Unproved rewrite conditions"
                     :actual (reverse failed))) th))))))
(cl:defun compset-conversion (name opts goal)
  (declare (ignore goal))
  (let* ((clauses (when name (or (gethash name *compsets*) (reject name "Unknown compset"))))
         (cs (native "HOLAI.COMPUTE.COMPUTE" "bool_compset" holai.runtime.data:unit))
         (strategy (getf opts :strategy (or (car (last (all-resource-values "strategy" clauses))) :cbv)))
         (stops (append (all-resource-values "stops" clauses) (getf opts :stops)))
         (stop-names (mapcar (lambda (x) (or (gethash x *constants*) (reject x "Unknown stopped constant"))) stops)))
    (unless (member strategy '(:cbv :weak)) (reject strategy "Expected :CBV or :WEAK"))
    (native "HOLAI.COMPUTE.COMPUTE" "add_thms" (all-resource-values "equations" clauses) cs)
    (native "HOLAI.COMPUTE.COMPUTE" "set_skip" cs (read-term 'if) (holai.runtime.core:make-Some 1))
    (dolist (entry (all-resource-values "conversions" clauses))
      (if (and (symbolp entry) (equal (name-text entry) "num-reduce"))
          (native "HOLAI.CALC_NUM" "num_compute_add_convs" cs)
          (progn
            (require-arity entry entry 3)
            (native "HOLAI.COMPUTE.COMPUTE" "add_conv"
              (tuple (first entry) (second entry) (third entry)) cs))))
    (lambda (tm)
      (let* ((auto holai.compute.compute::auto_import_definitions)
             (stop holai.compute.compute:stoppers)
             (old-auto (holai.runtime.data:deref auto)) (old-stop (holai.runtime.data:deref stop)))
        (unwind-protect
          (progn
            (holai.runtime.data:assign auto nil)
            (holai.runtime.data:assign stop
              (if stop-names (holai.runtime.core:make-Some
                               (lambda (c) (member (fst (holai.fusion:dest_const c)) stop-names :test #'equal)))
                  (holai.runtime.core:make-None)))
            (native "HOLAI.COMPUTE.COMPUTE" (if (eq strategy :weak) "WEAK_CBV_CONV" "CBV_CONV") cs tm))
          (holai.runtime.data:assign auto old-auto) (holai.runtime.data:assign stop old-stop))))))

(setf (gethash "ref" *theorem-expressions*)
  (lambda (form g)
    (require-arity form (cdr form) 1)
    (goal-theorem (second form) g)))
(setf (gethash "inst" *theorem-expressions*)
  (lambda (form g)
    (multiple-value-bind (facts opts) (options form (cddr form) '(:types :terms))
      (when facts (reject form "INST substitutions use keywords"))
      (let ((th (goal-theorem (second form) g)))
        (let ((types (mapcar (lambda (pair)
                              (require-arity pair pair 2)
                              (unless (type-variable-p (first pair)) (reject pair "Expected a type variable"))
                              (tuple (hol-type (second pair)) (hol-type (first pair)))) (getf opts :types))))
          (when types (setf th (native "HOLAI.FUSION" "INST_TYPE" types th))))
        (let* ((frees (holai.fusion:freesl (cons (holai.fusion:concl th) (holai.fusion:hyp th))))
               (substitutions (mapcar
                 (lambda (pair)
                   (require-arity pair pair 2)
                   (let ((v (find (variable-name (first pair)) frees
                                  :key (lambda (v) (fst (holai.fusion:dest_var v))) :test #'equal)))
                     (unless v (reject pair "Unknown theorem variable"))
                     (tuple (goal-term (second pair) g nil (holai.fusion:type_of v)) v))) (getf opts :terms))))
          (native "HOLAI.FUSION" "INST%" substitutions th))))))
(setf (gethash "gen" *theorem-expressions*)
  (lambda (form g)
    (require-arity form (cdr form) 2)
    (require-variables (second form))
    (reduce (lambda (v th) (native "HOLAI.BOOL" "GEN" (goal-term v g) th))
            (second form) :from-end t :initial-value (goal-theorem (third form) g))))
(setf (gethash "rule" *theorem-expressions*)
  (lambda (form g)
    (require-theorem (invoke-extension (second form) (cddr form) g *rules*) form)))
(cl:defun convert-theorem-at (conv th position goal)
  (if (and (consp position) (equal (name-text (car position)) "subterm"))
      (convert-theorem-at (position-conversion conv (third position)) th (second position) goal)
      (if (and (consp position) (equal (name-text (car position)) "hypothesis"))
          (let* ((target (second position))
                 (hyp (if (integerp target)
                          (and (<= 1 target (length (holai.fusion:hyp th))) (nth (1- target) (holai.fusion:hyp th)))
                          (let ((entry (find (variable-name target) (fst goal) :key #'fst :test #'equal)))
                            (and entry (holai.fusion:concl (snd entry)))))))
            (unless (and hyp (member hyp (holai.fusion:hyp th) :test #'holai.runtime.core:=))
              (reject position "The theorem has no such hypothesis"))
            (let* ((equality (funcall conv hyp))
                   (replacement (snd (holai.fusion:dest_eq (holai.fusion:concl equality))))
                   (old-from-new (native "HOLAI.FUSION" "EQ_MP" (native "HOLAI.EQUAL" "SYM" equality)
                                   (native "HOLAI.FUSION" "ASSUME" replacement))))
              (native "HOLAI.DRULE" "PROVE_HYP" old-from-new th)))
          (native "HOLAI.EQUAL" "CONV_RULE" (position-conversion conv position) th))))
(setf (gethash "convert" *theorem-expressions*)
  (lambda (form g)
    (multiple-value-bind (facts opts) (options form (cdddr form) '(:at))
      (when facts (reject form "CONVERT takes a conversion, theorem and :AT"))
      (convert-theorem-at (conversion (second form) g) (goal-theorem (third form) g) (getf opts :at) g))))

;; Standard rule descriptors state argument kinds; no arbitrary native binding is
;; guessed from an unqualified user symbol.
(dolist (entry '((sym "HOLAI.EQUAL" "SYM" :theorem)
                 (trans "HOLAI.FUSION" "TRANS" :theorem :theorem)
                 (mp "HOLAI.BOOL" "MP" :theorem :theorem)
                 (eq-mp "HOLAI.FUSION" "EQ_MP" :theorem :theorem)
                 (conj "HOLAI.BOOL" "CONJ" :theorem :theorem)
                 (conjunct1 "HOLAI.BOOL" "CONJUNCT1" :theorem)
                 (conjunct2 "HOLAI.BOOL" "CONJUNCT2" :theorem)
                 (disch "HOLAI.BOOL" "DISCH" :term :theorem)
                 (undisch "HOLAI.BOOL" "UNDISCH" :theorem)
                 (match-mp "HOLAI.DRULE" "MATCH_MP" :theorem :theorem)))
  (register-rule (first entry) (native-function (second entry) (third entry)) (cdddr entry))
  (export (first entry)))

(cl:defun rewriting-tactic (form)
  (multiple-value-bind (facts opts)
      (options form (cdr form) '(:using :at :orientation :repeat :set :strict))
    (when (and facts (member :using opts)) (reject form "Do not combine leading facts and :USING"))
    (let ((names (or facts (getf opts :using)))
          (orientation (getf opts :orientation :forward))
          (repeat (getf opts :repeat (if (member (name-text (car form)) '("simp" "asm-simp") :test #'equal) :repeat :once)))
          (at (getf opts :at :goal))
          (simp (member (name-text (car form)) '("simp" "asm-simp") :test #'equal))
          (asm (member (name-text (car form)) '("asm-simp" "asm-rewrite") :test #'equal)))
      (unless (member orientation '(:forward :backward)) (reject form "Bad rewrite orientation"))
      (unless (member repeat '(:once :repeat)) (reject form "Bad rewrite repetition"))
      (when (and (getf opts :set) (not simp)) (reject form ":SET applies to SIMP"))
      (lambda (g)
        (let* ((thms (mapcar (lambda (name)
                              (let ((th (rewrite-theorem name g)))
                                (if (eq orientation :backward) (native "HOLAI.EQUAL" "GSYM" th) th))) names))
               (thms (append thms (when asm (mapcar #'snd (fst g)))))
               (conv (if simp
                         (simpset-conversion (getf opts :set *default-simpset*) thms (eq repeat :once) (getf opts :strict))
                         (let ((*local-simp-theorems* nil))
                           (simpset-conversion nil thms (eq repeat :once) (getf opts :strict))))))
          (labels ((at-target (target path)
                     (let ((conv (position-conversion conv path)))
                       (if (and (consp target) (equal (name-text (car target)) "hypothesis"))
                           (let* ((label (variable-name (second target)))
                                  (entry (find label (fst g) :key #'fst :test #'equal)))
                             (unless entry (reject target "Unknown assumption label"))
                             (funcall (native "HOLAI.TACTICS" "REMOVE_THEN" label
                                        (holai.runtime.core:lambdac (th goal)
                                          (funcall (native "HOLAI.TACTICS" "LABEL_TAC" label
                                                       (native "HOLAI.EQUAL" "CONV_RULE" conv th)) goal))) g))
                           (progn
                             (unless (member target '(:goal goal)) (reject target "Unknown rewrite target"))
                             (funcall (native "HOLAI.TACTICS" "THEN"
                                        (native "HOLAI.TACTICS" "CONV_TAC" conv)
                                        (native "HOLAI.SIMP" "REWRITE_TAC" nil)) g))))))
            (if (and (consp at) (equal (name-text (car at)) "subterm"))
                (at-target (second at) (mapcar (lambda (p) (intern (string-upcase (name-text p)) :keyword)) (third at)))
                (at-target at nil))))))))
(dolist (name '("rewrite" "asm-rewrite" "simp" "asm-simp"))
  (setf (gethash name *proof-commands*) #'rewriting-tactic))
(setf (gethash "unfold" *proof-commands*)
      (lambda (form) (rewriting-tactic `(rewrite ,@(cdr form) :repeat :repeat)))
      (gethash "fold" *proof-commands*)
      (lambda (form) (rewriting-tactic `(rewrite ,@(cdr form) :orientation :backward))))
(dolist (name '("conv" "normalize"))
  (setf (gethash name *proof-commands*)
    (lambda (form)
      (require-arity form (cdr form) 1)
      (lambda (g) (funcall (native "HOLAI.TACTICS" "CONV_TAC" (conversion (second form) g)) g)))))
(setf (gethash "compute" *proof-commands*)
  (lambda (form)
    (multiple-value-bind (facts opts) (options form (cdr form) '(:set :restricted :strategy))
      (when facts (reject form "COMPUTE uses keywords"))
      (lambda (g)
        (funcall (native "HOLAI.TACTICS" "CONV_TAC"
                   (checked-conversion (compset-conversion (getf opts :set *default-compset*)
                                          (list :strategy (getf opts :strategy :cbv) :stops (getf opts :restricted)) g) form)) g)))))
(dolist (entry '(("left" "DISJ1_TAC") ("right" "DISJ2_TAC") ("contradiction" "CONTR_TAC")))
  (let ((op (second entry)))
    (setf (gethash (first entry) *proof-commands*)
      (lambda (form)
        (require-arity form (cdr form) 0)
        (if (equal op "CONTR_TAC")
            (native "HOLAI.TACTICS" "FIRST_ASSUM" (native-function "HOLAI.TACTICS" op))
            (native-function "HOLAI.TACTICS" op))))))
(setf (gethash "fix" *proof-commands*)
  (lambda (form)
    (unless (cdr form) (reject form "FIX needs variables"))
    (require-variables (cdr form))
    (when (intersection (cdr form) *bindings*) (reject-kind 'dsl-scope-error form "FIX shadows a fixed parameter"))
    (reduce (lambda (a b) (native "HOLAI.TACTICS" "THEN" a b))
      (mapcar (lambda (symbol)
        (lambda (g)
          (let ((v (fst (native "HOLAI.BASICS" "dest_forall" (snd g)))))
            (funcall (native "HOLAI.TACTICS" "X_GEN_TAC"
                       (holai.fusion:mk_var (tuple (variable-name symbol) (holai.fusion:type_of v)))) g)))) (cdr form))
      :initial-value #'holai.tactics:ALL_TAC)))
(setf (gethash "first" *proof-commands*)
  (lambda (form)
    (unless (cdr form) (reject form "FIRST needs tactics"))
    (reduce (lambda (a b) (native "HOLAI.TACTICS" "ORELSE" a b)) (mapcar #'command-tactic (cdr form)))))
(setf (gethash "apply" *proof-commands*)
  (lambda (form)
    (multiple-value-bind (facts opts) (options form (cddr form) '(:with))
      (when facts (reject form "APPLY takes one theorem and :WITH"))
      (lambda (g)
        (let ((th (goal-theorem (second form) g)))
          (dolist (term (getf opts :with)) (setf th (holai.bool:ISPEC (goal-term term g) th)))
          (funcall (holai.tactics:MATCH_MP_TAC th) g))))))
(cl:defun bounded-tactic (tactic form opts)
  (let ((timeout (getf opts :timeout 10)))
    (unless (and (realp timeout) (plusp timeout)) (reject form "Expected a positive timeout in seconds"))
    (lambda (g)
      (handler-case
        #+sbcl (sb-ext:with-timeout timeout (funcall tactic g))
        #-sbcl (reject form "This host has no proof timeout backend")
        #+sbcl (sb-ext:timeout () (reject-kind 'dsl-resource-exhausted form "Proof timeout"))))))
(dolist (entry '(("meson" "HOLAI.MESON" "ASM_MESON_TAC")
                 ("metis" "HOLAI.METIS" "ASM_METIS_TAC")
                 ("leancop" "HOLAI.THECOPS" "LEANCOP_TAC")
                 ("nanocop" "HOLAI.THECOPS" "NANOCOP_TAC")))
  (let ((package (second entry)) (binding (third entry)))
    (setf (gethash (first entry) *proof-commands*)
      (lambda (form)
        (multiple-value-bind (facts opts) (options form (cdr form) '(:using :timeout :depth :steps))
          (when (and facts (getf opts :using)) (reject form "Duplicate theorem lists"))
          (when (and (getf opts :depth) (getf opts :steps)) (reject form "Choose depth or inference-bound mode"))
          (dolist (key '(:depth :steps))
            (when (getf opts key)
              (unless (and (integerp (getf opts key)) (plusp (getf opts key))) (reject form "Expected a positive search bound"))
              (unless (equal package "HOLAI.MESON") (reject form "This engine exposes :TIMEOUT; it has no portable depth/step option"))))
          (bounded-tactic
            (lambda (g)
              (let ((thms (mapcar (lambda (x) (goal-theorem x g)) (or facts (getf opts :using)))))
                (if (equal package "HOLAI.MESON")
                    (let ((old-depth (holai.runtime.data:deref holai.meson:meson_depth))
                          (old-cut (holai.runtime.data:deref holai.meson:meson_dcutin)))
                      (unwind-protect
                        (progn
                          (holai.runtime.data:assign holai.meson:meson_depth (not (null (getf opts :depth))))
                          (handler-case
                            (funcall (native "HOLAI.MESON" "GEN_MESON_TAC" 0
                                       (or (getf opts :depth) (getf opts :steps) 50) 1 thms) g)
                            (holai.runtime.core:failure (condition)
                              (if (search "Too deep" (holai.runtime.core:exception-string condition))
                                  (error 'dsl-resource-exhausted :form form :cause condition)
                                  (error condition)))))
                        (holai.runtime.data:assign holai.meson:meson_depth old-depth)
                        (holai.runtime.data:assign holai.meson:meson_dcutin old-cut)))
                    (funcall (native package binding thms) g)))) form (append opts *automation-options*)))))))
(cl:defun term-contains-type (term type)
  (or (holai.runtime.core:= (holai.fusion:type_of term) type)
      (and (holai.fusion:is_comb term) (let ((p (holai.fusion:dest_comb term)))
                                       (or (term-contains-type (fst p) type) (term-contains-type (snd p) type))))
      (and (holai.fusion:is_abs term) (term-contains-type (snd (holai.fusion:dest_abs term)) type))))
(dolist (entry '(("ring" "INT_RING" "REAL_RING") ("field" nil "REAL_FIELD")))
  (let ((integer (second entry)) (real (third entry)))
    (setf (gethash (first entry) *proof-commands*)
      (lambda (form)
        (multiple-value-bind (facts opts) (options form (cdr form) '(:timeout))
          (when facts (reject form "Algebra tactic takes only :TIMEOUT"))
          (bounded-tactic
            (lambda (g)
              (let* ((types (mapcar #'holai.fusion:type_of (holai.fusion:frees (snd g))))
                     (intp (find (hol-type 'int) types :test #'equalp))
                     (realp (term-contains-type (snd g) (hol-type 'real)))
                     (intp (or intp (term-contains-type (snd g) (hol-type 'int))))
                     (package (cond (realp "HOLAI.CALC_RAT") (intp "HOLAI.INT") (t "HOLAI.GROBNER")))
                     (binding (cond (realp real) (intp integer) ((equal (name-text (car form)) "ring") "NUM_RING"))))
                (unless binding (reject form "No integer field procedure"))
                (funcall (native "HOLAI.TACTICS" "ACCEPT_TAC" (native package binding (snd g))) g))) form opts))))))
