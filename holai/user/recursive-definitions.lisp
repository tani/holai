(in-package :holai.user)

(cl:defun discharge-obligations (name evidence specifications parameters)
  (let* ((measure (second (assoc 'measure specifications)))
         (relation (second (assoc 'well-founded-relation specifications)))
         (termination (assoc 'termination specifications))
         (given (cdr (assoc 'obligation-proofs specifications)))
         (obligations (holai.fusion:hyp evidence)))
    (when (> (count-if #'identity (list measure relation termination)) 1)
      (reject specifications "TERMINATION, MEASURE and WELL-FOUNDED-RELATION are exclusive"))
    (when (and (or measure relation) (null obligations))
      (reject specifications "Explicit ordering was not used by this recursion principle"))
    (let ((remaining nil) (result evidence) (labels nil))
      (loop for proposition in obligations for index from 1
            for label = (intern (format nil "OBLIGATION-~d" index) :keyword) do
        (push label labels)
        (let* ((explicit (or (assoc label *definition-completion-proofs*) (assoc label given)))
               (proof (handler-case
                 (cond
                   (explicit (proof-for proposition (second explicit)))
                   ((or measure relation)
                    (let* ((ordering-type (holai.fusion:type_of (fst (native "HOLAI.BASICS" "dest_exists" proposition))))
                           (domain (first (snd (holai.fusion:dest_type ordering-type))))
                           (tuple-variable (holai.fusion:mk_var (tuple "measure_arguments" domain)))
                           (measure-body (and measure (read-term measure :expected-type 'num)))
                           (measure-body (and measure-body
                             (funcall holai.fusion:vsubst
                               (loop for parameter in parameters for index from 0
                                     collect (tuple
                                       (labels ((projection (term i count)
                                                  (if (= count 1) term
                                                      (if (zerop i) (native "HOLAI.BASICS" "list_mk_icomb" "FST" (list term))
                                                          (projection (native "HOLAI.BASICS" "list_mk_icomb" "SND" (list term)) (1- i) (1- count))))))
                                         (projection tuple-variable index (length parameters)))
                                       (read-term parameter))) measure-body)))
                           (ordering (if relation (read-term relation :expected-hol-type ordering-type)
                                         (native "HOLAI.BASICS" "list_mk_icomb" "MEASURE"
                                           (list (holai.fusion:mk_abs (tuple tuple-variable measure-body))))))
                           (tactic (native "HOLAI.TACTICS" "THEN"
                                     (native "HOLAI.TACTICS" "EXISTS_TAC" ordering)
                                     (native "HOLAI.TACTICS" "THEN"
                                       (native "HOLAI.SIMP" "REWRITE_TAC"
                                         (list holai.wf:WF_MEASURE holai.wf:MEASURE))
                                       holai.int:ASM_ARITH_TAC))))
                      (native "HOLAI.TACTICS" "prove" (tuple proposition tactic))))
                   (t nil))
                 (holai.runtime.core:failure () nil))))
          (if proof (setf result (native "HOLAI.DRULE" "PROVE_HYP" proof result))
              (push (list label :proposition proposition :parameters parameters) remaining))))
      (dolist (entry given) (unless (member (first entry) labels) (reject entry "Unknown obligation label")))
      (when remaining
        ;; The closure retains only checked evidence and source settings. No kernel
        ;; constant is created until every hypothesis has a closed proof.
        (let ((captured result) (remaining (nreverse remaining)))
          (setf (gethash name *pending-definitions*)
            (list :obligations remaining :complete
              (lambda (proofs)
                (let ((closed captured))
                  (dolist (obligation remaining)
                    (let ((proof (assoc (first obligation) proofs)))
                      (unless proof (reject proofs "Missing obligation ~s" (first obligation)))
                      (setf closed (native "HOLAI.DRULE" "PROVE_HYP"
                                     (proof-for (getf (cdr obligation) :proposition) (second proof)) closed))))
                  (require-closed-theorem closed name)
                  (let ((th (kernel-definition-call name
                              (lambda () (native "HOLAI.NUMS" "new_specification" (list (encoded-name name)) closed)))))
                    (setf (gethash name *constants*) (encoded-name name))
                    (register-definition-results name (list (cons ".definition" th) (cons ".equations" th)))
                    (remhash name *pending-definitions*) th))))))
        (error 'dsl-obligation-error :form name :cause "Unproved obligations; inspect OBLIGATIONS and use COMPLETE-DEFINITION"))
      (require-closed-theorem result name))))
(setf (gethash (intern "MEASURE" :holai.user) *constants*) "MEASURE")
(setf *recursive-introducer*
  (lambda (name parameters specifications equations function recursion)
    (let* ((explicit-order (or (assoc 'measure specifications) (assoc 'well-founded-relation specifications)))
           (evidence (if recursion
                         (native "HOLAI.RECURSION" "prove_recursive_functions_exist" recursion equations)
                         (native "HOLAI.DEFINE"
                           (if explicit-order "pure_prove_recursive_function_exists" "prove_general_recursive_function_exists")
                           (native "HOLAI.BOOL" "mk_exists" (tuple function equations)))))
           (closed (discharge-obligations name evidence specifications parameters)))
      (kernel-definition-call name
        (lambda () (native "HOLAI.NUMS" "new_specification" (list (encoded-name name)) closed))))))

;; Standard sum/product constructors used by pattern elaboration and simultaneous
;; recursion encoding. They remain ordinary HOL constants.
(dolist (entry '((inl . "INL") (inr . "INR") (outl . "OUTL") (outr . "OUTR")
                 (first-component . "FST") (second-component . "SND")
                 (member-of . "IN") (subset-of . "SUBSET") (union . "UNION")
                 (intersection . "INTER") (finite . "FINITE") (cardinality . "CARD")
                 (nsum . "nsum") (sum . "sum") (dimindex . "dimindex")))
  (setf (gethash (car entry) *constants*) (cdr entry)) (export (car entry)))
(dolist (entry '((sum-type "sum" 2) (cart "cart" 2) (finite-image "finite_image" 1)
                 (one "1" 0) (two "2" 0) (three "3" 0)))
  (setf (gethash (car entry) *types*) (cdr entry)) (export (car entry)))
(setf (gethash 'decimal *term-expanders*)
  (lambda (form)
    (require-arity form (cdr form) 1)
    (unless (and (stringp (second form))
                 (let ((s (second form)))
                   (and (> (length s) 0) (= (count #\. s) 1)
                        (every (lambda (c) (or (digit-char-p c) (find c ".-+"))) s))))
      (reject form "DECIMAL expects an exact decimal string"))
    (let* ((s (second form)) (dot (position #\. s))
           (digits (concatenate 'string (subseq s 0 dot) (subseq s (1+ dot))))
           (n (handler-case (parse-integer digits) (error () (reject form "Malformed decimal")))))
      `(the real ,(/ n (expt 10 (- (length s) dot 1)))))))

(cl:defun type-syntax (type)
  (if (funcall holai.fusion:is_vartype type)
      (let* ((native-name (holai.fusion:dest_vartype type))
             (symbol (intern (concatenate 'string "?" native-name) :holai.user)))
        (pushnew (cons symbol native-name) *type-parameters* :test #'equal) symbol)
      (let* ((parts (holai.fusion:dest_type type))
             (name (fst parts)) (arguments (snd parts))
             (head (if (equal name "fun") '->
                       (loop for s being the hash-keys of *types* using (hash-value info)
                             when (equal (first info) name) return s))))
        (unless head (reject type "No surface descriptor for native type"))
        (if arguments (cons head (mapcar #'type-syntax arguments)) head))))
(cl:defun tuple-syntax (terms)
  (cond ((null terms) 'true) ((null (cdr terms)) (car terms))
        (t `(pair ,(car terms) ,(tuple-syntax (cdr terms))))))
(cl:defun tuple-projection (term index count)
  (if (= count 1) term
      (if (zerop index) `(first-component ,term)
          (tuple-projection `(second-component ,term) (1- index) (1- count)))))
(cl:defun sum-injection (term index count)
  (if (= count 1) term
      (if (zerop index) `(inl ,term) `(inr ,(sum-injection term (1- index) (1- count))))))
(cl:defun sum-projection (term index count)
  (if (= count 1) term
      (if (zerop index) `(outl ,term) (sum-projection `(outr ,term) (1- index) (1- count)))))
(cl:defun projection-conditional (projection)
  (let* ((b (holai.fusion:mk_var (tuple "projection_condition" (hol-type 'bool))))
         (th (holai.bool:ISPEC (read-term projection) (holai.bool:ISPEC b holai.class:COND_RAND))))
    (native "HOLAI.BOOL" "GEN" b th)))
(cl:defun quantify-source (variables declarations proposition)
  (if variables `(forall ,variables (declare ,@declarations) ,proposition) proposition))
(cl:defun function-source (variables declarations body)
  (if variables `(lambda ,variables (declare ,@declarations) ,body) body))
(cl:defun acyclic-call-ranks (names bodies)
  (let ((cyclic nil))
    (labels ((rank (name path)
               (if (member name path) (progn (setf cyclic t) 0)
                   (let* ((body (nth (position name names) bodies))
                          (dependencies (remove-if-not (lambda (other) (contains-symbol-p (list other) body)) names)))
                     (if dependencies (1+ (reduce #'max (mapcar (lambda (dep) (rank dep (cons name path))) dependencies))) 0)))))
      (let ((ranks (mapcar (lambda (name) (cons name (rank name nil))) names)))
        (unless cyclic ranks)))))
(cl:defun primitive-function-equations (name args specs source)
  (let* ((expression (normalize-match-syntax source))
         (scrutinee (and (consp expression) (eq (car expression) 'match) (second expression)))
         (annotations (annotation-bindings specs)) (result-type (second (assoc 'values specs))))
    (unless (member scrutinee args) (reject source "The selected primitive recursion principle requires a top-level MATCH argument"))
    (let ((patterns (mapcar (lambda (b) (coverage-pattern (first b))) (cddr expression))))
      (unless (and (every #'consp patterns) (= (length patterns) (length (remove-duplicates patterns :key #'car)))
                   (exhaustive-patterns-p (mapcar #'list patterns)))
        (reject source "Primitive branches need distinct exhaustive constructor heads")))
    (mapcar (lambda (branch)
              (let* ((pattern (first branch)) (variables (pattern-variables pattern))
                     (others (remove scrutinee args))
                     (type (cdr (assoc scrutinee annotations)))
                     (arguments (subst (if type `(the ,type ,pattern) pattern) scrutinee args))
                     (declarations (loop for other in others for type = (cdr (assoc other annotations))
                                         when type collect `(type ,type ,other))))
                (quantify-source (append variables others) declarations
                  `(= (,name ,@arguments) ,(if result-type `(the ,result-type ,(second branch)) (second branch))))))
            (cddr expression))))
(cl:defun infer-simultaneous-principle (clauses)
  (let ((principles nil))
    (dolist (clause clauses)
      (multiple-value-bind (rest specs) (declaration-body (cddr clause) (second clause) '(type values type-variables ignorable) t)
        (let* ((body (first rest)) (scrutinee (and (consp body) (eq (car body) 'match) (second body)))
               (type (cdr (assoc scrutinee (annotation-bindings specs))))
               (principle (and type (handler-case
                                       (gethash (fst (holai.fusion:dest_type (hol-type type))) *type-recursions*)
                                       (holai.runtime.core:failure () nil)))))
          (unless principle (return-from infer-simultaneous-principle nil)) (push principle principles))))
    (when (every (lambda (th) (eq th (first principles))) principles)
      (let* ((inst (native "HOLAI.BOOL" "SPEC_ALL" (first principles)))
             (binders (fst (native "HOLAI.BASICS" "strip_exists" (holai.fusion:concl inst)))))
        (when (>= (length binders) (length clauses)) (first principles))))))
(cl:defun introduce-functions (group body)
  (multiple-value-bind (clauses group-specs)
      (declaration-body body nil '(recursion termination measure obligation-proofs) t)
    (unless (>= (length clauses) 2) (reject group "DEFFUNCTIONS requires at least two clauses"))
    (let ((names (mapcar #'first clauses)))
      (require-variables names) (dolist (name names) (require-owner name))
      (when (member group names) (reject group "A function group needs a separate group name"))
      (cache-definition group (list 'deffunctions group-specs clauses)
        (lambda ()
         (block functions-plan
          (ensure-result-names group '(".definition" ".equations"))
          (dolist (name names) (ensure-result-names name '(".definition" ".equations")))
          (let* ((*constants* (copy-table *constants*)) (*strict-names* t) (*bindings* nil)
                 (*variable-names* nil) (*elaboration-active* t) (*type-parameters* nil)
                 (equations nil) (bodies nil) (signatures nil) (parameters nil) (declarations nil))
            (dolist (name names)
              (when (gethash name *constants*) (reject name "Function name occupied"))
              (setf (gethash name *constants*) (encoded-name name)))
            (dolist (clause clauses)
              (let ((args (second clause)))
                (require-variables args)
                (multiple-value-bind (rest specs)
                    (declaration-body (cddr clause) args '(type values type-variables ignorable) t)
                  (require-arity clause rest 1)
                  (push args parameters) (push specs declarations) (push (first rest) bodies)
                  (push (quantify-source args (remove-if-not (lambda (x) (eq (car x) 'type)) specs)
                           `(= (,(first clause) ,@args)
                              ,(if (assoc 'values specs) `(the ,(second (assoc 'values specs)) ,(first rest)) (first rest)))) equations))))
            (setf parameters (nreverse parameters) bodies (nreverse bodies)
                  declarations (nreverse declarations) equations (nreverse equations))
            (let* ((original (read-term (cons 'and equations) :expected-type 'bool))
                   (frees (holai.fusion:frees original))
                   (functions (mapcar (lambda (name)
                                       (or (find (encoded-name name) frees :key (lambda (v) (fst (holai.fusion:dest_var v))) :test #'equal)
                                           (reject name "Missing function in simultaneous equations"))) names)))
              (unless (= (length frees) (length names)) (reject group "Unbound term in simultaneous equations"))
              (require-visible-type-variables original (mapcar #'holai.fusion:type_of functions) group)
              (loop for function in functions for specs in declarations do
                (require-type-parameters specs function group))
              (when (and (assoc 'termination group-specs)
                         (not (equal (assoc 'termination group-specs) '(termination :auto))))
                (reject group-specs "Expected TERMINATION :AUTO"))
              (dolist (measure (cdr (assoc 'measure group-specs)))
                (unless (and (proper-list-p measure) (= (length measure) 2) (member (first measure) names))
                  (reject measure "A group MEASURE entry is (function-name measure-term)")))
              (when (> (count-if #'identity (list (assoc 'termination group-specs) (assoc 'measure group-specs))) 1)
                (reject group-specs "TERMINATION and MEASURE are exclusive"))
              (let ((principle (or (and (assoc 'recursion group-specs) (theorem (second (assoc 'recursion group-specs))))
                                   (unless (assoc 'measure group-specs) (infer-simultaneous-principle clauses)))))
               (when principle
                (when (cdr (assoc 'obligation-proofs group-specs)) (reject group-specs "The primitive principle leaves no labelled obligations"))
                (when (assoc 'measure group-specs) (reject group-specs "The primitive recursion principle already discharges ordering"))
                (let* ((pieces (mapcar #'primitive-function-equations names parameters declarations bodies))
                       (statement (read-term (cons 'and (apply #'append pieces)) :expected-type 'bool))
                       (proof (require-closed-theorem
                                (native "HOLAI.RECURSION" "prove_recursive_functions_exist" principle statement) group))
                       (binders (fst (native "HOLAI.BASICS" "strip_exists" (holai.fusion:concl proof))))
                       (result (kernel-definition-call group
                                 (lambda () (native "HOLAI.NUMS" "new_specification"
                                              (mapcar (lambda (v)
                                                (let ((name (find-if (lambda (n) (native-binder-name-p n (fst (holai.fusion:dest_var v)))) names)))
                                                  (unless name (reject group "Unrecognized recursive function binder")) (encoded-name name))) binders) proof)))))
                  (register-definition-results group (list (cons ".definition" result) (cons ".equations" result)))
                  (loop for name in names for equations in pieces do
                    (let ((th (reduce (lambda (a b) (native "HOLAI.BOOL" "CONJ" a b))
                                      (mapcar (lambda (equation) (match-labelled-result equation (native "HOLAI.BOOL" "CONJUNCTS" result))) equations))))
                      (register-definition-results name (list (cons ".definition" th) (cons ".equations" th)))))
                  (return-from functions-plan result))))
              (setf signatures (mapcar (lambda (f) (type-syntax (holai.fusion:type_of f))) functions))
              ;; One total function on a tagged sum, returning a product of result
              ;; types. Simultaneous existence follows by explicit projection witnesses.
              (let* ((h (gensym "SIMULTANEOUS")) (count (length names)) (combined nil)
                     (arg-types (mapcar (lambda (signature args)
                                          (loop with type = signature for a in args collect
                                            (progn (unless (eq (car type) '->) (reject a "Function arity mismatch"))
                                                   (prog1 (second type) (setf type (third type)))))) signatures parameters))
                     (result-types (mapcar (lambda (signature args)
                                             (loop with type = signature repeat (length args)
                                                   do (setf type (third type)) finally (return type))) signatures parameters))
                     (domain-types (mapcar (lambda (types) (if types (reduce (lambda (a b) `(prod ,a ,b)) types :from-end t) 'bool)) arg-types))
                     (domain (reduce (lambda (a b) `(sum-type ,a ,b)) domain-types :from-end t))
                     (range (reduce (lambda (a b) `(prod ,a ,b)) result-types :from-end t))
                     (witnesses nil))
                (labels ((call-term (index args)
                           (tuple-projection `(,h ,(sum-injection (tuple-syntax args) index count)) index count))
                         (replace-functions (term)
                           (cond ((and (symbolp term) (member term names))
                                  (let* ((i (position term names)) (args (nth i parameters)))
                                    (function-source args (loop for a in args for ty in (nth i arg-types) collect `(type ,ty ,a))
                                       (call-term i args))))
                                 ((consp term) (mapcar #'replace-functions term)) (t term))))
                  (loop for args in parameters for source in bodies for index from 0 do
                    (labels ((output (expression)
                               (if (and (consp expression) (eq (car expression) 'if))
                                   `(if ,(replace-functions (second expression))
                                        ,(output (third expression)) ,(output (fourth expression)))
                                   (tuple-syntax (loop for type in result-types for i from 0
                                      collect (if (= i index) (replace-functions expression) `(arbitrary ,type)))))))
                      (push (quantify-source args (loop for a in args for ty in (nth index arg-types) collect `(type ,ty ,a))
                               `(= (,h ,(sum-injection (tuple-syntax args) index count)) ,(output source))) combined))
                    (push (function-source args (loop for a in args for ty in (nth index arg-types) collect `(type ,ty ,a))
                             (call-term index args)) witnesses))
                  (let* ((*bindings* (list h)) (*annotations* (list (cons h `(-> ,domain ,range))))
                         (combined-term (read-term (cons 'and (nreverse combined)) :expected-type 'bool))
                         (combined-term (snd (holai.fusion:dest_eq (holai.fusion:concl
                           (native "HOLAI.EQUAL" "DEPTH_CONV" (native-function "HOLAI.EQUAL" "BETA_CONV") combined-term)))))
                         (hv (find (variable-name h) (holai.fusion:frees combined-term)
                                   :key (lambda (v) (fst (holai.fusion:dest_var v))) :test #'equal))
                         (existence (native "HOLAI.DEFINE"
                                      (if (assoc 'measure group-specs) "pure_prove_recursive_function_exists" "prove_general_recursive_function_exists")
                                      (native "HOLAI.BOOL" "mk_exists" (tuple hv combined-term))))
                         (witness-terms (mapcar #'read-term (nreverse witnesses)))
                         (target (native "HOLAI.BOOL" "list_mk_exists" (tuple functions original))))
                    (let ((given (append *definition-completion-proofs* (cdr (assoc 'obligation-proofs group-specs)))))
                      (loop for obligation in (holai.fusion:hyp existence) for index from 1
                            for label = (intern (format nil "OBLIGATION-~d" index) :keyword)
                            for proof = (assoc label given)
                            when proof do (setf existence (native "HOLAI.DRULE" "PROVE_HYP"
                                                            (proof-for obligation (second proof)) existence))))
                    (when (holai.fusion:hyp existence)
                     (handler-case
                      (let* ((m (gensym "MUTUAL-MEASURE"))
                             (measure-spec (cdr (assoc 'measure group-specs)))
                             (ranks (acyclic-call-ranks names bodies))
                             (measure-clauses
                               (loop for args in parameters for index from 0 for name in names collect
                                 (quantify-source args (loop for a in args for ty in (nth index arg-types) collect `(type ,ty ,a))
                                    `(= (,m ,(sum-injection (tuple-syntax args) index count))
                                       ,(or (second (assoc name measure-spec))
                                            (cdr (assoc name ranks))
                                            (let ((numeric (loop for arg in args for ty in (nth index arg-types)
                                                                 when (eq ty 'num) collect arg)))
                                              (reduce (lambda (a b) `(+ ,a ,b)) numeric :initial-value 0)))))))
                             (*bindings* (list m)) (*annotations* (list (cons m `(-> ,domain num))))
                             (measure-body (read-term (cons 'and measure-clauses) :expected-type 'bool))
                             (mv (find (variable-name m) (holai.fusion:frees measure-body)
                                       :key (lambda (v) (fst (holai.fusion:dest_var v))) :test #'equal))
                             (mex (native "HOLAI.DEFINE" "prove_general_recursive_function_exists"
                                    (native "HOLAI.BOOL" "mk_exists" (tuple mv measure-body))))
                             (mth (native "HOLAI.CLASS" "SELECT_RULE" (require-closed-theorem mex group)))
                             (measure-term (read-term `(choose (,m) (declare (type (-> ,domain num) ,m))
                                                        ,(cons 'and measure-clauses))))
                             (ordering (native "HOLAI.BASICS" "list_mk_icomb" "MEASURE" (list measure-term))))
                        (dolist (obligation (holai.fusion:hyp existence))
                          (let* ((proof (native "HOLAI.TACTICS" "prove"
                                          (tuple obligation
                                            (native "HOLAI.TACTICS" "THEN"
                                              (native "HOLAI.TACTICS" "EXISTS_TAC" ordering)
                                              (native "HOLAI.TACTICS" "THEN"
                                                (native "HOLAI.SIMP" "REWRITE_TAC"
                                                  (list holai.wf:WF_MEASURE holai.wf:MEASURE mth))
                                                holai.int:ASM_ARITH_TAC))))))
                            (setf existence (native "HOLAI.DRULE" "PROVE_HYP" proof existence)))))
                       ((or holai.runtime.core:failure dsl-proof-failure) () nil)))
                    (when (holai.fusion:hyp existence)
                      (let ((remaining (loop for proposition in (holai.fusion:hyp existence) for index from 1
                                             collect (list (intern (format nil "OBLIGATION-~d" index) :keyword)
                                                           :proposition proposition))))
                        (setf (gethash group *pending-definitions*)
                          (list :obligations remaining :complete
                            (lambda (proofs)
                              (let ((*definition-completion-proofs* proofs)) (introduce-functions group body)))))
                        (error 'dsl-obligation-error :form group :cause "Simultaneous existence has pending obligations")))
                    (require-closed-theorem existence group)
                    (let* ((tactic (native "HOLAI.TACTICS" "X_CHOOSE_THEN" hv (native-function "HOLAI.TACTICS" "ASSUME_TAC") existence))
                           (tactic (reduce (lambda (tac witness)
                                             (native "HOLAI.TACTICS" "THEN" tac (native "HOLAI.TACTICS" "EXISTS_TAC" witness)))
                                           witness-terms :initial-value tactic))
                           (tactic (native "HOLAI.TACTICS" "THEN" tactic
                                     (native "HOLAI.TACTICS" "THEN"
                                       (native "HOLAI.TACTICS" "CONV_TAC"
                                         (native "HOLAI.EQUAL" "DEPTH_CONV" (native-function "HOLAI.EQUAL" "BETA_CONV")))
                                       (native "HOLAI.TACTICS" "THEN"
                                         (native "HOLAI.TACTICS" "REPEAT"
                                           (native "HOLAI.TACTICS" "ORELSE" #'holai.tactics:CONJ_TAC #'holai.tactics:GEN_TAC))
                                         (lambda (g)
                                           (funcall (native "HOLAI.TACTICS" "THEN"
                                             (native "HOLAI.TACTICS" "CONV_TAC"
                                               (native "HOLAI.EQUAL" "LAND_CONV"
                                                 (native "HOLAI.SIMP" "ONCE_REWRITE_CONV" (mapcar #'snd (fst g)))))
                                             (native "HOLAI.SIMP" "REWRITE_TAC"
                                               (list holai.pair:FST holai.pair:SND
                                                 (projection-conditional 'first-component)
                                                 (projection-conditional 'second-component)))) g))))))
                           (proof (native "HOLAI.TACTICS" "prove" (tuple target tactic)))
                           (result (kernel-definition-call group
                                     (lambda () (native "HOLAI.NUMS" "new_specification" (mapcar #'encoded-name names) proof)))))
                      (register-definition-results group (list (cons ".definition" result) (cons ".equations" result)))
                      (loop for name in names for equation in equations do
                        (let ((rule (match-labelled-result equation (native "HOLAI.BOOL" "CONJUNCTS" result))))
                          (register-definition-results name (list (cons ".definition" rule) (cons ".equations" rule)))))
                      result)))))))))
      (dolist (name names) (setf (gethash name *constants*) (encoded-name name)))
      (theorem (result-name group ".equations")))))
(cl:defun native-binder-name-p (name text)
  (let ((prefix (encoded-name name)))
    (and (uiop:string-prefix-p prefix text)
         (every (lambda (c) (char= c #\')) (subseq text (length prefix))))))
(cl:defun relation-label-suffixes (label labels group)
  (append (unless (eq (car label) group)
            (list (concatenate 'string ".rules." (symbol-name (car label)) "." (symbol-name (cdr label)))))
          (when (= 1 (count (cdr label) labels :key #'cdr))
            (list (concatenate 'string ".rules." (symbol-name (cdr label)))))))
(cl:defun relation-component (theorem name inductionp)
  (let* ((vars (fst (native "HOLAI.BASICS" "strip_forall" (holai.fusion:concl theorem))))
         (instance (native "HOLAI.BOOL" "SPECL" vars theorem))
         (antecedent (and inductionp (fst (native "HOLAI.BASICS" "dest_imp" (holai.fusion:concl instance)))))
         (body (if antecedent (native "HOLAI.BOOL" "UNDISCH" instance) instance))
         (parts (native "HOLAI.BOOL" "CONJUNCTS" body))
         (component
           (find-if
             (lambda (th)
               (let* ((claim (snd (native "HOLAI.BASICS" "strip_forall" (holai.fusion:concl th))))
                      (relation (fst (if inductionp (native "HOLAI.BASICS" "dest_imp" claim)
                                         (holai.fusion:dest_eq claim))))
                      (head (fst (native "HOLAI.BASICS" "strip_comb" relation))))
                 (and (holai.fusion:is_const head) (equal (fst (holai.fusion:dest_const head)) (encoded-name name))))) parts)))
    (unless component (reject name "No derivable relation component"))
    (native "HOLAI.BOOL" "GENL" vars (if antecedent (native "HOLAI.BOOL" "DISCH" antecedent component) component))))
(cl:defun parameterize-relations (syntax names parameters)
  (cond ((and (consp syntax) (member (car syntax) names))
         (list* (car syntax) (append parameters (mapcar (lambda (x) (parameterize-relations x names parameters)) (cdr syntax)))))
        ((consp syntax) (mapcar (lambda (x) (parameterize-relations x names parameters)) syntax))
        (t syntax)))
(setf *relation-introducer*
 (lambda (group parameters body)
  (require-variables parameters)
  (multiple-value-bind (clauses group-specs)
      (declaration-body body parameters '(type type-variables monotonicity-proof strong-induction) t)
    (unless clauses (reject group "Expected relation clauses"))
    (let ((names (mapcar #'first clauses)))
      (require-variables names) (dolist (name names) (require-owner name))
      (when (and (cdr names) (member group names)) (reject group "A mutual relation group needs a separate group name"))
      (cache-definition group (list 'defrelations parameters group-specs clauses)
       (lambda ()
        (let* ((*constants* (copy-table *constants*)) (*bindings* parameters) (*strict-names* t)
               (*annotations* (annotation-bindings group-specs)) (*variable-names* nil)
               (*elaboration-active* t) (propositions nil) (labels nil) (mono nil)
               (strong (second (assoc 'strong-induction group-specs))))
          (when (assoc 'monotonicity-proof group-specs) (push (second (assoc 'monotonicity-proof group-specs)) mono))
          (dolist (name names)
            (when (gethash name *constants*) (reject name "Relation name occupied"))
            (setf (gethash name *constants*) (encoded-name name)))
          (dolist (clause clauses)
            (multiple-value-bind (rules specs)
                (declaration-body (cddr clause) (second clause) '(type type-variables monotonicity-proof strong-induction) t)
              (declare (ignore rules))
              (when (second (assoc 'strong-induction specs)) (setf strong t))
              (when (assoc 'monotonicity-proof specs) (push (second (assoc 'monotonicity-proof specs)) mono)))
            (multiple-value-bind (props rule-labels signature)
                (relation-clauses (first clause) (second clause) (cddr clause))
              (when signature
                (let ((parameter-types (mapcar (lambda (p) (or (cdr (assoc p *annotations*))
                                                                (reject p "Fixed relation parameters require a TYPE declaration"))) parameters)))
                  (push (cons (first clause) (cons '-> (append parameter-types (cdr signature)))) *annotations*)))
              (setf propositions (append propositions
                                   (mapcar (lambda (p) (parameterize-relations p names parameters)) props))
                    labels (append labels (mapcar (lambda (label) (cons (first clause) label)) rule-labels)))))
          (ensure-result-names group
            (append '(".rules" ".induction" ".cases") (when strong '(".strong-induction"))
                    (mapcan (lambda (label) (relation-label-suffixes label labels group)) labels)))
          (dolist (name names)
            (unless (eq name group)
              (ensure-result-names name
                (append '(".rules" ".induction" ".cases")
                        (loop for label in labels when (eq (car label) name)
                              collect (concatenate 'string ".rules." (symbol-name (cdr label))))))))
          (let* ((term (read-term (cons 'and propositions) :expected-type 'bool))
                 (existence (native "HOLAI.IND_DEFS" "prove_inductive_relations_exist" term)))
            (let ((remaining nil))
              (loop for hyp in (holai.fusion:hyp existence) for index from 1
                    for label = (intern (format nil "OBLIGATION-~d" index) :keyword) do
                (let* ((given (assoc label *definition-completion-proofs*))
                       (proof (if given (proof-for hyp (second given))
                                  (loop for candidate in mono
                                        for th = (handler-case (proof-for hyp candidate)
                                                   ((or holai.runtime.core:failure dsl-proof-failure) () nil))
                                        when th return th))))
                  (if proof (setf existence (native "HOLAI.DRULE" "PROVE_HYP" proof existence))
                      (push (list label :proposition hyp) remaining))))
              (when remaining
                (setf (gethash group *pending-definitions*)
                  (list :obligations (nreverse remaining) :complete
                    (lambda (proofs)
                      (let ((*definition-completion-proofs* proofs))
                        (funcall *relation-introducer* group parameters body)))))
                (error 'dsl-obligation-error :form group :cause "Unproved monotonicity obligations")))
            (require-closed-theorem existence group)
            (let* ((binders (fst (native "HOLAI.BASICS" "strip_exists" (holai.fusion:concl existence))))
                   (native-names (mapcar (lambda (v)
                                          (let* ((text (fst (holai.fusion:dest_var v)))
                                                 (name (find-if (lambda (n) (native-binder-name-p n text)) names)))
                                            (unless name (reject group "Cannot identify an existential relation binder"))
                                            (encoded-name name))) binders)))
              (unless (= (length native-names) (length names)) (reject group "Relation binder count differs"))
              (let* ((result (kernel-definition-call group
                               (lambda () (native "HOLAI.NUMS" "new_specification" native-names existence))))
                     (vars (fst (native "HOLAI.BASICS" "strip_forall" (holai.fusion:concl result))))
                     (inst (native "HOLAI.BOOL" "SPECL" vars result))
                     (rules (native "HOLAI.BOOL" "GENL" vars (native "HOLAI.BOOL" "CONJUNCT1" inst)))
                     (rest (native "HOLAI.BOOL" "CONJUNCT2" inst))
                     (induction (native "HOLAI.BOOL" "GENL" vars (native "HOLAI.BOOL" "CONJUNCT1" rest)))
                     (cases (native "HOLAI.BOOL" "GENL" vars (native "HOLAI.BOOL" "CONJUNCT2" rest)))
                     (entries (list (cons ".rules" rules) (cons ".induction" induction) (cons ".cases" cases))))
                (dolist (name names) (setf (gethash name *constants*) (encoded-name name)))
                (when strong (push (cons ".strong-induction"
                                    (native "HOLAI.IND_DEFS" "derive_strong_induction" (tuple rules induction))) entries))
                (let ((label-results nil))
                  (loop for label in labels for prop in propositions do
                    (let* ((expected (read-term (close-parameters parameters prop) :expected-type 'bool))
                           (th (native "HOLAI.TACTICS" "prove"
                                 (tuple expected (native "HOLAI.MESON" "MESON_TAC" (list rules))))))
                      (push (cons label th) label-results)
                      (dolist (suffix (relation-label-suffixes label labels group)) (push (cons suffix th) entries))))
                  (register-definition-results group entries)
                  (dolist (name names)
                    (unless (eq name group)
                      (let* ((own (remove-if-not (lambda (entry) (eq (caar entry) name)) (reverse label-results)))
                             (own-rules (reduce (lambda (a b) (native "HOLAI.BOOL" "CONJ" a b)) (mapcar #'cdr own)))
                             (own-cases (relation-component cases name nil))
                             (own-induction (relation-component induction name t)))
                        (register-definition-results name
                          (append (list (cons ".rules" own-rules) (cons ".cases" own-cases) (cons ".induction" own-induction))
                            (mapcar (lambda (entry)
                                      (cons (concatenate 'string ".rules." (symbol-name (cdar entry))) (cdr entry))) own)))))))
                (tuple rules induction cases)))))))
      (dolist (name names) (setf (gethash name *constants*) (encoded-name name)))
      (theorem (result-name group ".rules"))))))
(defmacro definductive-set (name parameters &body body &environment environment)
  (declaration-expansion `(introduce-relations ',name nil
    ',(list (list* name parameters (expand-relation-body body environment))))))
