(uiop:define-package :holai.runtime.pattern
  (:use :cl)
  (:import-from :holai.runtime.data
    :tuple :tuple-value :tuple-items :ref-contents :ref-cell :deref :match-failure)
  (:import-from :holai.runtime.pattern-registry
    :*pattern-descriptions* :check-pattern-signature)
  (:export :character-code :guard :match))
(in-package :holai.runtime.pattern)

;; All descriptors and IR nodes below belong to the compilation environment.
(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun wildcard-pattern-p (x)
    (and (symbolp x) (string= (symbol-name x) "_")))
  (defun parse-pattern (p)
    (cond ((wildcard-pattern-p p) '(:wildcard))
          ((or (null p) (eq p t) (numberp p) (stringp p) (characterp p))
           (list :literal p))
          ((symbolp p) (when (or (keywordp p) (constantp p))
                         (error "Invalid pattern binding ~s" p))
           (list :bind p))
          ((not (and (consp p) (listp (cdr p)))) (error "Invalid pattern ~s" p))
          (t
           (let ((head (car p)) (args (cdr p)))
             (cond
               ((member head '(cl:and cl:or tuple cl:vector))
                (list (cond ((eq head 'cl:and) :and) ((eq head 'cl:or) :or)
                            ((eq head 'tuple) :tuple) (t :vector))
                      (mapcar #'parse-pattern args)))
               ((eq head 'cl:cons)
                (unless (cl:= (length args) 2) (error "CONS pattern arity"))
                (list :cons (mapcar #'parse-pattern args)))
               ((eq head 'ref-contents)
                (unless (cl:= (length args) 1) (error "Ref pattern arity"))
                (list :ref (parse-pattern (car args))))
               ((eq head 'cl:type)
                (unless (cl:= (length args) 1) (error "TYPE pattern arity"))
                (list :type (car args)))
               ((eq head 'character-code)
                (unless (and (cl:= (length args) 1) (typep (car args) '(integer 0 255)))
                  (error "Invalid character code pattern"))
                (list :literal (code-char (car args))))
               ((eq head 'guard)
                (unless (cl:= (length args) 2) (error "GUARD pattern arity"))
                (list :guard (parse-pattern (car args)) (second args)))
               (t
                (let* ((desc (or (gethash head *pattern-descriptions*)
                                 (error "Unknown pattern constructor ~s" head)))
                       (keys (getf desc :keys)) (arity (getf desc :arity)))
                  (if (getf desc :record)
                      (let ((seen nil) (patterns nil) (indexes nil))
                        (unless (evenp (length args)) (error "Odd record pattern fields"))
                        (loop for (key value) on args by #'cddr
                              for index = (position key keys :test #'eq)
                              do (unless index (error "Unknown record key ~s in ~s" key head))
                                 (when (member key seen) (error "Repeated record key ~s" key))
                                 (push key seen) (push index indexes)
                                 (push (parse-pattern value) patterns))
                        (list :constructor head desc (nreverse patterns) (nreverse indexes)))
                      (progn
                        (when (and (cl:> arity 1) (cl:= (length args) 1)
                                   (wildcard-pattern-p (car args)))
                          (setf args (make-list arity :initial-element '_)))
                        (unless (cl:= (length args) arity)
                          (error "Wrong constructor pattern arity: ~s" p))
                        (list :constructor head desc (mapcar #'parse-pattern args)
                              (loop for i below arity collect i)))))))))))
  (defun pattern-bindings (ir)
    (labels ((merge-bindings (patterns)
               (let ((result nil))
                 (dolist (p patterns result)
                   (dolist (name (pattern-bindings p))
                     (when (member name result) (error "Repeated pattern binding ~s" name))
                     (push name result))))))
      (case (car ir)
        (:bind (list (second ir)))
        ((:and :cons :tuple :vector) (merge-bindings (second ir)))
        (:constructor (merge-bindings (fourth ir)))
        (:ref (pattern-bindings (second ir)))
        (:guard (pattern-bindings (second ir)))
        (:or
         (let* ((arms (second ir)) (names (when arms (pattern-bindings (car arms)))))
           (dolist (arm (cdr arms))
             (let ((other (pattern-bindings arm)))
               (unless (and (subsetp names other) (subsetp other names))
                 (error "OR pattern has unequal binding sets"))))
           names))
        (otherwise nil))))
  (defun pattern-let (env form)
    `(let ,(mapcar (lambda (pair) (list (car pair) (cdr pair))) env)
       (declare (ignorable ,@(mapcar #'car env))) ,form))
  (defun compile-patterns (patterns values env success failure)
    (if (null patterns) (cl:funcall success env)
        (compile-pattern (car patterns) (car values) env
                         (lambda (next) (compile-patterns (cdr patterns) (cdr values)
                                                        next success failure)) failure)))
  (defun compile-pattern (ir value env success failure)
    (case (car ir)
      (:wildcard (cl:funcall success env))
      (:bind (cl:funcall success (acons (second ir) value env)))
      (:literal
       (let* ((literal (second ir))
              (test (cond ((stringp literal) `(and (stringp ,value) (string= ,value ,literal)))
                          ((characterp literal) `(and (characterp ,value) (char= ,value ,literal)))
                          ((or (null literal) (eq literal t)) `(eq ,value ',literal))
                          (t `(eql ,value ',literal)))))
         `(if ,test ,(cl:funcall success env) ,failure)))
      (:type `(if (typep ,value ',(second ir)) ,(cl:funcall success env) ,failure))
      (:and (compile-patterns (second ir) (make-list (length (second ir)) :initial-element value)
                             env success failure))
      (:guard
       (compile-pattern (second ir) value env
                        (lambda (bound)
                          `(if ,(pattern-let bound (third ir))
                               ,(cl:funcall success bound) ,failure)) failure))
      (:or
       (let* ((names (pattern-bindings ir)) (join (gensym "MATCHED"))
              (params (mapcar (lambda (x) (declare (ignore x)) (gensym "BOUND")) names))
              (joined-env (append (pairlis names params) env)))
         (labels ((arms (rest)
                    (if (null rest) failure
                        (compile-pattern (car rest) value env
                                         (lambda (bound) `(,join ,@(mapcar (lambda (name) (cdr (assoc name bound))) names)))
                                         (arms (cdr rest))))))
           `(flet ((,join ,params (declare (ignorable ,@params)) ,(cl:funcall success joined-env)))
              ,(arms (second ir))))))
      (:cons
       (let ((head (gensym "HEAD")) (tail (gensym "TAIL")))
         `(if (consp ,value)
              (let ,(loop for p in (second ir) for v in (list head tail)
                           for access in '(car cdr)
                           unless (eq (car p) :wildcard) collect `(,v (,access ,value)))
                ,(compile-patterns (second ir) (list head tail) env success failure))
              ,failure)))
      (:ref
       (let ((contents (gensym "CONTENTS")))
         `(if (typep ,value 'ref-cell)
              ,(if (eq (car (second ir)) :wildcard) (cl:funcall success env)
                   `(let ((,contents (deref ,value)))
                      ,(compile-pattern (second ir) contents env success failure))) ,failure)))
      ((:tuple :vector)
       (let* ((patterns (second ir)) (items (gensym "ITEMS"))
              (vars (mapcar (lambda (p) (declare (ignore p)) (gensym "ITEM")) patterns))
              (tuple-p (eq (car ir) :tuple)))
         `(if ,(if tuple-p `(typep ,value 'tuple-value) `(vectorp ,value))
              (let ((,items ,(if tuple-p `(tuple-items ,value) value)))
                (if (cl:= (length ,items) ,(length patterns))
                    ,(if tuple-p
                         (if (every (lambda (p) (eq (car p) :wildcard)) patterns)
                             (cl:funcall success env)
                             `(destructuring-bind ,vars ,items
                                (declare (ignorable ,@vars))
                                ,(compile-patterns patterns vars env success failure)))
                         `(let ,(loop for v in vars for p in patterns for i from 0
                                      unless (eq (car p) :wildcard) collect `(,v (aref ,items ,i)))
                            ,(compile-patterns patterns vars env success failure)))
                    ,failure)) ,failure)))
      (:constructor
       (let* ((name (second ir)) (desc (third ir)) (patterns (fourth ir))
              (indexes (fifth ir)) (fields (gensym "FIELDS"))
              (vars (mapcar (lambda (p) (declare (ignore p)) (gensym "FIELD")) patterns))
              (accessor (getf desc :accessor)) (readers (getf desc :readers))
              (active (loop for p in patterns for v in vars for i in indexes
                            unless (eq (car p) :wildcard) collect (cons v i))))
         `(if (cl:and (load-time-value (check-pattern-signature ',name ',desc) t)
                      (typep ,value ',(getf desc :class)))
                ,(cond ((null active) (compile-patterns patterns vars env success failure))
                       (accessor `(let ((,fields (,accessor ,value)))
                        (let ,(mapcar (lambda (pair) `(,(car pair) (aref ,fields ,(cdr pair)))) active)
                          ,(compile-patterns patterns vars env success failure))))
                       (t `(let ,(mapcar (lambda (pair) `(,(car pair) (,(nth (cdr pair) readers) ,value))) active)
                             ,(compile-patterns patterns vars env success failure))))
                ,failure)))
      (otherwise (error "Invalid pattern IR ~s" ir))))
  (defun compile-clauses (value clauses result)
    (loop for clause in clauses collect
          (progn
            (unless (consp clause) (error "Invalid MATCH clause ~s" clause))
            (let* ((ir (parse-pattern (car clause))) (next (gensym "NEXT-CLAUSE")))
              (pattern-bindings ir)
              `(block ,next
                 ,(compile-pattern ir value nil
                                   (lambda (env) `(return-from ,result
                                                    ,(pattern-let env `(progn ,@(cdr clause)))))
                                   `(return-from ,next nil))))))))

(defmacro match (value &body clauses)
  (let ((saved (gensym "VALUE")) (result (gensym "MATCH")))
    `(let ((,saved ,value))
       (declare (ignorable ,saved))
       (block ,result
         ,@(compile-clauses saved clauses result)
         (match-failure)))))
