      (parse_term
        "!(f:A->B) A s.
        (!x y. x IN s /\\ y IN s /\\ f(x) = f(y) ==> x = y) /\\
        FINITE A
        ==> FINITE {x | x IN s /\\ f(x) IN A}")
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
