                  (FIRST_X_ASSUM
                    (o
                      #'MP_TAC
                      (GEN_REWRITE_RULE #'I (cl:cons INJECTIVE_ON_LEFT_INVERSE nil)))))
                (DISCH_THEN (funcall X_CHOOSE_TAC (parse_term "g:B->A"))))
              (MATCH_MP_TAC FINITE_SUBSET))
            (funcall EXISTS_TAC (parse_term "IMAGE (g:B->A) A")))
          (funcall ASM_SIMP_TAC (cl:cons FINITE_IMAGE nil)))
        (ASM SET_TAC nil)))))

