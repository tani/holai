                  (cl:cons
                    (parse_term "\\x:A. t:B->bool")
                    (cl:cons (parse_term "CARD(t:B->bool)") nil))))
              HAS_SIZE_PRODUCT_DEPENDENT)))
        (funcall ASM_SIMP_TAC (cl:cons HAS_SIZE nil))))))

