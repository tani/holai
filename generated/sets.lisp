      (funcall
        THENL
        (funcall
          THEN
          (REPEAT #'STRIP_TAC)
          (SUBGOAL_THEN
            (parse_term
              "{x | x IN s /\\ (f:A->B)(x) IN t} =
    UNIONS (IMAGE (\\a. {x | x IN s /\\ f x = a}) t)")
            #'SUBST1_TAC))
        (cl:cons
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (GEN_REWRITE_TAC #'I (cl:cons EXTENSION nil))
                (REWRITE_TAC (cl:cons IN_ELIM_THM (cl:cons IN_UNIONS nil))))
              (REWRITE_TAC (cl:cons EXISTS_IN_IMAGE nil)))
            (funcall SET_TAC nil))
          (cl:cons
            (funcall
              ASM_SIMP_TAC
              (cl:cons
                FINITE_FINITE_UNIONS
                (cl:cons FINITE_IMAGE (cl:cons FORALL_IN_IMAGE nil))))
            nil))))))

