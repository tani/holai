          (DISCH_THEN (lambdac (th) (ONCE_REWRITE_TAC (cl:cons (funcall GSYM th) nil)))))
        (MESON_TAC nil)))))

(defparameter SURJECTIVE_EXISTS_THM
  (prove
    (tuple
      (parse_term "!f:A->B. (!y. ?x. f x = y) <=> (!P. (?x. P(f x)) <=> (?y. P y))")
