(defparameter FINITE_IMAGE_EXPAND
  (prove
    (tuple
      (parse_term "!(f:A->B) s. FINITE s ==> FINITE {y | ?x. x IN s /\\ (y = f x)}")
      (funcall
        THENL
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall THEN #'GEN_TAC (MATCH_MP_TAC FINITE_INDUCT))
