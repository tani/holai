            (REWRITE_TAC (cl:cons UNION_EMPTY nil)))
          (SUBGOAL_THEN
            (parse_term "!x s t. (x:A INSERT s) UNION t = x INSERT (s UNION t)")
            (lambdac (th) (REWRITE_TAC (cl:cons th nil)))))
        (cl:cons
          (funcall SET_TAC nil)
          (cl:cons (MESON_TAC (cl:cons FINITE_RULES nil)) nil))))))

(defparameter FINITE_UNION
