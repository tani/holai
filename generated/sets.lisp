(defparameter FINITE_EMPTY
  (prove
    (tuple (parse_term "FINITE ({}:A->bool)") (REWRITE_TAC (cl:cons FINITE_RULES nil)))))

(defparameter FINITE_SUBSET
  (prove
    (tuple
      (parse_term "!(s:A->bool) t. FINITE t /\\ s SUBSET t ==> FINITE s")
      (funcall
        THENL
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (funcall
                  THEN
                  (funcall
                    THEN
                    (funcall
                      THENL
                      (funcall
                        THEN
                        (funcall
                          THEN
                          (funcall
                            THEN
                            (funcall
                              THEN
                              (ONCE_REWRITE_TAC (cl:cons SWAP_FORALL_THM nil))
                              (REWRITE_TAC (cl:cons IMP_CONJ nil)))
                            (REWRITE_TAC (cl:cons RIGHT_FORALL_IMP_THM nil)))
                          (MATCH_MP_TAC FINITE_INDUCT))
                        #'CONJ_TAC)
                      (cl:cons
                        (MESON_TAC (cl:cons SUBSET_EMPTY (cl:cons FINITE_RULES nil)))
                        (cl:cons #'ALL_TAC nil)))
                    (funcall X_GEN_TAC (parse_term "x:A")))
                  (funcall X_GEN_TAC (parse_term "u:A->bool")))
                DISCH_TAC)
              (funcall X_GEN_TAC (parse_term "t:A->bool")))
            DISCH_TAC)
          (SUBGOAL_THEN (parse_term "FINITE((x:A) INSERT (t DELETE x))") ASSUME_TAC))
        (cl:cons
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (MATCH_MP_TAC (funcall CONJUNCT2 FINITE_RULES))
                (FIRST_ASSUM #'MATCH_MP_TAC))
              (UNDISCH_TAC (parse_term "t SUBSET (x:A INSERT u)")))
            (funcall SET_TAC nil))
          (cl:cons
            (funcall
              THENL
              (ASM_CASES_TAC (parse_term "x:A IN t"))
              (cl:cons
                (funcall
                  THENL
                  (SUBGOAL_THEN
                    (parse_term "x:A INSERT (t DELETE x) = t")
                    #'SUBST_ALL_TAC)
                  (cl:cons
                    (funcall
                      THEN
                      (UNDISCH_TAC (parse_term "x:A IN t"))
                      (funcall SET_TAC nil))
                    (cl:cons (funcall ASM_REWRITE_TAC nil) nil)))
                (cl:cons
                  (funcall
                    THEN
                    (funcall
                      THEN
                      (funcall
                        THEN
                        (FIRST_ASSUM #'MATCH_MP_TAC)
                        (UNDISCH_TAC (parse_term "t SUBSET x:A INSERT u")))
                      (UNDISCH_TAC (parse_term "~(x:A IN t)")))
                    (funcall SET_TAC nil))
                  nil)))
            nil))))))

(defparameter FINITE_RESTRICT
  (prove
