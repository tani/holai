;; (* ------------------------------------------------------------------------- *)
;; (* Tactic to automate some routine set theory by reduction to FOL.           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter SET_TAC
  (let
    ((PRESET_CONV
      (THENC
        (THENC
          (REWRITE_CONV
            (cl:cons
              INTERS_IMAGE
              (cl:cons INTERS_GSPEC (cl:cons UNIONS_IMAGE (cl:cons UNIONS_GSPEC nil)))))
          (REWRITE_CONV
            (cl:cons
              EXTENSION
              (cl:cons
                SUBSET
                (cl:cons
                  PSUBSET
                  (cl:cons
                    DISJOINT
                    (cl:cons SING (cl:cons BIJ (cl:cons INJ (cl:cons SURJ nil))))))))))
        (REWRITE_CONV
          (cl:cons
            NOT_IN_EMPTY
            (cl:cons
              IN_UNIV
              (cl:cons
                IN_UNION
                (cl:cons
                  IN_INTER
                  (cl:cons
                    IN_DIFF
                    (cl:cons
                      IN_INSERT
                      (cl:cons
                        IN_DELETE
                        (cl:cons
                          IN_REST
                          (cl:cons
                            IN_INTERS
                            (cl:cons
                              IN_UNIONS
                              (cl:cons IN_IMAGE (cl:cons IN_ELIM_THM (cl:cons IN nil)))))))))))))))))
    (lambdac (ths)
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (funcall THEN (MAP_EVERY #'MP_TAC ths) (POP_ASSUM_LIST (K #'ALL_TAC)))
                (REPEAT (funcall THEN COND_CASES_TAC (POP_ASSUM #'MP_TAC))))
              (funcall CONV_TAC PRESET_CONV))
            (MAP_EVERY
              #'MP_TAC
              (filter (lambdac (th) (= (CONV_RULE PRESET_CONV th) TRUTH)) ths)))
          (REWRITE_TAC (cl:cons IN nil)))
        (MESON_TAC nil)))))

(defunc SET_RULE (tm) (prove (tuple tm (funcall SET_TAC nil))))

