                (funcall
                  THEN
                  (funcall THEN (funcall THEN (REPEAT #'GEN_TAC) #'EQ_TAC) DISCH_TAC)
                  (funcall ASM_REWRITE_TAC nil))
                (POP_ASSUM (o #'MP_TAC (REWRITE_RULE (cl:cons NUMSUM nil)))))
              (DISCH_THEN
                (lambdac (th)
                  (funcall THEN (MP_TAC th) (MP_TAC (AP_TERM (parse_term "EVEN") th))))))
            (REPEAT COND_CASES_TAC))
          (REWRITE_TAC (cl:cons EVEN (cl:cons EVEN_DOUBLE nil))))
