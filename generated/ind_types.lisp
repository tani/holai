(defparameter NUMSUM_INJ
  (prove
    (tuple
      (parse_term
        "!b1 x1 b2 x2. (NUMSUM b1 x1 = NUMSUM b2 x2) <=> (b1 = b2) /\\ (x1 = x2)")
      (funcall
