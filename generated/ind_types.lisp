(defparameter INJ_INVERSE2
  (prove
    (tuple
      (parse_term
        "!P:A->B->C.
    (!x1 y1 x2 y2. (P x1 y1 = P x2 y2) <=> (x1 = x2) /\\ (y1 = y2))
    ==> ?X Y. !x y. (X(P x y) = x) /\\ (Y(P x y) = y)")
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (funcall
                  THEN
                  (funcall
                    THEN
                    (funcall
                      THEN
                      (funcall
                        THEN
                        (funcall
                          THEN
                          (funcall
                            THEN
                            (funcall
                              THEN
                              (funcall
                                THEN
                                (funcall THEN #'GEN_TAC DISCH_TAC)
                                (funcall
                                  EXISTS_TAC
                                  (parse_term "\\z:C. @x:A. ?y:B. P x y = z")))
                              (funcall
                                EXISTS_TAC
                                (parse_term "\\z:C. @y:B. ?x:A. P x y = z")))
                            (REPEAT #'GEN_TAC))
                          (funcall ASM_REWRITE_TAC (cl:cons BETA_THM nil)))
                        #'CONJ_TAC)
                      (MATCH_MP_TAC SELECT_UNIQUE))
                    #'GEN_TAC)
                  BETA_TAC)
                #'EQ_TAC)
              #'STRIP_TAC)
            (funcall ASM_REWRITE_TAC nil))
          (W
            (o
              (o (o (o EXISTS_TAC #'rand) (function-value #'snd 1)) dest_exists)
              (function-value #'snd 1))))
        #'REFL_TAC))))

;; (* ------------------------------------------------------------------------- *)
;; (* Define an injective pairing function on ":num".                           *)
;; (* ------------------------------------------------------------------------- *)


(defparameter NUMPAIR
  (funcall new_definition (parse_term "NUMPAIR x y = (2 EXP x) * (2 * y + 1)")))

(defparameter NUMPAIR_INJ_LEMMA
  (prove
    (tuple
      (parse_term "!x1 y1 x2 y2. (NUMPAIR x1 y1 = NUMPAIR x2 y2) ==> (x1 = x2)")
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (REWRITE_TAC (cl:cons NUMPAIR nil))
              (REPEAT (funcall THEN INDUCT_TAC #'GEN_TAC)))
            (funcall
              ASM_REWRITE_TAC
              (cl:cons
                EXP
                (cl:cons
                  (funcall GSYM MULT_ASSOC)
                  (cl:cons
                    ARITH
                    (cl:cons
                      EQ_MULT_LCANCEL
                      (cl:cons
                        NOT_SUC
                        (cl:cons (funcall GSYM NOT_SUC) (cl:cons SUC_INJ nil)))))))))
          (DISCH_THEN (o #'MP_TAC (AP_TERM (parse_term "EVEN")))))
        (REWRITE_TAC (cl:cons EVEN_MULT (cl:cons EVEN_ADD (cl:cons ARITH nil))))))))

(defparameter NUMPAIR_INJ
  (prove
    (tuple
      (parse_term
        "!x1 y1 x2 y2. (NUMPAIR x1 y1 = NUMPAIR x2 y2) <=> (x1 = x2) /\\ (y1 = y2)")
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (funcall THEN (funcall THEN (REPEAT #'GEN_TAC) #'EQ_TAC) DISCH_TAC)
                (funcall ASM_REWRITE_TAC nil))
              (FIRST_ASSUM (o #'SUBST_ALL_TAC (MATCH_MP NUMPAIR_INJ_LEMMA))))
            (POP_ASSUM #'MP_TAC))
          (REWRITE_TAC (cl:cons NUMPAIR nil)))
        (REWRITE_TAC
          (cl:cons
            EQ_MULT_LCANCEL
            (cl:cons EQ_ADD_RCANCEL (cl:cons EXP_EQ_0 (cl:cons ARITH nil)))))))))

(defparameter NUMPAIR_DEST
  (funcall
    new_specification
    (cl:cons "NUMFST" (cl:cons "NUMSND" nil))
    (MATCH_MP INJ_INVERSE2 NUMPAIR_INJ)))

