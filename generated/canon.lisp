      ((distribute
        (tm)
        (match tm
          ((Comb (Comb (Const "/\\" _) a%) (Comb (Comb (Const "\\/" _) b%) c%))
            (let
              ((th
                (INST%
                  (cl:cons
                    (tuple a% a_tm)
                    (cl:cons (tuple b% b_tm) (cl:cons (tuple c% c_tm) nil)))
                  pth1)))
              (cl:declare (cl:ignorable th))
              (TRANS th (BINOP_CONV #'distribute (rand (concl th))))))
          ((Comb (Comb (Const "/\\" _) (Comb (Comb (Const "\\/" _) a%) b%)) c%)
            (let
              ((th
