    (funcall reset_consts unit)
    (ORELSE
      (FIRST_ASSUM CONTR_TAC)
      (W
        (o
          (o
            (o ACCEPT_TAC (SIMPLE_MESON_REFUTE min~local~3776 max~local~3778 inc))
            (map (function-value #'snd 1)))
          (function-value #'fst 1)))
      gl)))

