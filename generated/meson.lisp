(defparameter clear_contrapos_cache nil)

(defparameter make_hol_contrapos nil)

(match
  (let
    ((DISJ_AC (AC DISJ_ACI))
      (imp_CONV (funcall REWR_CONV (funcall TAUT (parse_term "a \\/ b <=> ~b ==> a"))))
      (push_CONV
        (GEN_REWRITE_CONV
          TOP_SWEEP_CONV
          (cl:cons
            (funcall TAUT (parse_term "~(a \\/ b) <=> ~a /\\ ~b"))
            (cl:cons (funcall TAUT (parse_term "~(~a) <=> a")) nil))))
      (pull_CONV
        (GEN_REWRITE_CONV
          DEPTH_CONV
          (cl:cons (funcall TAUT (parse_term "~a \\/ ~b <=> ~(a /\\ b)")) nil)))
      (imf_CONV (funcall REWR_CONV (funcall TAUT (parse_term "~p <=> p ==> F")))))
    (let ((memory (ref nil)))
      (fletc
        ((clear_contrapos_cache~local~2350
          (arg~2352)
          (match arg~2352 ((cl:type hol2cl.runtime::unit-value) (assign memory nil)))))
        (fletc
          ((make_hol_contrapos~local~2358
            (arg~2360)
            (match arg~2360
              ((tuple n th)
                (let* ((tm (concl th)) (key (tuple n tm)))
                  (handler-case
                    (assoc key (deref memory))
                    (hol2cl.runtime:ocaml-condition
                      (exception~2371)
                      (match exception~2371
                        ((Failure _)
                          (if (< n 0)
                            (CONV_RULE (THENC pull_CONV imf_CONV) th)
                            (let*
                              ((djs (funcall disjuncts tm))
                                (acth
                                  (if (= n 0)
                                    th
                                    (match (chop_list n djs)
                                      ((tuple ldjs rdjs)
                                        (let
                                          ((ndjs
                                            (cl:cons (hd rdjs) (append ldjs (tl rdjs)))))
                                          (EQ_MP
                                            (funcall
                                              DISJ_AC
                                              (funcall
                                                mk_eq
                                                (tuple tm (funcall list_mk_disj ndjs))))
                                            th))))))
                                (fth
                                  (if (= (funcall length djs) 1)
                                    acth
                                    (CONV_RULE (THENC imp_CONV push_CONV) acth))))
                              (progn
                                (assign memory (cl:cons (tuple key fth) (deref memory)))
                                fth))))
                        (_ (raise exception~2371))))))))))
          (tuple #'clear_contrapos_cache~local~2350 #'make_hol_contrapos~local~2358)))))
  ((tuple clear_contrapos_cache~local~2307 make_hol_contrapos~local~2309)
    (setf
      clear_contrapos_cache
      clear_contrapos_cache~local~2307
      make_hol_contrapos
      make_hol_contrapos~local~2309)))

