          (basic_rws
            (list-filter (lambdac (th) (not (mem th lhs_lambda_rules))) basic_rws0))
          (cs (funcall new_compset (list-map lazyfy_thm basic_rws))))
        (progn
          (list-iter
            (lambdac (arg~2747)
              (match arg~2747
                ((tuple _ (tuple pat the_conv))
                  (match (funcall strip_comb pat)
                    ((tuple cst~local~2752 args)
                      (add_conv (tuple cst~local~2752 (funcall length args) the_conv) cs))))))
            (funcall basic_convs unit))
          (add_conv (tuple (parse_term "LET:(A->B)->A->B") 2 let_CONV) cs)
          (set_skip cs (parse_term "COND: bool -> A -> A -> A") (make-None))
          cs)))))

(defparameter the_compset (bool_compset unit))

(defparameter add_funs (C #'add_thms the_compset))

(defparameter add_convs
  (partial (function-value #'list-iter 2) (C #'add_conv the_compset)))

(defparameter del_consts
  (partial (function-value #'list-iter 2) (scrub_const the_compset)))

(defparameter del_funs (C #'scrub_thms the_compset))

(defparameter EVAL_CONV (CBV_CONV the_compset))

(defparameter EVAL_RULE (CONV_RULE EVAL_CONV))

(defparameter EVAL_TAC (funcall CONV_TAC EVAL_CONV))

(defunc same_const (c1 c2) (= (fst (dest_const c1)) (fst (dest_const c2))))

(defunc OR (arg~2845)
  (match arg~2845
    (nil (K cl:nil))
    ((cl:cons x nil) (same_const x))
    ((cl:cons h |t|) (lambdac (x) (cl:or (same_const h x) (OR |t| x))))))

(defunc RESTR_EVAL_CONV (clist)
  (with_flag (tuple stoppers (make-Some (OR clist))) EVAL_CONV))

(defparameter RESTR_EVAL_TAC (o CONV_TAC #'RESTR_EVAL_CONV))

(defparameter RESTR_EVAL_RULE (o #'CONV_RULE #'RESTR_EVAL_CONV))

