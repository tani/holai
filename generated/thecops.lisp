                        (assert-true (list-mem (concl th) (hyp bot)) "thecops.ml" 1389 10)
                        (funcall MP (funcall DISCH (concl th) bot) th)))))))
            (_ (failwith "bot_of_proof: not a well-formed proof"))))))
    (_ (failwith "bot_of_proof: not a well-formed proof"))))

