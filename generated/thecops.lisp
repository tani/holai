(defunc start (mat opt lim)
  (progn
    (if (deref copverb) (funcall (format-printf "Start %d
%!") (+ lim 1)) unit)
    (let*
      ((mati (copy_matrix 0 mat))
        (sub0 (empty 1000000))
        (hashek (fol_of_literal nil nil hashek_tm)))
      (>>=
        (|\|>|
          (|\|>|
            (of_list mati)
            (filter_map
              (lambdac (arg~6913)
                (match arg~6913
                  ((trivia:guard
                    (tuple
                      (cl:and idx (tuple (tuple i~local~6916 _) v))
                      (cl:and cla (cl:cons (|Lit| lit) nil)))
                    (= lit hashek))
                    (>>=
                      (|\|>|
                        (prove_clause
                          opt
                          (tuple sub0 0)
                          (tuple mati nil (cl:cons (tuple i~local~6916 0) nil) nil lim)
                          cla)
                        #'next_opt)
                      (lambdac (arg~6956)
                        (match arg~6956
                          ((tuple sub prfs)
                            (make-Some (tuple sub (make-Decomposition cla idx prfs))))))))
                  (_ (make-None))))))
          #'next_opt)
        (lambdac (arg~6979)
          (match arg~6979
            ((tuple sub prf)
              (make-Some
                (tuple (fst sub) (tuple (|MAKE-Mat| (tuple (tuple (- 1) 0) mati)) prf))))))))))

(defunc fol_of_thm (th)
  (let* ((lconsts (freesl (hyp th))) (tm (concl th)))
    (progn
      (assert-true
        (list-for-all (lambdac (x) (list-mem x lconsts)) (frees tm))
        "thecops.ml"
        1424
        2)
      (fol_of_form nil lconsts tm))))

(defunc NANOCOP_DEEPEN (opt ths)
  (progn
    (if (deref copverb)
      (progn
        (format-printf "NANOCOP_DEEPEN with ths:
%!")
        (list-iter (o (format-printf "  th: %s
%!") string_of_thm) ths))
      unit)
    (funcall reset_vars unit)
    (funcall reset_consts unit)
    (let*
      ((gen_eq
        (o
          (o (map #'GEN_ALL) (create_eq_axs (record-field opt :add_eq_symmetry)))
          (map #'concl)))
        (|ths'|
          (if (list-exists (lambdac (th) (= (concl th) hashek_tm)) ths)
            ths
            (cl:cons hashek_thm ths)))
        (|ths'~local~7076| (setify (append |ths'| (funcall gen_eq |ths'|))))
        (th (end_itlist CONJ |ths'~local~7076|))
        (fol (fol_of_thm th))
        (mat (index_matrix (matrix_of_form fol))))
      (progn
        (if (deref copverb)
          (progn (format-printf "Matrix:
%!") (funcall print_matrix_i mat))
          unit)
        (matrix2db mat)
        (if (deref copverb) (format-printf "Matrix loaded.
%!") unit)
        (match (strategy opt (start mat))
          ((tuple sub prfs)
            (progn
              (if (deref copverb)
                (progn (format-printf "Theorem
%!") (print_proof_def sub prfs))
                unit)
              (let*
                ((data (mk_recon_data (tuple th mat sub)))
                  (bot (bot_of_proof data nil th prfs)))
                (progn
                  (if (deref copverb)
                    (progn (format-printf "Reconstruction:
%!") (funcall print_thm bot))
                    unit)
                  (assert-true (set_eq (hyp bot) (hyp th)) "thecops.ml" 1456 2)
                  (assert-true (= (concl bot) (parse_term "F")) "thecops.ml" 1457 2)
                  bot)))))))))

;; (* Debugging tactic. *)


(defunc PRINT_TAC (g~local~7179)
  (progn
    (if (deref copverb) (funcall print_goal g~local~7179) unit)
    (ALL_TAC g~local~7179)))

(defunc PRINT_ID_TAC (s g~local~7193)
  (progn (if (deref copverb) (print-endline s) unit) (PRINT_TAC g~local~7193)))

(defunc PREPARE_NANOCOP_TAC (ths)
  (funcall
    THEN
    (funcall
      THEN
      (funcall
        THEN
        (PREPARE_COP_TAC ths)
        (RULE_ASSUM_TAC
          (CONV_RULE (funcall DEPTH_CONV (CHANGED_CONV (ASSOC_CONV DISJ_ASSOC))))))
      (RULE_ASSUM_TAC
        (CONV_RULE (funcall DEPTH_CONV (CHANGED_CONV (ASSOC_CONV CONJ_ASSOC))))))
    (REPEAT (FIRST_X_ASSUM #'SUBST_VAR_TAC))))

(defunc PURE_NANOCOP (opt gl)
  (ORELSE
    (FIRST_ASSUM CONTR_TAC)
    (W
      (o
        (o (o ACCEPT_TAC (NANOCOP_DEEPEN opt)) (map (function-value #'snd 1)))
        (function-value #'fst 1)))
    gl))

(defunc GEN_NANOCOP_TAC (opt ths)
  (funcall THEN (PREPARE_NANOCOP_TAC ths) (PURE_NANOCOP opt)))

(defunc NANOCOP_TAC (ths) (GEN_NANOCOP_TAC search_opts ths))

(defunc NANOCOP (ths tm) (prove (tuple tm (NANOCOP_TAC ths))))

