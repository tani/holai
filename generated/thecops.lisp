(defunc start (opt lim)
  (progn
    (if (deref copverb) (funcall (format-printf "Start %d
%!") (+ lim 1)) unit)
    (let*
      ((sub0 (empty 1000000))
        (hashek (fol_of_literal nil nil hashek_tm))
        (hashek_neg (negate_lit hashek))
        (prfs (prove_lit opt (tuple sub0 0) (tuple nil nil lim) hashek_neg)))
      (match (next_opt prfs)
        ((Some (tuple sub _ prf)) (make-Some (tuple (fst sub) prf)))
        ((None) (make-None))))))

;; (* Possible optimization:
;;    Reduce variable indexes to reduce used substitution and fit better in cache *)


(defunc LEANCOP_DEEPEN (opt ths)
  (progn
    (funcall clear_contrapos_cache unit)
    (funcall reset_vars unit)
    (funcall reset_consts unit)
    (let
      ((ths*
        (append ths (create_eq_axs (record-field opt :add_eq_symmetry) (map #'concl ths)))))
      (progn
        (axioms2db ths*)
        (match (strategy opt #'start)
          ((tuple sub prf)
            (let*
              ((hashek (fol_of_literal nil nil hashek_tm))
                (hashek_neg (negate_lit hashek))
                (th (hashek_of_proof sub nil hashek_neg prf)))
              (EQ_MP hashek_eq th))))))))

(defunc PREPARE_LEAN_TAC (ths)
  (funcall
    THEN
    (funcall
      THEN
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (PREPARE_COP_TAC ths)
            (RULE_ASSUM_TAC (CONV_RULE (THENC PRENEX_CONV WEAK_CNF_CONV))))
          (RULE_ASSUM_TAC
            (repeat
              (lambdac (th)
                (funcall
                  SPEC
                  (funcall genvar (type_of (fst (funcall dest_forall (concl th)))))
                  th)))))
        (hol2cl.tactics:REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN* ASSUME_TAC))))
      (RULE_ASSUM_TAC (CONV_RULE (ASSOC_CONV DISJ_ASSOC))))
    (hol2cl.tactics:REPEAT (FIRST_X_ASSUM #'SUBST_VAR_TAC))))

(defunc PURE_LEANCOP (opt gl)
  (ORELSE
    (FIRST_ASSUM CONTR_TAC)
    (W
      (o
        (o (o ACCEPT_TAC (LEANCOP_DEEPEN opt)) (map (function-value #'snd 1)))
        (function-value #'fst 1)))
    gl))

(defunc GEN_LEANCOP_TAC (opt ths)
  (funcall THEN (PREPARE_LEAN_TAC ths) (PURE_LEANCOP opt)))

(defunc LEANCOP_TAC (ths) (GEN_LEANCOP_TAC search_opts ths))

(defunc LEANCOP (ths tm) (prove (tuple tm (LEANCOP_TAC ths))))

