(defunc SUBLET_CONV (conv)
  (labelsc
    ((largconv
      (tm)
      (match tm
        ((Comb (Const "LET" _) _) (REFL tm))
        ((Comb l r*) (COMB2_CONV #'largconv conv tm))
        (_ (failwith "SUBLET_CONV")))))
    (lambdac (tm) (if (funcall is_let tm) (largconv tm) (failwith "SUBLET_CONV")))))

