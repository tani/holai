;; (* ------------------------------------------------------------------------- *)
;; (* Standard tactic for list induction using MATCH_MP_TAC list_INDUCT         *)
;; (* ------------------------------------------------------------------------- *)


(defparameter LIST_INDUCT_TAC
  (let
    ((list_INDUCT*
      (prove
        (tuple
          (parse_term
            "!P:(A)list->bool. P [] /\\ (!h t. P t ==> P (CONS h t)) ==> !l. P l")
          (funcall MATCH_ACCEPT_TAC list_INDUCT)))))
    (funcall
      THENL
      (funcall THEN (MATCH_MP_TAC list_INDUCT*) #'CONJ_TAC)
      (cl:cons
        #'ALL_TAC
        (cl:cons (funcall THEN (funcall THEN #'GEN_TAC #'GEN_TAC) DISCH_TAC) nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Basic definitions.                                                        *)
;; (* ------------------------------------------------------------------------- *)


(defparameter HD
  (funcall new_recursive_definition list_RECURSION (parse_term "HD(CONS (h:A) t) = h")))

(defparameter TL
  (funcall new_recursive_definition list_RECURSION (parse_term "TL(CONS (h:A) t) = t")))

(defparameter APPEND
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term
      "(!l:(A)list. APPEND [] l = l) /\\
   (!h t l. APPEND (CONS h t) l = CONS h (APPEND t l))")))

(defparameter REVERSE
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term
      "(REVERSE [] = []) /\\
   (REVERSE (CONS (x:A) l) = APPEND (REVERSE l) [x])")))

(defparameter LENGTH
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term "(LENGTH [] = 0) /\\
   (!h:A. !t. LENGTH (CONS h t) = SUC (LENGTH t))")))

(defparameter MAP
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term
      "(!f:A->B. MAP f NIL = NIL) /\\
   (!f h t. MAP f (CONS h t) = CONS (f h) (MAP f t))")))

(defparameter LAST
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term "LAST (CONS (h:A) t) = if t = [] then h else LAST t")))

(defparameter BUTLAST
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term
      "(BUTLAST [] = []) /\\
  (BUTLAST (CONS (h:A) t) = if t = [] then [] else CONS h (BUTLAST t))")))

(defparameter REPLICATE
  (funcall
    new_recursive_definition
    num_RECURSION
    (parse_term
      "(REPLICATE 0 (x:A) = []) /\\
   (REPLICATE (SUC n) x = CONS x (REPLICATE n x))")))

(defparameter NULL
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term "(NULL [] = T) /\\
   (NULL (CONS (h:A) t) = F)")))

(defparameter ALL
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term "(ALL P [] = T) /\\
   (ALL P (CONS (h:A) t) <=> P h /\\ ALL P t)")))

(defparameter EX
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term "(EX P [] = F) /\\
   (EX P (CONS (h:A) t) <=> P h \\/ EX P t)")))

(defparameter ITLIST
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term
      "(ITLIST (f:A->B->B) [] b = b) /\\
   (ITLIST f (CONS h t) b = f h (ITLIST f t b))")))

(defparameter MEM
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term "(MEM (x:A) [] <=> F) /\\
   (MEM x (CONS h t) <=> (x = h) \\/ MEM x t)")))

(defparameter ALL2_DEF
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term
      "(ALL2 (P:A->B->bool) [] l2 <=> (l2 = [])) /\\
   (ALL2 P (CONS h1 t1) l2 <=>
        if l2 = [] then F
        else P h1 (HD l2) /\\ ALL2 P t1 (TL l2))")))

(defparameter ALL2
  (prove
    (tuple
      (parse_term
        "(ALL2 (P:A->B->bool) [] [] <=> T) /\\
   (ALL2 P (CONS h1 t1) [] <=> F) /\\
   (ALL2 P [] (CONS h2 t2) <=> F) /\\
   (ALL2 P (CONS h1 t1) (CONS h2 t2) <=> P h1 h2 /\\ ALL2 P t1 t2)")
      (REWRITE_TAC
        (cl:cons (distinctness "list") (cl:cons ALL2_DEF (cl:cons HD (cl:cons TL nil))))))))

(defparameter MAP2_DEF
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term
      "(MAP2 (f:A->B->C) [] l = []) /\\
   (MAP2 f (CONS h1 t1) l = CONS (f h1 (HD l)) (MAP2 f t1 (TL l)))")))

(defparameter MAP2
  (prove
    (tuple
      (parse_term
        "(MAP2 (f:A->B->C) [] [] = []) /\\
   (MAP2 f (CONS h1 t1) (CONS h2 t2) = CONS (f h1 h2) (MAP2 f t1 t2))")
      (REWRITE_TAC (cl:cons MAP2_DEF (cl:cons HD (cl:cons TL nil)))))))

(defparameter EL
  (funcall
    new_recursive_definition
    num_RECURSION
    (parse_term "(EL 0 l :A = HD l) /\\
   (EL (SUC n) l = EL n (TL l))")))

(defparameter FILTER
  (funcall
    new_recursive_definition
    list_RECURSION
    (parse_term
      "(FILTER (P:A->bool) [] = []) /\\
   (FILTER P (CONS h t) = if P h then CONS h (FILTER P t) else FILTER P t)")))

