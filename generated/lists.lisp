    list_RECURSION
    (parse_term
      "(ITLIST2 (f:A->B->C->C) [] l2 b = b) /\\
   (ITLIST2 f (CONS h1 t1) l2 b = f h1 (HD l2) (ITLIST2 f t1 (TL l2) b))")))

(defparameter ITLIST2
  (prove
    (tuple
      (parse_term
        "(ITLIST2 (f:A->B->C->C) [] [] b = b) /\\
