            (parse_term "(!n. n < SUC k ==> P n) <=> (!n. n < k ==> P n) /\\ P k")
            (funcall THEN (REWRITE_TAC (cl:cons LT nil)) (MESON_TAC nil))))))
    (cl:declare (cl:ignorable pth_base pth_step))
    (let
      ((base_CONV (GEN_REWRITE_CONV #'I (cl:cons pth_base nil)))
        (step_CONV
          (THENC
            (BINDER_CONV (funcall LAND_CONV (RAND_CONV num_CONV)))
            (GEN_REWRITE_CONV #'I (cl:cons pth_step nil)))))
      (cl:declare (cl:ignorable base_CONV step_CONV))
      (labelsc
        ((conv (tm) (ORELSEC base_CONV (THENC step_CONV (funcall LAND_CONV #'conv)) tm)))
        (THENC #'conv (REWRITE_CONV (cl:cons (funcall GSYM CONJ_ASSOC) nil)))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Computation of (a EXP k) MOD n keeping intermediates reduced              *)
;; (* ------------------------------------------------------------------------- *)


(defparameter EXP_MOD_CONV
  (match
    (o
      CONJUNCTS
      #'prove
      (tuple
        (parse_term
          "(a EXP 0) MOD n = 1 MOD n /\\
     (a EXP (NUMERAL(BIT0 k))) MOD n =
     ((a EXP (NUMERAL k) MOD n) EXP 2) MOD n /\\
     (a EXP (NUMERAL(BIT1 k))) MOD n =
     (a * ((a EXP (NUMERAL k) MOD n) EXP 2) MOD n) MOD n")
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (REWRITE_TAC (cl:cons EXP (cl:cons EXP_2 nil)))
                (REWRITE_TAC (cl:cons BIT0 (cl:cons BIT1 (cl:cons NUMERAL nil)))))
              (REWRITE_TAC (cl:cons EXP (cl:cons EXP_ADD nil))))
            (funcall CONV_TAC MOD_DOWN_CONV))
          (REWRITE_TAC nil))))
    ((cl:cons pth_0 (cl:cons pth_even (cl:cons pth_odd nil)))
      (let
        ((conv_zero (GEN_REWRITE_CONV #'I (cl:cons MOD_ZERO nil)))
          (conv_0 (GEN_REWRITE_CONV #'I (cl:cons pth_0 nil)))
          (conv_even (GEN_REWRITE_CONV #'I (cl:cons pth_even nil)))
          (conv_odd (GEN_REWRITE_CONV #'I (cl:cons pth_odd nil))))
        (cl:declare (cl:ignorable conv_zero conv_0 conv_even conv_odd))
        (labelsc
          ((conv
            (tm)
            (ORELSEC
              (ORELSEC
                (THENC conv_0 NUM_MOD_CONV)
                (THENC
                  (THENC
                    conv_even
                    (funcall LAND_CONV (THENC (funcall LAND_CONV #'conv) NUM_EXP_CONV)))
                  NUM_MOD_CONV))
              (THENC
                (THENC
                  conv_odd
                  (funcall
                    LAND_CONV
                    (THENC
                      (RAND_CONV
                        (THENC
                          (funcall
                            LAND_CONV
                            (THENC (funcall LAND_CONV #'conv) NUM_EXP_CONV))
                          NUM_MOD_CONV))
                      NUM_MULT_CONV)))
                NUM_MOD_CONV)
              tm)))
          (let ((fullconv (ORELSEC (THENC conv_zero NUM_EXP_CONV) #'conv)))
            (cl:declare (cl:ignorable fullconv))
            (lambdac (tm)
              (match tm
                ((guard
                  (Comb (Comb (Const "MOD" _) (Comb (Comb (Const "EXP" _) m) k%)) n)
                  (cl:and
                    (funcall is_numeral m)
                    (cl:and (funcall is_numeral k%) (funcall is_numeral n))))
                  (funcall fullconv tm))
                (_ (failwith "EXP_MOD_CONV"))))))))))

