                                      DISCH_TAC)
                                    nil)))
                              (FIRST_ASSUM (o #'MP_TAC (MATCH_MP HREAL_LE_EXISTS))))
                            (DISCH_THEN (o #'MP_TAC SELECT_RULE)))
                          (DISCH_THEN
                            (lambdac (th)
                              (funcall
                                THEN
                                (funcall ASSUME_TAC (SYM th))
