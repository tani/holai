          (cl:cons treal_eq (cl:cons HREAL_OF_NUM_EQ (cl:cons HREAL_ADD_RID nil))))))))

(defparameter TREAL_OF_NUM_LE
  (prove
    (tuple
      (parse_term "!m n. (treal_of_num m treal_le treal_of_num n) <=> m <= n")
      (REWRITE_TAC
        (cl:cons
          treal_of_num
          (cl:cons treal_le (cl:cons HREAL_OF_NUM_LE (cl:cons HREAL_ADD_RID nil))))))))

(defparameter TREAL_OF_NUM_ADD
  (prove
