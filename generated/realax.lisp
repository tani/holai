              (REWRITE_TAC (cl:cons HREAL_LE_EXISTS_DEF nil)))
            (DISCH_THEN (X_CHOOSE_THEN (parse_term "d:hreal") #'SUBST1_TAC)))
          (funcall EXISTS_TAC (parse_term "d * c")))
        (REWRITE_TAC (cl:cons HREAL_ADD_RDISTRIB nil))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Define operations on representatives of signed reals.                     *)
;; (* ------------------------------------------------------------------------- *)


(defparameter treal_of_num
  (funcall new_definition (parse_term "treal_of_num n = (&n, &0)")))

(defparameter treal_neg
  (funcall new_definition (parse_term "treal_neg ((x:hreal),(y:hreal)) = (y,x)")))

(defparameter treal_add
  (funcall new_definition (parse_term "(x1,y1) treal_add (x2,y2) = (x1 + x2, y1 + y2)")))

(defparameter treal_mul
  (funcall
    new_definition
    (parse_term
      "(x1,y1) treal_mul (x2,y2) = ((x1 * x2) + (y1 * y2),(x1 * y2) + (y1 * x2))")))

(defparameter treal_le
  (funcall new_definition (parse_term "(x1,y1) treal_le (x2,y2) <=> x1 + y2 <= x2 + y1")))

(defparameter treal_inv
  (funcall
    new_definition
    (parse_term
      "treal_inv(x,y) = if x = y then (&0, &0)
                    else if y <= x then (inv(@d. x = y + d), &0)
                    else (&0, inv(@d. y = x + d))")))

;; (* ------------------------------------------------------------------------- *)
;; (* Define the equivalence relation and prove it *is* one.                    *)
;; (* ------------------------------------------------------------------------- *)


(defparameter treal_eq
  (funcall new_definition (parse_term "(x1,y1) treal_eq (x2,y2) <=> (x1 + y2 = x2 + y1)")))

(defparameter TREAL_EQ_REFL
  (prove
    (tuple
      (parse_term "!x. x treal_eq x")
      (REWRITE_TAC (cl:cons FORALL_PAIR_THM (cl:cons treal_eq nil))))))

(defparameter TREAL_EQ_SYM
  (prove
    (tuple
      (parse_term "!x y. x treal_eq y <=> y treal_eq x")
      (REWRITE_TAC (cl:cons FORALL_PAIR_THM (cl:cons treal_eq (cl:cons EQ_SYM_EQ nil)))))))

(defparameter TREAL_EQ_TRANS
  (prove
    (tuple
      (parse_term "!x y z. x treal_eq y /\\ y treal_eq z ==> x treal_eq z")
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (funcall
                  THEN
                  (REWRITE_TAC (cl:cons FORALL_PAIR_THM (cl:cons treal_eq nil)))
                  (REPEAT #'GEN_TAC))
                (DISCH_THEN
                  (o
                    (o (o #'MP_TAC #'MK_COMB%) (F_F (AP_TERM (parse_term "(+)")) #'I))
                    #'CONJ_PAIR)))
              (GEN_REWRITE_TAC (o LAND_CONV LAND_CONV) (cl:cons HREAL_ADD_SYM nil)))
            (REWRITE_TAC
              (cl:cons (funcall GSYM HREAL_ADD_ASSOC) (cl:cons HREAL_EQ_ADD_LCANCEL nil))))
          (REWRITE_TAC (cl:cons HREAL_ADD_ASSOC (cl:cons HREAL_EQ_ADD_RCANCEL nil))))
        (DISCH_THEN (o MATCH_ACCEPT_TAC (ONCE_REWRITE_RULE (cl:cons HREAL_ADD_SYM nil))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Useful to avoid unnecessary use of the equivalence relation.              *)
;; (* ------------------------------------------------------------------------- *)


(defparameter TREAL_EQ_AP
  (prove
