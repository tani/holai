;; (* ------------------------------------------------------------------------- *)
;; (* Consequential theorems needed later.                                      *)
;; (* ------------------------------------------------------------------------- *)


(defparameter HREAL_LE_EXISTS_DEF
  (prove
    (tuple
      (parse_term "!m n. m <= n <=> ?d. n = m + d")
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall THEN (REPEAT #'GEN_TAC) #'EQ_TAC)
            (REWRITE_TAC (cl:cons HREAL_LE_EXISTS nil)))
          (DISCH_THEN (CHOOSE_THEN #'SUBST1_TAC)))
        (REWRITE_TAC (cl:cons HREAL_LE_ADD nil))))))

(defparameter HREAL_EQ_ADD_LCANCEL
  (prove
    (tuple
      (parse_term "!m n p. (m + n = m + p) <=> (n = p)")
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall THEN (REPEAT #'GEN_TAC) #'EQ_TAC)
            (REWRITE_TAC (cl:cons HREAL_ADD_LCANCEL nil)))
          (DISCH_THEN #'SUBST1_TAC))
        #'REFL_TAC))))

(defparameter HREAL_EQ_ADD_RCANCEL
  (prove
    (tuple
      (parse_term "!m n p. (m + p = n + p) <=> (m = n)")
      (funcall
        THEN
        (ONCE_REWRITE_TAC (cl:cons HREAL_ADD_SYM nil))
        (REWRITE_TAC (cl:cons HREAL_EQ_ADD_LCANCEL nil))))))

(defparameter HREAL_LE_ADD_LCANCEL
  (prove
    (tuple
      (parse_term "!m n p. (m + n <= m + p) <=> (n <= p)")
      (REWRITE_TAC
