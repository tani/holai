          (cl:cons (funcall GSYM HREAL_ADD_ASSOC) (cl:cons HREAL_EQ_ADD_LCANCEL nil)))))))

(defparameter HREAL_LE_ADD_RCANCEL
  (prove
    (tuple
      (parse_term "!m n p. (m + p <= n + p) <=> (m <= n)")
      (funcall
        THEN
        (ONCE_REWRITE_TAC (cl:cons HREAL_ADD_SYM nil))
        (funcall MATCH_ACCEPT_TAC HREAL_LE_ADD_LCANCEL)))))

(defparameter HREAL_ADD_RID
  (prove
    (tuple
      (parse_term "!n. n + &0 = n")
      (funcall
        THEN
        (ONCE_REWRITE_TAC (cl:cons HREAL_ADD_SYM nil))
        (funcall MATCH_ACCEPT_TAC HREAL_ADD_LID)))))

(defparameter HREAL_ADD_RDISTRIB
  (prove
    (tuple
      (parse_term "!m n p. (m + n) * p = m * p + n * p")
      (funcall
        THEN
        (ONCE_REWRITE_TAC (cl:cons HREAL_MUL_SYM nil))
        (funcall MATCH_ACCEPT_TAC HREAL_ADD_LDISTRIB)))))

(defparameter HREAL_MUL_LZERO
  (prove
    (tuple
      (parse_term "!m. &0 * m = &0")
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                #'GEN_TAC
                (MP_TAC
                  (SPECL
                    (cl:cons
                      (parse_term "&0")
                      (cl:cons (parse_term "&1") (cl:cons (parse_term "m:hreal") nil)))
                    HREAL_ADD_RDISTRIB)))
              (REWRITE_TAC (cl:cons HREAL_ADD_LID nil)))
            (GEN_REWRITE_TAC
              (funpow 2 LAND_CONV)
              (cl:cons (funcall GSYM HREAL_ADD_LID) nil)))
          (REWRITE_TAC (cl:cons HREAL_EQ_ADD_RCANCEL nil)))
        (DISCH_THEN (o ACCEPT_TAC #'SYM))))))

(defparameter HREAL_MUL_RZERO
