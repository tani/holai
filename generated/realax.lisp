                (funcall X_CHOOSE_TAC (parse_term "d2:hreal")))))
          (funcall EXISTS_TAC (parse_term "d1 + d2")))
        (funcall ASM_REWRITE_TAC (cl:cons HREAL_ADD_AC nil))))))

