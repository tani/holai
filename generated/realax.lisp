;; (* ------------------------------------------------------------------------- *)
;; (* Absolute distance function on the naturals.                               *)
;; (* ------------------------------------------------------------------------- *)


(defparameter dist (funcall new_definition (parse_term "dist(m,n) = (m - n) + (n - m)")))

;; (* ------------------------------------------------------------------------- *)
;; (* Some easy theorems.                                                       *)
;; (* ------------------------------------------------------------------------- *)


(defparameter DIST_REFL
  (prove
    (tuple
      (parse_term "!n. dist(n,n) = 0")
      (REWRITE_TAC (cl:cons dist (cl:cons SUB_REFL (cl:cons ADD_CLAUSES nil)))))))

(defparameter DIST_LZERO
  (prove
    (tuple
      (parse_term "!n. dist(0,n) = n")
      (REWRITE_TAC (cl:cons dist (cl:cons SUB_0 (cl:cons ADD_CLAUSES nil)))))))

(defparameter DIST_RZERO
  (prove
    (tuple
      (parse_term "!n. dist(n,0) = n")
      (REWRITE_TAC (cl:cons dist (cl:cons SUB_0 (cl:cons ADD_CLAUSES nil)))))))

(defparameter DIST_SYM
  (prove
    (tuple
      (parse_term "!m n. dist(m,n) = dist(n,m)")
      (funcall THEN (REWRITE_TAC (cl:cons dist nil)) (funcall MATCH_ACCEPT_TAC ADD_SYM)))))

(defparameter DIST_LADD
  (prove
    (tuple
      (parse_term "!m p n. dist(m + n,m + p) = dist(n,p)")
      (REWRITE_TAC (cl:cons dist (cl:cons SUB_ADD_LCANCEL nil))))))

(defparameter DIST_RADD
  (prove
    (tuple
      (parse_term "!m p n. dist(m + p,n + p) = dist(m,n)")
      (REWRITE_TAC (cl:cons dist (cl:cons SUB_ADD_RCANCEL nil))))))

(defparameter DIST_LADD_0
  (prove
    (tuple
      (parse_term "!m n. dist(m + n,m) = n")
      (REWRITE_TAC
        (cl:cons dist (cl:cons ADD_SUB2 (cl:cons ADD_SUBR2 (cl:cons ADD_CLAUSES nil))))))))

(defparameter DIST_RADD_0
  (prove
    (tuple
      (parse_term "!m n. dist(m,m + n) = n")
      (funcall
        THEN
        (ONCE_REWRITE_TAC (cl:cons DIST_SYM nil))
        (funcall MATCH_ACCEPT_TAC DIST_LADD_0)))))

(defparameter DIST_LMUL
  (prove
    (tuple
      (parse_term "!m n p. m * dist(n,p) = dist(m * n,m * p)")
      (REWRITE_TAC
        (cl:cons dist (cl:cons LEFT_ADD_DISTRIB (cl:cons LEFT_SUB_DISTRIB nil)))))))

(defparameter DIST_RMUL
  (prove
    (tuple
      (parse_term "!m n p. dist(m,n) * p = dist(m * p,n * p)")
      (REWRITE_TAC
        (cl:cons dist (cl:cons RIGHT_ADD_DISTRIB (cl:cons RIGHT_SUB_DISTRIB nil)))))))

(defparameter DIST_EQ_0
  (prove
    (tuple
      (parse_term "!m n. (dist(m,n) = 0) <=> (m = n)")
      (REWRITE_TAC
        (cl:cons dist (cl:cons ADD_EQ_0 (cl:cons SUB_EQ_0 (cl:cons LE_ANTISYM nil))))))))

;; (* ------------------------------------------------------------------------- *)
;; (* Simplifying theorem about the distance operation.                         *)
;; (* ------------------------------------------------------------------------- *)


(defparameter DIST_ELIM_THM
  (prove
    (tuple
      (parse_term
        "P(dist(x,y)) <=> !d. ((x = y + d) ==> P(d)) /\\ ((y = x + d) ==> P(d))")
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (funcall
                  THEN
                  (funcall
                    THEN
                    (funcall
                      THEN
                      (funcall
                        THEN
                        (funcall
                          THEN
                          (funcall
                            THEN
                            (funcall
                              THEN
                              (DISJ_CASES_TAC
                                (SPECL
                                  (cl:cons
                                    (parse_term "x:num")
                                    (cl:cons (parse_term "y:num") nil))
                                  LE_CASES))
                              (POP_ASSUM
                                (o
                                  (X_CHOOSE_THEN (parse_term "e:num") #'SUBST1_TAC)
                                  (REWRITE_RULE (cl:cons LE_EXISTS nil)))))
                            (REWRITE_TAC
                              (cl:cons
                                dist
                                (cl:cons
                                  ADD_SUB
                                  (cl:cons
                                    ADD_SUB2
                                    (cl:cons ADD_SUBR (cl:cons ADD_SUBR2 nil)))))))
                          (REWRITE_TAC (cl:cons ADD_CLAUSES (cl:cons EQ_ADD_LCANCEL nil))))
                        (GEN_REWRITE_TAC
                          (o #'RAND_CONV ONCE_DEPTH_CONV)
                          (cl:cons EQ_SYM_EQ nil)))
                      (REWRITE_TAC
                        (cl:cons
                          (funcall GSYM ADD_ASSOC)
                          (cl:cons EQ_ADD_LCANCEL_0 (cl:cons ADD_EQ_0 nil)))))
                    (ASM_CASES_TAC (parse_term "e = 0")))
                  (funcall ASM_REWRITE_TAC nil))
                #'EQ_TAC)
              (REPEAT #'STRIP_TAC))
            (funcall ASM_REWRITE_TAC nil))
          (FIRST_ASSUM #'MATCH_MP_TAC))
        (funcall ASM_REWRITE_TAC nil)))))

;; (* ------------------------------------------------------------------------- *)
;; (* Now some more theorems.                                                   *)
;; (* ------------------------------------------------------------------------- *)


(defparameter DIST_ADD2 nil)

(defparameter DIST_ADD2_REV nil)

(defparameter DIST_ADDBOUND nil)

(defparameter DIST_LE_CASES nil)

(defparameter DIST_TRIANGLE nil)

(match
  (let*
    ((DIST_ELIM_TAC
      (let
        ((conv
          (funcall
            HIGHER_REWRITE_CONV
            (cl:cons SUB_ELIM_THM (cl:cons COND_ELIM_THM (cl:cons DIST_ELIM_THM nil)))
            cl:nil)))
        (cl:declare (cl:ignorable conv))
        (funcall
          THEN
          (funcall THEN (funcall THEN (funcall CONV_TAC conv) (TRY #'GEN_TAC)) #'CONJ_TAC)
          (DISCH_THEN
            (lambdac (th)
              (funcall
                THEN
                (SUBST_ALL_TAC th)
                (match (dest_eq (concl th))
                  ((tuple l r%)
                    (if (cl:and (is_var l) (not (vfree_in l r%)))
                      #'ALL_TAC
                      (funcall ASSUME_TAC th))))))))))
      (DIST_ELIM_TAC%
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (funcall
                  THEN
                  (funcall THEN (REPEAT #'STRIP_TAC) (REPEAT DIST_ELIM_TAC))
                  (REWRITE_TAC (cl:cons (funcall GSYM NOT_LT) (cl:cons LT_EXISTS nil))))
                (DISCH_THEN (CHOOSE_THEN #'SUBST_ALL_TAC)))
              (POP_ASSUM #'MP_TAC))
            (funcall CONV_TAC (funcall LAND_CONV NUM_CANCEL_CONV)))
          (REWRITE_TAC (cl:cons ADD_CLAUSES (cl:cons NOT_SUC nil))))))
    (cl:declare (cl:ignorable DIST_ELIM_TAC DIST_ELIM_TAC%))
    (match
      (tuple
        (prove
          (tuple
            (parse_term "!m n p. dist(m,n) <= p <=> (m <= n + p) /\\ (n <= m + p)")
            (funcall
              THEN
              (funcall THEN (REPEAT #'GEN_TAC) (REPEAT DIST_ELIM_TAC))
              (REWRITE_TAC
                (cl:cons
                  (funcall GSYM ADD_ASSOC)
                  (cl:cons LE_ADD (cl:cons LE_ADD_LCANCEL nil)))))))
        (prove
          (tuple
            (parse_term "!m n. dist(m,n) <= m + n")
            (funcall
              THEN
              (funcall
                THENL
                (funcall THEN (REPEAT #'GEN_TAC) DIST_ELIM_TAC)
                (cl:cons (ONCE_REWRITE_TAC (cl:cons ADD_SYM nil)) (cl:cons #'ALL_TAC nil)))
              (REWRITE_TAC (cl:cons ADD_ASSOC (cl:cons LE_ADDR nil))))))
        (o
          CONJUNCTS
          #'prove
          (tuple
            (parse_term
              "(!m n p. dist(m,p) <= dist(m,n) + dist(n,p)) /\\
     (!m n p q. dist(m + n,p + q) <= dist(m,p) + dist(n,q)) /\\
     (!m n p q. dist(m,p) <= dist(m + n,p + q) + dist(n,q))")
            DIST_ELIM_TAC%)))
      ((tuple
        DIST_LE_CASES%
        DIST_ADDBOUND%
        (cl:cons DIST_TRIANGLE% (cl:cons DIST_ADD2% (cl:cons DIST_ADD2_REV% nil))))
        (tuple DIST_LE_CASES% DIST_ADDBOUND% DIST_TRIANGLE% DIST_ADD2% DIST_ADD2_REV%))))
  ((tuple DIST_LE_CASES% DIST_ADDBOUND% DIST_TRIANGLE% DIST_ADD2% DIST_ADD2_REV%)
    (setf
      DIST_ADD2
      DIST_ADD2%
      DIST_ADD2_REV
      DIST_ADD2_REV%
      DIST_ADDBOUND
      DIST_ADDBOUND%
      DIST_LE_CASES
      DIST_LE_CASES%
      DIST_TRIANGLE
      DIST_TRIANGLE%)))

(defparameter DIST_TRIANGLE_LE
  (prove
    (tuple
      (parse_term "!m n p q. dist(m,n) + dist(n,p) <= q ==> dist(m,p) <= q")
      (funcall
        THEN
        (funcall
          THEN
          (funcall THEN (REPEAT #'STRIP_TAC) (MATCH_MP_TAC LE_TRANS))
          (funcall EXISTS_TAC (parse_term "dist(m,n) + dist(n,p)")))
        (funcall ASM_REWRITE_TAC (cl:cons DIST_TRIANGLE nil))))))

(defparameter DIST_TRIANGLES_LE
  (prove
    (tuple
      (parse_term
        "!m n p q r s.
        dist(m,n) <= r /\\ dist(p,q) <= s ==> dist(m,p) <= dist(n,q) + r + s")
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
