(defparameter ASM_METIS_TAC #'GEN_METIS_TAC)

(defunc METIS_TAC (ths)
  (funcall THEN (POP_ASSUM_LIST (K #'ALL_TAC)) (funcall ASM_METIS_TAC ths)))

(defunc METIS (ths tm) (prove (tuple tm (METIS_TAC ths))))

