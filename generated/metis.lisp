;; (* Slightly modified tactic from meson.ml. *)


(defunc FOL_PREPARE_TAC (ths)
  (funcall
    THEN
    (funcall
      THEN
      (funcall
        THEN
        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (funcall
                  THEN
                  (funcall
                    THEN
                    (funcall
                      THEN
                      (funcall
                        THEN
                        (funcall
                          THEN
                          (funcall
                            THEN
                            (funcall
                              THEN
                              (funcall
                                THEN
                                (funcall REFUTE_THEN ASSUME_TAC)
                                (funcall POLY_ASSUME_TAC (map #'GEN_ALL ths)))
                              (W
                                (o
                                  (MAP_EVERY
                                    (o (o #'UNDISCH_TAC #'concl) (function-value #'snd 1)))
                                  (function-value #'fst 1))))
                            SELECT_ELIM_TAC)
                          (W
                            (lambdac (arg~54560)
                              (match arg~54560
                                ((tuple asl w~local~54563)
                                  (MAP_EVERY
                                    (lambdac (v) (SPEC_TAC (tuple v v)))
                                    (frees w~local~54563)))))))
                        (funcall
                          CONV_TAC
                          (THENC
                            (THENC
                              (THENC
                                (THENC PRESIMP_CONV (funcall TOP_DEPTH_CONV #'BETA_CONV))
                                LAMBDA_ELIM_CONV)
                              CONDS_CELIM_CONV)
                            QUANT_BOOL_CONV)))
                      (REPEAT (ORELSE #'GEN_TAC DISCH_TAC)))
                    (funcall REFUTE_THEN ASSUME_TAC))
                  (RULE_ASSUM_TAC (CONV_RULE (THENC NNF_CONV SKOLEM_CONV))))
                (REPEAT (FIRST_X_ASSUM #'CHOOSE_TAC)))
              ASM_FOL_TAC)
            (SPLIT_TAC (deref split_limit)))
          (RULE_ASSUM_TAC (CONV_RULE (THENC PRENEX_CONV WEAK_CNF_CONV))))
        (RULE_ASSUM_TAC
          (hol2cl.lib:repeat
            (lambdac (th)
              (funcall
                SPEC
                (funcall genvar (type_of (fst (funcall dest_forall (concl th)))))
                th)))))
      (REPEAT (FIRST_X_ASSUM (|CONJUNCTS_THEN'| ASSUME_TAC))))
    (RULE_ASSUM_TAC (CONV_RULE (ASSOC_CONV DISJ_ASSOC)))))

