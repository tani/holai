(defparameter REAL_OF_NUM_CLAUSES
  (prove
    (tuple
      (parse_term
        "(!m n. &m:real = &n <=> m = n) /\\
   (!m n. &m:real >= &n <=> m >= n) /\\
   (!m n. &m:real > &n <=> m > n) /\\
   (!m n. &m:real <= &n <=> m <= n) /\\
   (!m n. &m:real < &n <=> m < n) /\\
   (!m n. max (&m) (&n):real = &(MAX m n)) /\\
   (!m n. min (&m) (&n):real = &(MIN m n)) /\\
   (!m n. &m + &n:real = &(m + n)) /\\
