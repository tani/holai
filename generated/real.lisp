        (funcall
          THEN
          (funcall
            THEN
            (funcall
              THEN
              (funcall
                THEN
                (funcall
                  THEN
                  (funcall THEN (REPEAT #'GEN_TAC) (REWRITE_TAC (cl:cons LE_EXISTS nil)))
                  #'STRIP_TAC)
                (funcall ASM_REWRITE_TAC (cl:cons ADD_SUB2 nil)))
              (REWRITE_TAC (cl:cons (funcall GSYM REAL_OF_NUM_ADD) nil)))
            (ONCE_REWRITE_TAC (cl:cons REAL_ADD_SYM nil)))
