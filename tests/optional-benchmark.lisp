(require :asdf)
(asdf:initialize-source-registry `(:source-registry (:directory ,(truename ".")) :inherit-configuration))
(setf asdf:*asdf-verbose* nil *compile-verbose* nil *load-verbose* nil)
(asdf:load-system "hol2cl-runtime")
(hol2cl.runtime:defunc bench-add (a b c) (+ a b c))
(hol2cl.runtime:defunc bench-return (a) (hol2cl.runtime:lambdac (b c) (+ a b c)))
(defparameter *bench-lambda* (hol2cl.runtime:lambdac (a b c) (+ a b c)))
(defparameter *bench-prefix* (bench-add 1))
(defun measure-entry (trial name function repetitions)
  (dotimes (i 1000) (declare (ignorable i)) (unless (= 6 (funcall function)) (error "Warmup result")))
  (sb-ext:gc :full t)
  (let ((start (get-internal-run-time)) (bytes (sb-ext:get-bytes-consed)) (result 0))
    (dotimes (i repetitions) (declare (ignorable i)) (setf result (funcall function)))
    (let ((elapsed (/ (- (get-internal-run-time) start) (float internal-time-units-per-second 1d0)))
          (allocated (- (sb-ext:get-bytes-consed) bytes)))
      (unless (= result 6) (error "Timed result"))
      (format t "~&ENTRY_BENCH ~d ~a ~d ~,9f ~d ~d~%" trial name repetitions elapsed allocated result))))
(dotimes (trial 3)
  (measure-entry trial "global-complete" (lambda () (bench-add 1 2 3)) 2000000)
  (measure-entry trial "lambda-complete" (lambda () (funcall *bench-lambda* 1 2 3)) 2000000)
  (hol2cl.runtime:labelsc ((local-add (a b c) (+ a b c)))
    (measure-entry trial "labels-complete" (lambda () (local-add 1 2 3)) 2000000))
  (hol2cl.runtime:fletc ((local-add (a b c) (+ a b c)))
    (measure-entry trial "flet-complete" (lambda () (local-add 1 2 3)) 2000000))
  (measure-entry trial "partial-create-call" (lambda () (funcall (bench-add 1) 2 3)) 300000)
  (measure-entry trial "partial-existing" (lambda () (funcall *bench-prefix* 2 3)) 1000000)
  (measure-entry trial "excess" (lambda () (bench-return 1 2 3)) 300000)
  (measure-entry trial "runtime-funcall" (lambda () (hol2cl.runtime:funcall *bench-lambda* 1 2 3)) 1000000))
