(require :asdf)
(with-open-file (stream "_build/lisp-initialization.txt" :direction :output :if-exists :supersede)
  (let ((*standard-output* stream))
    (load (merge-pathnames "bootstrap.lisp" *load-truename*))
    (uiop:symbol-call :hol2cl.runtime :pp-print-flush
      (symbol-value (find-symbol "STD-FORMATTER" :hol2cl.runtime))
      (symbol-value (find-symbol "UNIT" :hol2cl.runtime)))))
(setf (hol2cl.runtime::formatter-stream hol2cl.runtime:std-formatter) *standard-output*)
(defvar *checks* 0)
(defparameter *initial-inductive-definitions*
  (length (hol2cl.runtime:deref hol2cl.ind_defs:the_inductive_definitions)))
(defparameter *initial-source-axioms* (copy-list (hol2cl.fusion:axioms hol2cl.runtime:unit)))
(defun check (test message)
  (incf *checks*) (unless test (error "Check failed: ~a" message)))
(defun load-checked (path)
  (multiple-value-bind (fasl warnings failure) (compile-file path)
    (declare (ignore warnings))
    (when failure (error "Fixture compilation failed: ~a" path))
    (load fasl)))
(load-checked "_build/fixtures/semantics.lisp")
(load-checked "_build/fixtures/differential.lisp")
(load-checked "_build/fixtures/extended.lisp")
(load-checked "_build/fixtures/logic.lisp")
(load-checked "_build/fixtures/tactical.lisp")
(load-checked "_build/fixtures/foundation.lisp")
(load-checked "_build/fixtures/language.lisp")
(load-checked "_build/fixtures/provers.lisp")
(load-checked "_build/fixtures/execution.lisp")
(load-checked "_build/fixtures/arithmetic.lisp")
(load-checked "_build/fixtures/standard.lisp")

(check (= 42 (hol2cl.semantics:unit_fn hol2cl.runtime:unit)) "unit argument")
(check (= 18 (hol2cl.semantics:case_shadow hol2cl.runtime:unit)) "lexical case collision")
(check (= 44 (hol2cl.semantics:case_function_shadow hol2cl.runtime:unit)) "local function case collision")
(check (= 44 (hol2cl.semantics:case_parallel_functions hol2cl.runtime:unit)) "parallel function case collision")
(check (= 13 (hol2cl.semantics:local_cl_functions hol2cl.runtime:unit)) "local functions shadow inherited CL names")
(check (= 12 (hol2cl.semantics:local_syntax_function hol2cl.runtime:unit)) "local functions preserve generated control syntax")
(check (= 28 (hol2cl.semantics:parent_capture hol2cl.runtime:unit)) "child module captures an earlier enclosing binding")
(check (= 263 (length (hol2cl.fusion:definitions hol2cl.runtime:unit))) "all original standard-core definitions initialized")
(check (= 303 (length (hol2cl.fusion:constants hol2cl.runtime:unit))) "all original standard-core constants initialized before test extensions")
(check (= 22 (length (hol2cl.fusion:types hol2cl.runtime:unit))) "all original standard-core types initialized before test extensions")
(check (hol2cl.runtime:= (hol2cl.fusion:axioms hol2cl.runtime:unit)
                        (list hol2cl.nums:INFINITY_AX hol2cl.class:SELECT_AX hol2cl.class:ETA_AX))
       "initialization adds exactly the original infinity, choice and eta axioms")
(check (and (null (hol2cl.fusion:hyp hol2cl.bool:TRUTH))
            (hol2cl.runtime:= (hol2cl.fusion:concl hol2cl.bool:TRUTH)
                              (hol2cl.parser:parse_term "T"))) "TRUTH is closed and concludes T")
(check (handler-case (progn (hol2cl.runtime:format-asprintf "%04d") nil)
         (hol2cl.runtime:invalid_argument () t)) "unsupported format rejected")
(check (handler-case (progn (hol2cl.runtime:format-asprintf "%") nil)
         (hol2cl.runtime:invalid_argument () t)) "incomplete format rejected")
(check (not (eq hol2cl.tactics:THEN hol2cl.tactics:then1_)) "THEN and then1_ have separate bindings")
(let* ((goal (hol2cl.parser:parse_term "T /\\ T"))
       (accept (hol2cl.runtime:partial
                 hol2cl.tactics:ACCEPT_TAC hol2cl.bool:TRUTH))
       (tactic (hol2cl.runtime:funcall hol2cl.tactics:THEN
                 (hol2cl.runtime:function-value #'hol2cl.tactics:CONJ_TAC 1) accept))
       (theorem (hol2cl.tactics:prove (hol2cl.runtime:tuple goal tactic))))
  (check (and (null (hol2cl.fusion:hyp theorem))
              (hol2cl.fusion:aconv goal (hol2cl.fusion:concl theorem)))
         "THEN composes both branch justifications"))
(let ((old (hol2cl.runtime:deref hol2cl.lib:verbose)))
  (hol2cl.runtime:assign hol2cl.lib:verbose nil)
  (unwind-protect
      (let* ((goal (hol2cl.parser:parse_term "(p:bool) /\\ q ==> q"))
             (theorem (hol2cl.itab:ITAUT goal)))
        (check (and (null (hol2cl.fusion:hyp theorem))
                    (hol2cl.fusion:aconv goal (hol2cl.fusion:concl theorem)))
               "ITAUT returns a closed theorem of the requested goal"))
    (hol2cl.runtime:assign hol2cl.lib:verbose old)))
(let ((bogus (hol2cl.runtime:function-value
               (lambda (goal)
                 (declare (ignore goal))
                 (hol2cl.runtime:tuple hol2cl.tactics:null_meta nil
                   (hol2cl.runtime:function-value
                     (lambda (inst ths) (declare (ignore inst ths)) hol2cl.bool:TRUTH) 2))) 1)))
  (check (handler-case
           (progn (hol2cl.runtime:funcall hol2cl.tactics:VALID bogus
                    (hol2cl.runtime:tuple nil (hol2cl.parser:parse_term "F"))) nil)
           (hol2cl.runtime:failure () t)) "VALID rejects a wrong justification"))
(check (handler-case (progn (hol2cl.runtime:printf-sprintf "%a") nil)
         (hol2cl.runtime:invalid_argument () t)) "Printf callback profile rejected explicitly")
(check (null (hol2cl.runtime:deref hol2cl.tactics:current_goalstack)) "goalstack starts empty")
(check (= 7 (hol2cl.semantics:higher
              (hol2cl.runtime:function-value #'hol2cl.semantics:add 2) 3 4)) "higher order saturated")
(check (= 16 (hol2cl.semantics:staged
               (hol2cl.runtime:function-value #'hol2cl.semantics:add 2))) "higher order underapplication")
(check (= 13 (hol2cl.semantics:alias
               (hol2cl.semantics:make-Pair (hol2cl.runtime:tuple 4 9)))) "tuple payload + alias")
(check (handler-case (progn (hol2cl.semantics:only_one (hol2cl.semantics:make-Zero)) nil)
         (hol2cl.runtime:match-failure () t)) "incomplete match raises")
(check (equal hol2cl.semantics:escaped (format nil "a~%~c~a~c~a" #\" "b" #\\ "c")) "string escaping")
(check (= (hol2cl.semantics:floating 1.0d0) 1.5d0) "float literal")
(check (= 42 (hol2cl.semantics:pass_unit
               (hol2cl.runtime:function-value #'hol2cl.semantics:unit_fn 1))) "unit higher-order arity")
(check (hol2cl.runtime:<> (hol2cl.runtime:make-None) nil) "None is not empty list")
(check (not (nth-value 1 (find-symbol "SEQUENT" :hol2cl.fusion))) "opaque constructor not reexported")
(check (eq :internal (nth-value 1 (find-symbol "MAKE-SEQUENT" :hol2cl.fusion.hol))) "theorem maker internal")
(check (not (eq :external (nth-value 1 (find-symbol "MAKE-TYAPP" :hol2cl.fusion.hol)))) "private type maker")
(check (not (eq (find-symbol "Abs" :hol2cl.fusion) (find-symbol "ABS" :hol2cl.fusion))) "constructor/rule case collision")
(check (hol2cl.fusion:aconv
         (hol2cl.fusion:mk_abs (hol2cl.runtime:tuple
           (hol2cl.fusion:mk_var (hol2cl.runtime:tuple "x" hol2cl.fusion:bool_ty))
           (hol2cl.fusion:mk_var (hol2cl.runtime:tuple "x" hol2cl.fusion:bool_ty))))
         (hol2cl.fusion:mk_abs (hol2cl.runtime:tuple
           (hol2cl.fusion:mk_var (hol2cl.runtime:tuple "y" hol2cl.fusion:bool_ty))
           (hol2cl.fusion:mk_var (hol2cl.runtime:tuple "y" hol2cl.fusion:bool_ty))))) "alpha equivalence")

(with-open-file (stream "_build/lisp-observations.txt" :direction :output :if-exists :supersede)
  (let ((*standard-output* stream))
    (setf (hol2cl.runtime::formatter-stream hol2cl.runtime:std-formatter) stream)
    (dolist (line (append (hol2cl.differential:observations hol2cl.runtime:unit)
                         (hol2cl.extended:extended_observations hol2cl.runtime:unit)
                         (hol2cl.logic:logic_observations hol2cl.runtime:unit)
                         (hol2cl.tactical:tactical_observations hol2cl.runtime:unit)
                         (hol2cl.foundation:foundation_observations hol2cl.runtime:unit)
                         (hol2cl.language:language_observations hol2cl.runtime:unit)
                         (hol2cl.provers:provers_observations hol2cl.runtime:unit)
                         (hol2cl.execution:execution_observations hol2cl.runtime:unit)
                         (hol2cl.arithmetic:arithmetic_observations hol2cl.runtime:unit)
                         (hol2cl.standard:standard_observations hol2cl.runtime:unit)))
      (write-line line stream))))
(setf (hol2cl.runtime::formatter-stream hol2cl.runtime:std-formatter) *standard-output*)
(let* ((goal (hol2cl.parser:parse_term "(p:bool) \\/ ~p"))
       (th (hol2cl.runtime:funcall hol2cl.class:TAUT goal)))
  (check (and (null (hol2cl.fusion:hyp th))
              (hol2cl.fusion:aconv goal (hol2cl.fusion:concl th)))
         "classical tautology is closed and concludes excluded middle"))
(let* ((term (hol2cl.parser:parse_term "~((p:bool) ==> q)"))
       (th (hol2cl.runtime:funcall hol2cl.canon:NNF_CONV term))
       (sides (hol2cl.fusion:dest_eq (hol2cl.fusion:concl th))))
  (check (and (null (hol2cl.fusion:hyp th))
              (hol2cl.fusion:aconv term (hol2cl.runtime:fst sides))
              (hol2cl.fusion:aconv (hol2cl.parser:parse_term "(p:bool) /\\ ~q")
                                  (hol2cl.runtime:snd sides)))
         "NNF conversion derives the expected negated-implication equivalence"))
(let* ((term (hol2cl.parser:parse_term "(q:bool) /\\ p /\\ q"))
       (th (hol2cl.canon:CONJ_CANON_CONV term))
       (sides (hol2cl.fusion:dest_eq (hol2cl.fusion:concl th))))
  (check (and (null (hol2cl.fusion:hyp th))
              (hol2cl.fusion:aconv term (hol2cl.runtime:fst sides))
              (hol2cl.fusion:aconv (hol2cl.parser:parse_term "(p:bool) /\\ q")
                                  (hol2cl.runtime:snd sides)))
         "conjunction canonicalization derives sorted atoms without duplicates"))
(let* ((goal (hol2cl.parser:parse_term
               "(!x:A. P x ==> Q x) ==> (?x. P x) ==> (?x. Q x)"))
       (th (hol2cl.tactics:prove
             (hol2cl.runtime:tuple goal (hol2cl.meson:GEN_MESON_TAC 0 12 1 nil)))))
  (check (and (null (hol2cl.fusion:hyp th))
              (hol2cl.fusion:aconv goal (hol2cl.fusion:concl th)))
         "bounded MESON reconstructs a closed quantified theorem"))
(check (handler-case
         (progn (hol2cl.tactics:prove
                  (hol2cl.runtime:tuple (hol2cl.parser:parse_term "p:bool")
                    (hol2cl.meson:GEN_MESON_TAC 0 2 1 nil))) nil)
         (hol2cl.runtime:failure () t))
       "bounded MESON rejects an unsupported proposition")
(let ((definitions (hol2cl.runtime:deref hol2cl.ind_defs:the_inductive_definitions)))
  (check (>= (length definitions) (+ *initial-inductive-definitions* 2)) "original core and actual test relations/types registered")
  (dolist (triple definitions)
    (check (every (lambda (th) (null (hol2cl.fusion:hyp th)))
                  (coerce (hol2cl.runtime:tuple-items triple) 'list))
           "registered inductive rules, induction and cases have no assumptions")))
(check (hol2cl.runtime:=
         (hol2cl.fusion:get_const_type "test_reach")
         (hol2cl.parser:parse_type "(A->A->bool)->A->A->bool"))
       "schematic inductive predicate retains its relation parameter")
(check (equal (list (hol2cl.runtime:deref hol2cl.meson:meson_depth)
                    (hol2cl.runtime:deref hol2cl.meson:meson_prefine)
                    (hol2cl.runtime:deref hol2cl.meson:meson_brand)
                    (hol2cl.runtime:deref hol2cl.meson:meson_split_limit)
                    (hol2cl.runtime:deref hol2cl.meson:meson_dcutin)
                    (hol2cl.runtime:deref hol2cl.meson:meson_skew)
                    (hol2cl.runtime:deref hol2cl.meson:meson_chatty))
              '(nil t nil 8 1 3 nil))
       "search configuration restored after focused and failing cases")

;; Check the newly supported language/proof boundaries after the oracle
;; transcript, so native checks cannot perturb its source registry/fresh names.
(check (equal (list (hol2cl.language.language_a:observe hol2cl.runtime:unit)
                    (hol2cl.language.language_b:observe hol2cl.runtime:unit)) '(8 10))
       "functor instances retain the definition-time enclosing binding")
(check (and (not (eq hol2cl.language.language_a:counter hol2cl.language.language_b:counter))
            (= 2 (hol2cl.runtime:deref hol2cl.language.language_a:counter))
            (= 1 (hol2cl.runtime:deref hol2cl.language.language_b:counter)))
       "module aliases share state while separate functor applications do not")
(check (= 327 (hol2cl.language:language_labels 7 2 3)) "required labels retain parameter binding")
(check (= 8 (hol2cl.runtime:funcall hol2cl.language:language_recursive 4))
       "recursive closure retains its leading-let capture")
(check (= 9 (hol2cl.language:language_prefix_operator hol2cl.runtime:unit))
       "locally rebound prefix ! invokes the source operator")
(let ((a (hol2cl.language:language_local 10)) (b (hol2cl.language:language_local 30)))
  (check (equal (list (hol2cl.runtime:funcall a 3) (hol2cl.runtime:funcall a 3)
                     (hol2cl.runtime:funcall b 3)) '(16 17 36))
         "escaped local module closure preserves capture and instance separation"))
(check (= 14 (hol2cl.runtime:funcall (hol2cl.language.language_nested:make 11) 3))
       "local type metadata retains the enclosing nested module's namespace")
(check (hol2cl.runtime:= (hol2cl.language:language_loops hol2cl.runtime:unit)
                        (hol2cl.runtime:tuple 19 3)) "source for/while loops retain bounds and mutation")
(check (string= (hol2cl.language:language_lazy hol2cl.runtime:unit) "0,42,42,1,1:true:true")
       "lazy forcing caches values and exceptions")
(check (hol2cl.runtime:<>
         (hol2cl.language:language_bool t) (hol2cl.language:language_bool nil))
       "boolean tokens remain distinct from True/False variant tags")
(check (= -1 (hol2cl.runtime:int-lsr -1 0)) "zero logical shift retains the original signed int")
(check (= (- (expt 2 62)) (hol2cl.runtime:int-lsl 1 62)) "left shift retains the 63-bit sign bit")
(hol2cl.runtime:random-init 0)
(check (= 218040752 (hol2cl.runtime:random-bits hol2cl.runtime:unit))
       "seeded Random matches original OCaml's first value")
(let ((table (hol2cl.runtime:table-create 1)))
  (hol2cl.runtime:table-add table (hol2cl.runtime:tuple 1 2) 4)
  (hol2cl.runtime:table-add table (hol2cl.runtime:tuple 1 2) 5)
  (check (= 5 (hol2cl.runtime:table-find table (hol2cl.runtime:tuple 1 2)))
         "hash add shadows an earlier structural key")
  (hol2cl.runtime:table-clear table)
  (check (handler-case (progn (hol2cl.runtime:table-find table (hol2cl.runtime:tuple 1 2)) nil)
           (hol2cl.runtime:not_found () t)) "cleared hash lookup raises Not_found"))
(check (handler-case (progn (hol2cl.runtime:assert-true nil "native-assert" 9 3) nil)
         (hol2cl.runtime:assert_failure (condition)
           (hol2cl.runtime:= (hol2cl.runtime::assert_failure-location condition)
                             (hol2cl.runtime:tuple "native-assert" 9 3))))
       "assertion failure retains its source coordinates")
(let ((old-verbose (hol2cl.runtime:deref hol2cl.lib:verbose))
      (old-cop (hol2cl.runtime:deref hol2cl.firstorder:copverb))
      (old-metis (hol2cl.runtime:deref hol2cl.metis:metisverb)))
  (hol2cl.runtime:assign hol2cl.lib:verbose nil)
  (hol2cl.runtime:assign hol2cl.firstorder:copverb nil)
  (hol2cl.runtime:assign hol2cl.metis:metisverb nil)
  (unwind-protect
      (dolist (prover (list (hol2cl.runtime:function-value #'hol2cl.metis:METIS 2)
                           hol2cl.thecops:LEANCOP hol2cl.thecops:NANOCOP))
        (let* ((goal (hol2cl.parser:parse_term
                       "(!x:A. P x ==> Q x) ==> (?x. P x) ==> (?x. Q x)"))
               (th (hol2cl.runtime:funcall prover nil goal)))
          (check (and (null (hol2cl.fusion:hyp th))
                      (hol2cl.fusion:aconv goal (hol2cl.fusion:concl th)))
                 "first-order prover reconstructs the requested closed quantified theorem"))
        (let ((p (hol2cl.parser:parse_term "p:bool")))
          (check (handler-case (progn (hol2cl.runtime:funcall prover (list (hol2cl.fusion:ASSUME p)) p) nil)
                   (hol2cl.runtime:failure () t))
                 "proof wrapper rejects additional hypotheses")))
    (hol2cl.runtime:assign hol2cl.lib:verbose old-verbose)
    (hol2cl.runtime:assign hol2cl.firstorder:copverb old-cop)
    (hol2cl.runtime:assign hol2cl.metis:metisverb old-metis)))
(check (hol2cl.runtime:= (hol2cl.fusion:get_const_type "test_qnot")
                        (hol2cl.parser:parse_type "test_quot->test_quot"))
       "lifted quotient negation has the requested abstract type")
(check (= 0 (hol2cl.fusion:get_type_arity "test_quot")) "quotient type is nullary")
(check (and (not (hol2cl.runtime:deref hol2cl.lib:verbose))
            (not (hol2cl.runtime:deref hol2cl.firstorder:copverb))
            (not (hol2cl.runtime:deref hol2cl.metis:metisverb)))
       "prover corpus retains the surrounding fixture verbosity settings")

(check (= 5 (hol2cl.execution.execution_constructors:first
              (hol2cl.execution.execution_constructors:original_const 2 3)))
       "constructor family retains the preceding multiple-field Const")
(check (= 5 (hol2cl.execution.execution_constructors:first
              (hol2cl.execution.execution_constructors:original_abs 9 4)))
       "constructor family retains the preceding multiple-field Abs")
(check (= 7 (hol2cl.execution.execution_constructors:tuple_first
              (hol2cl.runtime:tuple 0 (hol2cl.execution.execution_constructors:original_const 3 4))))
       "constructor family evidence remains local to the tuple component")
(check (= 11 (hol2cl.execution.execution_constructors:lower
               (hol2cl.execution.execution_constructors:lower_value 11)))
       "the newer constructor still represents its own declared type")
(check (= 9 (hol2cl.execution.execution_records:read
              (hol2cl.execution.execution_records:make-left :head 0 :rws 9)))
       "sibling record fields disambiguate the partial guarded-match fallback")
(let ((rows (hol2cl.execution:execution_boundary_observations hol2cl.runtime:unit)))
  (dolist (expected '("ref_record=4,5,6,7,8,9,6:true:true"
                      "hash_fold=16:1,2,4;1,2,5;3,4,7"
                      "hash_remove=4:true" "array_fold=123:1,2,3"))
    (check (member expected rows :test #'string=)
           "source reference/hash/array examples have their independently expected results")))
(let* ((tm (hol2cl.parser:parse_term "T /\\ F"))
       (th (hol2cl.runtime:funcall hol2cl.compute.compute:EVAL_CONV tm))
       (sides (hol2cl.fusion:dest_eq (hol2cl.fusion:concl th))))
  (check (and (null (hol2cl.fusion:hyp th))
              (hol2cl.fusion:aconv tm (hol2cl.runtime:fst sides))
              (hol2cl.fusion:aconv (hol2cl.parser:parse_term "F") (hol2cl.runtime:snd sides)))
         "actual CBV reconstructs a closed boolean simplification equation"))
(let* ((tm (hol2cl.parser:parse_term "(\\(x:bool,y:bool). x) (p:bool,q:bool)"))
       (th (hol2cl.runtime:funcall hol2cl.pair:GEN_BETA_CONV tm))
       (sides (hol2cl.fusion:dest_eq (hol2cl.fusion:concl th))))
  (check (and (null (hol2cl.fusion:hyp th))
              (hol2cl.fusion:aconv tm (hol2cl.runtime:fst sides))
              (hol2cl.fusion:aconv (hol2cl.parser:parse_term "p:bool") (hol2cl.runtime:snd sides)))
         "generalized beta conversion derives the expected product projection"))
(let* ((n 123456789012345678901234567890)
       (tm (hol2cl.runtime:funcall hol2cl.nums:mk_numeral n)))
  (check (= n (hol2cl.runtime:funcall hol2cl.basics:dest_numeral tm))
         "the source numeral algorithm roundtrips beyond machine-integer width"))
(check (handler-case (progn (hol2cl.runtime:funcall hol2cl.nums:mk_numeral -1) nil)
         (hol2cl.runtime:failure () t)) "source numeral construction rejects a negative integer")
(check (hol2cl.runtime:= (hol2cl.fusion:get_const_type "test_npair")
                        (hol2cl.parser:parse_type "num->bool->bool"))
       "primitive-recursive definition retains its additional parameter")
(check (hol2cl.runtime:= (hol2cl.fusion:get_const_type "test_speczero")
                        (hol2cl.parser:parse_type "num"))
       "existence-based specification introduces the requested natural constant")
(check (and (hol2cl.runtime:= (hol2cl.runtime:deref hol2cl.compute.compute:monitoring)
                              (hol2cl.runtime:make-None))
            (hol2cl.runtime:= (hol2cl.runtime:deref hol2cl.compute.compute:stoppers)
                              (hol2cl.runtime:make-None)))
       "restricted CBV restores the original evaluator flags")
(check (equal (list (hol2cl.arithmetic:arithmetic_global 3)
                    hol2cl.arithmetic:arithmetic_global_base
                    hol2cl.arithmetic:arithmetic_standalone) '(7 7 8))
       "global recursive group admits independent application and scalar values")
(check (= 8 (hol2cl.arithmetic.arithmetic_mixed:run 3))
       "static module recursive function captures its independent function value")
(check (hol2cl.runtime:= (hol2cl.arithmetic:arithmetic_local 6)
                        (hol2cl.runtime:tuple 10 11 6 1))
       "mutual closures capture mixed values initialized exactly once")
(check (hol2cl.runtime:= (hol2cl.arithmetic:arithmetic_module 7)
                        (hol2cl.runtime:tuple 10 5 7 1))
       "mixed lexical module slots preserve call dispatch and once-only initialization")
(check (= 9 (hol2cl.arithmetic:arithmetic_shadow hol2cl.runtime:unit))
       "inner same-spelling function is distinct from the recursive group")
(check (= 13 (hol2cl.runtime:funcall (hol2cl.arithmetic:arithmetic_capture 11) 3))
       "independent local module captures the actual outer value")
(check (= 5 (hol2cl.arithmetic:arithmetic_nested hol2cl.runtime:unit))
       "nested independent recursive initialization composes reference guards")
(dolist (example (list
                  (list hol2cl.arith:MOD_DOWN_CONV
                        "(m MOD p + n MOD p) MOD p" "(m + n) MOD p")
                  (list hol2cl.arith:MOD_DOWN_CONV
                        "((m MOD n) EXP k) MOD n" "(m EXP k) MOD n")
                  (list hol2cl.arith:NUM_CANCEL_CONV
                        "a + b + a = b + a + c" "a = c:num")
                  (list hol2cl.arith:BITS_ELIM_CONV "BIT1 m" "2 * m + 1")))
  (destructuring-bind (conv text expected) example
    (let* ((tm (hol2cl.parser:parse_term text))
           (th (hol2cl.runtime:funcall conv tm))
           (sides (hol2cl.fusion:dest_eq (hol2cl.fusion:concl th))))
      (check (and (null (hol2cl.fusion:hyp th))
                  (hol2cl.fusion:aconv tm (hol2cl.runtime:fst sides))
                  (hol2cl.fusion:aconv (hol2cl.parser:parse_term expected)
                                      (hol2cl.runtime:snd sides)))
             "source arithmetic conversion derives a closed equation with the expected result"))))
(check (handler-case
         (progn (hol2cl.runtime:funcall hol2cl.arith:NUM_CANCEL_CONV
                                      (hol2cl.parser:parse_term "T")) nil)
         (hol2cl.runtime:failure () t))
       "source arithmetic cancellation rejects a non-equation")
(check (hol2cl.runtime:= (hol2cl.fusion:get_const_type "DIV")
                        (hol2cl.parser:parse_type "num->num->num"))
       "source specification introduces natural division with its actual type")
(let* ((goal (hol2cl.parser:parse_term "!n:num. n + 0 = n"))
       (tactic (hol2cl.runtime:funcall hol2cl.tactics:THEN hol2cl.nums:INDUCT_TAC
                 (hol2cl.runtime:funcall hol2cl.simp:ASM_REWRITE_TAC (list hol2cl.arith:ADD))))
       (th (hol2cl.tactics:prove (hol2cl.runtime:tuple goal tactic))))
  (check (and (null (hol2cl.fusion:hyp th))
              (hol2cl.fusion:aconv goal (hol2cl.fusion:concl th)))
         "original induction derives the requested arithmetic theorem without assumptions"))
(check (= 8 (hol2cl.standard.standard_syntax_value:use 3))
       "a source value named lambda cannot hide generated lambda syntax")
(check (= 4 (hol2cl.standard.standard_syntax_function:use 3))
       "a source function named lambda retains actual calls beside CL lambda syntax")
(let ((rows (hol2cl.standard:standard_library_observations hol2cl.runtime:unit)))
  (dolist (expected '("standard_array=3,8,3:true:2,3,4:4,9,16"
                      "standard_gc=16777216,16777217,16777216:true"
                      "standard_num=-3/2:2:1;-3:2;-2:1;3:2"
                      "standard_num_rational=-2:1/2"
                      "standard_num_noninteger=true" "standard_num_overflow=true"))
    (check (member expected rows :test #'string=)
           "fresh array, GC snapshots and exact Num examples have independent expected values")))
(dolist (example (list
                  (list hol2cl.calc_num:NUM_REDUCE_CONV "((17 + 25) * 3) DIV 7" "18:num")
                  (list hol2cl.calc_rat:REAL_RAT_REDUCE_CONV "&1 / &3 + &1 / &6:real" "&1 / &2:real")
                  (list hol2cl.int:INT_REDUCE_CONV "(-- &7) rem &3:int" "&2:int")
                  (list hol2cl.cart:DIMINDEX_CONV "dimindex(:2)" "2:num")))
  (destructuring-bind (conv text expected) example
    (let* ((tm (hol2cl.parser:parse_term text))
           (th (hol2cl.runtime:funcall conv tm))
           (sides (hol2cl.fusion:dest_eq (hol2cl.fusion:concl th))))
      (check (and (null (hol2cl.fusion:hyp th))
                  (hol2cl.fusion:aconv tm (hol2cl.runtime:fst sides))
                  (hol2cl.fusion:aconv (hol2cl.parser:parse_term expected)
                                      (hol2cl.runtime:snd sides)))
             "original numeric, rational, integer and dimension conversions reconstruct closed expected results"))))
(dolist (example (list
                  (list hol2cl.grobner:NUM_RING "!x y:num. (x + y) EXP 2 = x EXP 2 + 2 * x * y + y EXP 2")
                  (list hol2cl.calc_rat:REAL_RING "!x y:real. (x + y) pow 2 = x pow 2 + &2 * x * y + y pow 2")
                  (list hol2cl.calc_rat:REAL_ARITH "!x y:real. x <= y ==> x + &3 <= y + &3")
                  (list hol2cl.int:INT_ARITH "!x y:int. x < y ==> x + &1 <= y")))
  (destructuring-bind (prover text) example
    (let* ((goal (hol2cl.parser:parse_term text))
           (th (hol2cl.tactics:prove
                 (hol2cl.runtime:tuple goal (hol2cl.runtime:funcall hol2cl.tactics:CONV_TAC prover)))))
      (check (and (null (hol2cl.fusion:hyp th))
                  (hol2cl.fusion:aconv goal (hol2cl.fusion:concl th)))
             "original ring and arithmetic provers derive the requested closed theorem"))))
(check (= 1 (hol2cl.fusion:get_type_arity "test_full_tree"))
       "the original datatype package constructs a new parameterized recursive tree")
(check (hol2cl.runtime:= (hol2cl.fusion:get_const_type "test_full_size")
                        (hol2cl.parser:parse_type "(A)test_full_tree->num"))
       "general definition retains its newly constructed tree parameter")
(check (hol2cl.runtime:= (hol2cl.fusion:get_const_type "test_full_countdown")
                        (hol2cl.parser:parse_type "num->num"))
       "general recursive definition introduces the requested natural function")
(check hol2cl.runtime::*catch-break* "system.ml installs the source interrupt policy")
(let ((axioms (hol2cl.fusion:axioms hol2cl.runtime:unit)))
  (check (and (= 4 (length axioms))
              (hol2cl.runtime:= (rest axioms) *initial-source-axioms*))
         "source axioms remain unchanged beside the one explicit primitive-kernel fixture axiom"))
(format t "SBCL checks passed: ~d~%" *checks*)
