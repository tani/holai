(require :asdf)
(asdf:initialize-source-registry `(:source-registry (:directory ,(truename ".")) :inherit-configuration))
(setf *compile-verbose* nil *load-verbose* nil)
(asdf:load-system "hol2cl-runtime")
(defpackage :pattern-test (:use :cl :hol2cl.runtime)
  (:shadowing-import-from :hol2cl.runtime :funcall :partial :compare := :< :> :<= :>= :Some :formatter :list-length))
(in-package :pattern-test)
(defvar *checks* 0)
(defun check (x) (incf *checks*) (unless x (error "Pattern check ~d" *checks*)))
(defvariant term (Var name ty) (Const name ty) (Comb left right) (Empty))
(defrecord rec foo bar baz)
(define-exception boom message)
(let* ((tm (make-Comb (make-Var "x" 1) (make-Const "y" 2))) (count 0))
  (check (equal (match (progn (incf count) tm)
                 ((Comb (Var name _) (Const rhs _)) (list name rhs))) '("x" "y")))
  (check (= count 1))
  (check (eq (match tm ((cl:and alias (Comb _ _)) alias)) tm))
  (check (match tm ((Comb _) t)))
  (check (match 9 ((Comb _ _) nil) (_ t))))
(check (= (match (make-rec :foo 3 :bar 4 :baz 5) ((rec :baz x :foo y) (+ x y))) 8))
(check (= (match (ref 7) ((ref-contents x) x)) 7))
(check (match (make-boom "bad") ((boom "bad") t)))
(check (match #\a ((character-code 97) t) (_ nil)))
(check (match 1 ((character-code 97) nil) (_ t)))
(check (match "abc" ("abc" t) (_ nil)))
(check (match 4 ("abc" nil) (_ t)))
(check (match #\a (#\a t)))
(check (match 1.0d0 (1.0d0 t)))
(check (match 1 (1.0d0 nil) (_ t)))
(check (eq (match -0.0d0 (0.0d0 t) (_ nil)) (eql -0.0d0 0.0d0)))
#+sbcl
(sb-int:with-float-traps-masked (:invalid)
  (let* ((nan (sb-kernel:make-double-float #x7ff80000 0))
         (matcher (compile nil `(lambda (value) (match value (,nan t) (_ nil))))))
    (check (eq (cl:funcall matcher nan) (eql nan nan)))))
(check (match nil (nil t)))
(check (match t (cl:t t)))
(check (= (match #(2 3) ((cl:vector a b) (+ a b))) 5))
(check (match #(2) ((cl:vector _ _) nil) (_ t)))
(check (match unit ((cl:type hol2cl.runtime::unit-value) t)))
(let ((count 0) (limit 0))
  (check (= (match (make-Var "x" 1)
              ((guard (cl:or (Var x _) (Var x _)) (progn (incf count) (> limit 0))) (length x))
              (_ 42)) 42))
  (check (= count 1)))
(let ((outer 10))
  (check (= (match (tuple 2 3) ((guard (tuple x y) (< x outer)) (+ x y outer))) 15)))
(check (= (match (make-Const 5 6) ((cl:or (Var x _) (Const x _)) x)) 5))
(check (= (match (tuple (make-Var 2 0) 3)
            ((tuple (cl:or (Var x _) (Const x _)) y) (+ x y))) 5))
(check (= (match (tuple 1 2) ((tuple x y) (+ x (match y (y (+ y 10)))))) 13))
(check (handler-case (match 1 (2 nil)) (match-failure () t)))
(check (handler-case (match 1 ((guard x (error 'boom :message "guard")) x)) (boom () t)))
(check (handler-case (match 1 (x (error 'boom :message "body"))) (boom () t)))
(dolist (pattern '((tuple x x) (cl:or x _) (Var _ _ _) (rec :missing x)
                   (rec :foo x :foo y) (Unknown x) (cl:cons x) (:bad)))
  (check (handler-case (progn (macroexpand-1 `(match nil (,pattern t))) nil)
           (error () t))))
;; The body is present once despite a wide OR; no runtime registry operations.
(let* ((body '(print :unique-pattern-body))
       (expansion (macroexpand-1 `(match nil ((cl:or x x x x x x x x) ,body))))
       (text (write-to-string expansion)))
  (check (= (loop for pos = (search "UNIQUE-PATTERN-BODY" text) then (search "UNIQUE-PATTERN-BODY" text :start2 (+ pos 1))
                 while pos count t) 1))
  (check (not (search "GETHASH" text))))
;; Separate compilation, FASL load and stale declaration signature rejection.
(let* ((source #p"_build/pattern-unit.lisp") (output nil))
  (with-open-file (s source :direction :output :if-exists :supersede)
    (write-line "(in-package :pattern-test)" s)
    (write-line "(defvariant separate (Separate value))" s)
    (write-line "(defun separate-match (x) (match x ((Separate y) y)))" s))
  (setf output (compile-file source))
  (load output)
  (check (= (separate-match (make-Separate 9)) 9))
  (with-open-file (s source :direction :output :if-exists :supersede)
    (write-line "(in-package :pattern-test)" s)
    (write-line "(defun dependent-match (x) (match x ((Separate y) y)))" s))
  (setf output (compile-file source))
  (load output)
  (let* ((registry hol2cl.runtime::*pattern-descriptions*)
         (old (gethash 'Separate registry)))
    (unwind-protect
         (progn (setf (gethash 'Separate registry) (list :class 'bogus :arity 1))
                (check (= (dependent-match (make-Separate 11)) 11))
                (check (handler-case (progn (load output) nil) (error () t))))
      (setf (gethash 'Separate registry) old))))
;; Wide tuples and nested constructors must compile without recursive list DSL expansion.
(let* ((wide (make-list 128 :initial-element '_))
       (deep (loop with p = '_ repeat 60 do (setf p `(Comb ,p _)) finally (return p))))
  (check (functionp (compile nil `(lambda (x) (match x ((tuple ,@wide) t) (_ nil))))))
  (check (functionp (compile nil `(lambda (x) (match x (,deep t) (_ nil)))))))
(format t "~&Pattern checks passed: ~d~%" *checks*)
