(require :asdf)
(defmethod asdf:perform :before ((op asdf:compile-op) (component asdf:cl-source-file))
  (error "Unexpected file compilation during FASL-only measurement: ~a" (asdf:component-pathname component)))
(defmethod asdf:perform :around ((op asdf:load-op) (component asdf:cl-source-file))
  (if (search "/generated/" (namestring (asdf:component-pathname component)))
      (let ((wall (get-internal-real-time)) (cpu (get-internal-run-time))
            (gc sb-ext:*gc-run-time*) (bytes (sb-ext:get-bytes-consed)))
        (format t "~&START_LOAD ~a~%" (asdf:component-name component)) (finish-output)
        (prog1 (call-next-method)
          (format t "~&LOAD_METRIC ~a ~,6f ~,6f ~,6f ~d~%"
            (asdf:component-name component)
            (/ (- (get-internal-real-time) wall) (float internal-time-units-per-second 1d0))
            (/ (- (get-internal-run-time) cpu) (float internal-time-units-per-second 1d0))
            (/ (- sb-ext:*gc-run-time* gc) (float internal-time-units-per-second 1d0))
            (- (sb-ext:get-bytes-consed) bytes)) (finish-output)))
      (call-next-method)))
(time (load "tests/bootstrap.lisp"))
(format t "~&INITIAL_COUNTS ~d ~d ~d ~d~%"
 (length (hol2cl.fusion:types hol2cl.runtime:unit))
 (length (hol2cl.fusion:constants hol2cl.runtime:unit))
 (length (hol2cl.fusion:definitions hol2cl.runtime:unit))
 (length (hol2cl.fusion:axioms hol2cl.runtime:unit)))
(format t "~&CORE_INITIALIZATION_COMPLETE~%")
(finish-output)
