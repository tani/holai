(require :asdf)
(asdf:initialize-source-registry `(:source-registry (:directory ,(truename ".")) (:tree ,(truename "vendor/lisp/")) :inherit-configuration))
(setf asdf:*asdf-verbose* nil *compile-verbose* nil *load-verbose* nil)
(asdf:load-system "hol2cl-runtime")
(defvar *protocol-checks* 0)
(defun ensure-protocol (test) (incf *protocol-checks*) (unless test (error "Protocol check ~d" *protocol-checks*)))
(hol2cl.runtime:defunc foo (a b c) (+ (* 100 a) (* 10 b) c))
(ensure-protocol (= 123 (foo 1 2 3)))
(ensure-protocol (= 123 (funcall (funcall (foo 1) 2) 3)))
(ensure-protocol (= 123 (funcall (foo 1 2) 3)))
(ensure-protocol (= 123 (funcall (foo 1) 2 3)))
(ensure-protocol (= 123 (funcall (funcall (funcall (foo) 1) 2) 3)))
(hol2cl.runtime:defunc returned-adder (x)
  (hol2cl.runtime:lambdac (y) (+ x y)))
(ensure-protocol (= 30 (returned-adder 10 20)))
(ensure-protocol (= 30 (funcall (returned-adder 10) 20)))
(hol2cl.runtime:defunc three-stages (x)
  (hol2cl.runtime:lambdac (y) (hol2cl.runtime:lambdac (z) (+ x y z))))
(ensure-protocol (= 6 (three-stages 1 2 3)))
(ensure-protocol (= 6 (funcall (three-stages 1 2) 3)))
(let ((f (hol2cl.runtime:lambdac (a b c) (+ a b c))))
  (ensure-protocol (= 6 (funcall (funcall (funcall f 1) 2) 3)))
  (ensure-protocol (= 6 (funcall f 1 2 3))))
(hol2cl.runtime:labelsc ((even-p (x) (if (zerop x) t (odd-p (1- x))))
                       (odd-p (x) (if (zerop x) nil (even-p (1- x)))))
  (ensure-protocol (even-p 10))
  (ensure-protocol (odd-p 9))
  (ensure-protocol (funcall (even-p) 10)))
(flet ((same (x) (+ 100 x)))
  (hol2cl.runtime:fletc ((same (x y) (+ (same x) y)))
    (ensure-protocol (= 105 (same 2 3)))
    (ensure-protocol (= 105 (funcall (same 2) 3)))))
(let ((f (hol2cl.runtime:fletc ((capture (x y) (+ x y))) #'capture)))
  (ensure-protocol (= 5 (funcall (funcall f 2) 3))))
(defparameter *old-foo* (symbol-function 'foo))
(hol2cl.runtime:defunc foo (a b c) (* a b c))
(ensure-protocol (= 123 (funcall (funcall *old-foo* 1) 2 3)))
(ensure-protocol (= 6 (foo 1 2 3)))
(let* ((fn #'+) (a (hol2cl.runtime:function-value fn 2))
       (b (hol2cl.runtime:function-value fn 2)))
  (ensure-protocol (eq a b))
  (ensure-protocol (= 7 (funcall (funcall a 3) 4)))
  (sb-ext:gc :full t)
  (ensure-protocol (eq a (hol2cl.runtime:function-value fn 2))))
(ensure-protocol (multiple-value-bind (symbol present) (find-symbol "*FUNCTION-ARITIES*" :hol2cl.runtime)
                    (or (not present) (not (boundp symbol)))))
(ensure-protocol (handler-case (progn (foo 1 2 3 4) nil) (type-error () t)))
(defvar *body-count* 0)
(hol2cl.runtime:defunc once-only (x)
  (incf *body-count*)
  (hol2cl.runtime:lambdac (y) (+ x y)))
(ensure-protocol (and (= 30 (once-only 10 20)) (= 1 *body-count*)))
(defun dead-native-adapter ()
  (let* ((cell (vector 0))
         (fn (lambda (x) (incf (aref cell 0) x)))
         (adapter (hol2cl.runtime:function-value fn 1)))
    (sb-ext:make-weak-pointer adapter)))
;; Separate top-level forms let the creation frame/registers cease retaining
;; the otherwise dead adapter before testing collection.
(defparameter *dead-native-pointer* (dead-native-adapter))
(sb-ext:gc :full t)
(sb-ext:gc :full t)
(ensure-protocol (null (sb-ext:weak-pointer-value *dead-native-pointer*)))
(let ((p (foo 1)))
  (sb-ext:gc :full t)
  (ensure-protocol (= 6 (funcall p 2 3))))
(format t "Protocol checks passed: ~d~%" *protocol-checks*)
