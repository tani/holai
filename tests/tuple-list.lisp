(require :asdf)
(asdf:initialize-source-registry `(:source-registry (:directory ,(truename ".")) (:tree ,(truename "vendor/lisp/")) :inherit-configuration))
(setf asdf:*asdf-verbose* nil *compile-verbose* nil *load-verbose* nil)
(asdf:load-system "hol2cl-runtime")
(defvar *tuple-list-checks* 0)
(defun check-tuple (value) (incf *tuple-list-checks*) (unless value (error "Tuple-list check ~d failed" *tuple-list-checks*)))
(let* ((inner (hol2cl.runtime:tuple 3 4)) (pair (hol2cl.runtime:tuple nil inner)))
  (check-tuple (equal (hol2cl.runtime:tuple-items pair) (list nil inner)))
  (check-tuple (not (vectorp (hol2cl.runtime:tuple-items pair))))
  (check-tuple (null (hol2cl.runtime:fst pair)))
  (check-tuple (eq inner (hol2cl.runtime:snd pair)))
  (check-tuple (trivia:match pair ((hol2cl.runtime:tuple nil (hol2cl.runtime:tuple 3 4)) t) (_ nil)))
  (check-tuple (trivia:match pair ((hol2cl.runtime:tuple _) nil) (_ t)))
  (check-tuple (trivia:match pair ((hol2cl.runtime:tuple _ _ _) nil) (_ t)))
  (check-tuple (handler-case (progn (hol2cl.runtime:= pair (list nil inner)) nil) (hol2cl.runtime:invalid_argument () t))))
(check-tuple (hol2cl.runtime:< (hol2cl.runtime:tuple 99 99) (hol2cl.runtime:tuple 0 0 0)))
(check-tuple (hol2cl.runtime:< (hol2cl.runtime:tuple 1 8) (hol2cl.runtime:tuple 2 0)))
(let ((a (hol2cl.runtime:tuple 1 (hol2cl.runtime:tuple 2 3)))
      (b (hol2cl.runtime:tuple 1 (hol2cl.runtime:tuple 2 3))))
  (check-tuple (hol2cl.runtime:= a b))
  (check-tuple (= (hol2cl.runtime::structural-hash a) (hol2cl.runtime::structural-hash b))))
(dolist (index '(-1 2 1/2))
  (check-tuple (handler-case (progn (hol2cl.runtime:tuple-ref (hol2cl.runtime:tuple 1 2) index) nil)
                 (type-error () t))))
(check-tuple (trivia:match (hol2cl.runtime:tuple) ((hol2cl.runtime:tuple) t) (_ nil)))
(format t "~&Tuple-list checks passed: ~d~%" *tuple-list-checks*)
